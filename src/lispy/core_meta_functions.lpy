;;; This is the source for core/meta_functions.py
(= WARNING "This script should be edited in .lpy file, not translated .py file.")

(require lispy.macros *)

(from lispy.core.compiler.literal [identifier-p plain-name-p python-name-p])
(from lispy.core.errors [LispyCompileError])
(from lispy.core.nodes *)
(from lispy.core.nodes [atom-text])
(from lispy.core.builtins [__all__ as MACRO-SCOPE-NAMES])

;; The generated code binds no lasting global of the module it runs in
;; (defmacro's scope function is deleted right after it runs): it reaches
;; every module it needs through __import__ (read from a function's
;; __builtins__), so a user's own importlib stays theirs and a macro named
;; importlib does not clash with the next defmacro.  The one import statement
;; is defmacro's import of the macro tools, local to its scope function, and
;; it stays a statement so the Python backend resolves the names to their
;; declarations.  Fresh nodes per use, since compiling may change a node in
;; place.
(def builtin [name]
  "The generated code's form for the builtin NAME, read from a function's
   __builtins__, never by a global lookup: the user module can rebind a global
   name (or make it a macro), while a function's __builtins__ is the dict an
   import statement reads."
  (return `(sub (. (lambda [] 0) __builtins__) ~name)))

(def macro-table []
  "The generated code's form for the module lispy.core.macro_table."
  (return `(~(builtin "__import__") "lispy.core.macro_table"
                                     :fromlist ["MacroTable"])))

(def defmacro-transform [sexp]
  (= [op macroname *body] sexp.list)
  (= macroname (str macroname))
  ;; The generated defs are Python names: a macro named ->> or ++ gets the
  ;; bare prefix (each is deleted or local, so names never clash).
  (= newname (Symbol (+ "___defmacro_temp___" macroname)))
  (if (not (identifier-p newname.name))
      (= newname (Symbol "___defmacro_temp___")))
  (= scopename (Symbol (+ "___defmacro_scope___" macroname)))
  (if (not (identifier-p scopename.name))
      (= scopename (Symbol "___defmacro_scope___")))
  ;; The body is defined inside a function that first imports the macro
  ;; tools (MACRO-SCOPE-NAMES, lispy.core.builtins) by an explicit list, so it
  ;; and the node-class calls its quasiquotes compile to read them as closure
  ;; cells: a function-local import binds none of them in the user's module,
  ;; where they would overwrite the user's own Paren or gensym, and the Python
  ;; backend resolves each name to its real declaration (types, docs).  The
  ;; runtime table is a MacroTable too, so the module's code registers by
  ;; name as the compiler does (why: core/macro_table.py).  Modules are
  ;; reached by attribute, never bound in the module: a binding deleted after
  ;; use is missing meanwhile for code running in the same scope.  Only the
  ;; parameter list and body forms are the user's; they still expand.
  (= tools [(Symbol name) for name in MACRO-SCOPE-NAMES])
  (return (mark-compiler-forms
            `(do (def ~scopename []
                   (from lispy.core.builtins [~@tools])
                   (def ~newname ~@body)
                   (return ~newname))
                 (= (sub (.scope-table ~(macro-table) (~(builtin "globals"))) ~macroname)
                    (~scopename))
                 (del ~scopename))
            body)))

(= REQUIRE-QUALIFIED "qualified")
(= REQUIRE-ALL "all")
(= REQUIRE-NAMED "named")

(def require-error [node problem]
  "The one shape of a malformed require's error, at node."
  (return (LispyCompileError (+ "(require ...) " problem) node)))

(def symbol-text-p [node text]
  "Whether node is the bare symbol spelled text."
  (return (and (is (type node) Symbol) (== (atom-text node) text))))

(def require-qualifier [module]
  "The name a qualified (require module) registers every macro under (as
   qualifier.name): the name Python's import of module binds, its dotted
   name when absolute, its last part when relative (.mac and ..pkg.mac
   are mac, as from . import mac and from ..pkg import mac bind mac).  A
   relative module of dots alone binds no name: an error at it."
  (= text (atom-text module))
  (if (not (.startswith text "."))
      (return text))
  (= last (sub (.split (.lstrip text ".") ".") -1))
  (if (not last)
      (raise (require-error
               module
               f"cannot qualify macros by {text}, which binds no name: use (require {text} as name), * or [names...]")))
  (return last))

(def require-parse [sexp]
  "The one parse of (require module ...), read by the compiler and the LSP:
   (kind, qualifier, names).  REQUIRE-QUALIFIED for (require module) and
   (require module as alias): every macro, registered as qualifier.name,
   the qualifier being alias, else require-qualifier's.  REQUIRE-ALL for *:
   every macro, unqualified.  REQUIRE-NAMED for a list: exactly names, so
   an empty [] registers none.  The qualifier is None unless qualified,
   names None unless named.  A malformed require is a LispyCompileError at
   the part at fault (require-error), as the import forms refuse theirs."
  (= args (sub sexp.list [: 1 None]))
  (if (== (len args) 0)
      (raise (require-error sexp "expects a module name")))
  (= module (sub args 0))
  (if (isinstance module GluedHead)
      (raise (.misuse-error module)))
  (if (is-not (type module) Symbol)
      (raise (require-error module f"expects a module name, got {module}")))
  ;; Leading dots are a relative module's level; every part after them is a
  ;; name (python-name-p), so mac., a..b, m.- and .mac. are refused here.
  (= path (.lstrip (atom-text module) "."))
  (if (and path (not (all (map python-name-p (.split path ".")))))
      (raise (require-error module f"expects a module name, got {module}")))
  (= rest (sub args [: 1 None]))
  (if (== (len rest) 0)
      (return (, REQUIRE-QUALIFIED (require-qualifier module) None)))
  (= selection (sub rest 0))
  (if (symbol-text-p selection "as")
      (do (if (== (len rest) 1)
              (raise (require-error selection "expects a name after as")))
          (= alias (sub rest 1))
          (if (not (plain-name-p alias))
              (raise (require-error alias f"expects a name after as, got {alias}")))
          (if (> (len rest) 2)
              (raise (require-error
                       (sub rest 2)
                       f"takes no selection after an alias, which qualifies every macro, got {(sub rest 2)}")))
          (return (, REQUIRE-QUALIFIED (atom-text alias) None))))
  (= star (symbol-text-p selection "*"))
  (if (not (or star (isinstance selection Bracket)))
      (raise (require-error
               selection
               f"expects as alias, * or [names...] after the module, got {selection}")))
  (if (> (len rest) 1)
      (raise (require-error
               (sub rest 1)
               (ife (symbol-text-p (sub rest 1) "as")
                    "takes no alias after a selection: an alias qualifies every macro"
                    f"takes one selection after the module, got {(sub rest 1)}"))))
  (if star
      (return (, REQUIRE-ALL None None)))
  (for name in selection
    (if (is-not (type name) Symbol)
        (raise (require-error name f"expects a macro name, got {name}"))))
  (return (, REQUIRE-NAMED None [(atom-text name) for name in selection])))

(def require-transform [sexp]
  (= [kind qualifier names] (require-parse sexp))
  (= module-name-str (.replace (atom-text (sub sexp.list 1)) "-" "_"))
  (= is-relative (.startswith module-name-str "."))
  ;; The import runs in the emitted code itself, whose filename
  ;; (REQUIRE_FILENAME) tells the LSP a require asked for it.
  (= import-call (ife is-relative
                      `(.import-module (~(builtin "__import__") "importlib") ~module-name-str
                                       :package __package__)
                      `(.import-module (~(builtin "__import__") "importlib") ~module-name-str)))
  ;; One call registers the selection (register-required in
  ;; core/macro_table.py), so the emitted code binds no name in the requiring
  ;; module, where binding a name that is a macro there would be an error.
  (= prefix (ife (== kind REQUIRE-QUALIFIED) (+ qualifier ".") ""))
  (= selected (ife (== kind REQUIRE-NAMED) names `None))
  (return
    (mark-compiler-forms
      `(.register-required ~(macro-table) (~(builtin "globals")) ~import-call ~prefix ~selected))))

(when (== __name__ "__main__")
  (import os.path as osp)
  (from lispy.tools [l2py-s])

  (= path (osp.abspath __file__))

  (with [(open path "r") as f]
    (= org (f.read)))

  (= translated (l2py-s org :no-lispy True))

  (with [(open (-> path
                   (osp.dirname)
                   (osp.join "core" "meta_functions.py"))
               "w")
         as f]
    (f.write translated)))
