(defmacro cond [*body]
  (if (< (len body) 4)
      (return `(if ~@body))
      (do (= [test then *orelse] body)
          (return `(if ~test ~then (cond ~@orelse))))))

(defmacro conde [*body]
  (if (<= (len body) 2)
      (return (sub body -1))
      (do (= [test then *orelse] body)
          (return `(ife ~test ~then (conde ~@orelse))))))

(defmacro -> [x *fs]
  (if (== 0 (len fs))
      (return x))
  (= [f *rest] fs)
  (if (isinstance f Paren)
      (do (f.list.insert 1 x)
          (return `(-> ~f ~@rest)))
      (return `(-> (~f ~x) ~@rest))))

(defmacro ->> [x *fs]
  (if (== 0 (len fs))
      (return x))
  (= [f *rest] fs)
  (if (isinstance f Paren)
      (do (f.list.append x)
          (return `(->> ~f ~@rest)))
      (return `(-> (~f ~x) ~@rest))))

(defmacro as-> [expr name *forms]
  (if (== 0 (len forms))
      (return expr))
  (= sym (gensym (str name)))
  (= stmts [])
  (stmts.append `(= ~sym ~expr))
  (for f in forms
    (stmts.append `(= ~sym ~(replace-symbol f name sym))))
  (stmts.append sym)
  (return `(do ~@stmts)))

(defmacro fn [*body]
  (return `(lambda ~@body)))

(defmacro comment [*body]
  (pass))

(defmacro when [condition *body]
  (return `(if ~condition (do ~@body))))

(defmacro inc [elt]
  (return `(+ ~elt 1)))

(defmacro dec [elt]
  (return `(- ~elt 1)))

(defmacro ++ [elt]
  (return `(+= ~elt 1)))

(defmacro -- [elt]
  (return `(-= ~elt 1)))
