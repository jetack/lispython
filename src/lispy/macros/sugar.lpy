(defmacro cond [*body]
  (if (< (len body) 4)
      (return `(if ~@body))
      (do (= [test then *orelse] body)
          (return `(if ~test ~then (cond ~@orelse))))))

(defmacro conde [*body]
  (if (<= (len body) 2)
      (return (sub body -1))
      (do (= [test then *orelse] body)
          (return `(ife ~test ~then (conde ~@orelse))))))

(defmacro -> [x *fs]
  (if (== 0 (len fs))
      (return x))
  (= [f *rest] fs)
  (if (isinstance f Paren)
      (do (f.list.insert 1 x)
          (return `(-> ~f ~@rest)))
      (return `(-> (~f ~x) ~@rest))))

(defmacro ->> [x *fs]
  (if (== 0 (len fs))
      (return x))
  (= [f *rest] fs)
  (if (isinstance f Paren)
      (do (f.list.append x)
          (return `(->> ~f ~@rest)))
      (return `(-> (~f ~x) ~@rest))))

;; A tuple of walrus assignments indexed with -1 is a single expression, so
;; as-> works in any expression position (return value, call argument, lambda
;; body, nested) and evaluates each form once, left to right. It stays in the
;; caller's scope, so await/yield inside forms and class-body names keep their
;; meaning, unlike nested lambdas. The gensym binding leaks into the enclosing
;; scope (a unique name; a class attribute at class scope). CPython refuses
;; walrus in a comprehension's iterable and in a comprehension inside a class
;; body: that is a loud compile error, bind the value first.
(defmacro as-> [expr name *forms]
  (if (== 0 (len forms))
      (return expr))
  (= sym (gensym (str name)))
  (= steps [`(:= ~sym ~expr)])
  (for f in (sub forms (slice None -1))
    (steps.append `(:= ~sym ~(replace-symbol f name sym))))
  (steps.append (replace-symbol (sub forms -1) name sym))
  (return `(sub (, ~@steps) -1)))

(defmacro fn [*body]
  (return `(lambda ~@body)))

(defmacro comment [*body]
  (pass))

(defmacro when [condition *body]
  (return `(if ~condition (do ~@body))))

(defmacro inc [elt]
  (return `(+ ~elt 1)))

(defmacro dec [elt]
  (return `(- ~elt 1)))

(defmacro ++ [elt]
  (return `(+= ~elt 1)))

(defmacro -- [elt]
  (return `(-= ~elt 1)))
