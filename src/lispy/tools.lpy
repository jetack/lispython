(= HAS_RUFF (shutil.which "ruff"))

(from lispy.core.nodes *)
(from lispy.core.importer [package-root])
(from lispy.core.parser [parse])
(from lispy.core.compiler.literal [completion-label completion-prefix
                                   hyphen-spelling module-import-name name-key
                                   name-spellings])
(from lispy.core.macro [UnitStart compile-unit macroexpand seed-prelude])
(from lispy.core.macro-table [MacroTable find-macro])
(from lispy.core.compiler.utils [compile-nesting-errors])
(from lispy.core.unparse [unparse])
(from lispy.core.errors [LispyCompileError attach-source compile-errors
                         format-compile-error nesting-error])
(from lispy.form-docs [CLASS-KIND FUNCTION-KIND KEYWORD-KIND MACRO-TAG
                       OWN-NAME-TAGS OWN-TAG-KINDS VARIABLE-KIND])

(def report-compile-error [err :filename None :source None]
  "Print a LispyCompileError compiler-style (path:line:col, source, caret) to stderr."
  (print (format-compile-error (attach-source err filename source))
         :file sys.stderr))

(def detect-package-name [:path None]
  "(package name, import root) of path's directory (default the working
   directory), by __init__.py or __init__.lpy (package-root): a directory that
   is no package is its own import root, with an empty name.  Pure."
  (= dir-path (ife (is path None)
                   (os.getcwd)
                   (osp.dirname (osp.abspath path))))
  (= [root parts] (package-root dir-path))
  (return (, (.join "." parts) root)))

(= [MAIN-PACKAGE _main-root] (detect-package-name))
(if (and MAIN-PACKAGE (not (in _main-root sys.path)))
    (sys.path.insert 0 _main-root))

(def main-scope []
  "A new __main__ scope in the working directory's package.  SCOPE, the one
   the REPL and nREPL sessions share, is one; a translation that names no
   scope compiles in a new one, since every module unit compiles in its own
   scope and must not reset the session's macros."
  (return {"__builtins__" __builtins__
           "__name__" "__main__"
           "__package__" MAIN-PACKAGE
           "__macro_namespace" (MacroTable)}))

(= SCOPE (main-scope))

(def ast-to-python [st]
  ;; unparse writes any depth compile() takes, on a bounded stack per chunk;
  ;; a caller whose stack leaves less room than a chunk needs gets its
  ;; RecursionError, which is the nesting error, at st.
  (try
    (return (unparse st))
    (except [RecursionError]
      (raise (nesting-error st :recursion-limit True :what "translate")
             from None))))

(def src-to-python-org [src :include-meta False :scope None]
  "src's Python, compiled as a module unit in scope (default a new
   main-scope)."
  (if (is scope None)
      (= scope (main-scope)))
  (return (.join "\n" (map ast-to-python
                           (compile-unit
                             (parse src)
                             scope
                             :include-meta include-meta)))))

(def src-to-python [src :include-meta False :scope None :format True]
  (= raw-pysrc (src-to-python-org src :include-meta include-meta :scope scope))
  (if format
      (return (format-python-source raw-pysrc))
      (return raw-pysrc)))

(def format-python-source [pysrc]
  (if (not HAS_RUFF)
      (return pysrc))
  (try
    (with [(tempfile.NamedTemporaryFile :mode "w" :suffix ".py" :delete False) as f]
      (f.write pysrc)
      (= tmppath f.name))
    ;; Run ruff check --fix for import sorting (modifies file in place)
    (subprocess.run ["ruff" "check" "--fix" "--select" "I" tmppath]
                    :capture-output True)
    ;; Run ruff format (modifies file in place)
    (subprocess.run ["ruff" "format" tmppath]
                    :capture-output True)
    ;; Read back the formatted code
    (with [(open tmppath "r") as f]
      (= pysrc (.rstrip (f.read) "\n")))
    (os.unlink tmppath)
    (except [Exception as e]
      (print f"Ruff formatting failed: {e}")))
  (return pysrc))

(= argparser (argparse.ArgumentParser))
(argparser.add-argument "--meta"
                        :dest "include_meta"
                        :action "store_true")
(argparser.add-argument "--no-lispy"
                        :dest "no_lispy"
                        :action "store_true")

(def l2py-s [src :include-meta False :fresh-scope False :package "" :name None :no-lispy False :format True]
  "Translate lispy source string to Python source string.  A fresh scope is
   the module name's (when given) in package."
  (if fresh-scope
      (do (= scope {"__builtins__" __builtins__
                    "__package__" package
                    "__macro_namespace" (MacroTable)})
          (if (is-not name None)
              (= (sub scope "__name__") name)))
      (= scope (main-scope)))
  (= pysrc (src-to-python src :include-meta include_meta :scope scope :format format))
  (if no_lispy
      (return pysrc))
  (return (+ "import lispy\n\n" pysrc)))

(def l2py-f [file-path :include-meta False :no-lispy False :format True]
  "Translate lispy file to Python source string (standalone with sys.path setup)"
  ;; A translation never drops or replaces a loaded module, since dropping
  ;; lispython's own .lpy modules splits the process into two copies of them
  ;; (macro_modules is the one home of dropping modules), and its import root
  ;; is on sys.path only while it runs.
  (= [pkg root] (detect-package-name :path file-path))
  (= added-dir None)
  (if (not (in root sys.path))
      (do (sys.path.insert 0 root)
          (= added-dir root)))
  (try
    (with [(open file-path "rb") as f]
      (= src (.decode (f.read) "utf-8")))
    ;; The module's dotted name, as the importer names it: a module of
    ;; lispy.macros compiles without the prelude it is the source of.
    (= stem (sub (osp.splitext (osp.basename file-path)) 0))
    (= module-name (conde (== stem "__init__") pkg
                          pkg (+ pkg "." stem)
                          stem))
    (with [(compile-errors file-path src)]
      (return (+ (l2py-s src :include-meta include_meta :fresh-scope True :package pkg :name module-name :no-lispy no_lispy :format format) "\n")))
    (finally
      (if (and (is-not added-dir None) (in added-dir sys.path))
          (sys.path.remove added-dir)))))

(def l2py []
  "CLI entry point: parse args and translate file"
  (= [args more-args] (argparser.parse-known-args))
  (try
    (if (and (>= (len more-args) 2) (== (sub more-args 0) "-c"))
        (do (= src (sub more-args 1))
            (with [(compile-errors "<string>" src)]
              (print (l2py-s src :include-meta args.include_meta :no-lispy args.no_lispy))))
        (do (= file (osp.join (os.getcwd) (sub more-args 0)))
            (print (l2py-f file :include-meta args.include_meta :no-lispy args.no_lispy))))
    (except [LispyCompileError as e]
      (report-compile-error e)
      (sys.exit 1))))

(def _make-open-handler [o c]
  (def handler [event]
    (= buf event.app.current-buffer)
    (buf.insert-text (+ o c))
    (buf.cursor-left))
  (return handler))

(def _make-close-handler [c]
  (def handler [event]
    (= buf event.app.current-buffer)
    (if (== buf.document.current-char c)
        (buf.cursor-right)
        (buf.insert-text c)))
  (return handler))

(def _make-quote-handler [q]
  (def handler [event]
    (= buf event.app.current-buffer)
    (if (== buf.document.current-char q)
        (buf.cursor-right)
        (do
          (buf.insert-text (+ q q))
          (buf.cursor-left))))
  (return handler))

(= _SPECIAL-FORMS
   {, "def" "defn" "defmacro" "async-def"
      "if" "cond" "conde" "when" "unless"
      "while" "for" "async-for"
      "do" "try" "with" "async-with"
      "class" "deco"
      "lambda" "fn"
      "let" "match" "case"
      "except" "except*" "finally" "else"})

(def _col-of [text pos]
  "Column of position pos in text (0-based)."
  (= nl (.rfind text "\n" 0 pos))
  (return (- pos nl 1)))

(def _calc-indent [text]
  "Calculate indent for the next line based on text before cursor."
  (= in-string False)
  (= stack [])
  (= i 0)
  (= n (len text))
  (while (< i n)
    (= c (sub text i))
    (cond in-string
          (if (== c "\"")
              (= in-string False))

          (== c "\"")
          (= in-string True)

          (== c ";")
          (break)

          (in c "([{")
          (do
            (= paren-col (_col-of text i))
            (if (!= c "(")
                ;; [ and {: align to first element
                (do
                  (= j (+ i 1))
                  (while (and (< j n) (== (sub text j) " "))
                    (+= j 1))
                  (if (and (< j n) (not (in (sub text j) "\n")))
                      (stack.append (_col-of text j))
                      (stack.append (+ paren-col 1))))
                ;; (: special form vs function call
                (do
                  (= j (+ i 1))
                  (while (and (< j n) (== (sub text j) " "))
                    (+= j 1))
                  (= op-start j)
                  (while (and (< j n) (not (in (sub text j) " \n\t()[]{}'\"")))
                    (+= j 1))
                  (= op (sub text [: op-start j]))
                  (if (or (== op "") (in op _SPECIAL-FORMS))
                      (stack.append (+ paren-col 2))
                      (do
                        (= arg-pos j)
                        (while (and (< arg-pos n) (== (sub text arg-pos) " "))
                          (+= arg-pos 1))
                        (if (and (< arg-pos n) (not (in (sub text arg-pos) "\n")))
                            (stack.append (_col-of text arg-pos))
                            (stack.append (+ paren-col 2))))))))

          (in c ")]}")
          (if stack
              (stack.pop)))
    (+= i 1))
  (if stack
      (return (sub stack -1))
      (return 0)))

(def _parens-balanced? [text]
  (= depth 0)
  (= in-string False)
  (for c in text
    (cond in-string
          (if (== c "\"")
              (= in-string False)
              (continue))

          (== c "\"")
          (= in-string True)

          (in c "([{")
          (+= depth 1)

          (in c ")]}")
          (-= depth 1)))
  (return (<= depth 0)))

(def make-repl-session []
  (from prompt-toolkit [PromptSession])
  (from prompt-toolkit.history [FileHistory])
  (from prompt-toolkit.key-binding [KeyBindings])
  (from prompt-toolkit.keys [Keys])

  (= kb (KeyBindings))
  (= _pairs {"(" ")" "[" "]" "{" "}" "'" "'" "\"" "\""})

  (for [o c] in (_pairs.items)
    ((kb.add o) (_make-open-handler o c)))

  (for c in (_pairs.values)
    ((kb.add c) (_make-close-handler c)))

  (for q in ["'" "\""]
    ((kb.add q) (_make-quote-handler q)))

  ;; Backspace deletes both chars of an empty pair
  (= _bp _pairs)
  (def handle-backspace [event]
    (= buf event.app.current-buffer)
    (= doc buf.document)
    (= before doc.char-before-cursor)
    (= after doc.current-char)
    (if (and (in before _bp) (== (sub _bp before) after))
        (do (buf.delete) (buf.delete-before-cursor))
        (buf.delete-before-cursor)))
  ((kb.add Keys.Backspace) handle-backspace)

  ;; Enter: submit
  (def handle-enter [event]
    (event.app.current-buffer.validate-and-handle))
  ((kb.add Keys.Enter) handle-enter)

  ;; Ctrl+J: insert newline with auto-indent
  (def handle-newline [event]
    (= buf event.app.current-buffer)
    (= text-before buf.document.text-before-cursor)
    (= indent (_calc-indent text-before))
    (buf.insert-text (+ "\n" (* " " indent))))
  ((kb.add "c-j") handle-newline)

  ;; Tab: auto-indent current line
  (def handle-tab [event]
    (= buf event.app.current-buffer)
    (= doc buf.document)
    ;; Get all text up to start of current line
    (= lines (.split doc.text-before-cursor "\n"))
    (if (> (len lines) 1)
        (= text-before (.join "\n" (sub lines [: -1])))
        (= text-before ""))
    (= indent (_calc-indent text-before))
    ;; Replace leading whitespace on current line
    (= current-line doc.current-line-before-cursor)
    (= stripped (.lstrip current-line))
    (= old-indent (- (len current-line) (len stripped)))
    (= new-indent-str (* " " indent))
    ;; Delete old indent, insert new
    (buf.cursor-left :count old-indent)
    (buf.delete :count old-indent)
    (buf.insert-text new-indent-str))
  ((kb.add "c-i") handle-tab)

  (= histfile (osp.join (osp.expanduser "~") ".lpy_history"))
  (return (PromptSession :history (FileHistory histfile)
                         :key-bindings kb
                         :multiline True
                         :prompt-continuation "...   ")))

(def eval-and-print [src :scope SCOPE :translate False :filename "<string>" :start UnitStart.MODULE]
  ;; Compile every statement before running any, so compile-errors covers
  ;; compiling only; compile-nesting-errors wraps compile() alone, one
  ;; statement at a time, so a too-deep error is at the first statement
  ;; compile() fails on, not the deepest of all.  start: src is a whole
  ;; unit (lpy -c) by default, CONTINUE for one input of a REPL session
  ;; (UnitStart).
  (with [(compile-errors filename src)]
    (= stl (compile-unit (parse src) scope :start start))
    (= codes [])
    (for st stl
      (with [(compile-nesting-errors [st])]
        (.append codes (compile (ast.Interactive :body [st]) filename "single")))))
  (if translate
      (do ;; (print "python translation")
        (-> (.join "\n" (list (map ast-to-python stl)))
            (format-python-source)
            (print))
        ;; (print "")
        ))
  ;; (print "result")
  (for code codes
    (eval code scope))
  ;; (print "\n")
  )

(def repl [:translate False]
  ;; Add current directory to sys.path for local imports
  (= cwd (os.getcwd))
  (if (not (in cwd sys.path))
      (sys.path.insert 0 cwd))

  (= session (make-repl-session))
  (= scope SCOPE)
  (eval-and-print "(from pprint [pprint])" scope :start UnitStart.CONTINUE)
  (while True
    (try
      (do
        (= src (session.prompt "repl> "))
        (eval-and-print src scope translate :filename "<repl>" :start UnitStart.CONTINUE))
      (except [SystemExit]
        (print "SystemExit caught. Exiting REPL.")
        (break))
      (except [EOFError as e]
        (print "Ctrl-d input. Exiting REPL.")
        (break))
      (except [KeyboardInterrupt]
        (print "\nKeyboard Interrupt")
        (continue))
      (except [LispyCompileError as e]
        (report-compile-error e))
      (except [Exception as e]
        (print "An error occurred:\n====================================")
        (traceback.print_exc)
        (print "====================================")))))

(= _NREPL-EVAL-IDS (itertools.count 1))  ; names "<nrepl-N>" for file-less evals
(= _NREPL-LINECACHE-LOCK (threading.Lock))  ; clients are served on threads

(def _nrepl-buffer-position [value name limit]
  "value as a 1-based buffer line or column; ValueError unless an int from 1
  to limit.  The bound matters: the source is padded with a character per
  line and column before it is parsed."
  (if (or (not (isinstance value int)) (isinstance value bool)
          (< value 1) (> value limit))
      (raise (ValueError (+ name " must be an integer from 1 to " (str limit)
                            ", got " (repr value)))))
  (return value))

(class _NreplBufferLines [collections.abc.Sequence]
  "linecache's lines for a file the nREPL has evaluated regions of: the lines
  each eval sent, keyed by line number, over the lines known before the first
  of them (the file on disk, or a load-file's text).

  ⚠️ Never a list with a slot per buffer line: linecache keeps the entry for
  the whole session (mtime None), and every file-less eval adds a new name,
  so a padded list would pin up to NREPL-MAX-POSITION-LINE slots per request.
  This holds only the code the client sent.  linecache and traceback use
  only len() and an index; an in-range line nothing supplied reads as a bare
  newline (a blank line), and only a read past the end gives '' (linecache's unknown line)."
  (def __init__ [self base]
    (= self._base base)
    (= self._overlay {})  ; 0-based index -> (leading spaces, text)
    (= self._len (len base)))

  (def overlay [self start lines indent]
    "Show lines from 0-based index start on, the first after indent spaces
    (the eval's column, so traceback carets line up)."
    (for [i text] (enumerate lines)
      (= (sub self._overlay (+ start i)) (, (ife (== i 0) indent 0) text)))
    (= self._len (max self._len (+ start (len lines)))))

  (def __len__ [self]
    (return self._len))

  (def __getitem__ [self index]
    (if (isinstance index slice)
        (return [(sub self i) for i in (range *(index.indices self._len))]))
    (if (< index 0)
        (+= index self._len))
    (if (or (< index 0) (>= index self._len))
        (raise (IndexError "line index out of range")))
    (= entry (self._overlay.get index))
    (if (is-not entry None)
        (return (+ (* " " (sub entry 0)) (sub entry 1))))
    (return (ife (< index (len self._base)) (sub self._base index) "\n"))))

(def _nrepl-register-source [filename src line column whole-file]
  "Make linecache show src at its buffer position in filename, so a
  traceback prints the user's source lines.

  mtime None keeps the entry through linecache.checkcache.  An eval of a
  region overlays its lines onto what is known of that file
  (_NreplBufferLines): separate requests evaluate separate definitions of
  one buffer, and a traceback through several of them must show every line.
  whole-file (load-file) replaces the entry with the file's lines, dropping
  regions evaluated earlier."
  (= lines [(+ l "\n") for l in (.split src "\n")])
  (if (.endswith src "\n")
      (lines.pop))
  (with [_NREPL-LINECACHE-LOCK]
    (if whole-file
        (= (sub linecache.cache filename) (, (len src) None lines filename))
        (do (= known (linecache.getlines filename))
            (if (not (isinstance known _NreplBufferLines))
                (do (= known (_NreplBufferLines known))
                    (= (sub linecache.cache filename)
                       (, 0 None known filename))))
            (known.overlay (- line 1) lines (- column 1))))))

(def _nrepl-format-exception [e]
  "The traceback of e without nrepl-eval's own frame: it starts at the
  user's code (or at the compiler, for a crash while compiling)."
  (= tb e.__traceback__)
  (while (and (is-not tb None) (is tb.tb_frame.f_code nrepl-eval.__code__))
    (= tb tb.tb_next))
  (return (.rstrip (.join "" (traceback.format-exception (type e) e tb)))))

;; --- eval output ------------------------------------------------------------
;;
;; An eval's output goes to a sink of the thread running it, never to a
;; globally swapped sys.stdout: connections evaluate on threads of their own
;; at the same time, and a global swap sent one eval's prints to whichever
;; eval swapped last.  While any eval runs, sys.stdout and sys.stderr are
;; routers (_NreplRouter) that look the writing thread's sink up.  A sink
;; is anything with write(key, text) and flush(), key NREPL-STDOUT-FIELD or
;; NREPL-STDERR-FIELD: a _NreplCapture (a plain eval, returned in its
;; result) or a _NreplStream (a stream eval, sent as out messages).
;; ⚠️ Output of a thread the user's code starts goes to the server's own
;; stream, never to the eval: that thread has no sink, and a sink found by
;; anything but the writing thread would cross between connections.

(= NREPL-STDOUT-FIELD "stdout")  ; result and out-message field of stdout text
(= NREPL-STDERR-FIELD "stderr")  ; result and out-message field of stderr text

(class _NreplRouter []
  "sys.stdout or sys.stderr while an nREPL eval runs: a write goes to the
  writing thread's innermost sink, under key, or to the wrapped stream (what
  sys.stdout/stderr was when routing started) for a thread with no sink."
  (def __init__ [self routing key wrapped]
    (= self._routing routing)
    (= self._key key)
    (= self.wrapped wrapped))

  (def write [self text]
    (if (not (isinstance text str))
        (raise (TypeError (+ "write() argument must be str, not "
                             (. (type text) __name__)))))
    (= sink (self._routing.sink))
    (if (is sink None)
        (return (self.wrapped.write text)))
    (sink.write self._key text)
    (return (len text)))

  (def writelines [self lines]
    (for text lines
      (self.write text)))

  (def flush [self]
    (= sink (self._routing.sink))
    (if (is sink None)
        (self.wrapped.flush)
        (sink.flush)))

  (deco property
    (def encoding [self]
      (return (or (getattr self.wrapped "encoding" None) "utf-8"))))

  (deco property
    (def errors [self]
      (return (getattr self.wrapped "errors" "strict"))))

  (deco property
    (def closed [self]
      (return False)))

  (def isatty [self]
    (return False))

  (def writable [self]
    (return True))

  (def readable [self]
    (return False))

  (def seekable [self]
    (return False))

  (def fileno [self]
    ;; No descriptor: one would let C-level writes bypass the sink.
    (raise (io.UnsupportedOperation "fileno"))))

(class _NreplOutputRouting []
  "Which sink each thread's output goes to, and the routers that read it.
  The routers are installed when the first thread pushes a sink and removed
  (sys.stdout/stderr back to the wrapped streams, when they are still the
  routers) when the last sink is gone.  Sinks are per thread ident, a stack
  for nested evals; only the thread itself pushes and pops its stack, so a
  write reads it without the lock."
  (def __init__ [self]
    (= self._lock (threading.Lock))
    (= self._sinks {})  ; thread ident -> [sink ...], innermost last
    (= self._routers None))  ; (stdout router, stderr router) while installed

  (def sink [self]
    "The calling thread's innermost sink, or None."
    (= stack (.get self._sinks (threading.get-ident)))
    (return (ife stack (sub stack -1) None)))

  (def push [self sink]
    (with [self._lock]
      (.append (.setdefault self._sinks (threading.get-ident) []) sink)
      (if (is self._routers None)
          (self._install))))

  (def pop [self sink]
    (with [self._lock]
      (= ident (threading.get-ident))
      (= stack (.get self._sinks ident []))
      (if (in sink stack)
          (.remove stack sink))
      (if (and (in ident self._sinks) (not stack))
          (del (sub self._sinks ident)))
      (self._uninstall-if-idle)))

  (def release-thread [self]
    "Drop every sink of the calling thread.  The eval worker calls it after
    each job: an async KeyboardInterrupt (an interrupt) can land between a
    push and the try whose finally pops it, which would otherwise leave the
    routers installed for good."
    (with [self._lock]
      (.pop self._sinks (threading.get-ident) None)
      (self._uninstall-if-idle)))

  (def _install [self]
    (= routers [])
    (for [key stream] [(, NREPL-STDOUT-FIELD sys.stdout) (, NREPL-STDERR-FIELD sys.stderr)]
      (if (isinstance stream _NreplRouter)  ; left behind by a replaced router
          (= stream stream.wrapped))
      (.append routers (_NreplRouter self key stream)))
    (= self._routers (tuple routers))
    (= [sys.stdout sys.stderr] routers))

  (def _uninstall-if-idle [self]
    (if (or self._sinks (is self._routers None))
        (return))
    (= [out err] self._routers)
    (= self._routers None)
    ;; Code that replaced sys.stdout while it ran keeps its replacement.
    (if (is sys.stdout out)
        (= sys.stdout out.wrapped))
    (if (is sys.stderr err)
        (= sys.stderr err.wrapped))))

(= _NREPL-OUTPUT (_NreplOutputRouting))

(class _NreplCapture []
  "A sink keeping an eval's stdout and stderr for its result."
  (def __init__ [self]
    (= self.streams {NREPL-STDOUT-FIELD (io.StringIO) NREPL-STDERR-FIELD (io.StringIO)}))

  (def write [self key text]
    (.write (sub self.streams key) text))

  (def flush [self]
    (pass))

  (def value [self key]
    (return (.getvalue (sub self.streams key)))))

(= NREPL-OUT-OP "out")  ; op of a stream eval's interim output message
;; A stream eval's output goes out promptly: at once on a newline, a flush()
;; or NREPL-OUT-FLUSH-SIZE buffered characters, else at most
;; NREPL-OUT-FLUSH-DELAY seconds after a partial line was written.
(= NREPL-OUT-FLUSH-DELAY 0.05)
(= NREPL-OUT-FLUSH-SIZE 8192)
;; Characters buffered or being sent at which a writer blocks until the
;; flusher drained them, so an eval printing faster than the client reads
;; holds bounded memory.  It waits in NREPL-OUT-WAIT-SLICE second slices:
;; an async KeyboardInterrupt (an interrupt) is delivered only between
;; bytecodes, never inside one untimed wait.
(= NREPL-OUT-CAP (* 1024 1024))
(= NREPL-OUT-WAIT-SLICE 0.1)
(= NREPL-OUT-MAX-MESSAGE (* 64 1024))  ; most characters of text in one out message

(class _NreplStream []
  "A stream eval's sink: output is buffered in write order across stdout and
  stderr as (key, texts) chunks, adjacent writes to one key merged, and a
  flusher thread sends each chunk as out messages of at most
  NREPL-OUT-MAX-MESSAGE characters through send (a whole-line sender that
  raises OSError).  A send failure marks the stream dead: later output is
  dropped and writers never block.  stop() sends what is left and joins the
  flusher, so every out message precedes the final result."
  ;; ⚠️ The writer is the eval's thread, where an interrupt raises
  ;; KeyboardInterrupt at any bytecode boundary, so its path uses only
  ;; primitives whose every step is one C call: a Lock held through `with`
  ;; and SimpleQueue tokens.  Never a threading.Condition or Event there:
  ;; their wait and notify are Python code, and an exception landing inside
  ;; one leaves the lock or the waiter list inconsistent.
  (def __init__ [self send msg]
    (= self._send send)
    (= self._msg msg)  ; the request, for its id
    (= self._lock (threading.Lock))
    ;; At most one pending token each: _wake tells the flusher the state
    ;; changed, _drained tells a writer blocked at NREPL-OUT-CAP that a batch
    ;; went out (or the stream died).
    (= self._wake (queue.SimpleQueue))
    (= self._drained (queue.SimpleQueue))
    (= self._chunks [])  ; [key, [text ...]] in write order
    (= self._buffered 0)  ; characters in _chunks
    (= self._in-flight 0)  ; characters taken by the flusher and not yet sent
    (= self._due None)  ; monotonic time a buffered partial line must go out by
    (= self._urgent False)  ; send without waiting for _due
    (= self._stopping False)
    (= self.dead False)
    (= self._thread (threading.Thread :target self._run :daemon True
                                      :name "nrepl-out")))

  (def start [self]
    (self._thread.start))

  (def stop [self]
    "Send what is buffered, then end and join the flusher."
    (with [self._lock]
      (= self._stopping True))
    (_nrepl-signal self._wake)
    (self._thread.join))

  (def write [self key text]
    (if (not text)
        (return))
    (while True
      (with [self._lock]
        (if self.dead
            (return))
        (if (< (+ self._buffered self._in-flight) NREPL-OUT-CAP)
            (do (if (and self._chunks (== (sub (sub self._chunks -1) 0) key))
                    (.append (sub (sub self._chunks -1) 1) text)
                    (.append self._chunks [key [text]]))
                (+= self._buffered (len text))
                (cond (or (in "\n" text) (>= self._buffered NREPL-OUT-FLUSH-SIZE))
                      (do (= self._urgent True)
                          (_nrepl-signal self._wake))
                      (is self._due None)
                      (do (= self._due (+ (time.monotonic) NREPL-OUT-FLUSH-DELAY))
                          (_nrepl-signal self._wake)))
                (return))))
      ;; Over the cap: wait for the flusher in short slices, so an interrupt
      ;; is delivered between them.
      (try
        (self._drained.get :timeout NREPL-OUT-WAIT-SLICE)
        (except [queue.Empty]
          (pass)))))

  (def flush [self]
    (with [self._lock]
      (if self._chunks
          (do (= self._urgent True)
              (_nrepl-signal self._wake)))))

  (def _take [self]
    "Wait for the next batch of chunks and take it; None once stopping with
    nothing left, or dead.  With nothing buffered it waits with no timeout:
    an idle stream never polls."
    (while True
      (with [self._lock]
        (if self.dead
            (return None))
        (= timeout None)
        (if self._chunks
            (do (if (not (or self._urgent self._stopping (is self._due None)))
                    (= timeout (max 0 (- self._due (time.monotonic)))))
                (if (not timeout)
                    (do (= batch self._chunks)
                        (= self._chunks [])
                        (= self._in-flight self._buffered)
                        (= self._buffered 0)
                        (= self._urgent False)
                        (= self._due None)
                        (return batch))))
            (if self._stopping
                (return None))))
      (try
        (self._wake.get :timeout timeout)
        (except [queue.Empty]
          (pass)))))

  (def _run [self]
    (while True
      (= batch (self._take))
      (if (is batch None)
          (return))
      (try
        (for [key texts] batch
          (= text (.join "" texts))
          (for start (range 0 (len text) NREPL-OUT-MAX-MESSAGE)
            (self._send
              (_nrepl-encode self._msg
                             {"op" NREPL-OUT-OP
                              key (sub text (slice start (+ start NREPL-OUT-MAX-MESSAGE)))}))))
        (except [OSError]
          (with [self._lock]
            (= self.dead True)
            (= self._chunks [])
            (= self._buffered 0))))
      (with [self._lock]
        (= self._in-flight 0))
      (_nrepl-signal self._drained))))

(def _nrepl-signal [tokens]
  "Leave one token in the SimpleQueue tokens unless one is pending already,
  so a wake-up never piles up."
  (if (tokens.empty)
      (tokens.put None)))

(def nrepl-eval [src scope :filename None :line None :column None :whole-file False
                 :output None]
  "Evaluate LisPython source, capturing stdout/stderr and return value.

  Output written by this thread goes to output (a sink: write(key, text)
  and flush(), see _NreplRouter), or, by default (None), into the result's
  stdout and stderr (stderr only when non-empty).  With an output the
  result's stdout is empty and it has no stderr.

  filename, line and column say where src sits in the editor's buffer (the
  1-based position of its first character, nREPL's file/line/column eval
  fields; None, a field the request left out, is 1); without a filename
  the source gets a fresh <nrepl-N> name.  The source is padded to that
  position before parsing, so compile errors, tracebacks and linecache all
  use buffer lines and columns.  whole-file marks src as the entire file
  (load-file), so it starts at line 1, column 1.  A load-file starts the
  file's unit again (UnitStart.MODULE): its macros are the built-in ones
  alone, and its first form may narrow them.  Source naming a file at a
  line given as 1 (column 1 or not given) is the file's top region
  (UnitStart.TOP): its first form re-derives only the built-in macros, so
  the file's own macros stay.  Any other eval only adds, since editor
  clients send file, line and column with every region.
  A compiled eval records each name its code spells other than by a
  hyphenated spelling (ok? for ok_p) in the scope's spellings
  (nrepl-scope-spellings), which completion labels by.  A whole-file eval
  replaces the record, as it is the whole buffer; any other eval only adds
  such spellings, so a later (def ok-p ...) wins the binding but not the
  label.  Only a load-file clears the record: a region eval renaming ok? to
  ok-p keeps the label ok? until the next load-file, since the nREPL sees
  only the code sent, never the buffer the rename left behind.
  Raises ValueError for an invalid filename, line or column; every other
  failure is the result's error."
  ;; Only a line the request sent as 1 is the file's top: a file eval with
  ;; no line has no known position, and re-deriving the built-ins there
  ;; would undo the file's opt-out mid-file.
  (= start (conde whole-file UnitStart.MODULE
                  (and (is-not filename None) (== line 1) (in column (, None 1)))
                  UnitStart.TOP
                  UnitStart.CONTINUE))
  (if (is line None)
      (= line 1))
  (if (is column None)
      (= column 1))
  (_nrepl-buffer-position line "line" NREPL-MAX-POSITION-LINE)
  (_nrepl-buffer-position column "column" NREPL-MAX-POSITION-COLUMN)
  (if (and whole-file (!= (, line column) (, 1 1)))
      (raise (ValueError "a whole file starts at line 1, column 1")))
  (if (is filename None)
      (= filename (+ "<nrepl-" (str (next _NREPL-EVAL-IDS)) ">")))
  (if (not (isinstance filename str))
      (raise (ValueError (+ "file must be a string, got " (repr filename)))))
  (= result {"value" None NREPL-STDOUT-FIELD "" "error" None})
  (= sink (ife (is output None) (_NreplCapture) output))
  (_NREPL-OUTPUT.push sink)
  (try
    (= padded (+ (* "\n" (- line 1)) (* " " (- column 1)) src))
    (_nrepl-register-source filename src line column whole-file)
    ;; Compile every statement before running any (see eval-and-print).
    ;; Compiling reshapes the scope's macro table; running the code holds
    ;; no lock, so a long eval never blocks another connection.
    (with [(nrepl-scope-lock scope) (compile-errors filename padded)]
      (= tree (parse padded))
      ;; Read before compiling: the spellings are the source's, never a
      ;; macro expansion's.  Only a spelling that is no hyphenated spelling
      ;; of its name is kept, the only kind completion-label uses, so the
      ;; record prefers the code spelling ok? to ok-p in whichever order the
      ;; evals wrote them, and an (ok-p) in a later eval never erases it.
      (= spelled {name spelling for [name spelling] in (.items (name-spellings tree))
                  if (!= (name-key spelling) name)})
      (= stl (compile-unit tree scope :start start))
      (= codes [])
      (for st stl
        (with [(compile-nesting-errors [st])]
          (.append codes
                   (ife (isinstance st ast.Expr)
                        (, eval (compile (ast.Expression :body st.value) filename "eval"))
                        (, exec (compile (ast.Module :body [st] :type-ignores [])
                                         filename "exec"))))))
      ;; Only code that compiled binds anything, so only it is recorded.
      (= spellings (nrepl-scope-spellings scope))
      (if whole-file
          (.clear spellings))
      (.update spellings spelled))
    (= last-val None)
    (for [run code] codes
      (= last-val (run code scope)))
    (if (is-not last-val None)
        (= (sub result "value") (repr last-val)))
    (except [LispyCompileError as e]
      (= (sub result "error") (format-compile-error e)))
    ;; SystemExit is a BaseException, so (exit) in client code would otherwise
    ;; escape and kill the connection; report it like any other eval error.
    (except [SystemExit as e]
      (= (sub result "error") (+ "SystemExit: " (str e.code))))
    ;; An interrupt (nREPL interrupt op) is a KeyboardInterrupt raised in
    ;; this thread: report it as the eval's error, with the traceback of
    ;; where the code stopped.
    (except [(, KeyboardInterrupt Exception) as e]
      (= (sub result "error") (_nrepl-format-exception e)))
    (finally
      (_NREPL-OUTPUT.pop sink)))
  (if (is output None)
      (do (= (sub result NREPL-STDOUT-FIELD) (sink.value NREPL-STDOUT-FIELD))
          (= stderr-out (sink.value NREPL-STDERR-FIELD))
          (if stderr-out
              (= (sub result NREPL-STDERR-FIELD) stderr-out))))
  (return result))

(def nrepl-load-file [file-path scope :output None]
  "Load a .lpy file into the REPL scope; its traceback lines come from this
  text, replacing any regions evaluated from the file earlier."
  (= script-dir (osp.dirname (osp.abspath file-path)))
  (if (not (in script-dir sys.path))
      (sys.path.insert 0 script-dir))
  (with [(open file-path "rb") as f]
    (= src (.decode (f.read) "utf-8")))
  (return (nrepl-eval src scope :filename file-path :whole-file True :output output)))

;; A file's own scope (Clojure's namespace of a file): evals naming a file and
;; load-files run in it, never in the session scope, so a file's definitions
;; and macro choices stay its own.  Created on first use and kept for the
;; server's lifetime; clients are served on threads, hence the lock.
(= _NREPL-FILE-SCOPES {})  ; normalised absolute path -> scope
(= _NREPL-FILE-SCOPES-LOCK (threading.Lock))

;; The search roots a file scope's namespace packages are counted up to:
;; sys.path as nrepl-server left it once it put the working directory on it,
;; never the live list, because nrepl-load-file puts each loaded file's own
;; directory there, and the nearest-root rule (package-root) would then make
;; a file's package depend on which sibling was loaded first.  None until a
;; server starts, when the current sys.path stands in.
(= _NREPL-IMPORT-ROOTS None)

(def nrepl-import-roots []
  "The search roots a file scope's package is decided against (package-root's
   roots): the server's sys.path snapshot, else the current sys.path, with
   '' read as the working directory."
  (= roots (ife (is _NREPL-IMPORT-ROOTS None) (list sys.path) _NREPL-IMPORT-ROOTS))
  (return [(ife (== root "") (os.getcwd) root) for root in roots]))

(def nrepl-file-scope [path]
  "The scope of the file at path, created (with the built-in macros) on first
   use.  Its __name__ is __main__, so a load-file runs the main guard; its
   __package__ is the package Python imports the file in from
   nrepl-import-roots (package-root, namespace packages included)."
  (= path (osp.abspath path))
  (= key (osp.normcase path))
  (with [_NREPL-FILE-SCOPES-LOCK]
    (= scope (.get _NREPL-FILE-SCOPES key))
    (if (is scope None)
        (do (= [_ parts] (package-root (osp.dirname path) (nrepl-import-roots)))
            (= scope {"__builtins__" __builtins__
                      "__name__" "__main__"
                      "__package__" (.join "." parts)
                      "__file__" path
                      "__macro_namespace" (MacroTable)})
            (seed-prelude scope)
            (= (sub _NREPL-FILE-SCOPES key) scope))))
  (return scope))

;; id(scope) -> (scope, lock, spellings), under _NREPL-FILE-SCOPES-LOCK.  A
;; side table, never a key in the scope, which is the user's globals
;; (completion would offer it, pickling fails, and code that clears its
;; globals would swap it).  The entry keeps the scope alive, so its id is
;; never reused.
(= _NREPL-SCOPE-LOCKS {})

(def _nrepl-scope-entry [scope]
  "scope's side-table entry (scope, lock, spellings), created on first use."
  (with [_NREPL-FILE-SCOPES-LOCK]
    (= entry (.get _NREPL-SCOPE-LOCKS (id scope)))
    (if (is entry None)
        (do (= entry (, scope (threading.RLock) {}))
            (= (sub _NREPL-SCOPE-LOCKS (id scope)) entry))))
  (return entry))

(def nrepl-scope-lock [scope]
  "The lock of scope's macro table, created on first use.  Connections are
   served on threads and share the session scope and file scopes.
   Compiling (an eval's compile phase, a macroexpand) holds it, so two
   compiles never reshape one table at once and completion, which takes
   its snapshot under it, never sees a table half reset by a unit start.
   Running code holds no lock and may still add to the table (a compiled
   defmacro or require), so every iteration over the table or scope is
   over a snapshot (list/dict), never the live dict."
  (return (sub (_nrepl-scope-entry scope) 1)))

(def nrepl-scope-spellings [scope]
  "Python name -> the code spelling evaluated in scope for it, when that is
   no hyphenated spelling of the name (ok? for ok_p, ->foo for _to_foo: the
   part of name-spellings' map nrepl-eval records), which completion labels
   the name by (completion-label, the LSP's rule over its buffer).  Read
   and written only under nrepl-scope-lock."
  (return (sub (_nrepl-scope-entry scope) 2)))

(= NREPL-NS-FIELD "ns")  ; the request field naming an eval/complete/macroexpand scope

(def _nrepl-request-scope [msg fields scope]
  "The scope a request runs in: the file scope of the first of fields (tried
   in order) whose value is a string path, else the session scope.  The one
   home of the ns rule: a present, non-null ns must be an absolute path
   (standard clients send namespace names, which would otherwise become
   <cwd>/name), checked even when an earlier field wins; ValueError if not."
  (if (in NREPL-NS-FIELD fields)
      (do (= ns (.get msg NREPL-NS-FIELD))
          (if (and (is-not ns None)
                   (not (and (isinstance ns str) (osp.isabs ns))))
              (raise (ValueError
                       (+ "ns must be an absolute file path, got " (repr ns)))))))
  (for field in fields
    (= path (.get msg field))
    (if (isinstance path str)
        (return (nrepl-file-scope path))))
  (return scope))

(def nrepl-macroexpand [src scope]
  "Macroexpand LisPython source and return the expanded s-expression."
  (try
    (= parsed (parse src))
    (= expanded [])
    ;; A defmacro in src defines a macro as it expands.
    (with [(nrepl-scope-lock scope)]
      (for sexp in parsed
        (expanded.append (str (macroexpand sexp scope)))))
    (return {"op" "macroexpand-result"
             "expansion" (.join "\n" expanded)
             "error" None})
    (except [Exception as e]
      (return {"op" "macroexpand-result"
               "expansion" None
               "error" (.rstrip (traceback.format-exc))}))))

(def _py-name [text]
  "The Python name lispython text stands for, as the compiler maps it
   (Symbol.name: my-x is my_x, ok? is ok_p)."
  (return (. (Symbol text) name)))

(def _resolve-obj [symbol scope]
  "Resolve a symbol string to a Python object in scope."
  (try
    (return (eval (_py-name symbol) scope))
    (except [Exception]
      (return None))))

;; The runtime-kind home: the LSP CompletionItemKind of a name with no own tag,
;; by its word (a Python keyword, or what _completion-kind or _attribute-kind
;; found its value to be).  An own tag's kind is OWN-TAG-KINDS'.
(= _RUNTIME-KINDS
   {"keyword" KEYWORD-KIND
    "class" CLASS-KIND
    "function" FUNCTION-KIND
    "variable" VARIABLE-KIND})

(def _own-name-tags []
  "{name: tag} of lispython's own names, the first row naming a name winning."
  (= tags {})
  (for [names tag] in OWN-NAME-TAGS
    (for name in names
      (.setdefault tags name tag)))
  (return tags))

(= _OWN-NAME-TAGS (_own-name-tags))

(def _tagged [tag]
  "The (tag, runtime word) class of a name lispython tags (own or macro)."
  (return (, tag None)))

(def _untagged [word]
  "The (tag, runtime word) class of a name with no tag: a keyword or a value."
  (return (, None word)))

(def _complete-result [head word classes]
  "The complete reply over {label: (filterText, (tag, runtime word))} for a
   prefix that is head (its text through its last ., or empty) then word,
   every label once in sorted order.  `items` is the contract, LSP-shaped:
   {label, kind, filterText} with the LSP CompletionItemKind number, plus
   labelDetails.description only for a tagged name (OWN-TAG-KINDS gives its
   kind, _RUNTIME-KINDS any other's).  A label is the text after head, as
   the LSP labels an item after a dot, and `word` is the typed text each
   label replaces, so a client places an item by replacing that many
   characters before the cursor in its own string units.  filterText is
   completion-prefix's (word as typed plus the rest of the label), so a
   client's plain prefix match keeps exactly the server's items.
   `completions` is the full name list (head + label, in items' order),
   read only by clients older than `items`."
  (= labels (sorted classes))
  (= items [])
  (for label in labels
    (= [text [tag kind-word]] (sub classes label))
    (if (is tag None)
        (.append items {"label" label
                        "kind" (sub _RUNTIME-KINDS kind-word)
                        "filterText" text})
        (.append items {"label" label
                        "kind" (sub OWN-TAG-KINDS tag)
                        "filterText" text
                        "labelDetails" {"description" tag}})))
  (return {"op" "complete-result"
           "word" word
           "completions" [(+ head label) for label in labels]
           "items" items}))

(def _completion-kind [obj]
  "The nREPL completion kind of a value: class, function or variable."
  (cond (isinstance obj type) (return "class")
        (callable obj) (return "function")
        True (return "variable")))

(= _FUNCTION-DESCRIPTORS
   ;; partialmethod is listed because, unlike other method wrappers, it is
   ;; not callable itself.
   (, staticmethod classmethod functools.partialmethod
      types.FunctionType types.BuiltinFunctionType types.MethodType
      types.MethodDescriptorType types.ClassMethodDescriptorType
      types.WrapperDescriptorType types.MethodWrapperType))

(def _attribute-kind [obj attr]
  "The completion kind of obj.attr, found without running user code.

   getattr would run a property, a descriptor or __getattr__ -- side effects
   and exceptions in the middle of a completion -- so the attribute is read
   with inspect.getattr_static and its raw object classified: functions,
   methods, static/class methods and partialmethods are functions; a class
   is a class; any other callable (an lru_cache wrapper) is a function; a
   non-callable descriptor (property, cached_property, slots) yields a
   value, so it is a variable, as is any other object.  An attribute only
   __getattr__ knows about is a variable."
  (try
    (= raw (inspect.getattr-static obj attr))
    (except [Exception]
      (return "variable")))
  (cond (isinstance raw _FUNCTION-DESCRIPTORS) (return "function")
        True (return (_completion-kind raw))))

(def _scope-macro-names [scope]
  "The keys of scope's macro table, as written ((require mod) registers
   mod.name); a call finds one by any spelling of its name (find-macro)."
  (with [(nrepl-scope-lock scope)]
    (return (list (.get scope "__macro_namespace" {})))))

(def nrepl-complete [prefix scope]
  "Return completions matching prefix, including dot-completion, filtered
   on the server as the LSP filters (filtered-answer): an item stays when
   its label starts with the typed word, prefix's last .-part, by
   completion-prefix (case aside, - and _ after a letter or digit match
   each other), which also gives its filterText.  Every key of the scope's
   macro table (defmacro, every require form) is a macro, so a qualified
   macro (mod.name) is offered under a dotted prefix too, when its leading
   parts are the typed head's by name-key.  Each name is offered once
   (name-key of its full name), the first source naming it winning:
   macros, lispython's own names, keywords, the scope, the builtins.
   Labels are the LSP's: the text after prefix's last . (the reply's word
   is what a label replaces); a runtime name (scope, builtins, attributes)
   by completion-label over the spellings of the code evaluated in the
   scope (ok? for ok_p, else the hyphen spelling), a macro key by the
   hyphen spelling of its parts after the head, own names and keywords as
   they are."
  (with [(nrepl-scope-lock scope)]
    (= spellings (dict (nrepl-scope-spellings scope))))
  (= parts (.split prefix "."))
  (= head-parts (sub parts [: -1]))
  ;; The typed text through the last ., which every candidate starts with.
  (= head (.join "" [(+ part ".") for part in head-parts]))
  (= head-key (name-key (.join "." head-parts)))
  (= word (sub parts -1))
  ;; name-key of the full name -> (label, (filterText, (tag, runtime word))).
  (= entries {})
  (def offer [label cls]
    (= text (completion-prefix word label))
    (if (is-not text None)
        (.setdefault entries (name-key (+ head label)) (, label (, text cls)))))
  (for key in (_scope-macro-names scope)
    (= key-parts (.split key "."))
    (if (and (> (len key-parts) (len head-parts))
             (or (not head-parts)
                 (== (name-key (.join "." (sub key-parts [: (len head-parts)])))
                     head-key)))
        (offer (hyphen-spelling (.join "." (sub key-parts [: (len head-parts) None])))
               (_tagged MACRO-TAG))))
  (if (in "." prefix)
      (do
        ;; Dot completion: resolve object, list its attributes
        (= obj (_resolve-obj (.join "." head-parts) scope))
        (if (is-not obj None)
            (for attr in (dir obj)
              (offer (completion-label attr spellings)
                     (_untagged (_attribute-kind obj attr))))))
      (do
        ;; Prefix completion from lispython's own names, keywords, scope
        ;; and builtins
        (for k in _OWN-NAME-TAGS
          (offer k (_tagged (sub _OWN-NAME-TAGS k))))
        (for k in keyword.kwlist
          (offer k (_untagged "keyword")))
        (with [(nrepl-scope-lock scope)]
          (= names (list scope)))
        ;; A scope binding shadows the builtin of the same name.
        (for k in names
          (offer (completion-label k spellings)
                 (_untagged (_completion-kind (.get scope k)))))
        (= builtins (ife (isinstance __builtins__ dict)
                         __builtins__
                         (vars __builtins__)))
        (for k in builtins
          (offer (completion-label k spellings)
                 (_untagged (_completion-kind (sub builtins k)))))))
  (return (_complete-result head word (dict (.values entries)))))

(def nrepl-docs [symbol scope]
  "Return documentation for a symbol."
  (try
    (= obj (_resolve-obj symbol scope))
    ;; Check macros, by any spelling of the name (find-macro)
    (if (is obj None)
        (= obj (find-macro (.get scope "__macro_namespace") symbol)))
    (if (is obj None)
        (return {"op" "docs-result" "docs" None "error" None}))
    ;; Build docs string
    (= parts [])
    (= name (hyphen-spelling symbol))
    ;; Signature
    (try
      (= sig (inspect.signature obj))
      (= params [])
      (for [pname p] in (.items sig.parameters)
        (= kind p.kind)
        (cond (== kind inspect.Parameter.VAR-POSITIONAL)
              (params.append (+ "*" (hyphen-spelling pname)))
              (== kind inspect.Parameter.VAR-KEYWORD)
              (params.append (+ "**" (hyphen-spelling pname)))
              (and (!= p.default inspect.Parameter.empty)
                   (in kind [inspect.Parameter.KEYWORD-ONLY
                             inspect.Parameter.POSITIONAL-OR-KEYWORD]))
              (params.append (+ ":" (hyphen-spelling pname) " " (repr p.default)))
              True
              (params.append (hyphen-spelling pname))))
      (parts.append (+ name " [" (.join " " params) "]"))
      (except [TypeError ValueError]
        (parts.append name)))
    ;; Docstring
    (= docstring (getattr obj "__doc__" None))
    (if docstring
        (parts.append (.strip (sub (.splitlines docstring) 0))))
    (return {"op" "docs-result"
             "docs" (.join " - " parts)
             "error" None})
    (except [Exception as e]
      (return {"op" "docs-result"
               "docs" None
               "error" (str e)}))))

(def nrepl-annotate [symbol scope]
  "Return type annotation for a symbol."
  (try
    (= obj (_resolve-obj symbol scope))
    (= macro None)
    (if (is obj None)
        (do (= macro (find-macro (.get scope "__macro_namespace") symbol))
            (= obj macro)))
    (if (is obj None)
        (return {"op" "annotate-result" "annotation" "unknown"}))
    (= klass (. (type obj) __name__))
    ;; A macro is a function too: the macro check comes first.
    (cond (is-not macro None)
          (= annotation "macro")
          (in klass ["function" "builtin_function_or_method"])
          (= annotation "function")
          (== klass "type")
          (= annotation "class")
          (== klass "module")
          (= annotation "module")
          True
          (= annotation "instance"))
    (return {"op" "annotate-result"
             "annotation" (+ "<" annotation " " (hyphen-spelling symbol) ">")})
    (except [Exception as e]
      (return {"op" "annotate-result"
               "annotation" "unknown"}))))

(def _nrepl-encode [msg result]
  "Encode result as one wire line, echoing the request id if present. Raises
  when result is not JSON-serialisable."
  (= req-id (.get msg "id"))
  (if req-id
      (= (sub result "id") req-id))
  (return (.encode (+ (json.dumps result) "\n") "utf-8")))

(def _nrepl-reply [conn msg result]
  "Send result back, echoing the request id if present."
  (conn.sendall (_nrepl-encode msg result)))

(def _nrepl-error-reply [conn msg error]
  "Reply {op: error} for a failed request. The one home of the error shape;
  msg is {} when no request could be parsed, so the reply carries no id."
  (_nrepl-reply conn msg {"op" "error" "error" error}))

(class _NreplUnknownOp [Exception]
  "Raised by _nrepl-dispatch; its message is the reply text as is."
  (pass))

(def _nrepl-failure-text [e]
  "The error reply text of a request whose handler raised e."
  (return (ife (isinstance e _NreplUnknownOp)
               (str e)
               (+ (. (type e) __name__) ": " (str e)))))

(def _nrepl-send-result [conn msg result]
  "Send a handler's result, or an error reply when it is not JSON-
  serialisable; only the socket send may raise (OSError)."
  (try
    (= data (_nrepl-encode msg result))
    (except [Exception as e]
      (_nrepl-error-reply conn msg (_nrepl-failure-text e))
      (return)))
  (conn.sendall data))

;; The nREPL wire names editor clients (lpy-mode, vsc-lispy) mirror; a test
;; pins each value.  NREPL-NS-FIELD, NREPL-OUT-OP and the stdout/stderr
;; fields are defined beside the code that reads them.
(= NREPL-EVAL-OP "eval")
(= NREPL-EVAL-RESULT-OP "eval-result")
(= NREPL-LOAD-FILE-OP "load-file")
(= NREPL-LOAD-FILE-RESULT-OP "load-file-result")
(= NREPL-STREAM-FIELD "stream")  ; true on an eval/load-file: a stream eval
(= NREPL-INTERRUPT-OP "interrupt")
(= NREPL-INTERRUPT-RESULT-OP "interrupt-result")
(= NREPL-INTERRUPT-ID-FIELD "interrupt-id")  ; the id of the eval to interrupt
(= NREPL-INTERRUPTED-ERROR "KeyboardInterrupt")  ; error of an eval stopped before it ran
(= _NREPL-RESULT-OPS {NREPL-EVAL-OP NREPL-EVAL-RESULT-OP
                      NREPL-LOAD-FILE-OP NREPL-LOAD-FILE-RESULT-OP})

(def _nrepl-dispatch [msg scope :output None]
  "Run one parsed request and return its result dict. Raises on an unknown op
  or when a handler fails; the caller turns that into an error reply.
  output is an eval's or load-file's sink (nrepl-eval); interrupt is the
  connection's (_NreplConnection), never dispatched here."
  (= op (.get msg "op" NREPL-EVAL-OP))
  (cond (== op NREPL-EVAL-OP)
        ;; file/line/column: where code sits in the client's buffer; a missing
        ;; or null field goes to nrepl-eval as None, which tells it apart
        ;; from a sent 1 (a file eval with no line is not the file's start).
        ;; ns (also on macroexpand and complete) picks the scope only: with
        ;; no file the filename stays None, so linecache and tracebacks never
        ;; name the ns file; file wins when both are sent.
        (do (= result (nrepl-eval (sub msg "code")
                                  (_nrepl-request-scope msg ["file" NREPL-NS-FIELD] scope)
                                  :filename (.get msg "file")
                                  :line (.get msg "line")
                                  :column (.get msg "column")
                                  :output output))
            (= (sub result "op") NREPL-EVAL-RESULT-OP)
            (return result))

        (== op NREPL-LOAD-FILE-OP)
        (do (= result (nrepl-load-file (sub msg "path")
                                       (_nrepl-request-scope msg ["path"] scope)
                                       :output output))
            (= (sub result "op") NREPL-LOAD-FILE-RESULT-OP)
            (return result))

        (== op "macroexpand")
        (return (nrepl-macroexpand (sub msg "code")
                                   (_nrepl-request-scope msg ["file" NREPL-NS-FIELD] scope)))

        (== op "complete")
        (return (nrepl-complete (sub msg "prefix")
                                (_nrepl-request-scope msg ["file" NREPL-NS-FIELD] scope)))

        (== op "docs")
        (return (nrepl-docs (sub msg "symbol")
                            (_nrepl-request-scope msg ["file"] scope)))

        (== op "annotate")
        (return (nrepl-annotate (sub msg "symbol")
                                (_nrepl-request-scope msg ["file"] scope)))

        (== op "ping")
        (return {"op" "pong"}))
  (raise (_NreplUnknownOp (+ "unknown op: " (str op)))))

(= NREPL-MAX-LINE (* 4 1024 1024))  ; bytes; longest request line a client may send
;; Largest eval line/column a client may send: nrepl-eval pads the source to
;; that position, so an unbounded one makes the server allocate without limit.
(= NREPL-MAX-POSITION-LINE 1_000_000)
(= NREPL-MAX-POSITION-COLUMN 100_000)

(def _nrepl-raise-in [ident exc]
  "Make exc pending in the thread ident (raised there at its next bytecode
  boundary); exc None clears a pending one.  ⚠️ Code blocked in one C call
  (a long time.sleep, a blocking read) sees it only when that call returns."
  (ctypes.pythonapi.PyThreadState-SetAsyncExc
    (ctypes.c-ulong ident) (ife (is exc None) None (ctypes.py-object exc))))

(def _nrepl-interrupt-key [value]
  "value as the key an interruptible eval is found by: a truthy id (one
  _nrepl-encode echoes) that is a JSON string or number, else None."
  (if (and value (isinstance value (, str int float)))
      (return value))
  (return None))

;; An eval job's states: QUEUED until the worker takes it; RUNNING while it
;; is inside its user-code window, the only state an interrupt raises in;
;; FINISHING once the window is closed and its result is being delivered.
(= _NREPL-QUEUED "queued")
(= _NREPL-RUNNING "running")
(= _NREPL-FINISHING "finishing")
(= _NREPL-DONE "done")

(class _NreplJob []
  "One eval or load-file request waiting for or running on a connection's
  eval worker."
  (def __init__ [self msg stream send]
    (= self.msg msg)
    (= self.sink (ife stream (_NreplStream send msg) None))
    (= self.state _NREPL-QUEUED)
    (= self.cancelled False)  ; interrupted while queued: never run
    (= self.ident None)  ; the worker thread, once RUNNING
    (= self.done (threading.Event))  ; its final reply was sent (or failed)
    (= self.send-error None)))  ; the OSError sending that reply raised

(class _NreplConnection []
  "One client connection: its send lock and its eval worker.

  Every eval and load-file runs on the connection's worker thread, from a
  FIFO queue: one connection's evals run one at a time in request order
  (Clojure nREPL's session rule, so an eval sees what the one before it
  defined), and different connections run at the same time.  A plain eval
  keeps the old contract: the reader waits for it before reading the next
  request, and its output comes back in its result, which vsc-lispy relies
  on (it settles a request on the first message carrying its id).  A
  stream eval (NREPL-STREAM-FIELD true, opt-in for that reason) does not
  hold the reader: complete, docs, interrupt and the rest are answered while
  it runs, and its output arrives as out messages (_NreplStream) before its
  final result.

  Every send on the connection is one whole line under one lock (sendall),
  so the reader, the worker and a stream's flusher never interleave bytes."
  (def __init__ [self conn scope]
    (= self.conn conn)
    (= self.scope scope)
    (= self._send-lock (threading.Lock))
    ;; Guards the jobs and every state change; an interrupt raises only
    ;; under it, while the job is RUNNING.
    (= self._lock (threading.Lock))
    (= self._jobs [])  ; queued and running jobs, in request order
    (= self._by-id {})  ; _nrepl-interrupt-key -> stream job, queued or running
    (= self._queue (queue.SimpleQueue))
    (= self._worker (threading.Thread :target self._work :daemon True
                                      :name "nrepl-eval"))
    (self._worker.start))

  (def sendall [self data]
    (with [self._send-lock]
      (self.conn.sendall data)))

  (def evaluate [self msg]
    "Queue an eval or load-file request.  A plain one is waited for (and its
    reply's send failure raised here, which ends the connection); a stream
    one returns at once.  A stream eval reusing the id of a queued or
    running one gets an error reply and is not run."
    (= stream (is (.get msg NREPL-STREAM-FIELD) True))
    (= key (_nrepl-interrupt-key (.get msg "id")))
    (= job (_NreplJob msg stream self.sendall))
    (with [self._lock]
      (= duplicate (and stream (is-not key None) (in key self._by-id)))
      (if (not duplicate)
          (do (if (and stream (is-not key None))
                  (= (sub self._by-id key) job))
              (.append self._jobs job))))
    (if duplicate
        (do (_nrepl-error-reply self msg (+ "an eval with id " (json.dumps key)
                                            " is already queued or running"))
            (return)))
    (self._queue.put job)
    (if (not stream)
        (do (job.done.wait)
            (if (is-not job.send-error None)
                (raise job.send-error)))))

  (def interrupt [self msg]
    "Answer an interrupt request: raise KeyboardInterrupt in the stream eval
    whose id is its NREPL-INTERRUPT-ID-FIELD when that eval runs, or cancel
    it when it is queued; an error reply when there is no such eval.  The
    reply goes out under the lock, so it precedes the eval's final result."
    (= target (.get msg NREPL-INTERRUPT-ID-FIELD))
    (= key (_nrepl-interrupt-key target))
    (with [self._lock]
      (= job (ife (is key None) None (.get self._by-id key)))
      (cond (is job None)
            (pass)
            (== job.state _NREPL-QUEUED)
            (= job.cancelled True)
            (== job.state _NREPL-RUNNING)
            (_nrepl-raise-in job.ident KeyboardInterrupt)
            True
            (= job None))
      (if (is job None)
          (_nrepl-error-reply self msg (+ "no queued or running stream eval with id "
                                          (json.dumps target)))
          (_nrepl-reply self msg {"op" NREPL-INTERRUPT-RESULT-OP
                                  NREPL-INTERRUPT-ID-FIELD target}))))

  (def close [self]
    "End the connection's evals: cancel the queued ones, interrupt the
    running one, then stop and join the worker (each still sends its final
    reply, which a closed peer may refuse)."
    (with [self._lock]
      (for job self._jobs
        (cond (== job.state _NREPL-QUEUED)
              (= job.cancelled True)
              (== job.state _NREPL-RUNNING)
              (_nrepl-raise-in job.ident KeyboardInterrupt))))
    (self._queue.put None)
    (self._worker.join))

  (def _work [self]
    (while True
      (= job (self._queue.get))
      (if (is job None)
          (return))
      (self._serve job)))

  (def _serve [self job]
    (if job.sink
        (job.sink.start))
    (= outcome (, _NREPL-INTERRUPTED None))
    (try
      (= outcome (self._execute job))
      ;; Raised past _execute's own close of the window (a second interrupt
      ;; landing in its bookkeeping): close it again.
      (except [KeyboardInterrupt]
        (self._close-window job)))
    ;; From here on no interrupt can be raised in this thread.
    (_NREPL-OUTPUT.release-thread)
    (if job.sink
        (job.sink.stop))
    (with [self._lock]
      (= job.state _NREPL-DONE)
      (.remove self._jobs job)
      ;; Before the final reply: a client may reuse the id once it has it.
      (= key (_nrepl-interrupt-key (.get job.msg "id")))
      (if (and (is-not key None) (is (.get self._by-id key) job))
          (del (sub self._by-id key))))
    (try
      (self._deliver job outcome)
      (except [OSError as e]
        (= job.send-error e))
      (finally
        (job.done.set))))

  (def _execute [self job]
    "Run job inside its user-code window and return its outcome, a (kind,
    value) pair."
    (with [self._lock]
      (if job.cancelled
          (return (, _NREPL-INTERRUPTED None)))
      (= job.ident (threading.get-ident))
      (= job.state _NREPL-RUNNING))
    ;; The window is open: from here an interrupt may raise KeyboardInterrupt
    ;; at any bytecode boundary, inside nrepl-eval's own bookkeeping too.
    ;; Every lock taken in it (scope lock, linecache lock, output routing,
    ;; a stream's lock) is held through `with`, so it is released on
    ;; the way out; a sink left pushed is dropped by release-thread.
    ;; nrepl-eval reports an interrupt of the user's code as its error; one
    ;; that escapes it (raised before or after its try) leaves the outcome
    ;; INTERRUPTED.
    (= outcome (, _NREPL-INTERRUPTED None))
    (try
      (try
        (= outcome (, _NREPL-RESULT (_nrepl-dispatch job.msg self.scope
                                                     :output job.sink)))
        (except [Exception as e]
          (= outcome (, _NREPL-FAILURE e))))
      (except [KeyboardInterrupt]
        (pass))
      (finally
        (self._close-window job)))
    (return outcome))

  (def _close-window [self job]
    "Leave job's user-code window: no interrupt raises in this thread after
    the lock is released, and one already pending is cleared.  A pending one
    may still fire anywhere before that, in this bookkeeping too, so it is
    retried until it completes."
    (while True
      (try
        (with [self._lock]
          (if (== job.state _NREPL-RUNNING)
              (do (= job.state _NREPL-FINISHING)
                  (_nrepl-raise-in job.ident None))))
        (return)
        (except [KeyboardInterrupt]
          (continue)))))

  (def _deliver [self job outcome]
    (= [kind value] outcome)
    (cond (== kind _NREPL-RESULT)
          (_nrepl-send-result self job.msg value)
          (== kind _NREPL-FAILURE)
          (_nrepl-error-reply self job.msg (_nrepl-failure-text value))
          True
          (_nrepl-send-result
            self job.msg
            {"op" (.get _NREPL-RESULT-OPS (.get job.msg "op" NREPL-EVAL-OP))
             "value" None NREPL-STDOUT-FIELD "" "error" NREPL-INTERRUPTED-ERROR}))))

;; A job's outcome kinds: a result dict, a handler's exception, or stopped by
;; an interrupt before nrepl-eval could report it (or cancelled while queued).
(= _NREPL-RESULT "result")
(= _NREPL-FAILURE "failure")
(= _NREPL-INTERRUPTED "interrupted")

(def _nrepl-handle-client [conn addr scope]
  "Serve one connection until EOF or a socket error, then end its evals
  (_NreplConnection.close) and close conn.  Every non-blank request line
  gets exactly one final reply; only a stream eval's out messages come
  besides."
  ;; Buffer bytes and decode only whole lines: a multi-byte UTF-8 character can
  ;; straddle two recv reads, and decoding each read on its own would raise.
  ;; A line over NREPL-MAX-LINE gets one error reply and is dropped up to its
  ;; newline (discarding), so a client that never sends one cannot grow buf.
  (= connection (_NreplConnection conn scope))
  (= buf b"")
  (= discarding False)
  (try
    (while True
      (= data (conn.recv 4096))
      (if (not data)
          (break))
      (if discarding
          (do (if (not (in b"\n" data))
                  (continue))
              (= [dropped data] (.split data b"\n" 1))
              (= discarding False)))
      (+= buf data)
      ;; Process complete JSON messages (newline-delimited)
      (while (in b"\n" buf)
        (= [line buf] (.split buf b"\n" 1))
        (if (> (len line) NREPL-MAX-LINE)
            (do (_nrepl-error-reply connection {} "request line too long")
                (continue)))
        (if (not (.strip line))
            (continue))
        (try
          (= msg (json.loads (.decode line "utf-8")))
          (except [(, ValueError RecursionError) as e]
            ;; invalid UTF-8, invalid JSON or JSON nested too deeply to parse:
            ;; no id to echo
            (_nrepl-error-reply connection {} (str e))
            (continue)))
        (if (not (isinstance msg dict))
            (do (_nrepl-error-reply connection {} "request must be a JSON object")
                (continue)))
        (= op (.get msg "op" NREPL-EVAL-OP))
        (cond (in op (, NREPL-EVAL-OP NREPL-LOAD-FILE-OP))
              (connection.evaluate msg)
              (== op NREPL-INTERRUPT-OP)
              (connection.interrupt msg)
              True
              (do (try
                    (= result (_nrepl-dispatch msg scope))
                    (except [Exception as e]
                      (_nrepl-error-reply connection msg (_nrepl-failure-text e))
                      (continue)))
                  ;; Only the socket send may end the connection.
                  (_nrepl-send-result connection msg result))))
      (if (> (len buf) NREPL-MAX-LINE)
          (do (_nrepl-error-reply connection {} "request line too long")
              (= buf b"")
              (= discarding True))))
    (except [OSError] None)
    (finally
      (try
        (connection.close)
        (finally
          (conn.close))))))

(= NREPL-PORT-FILE ".nrepl-port")

(def _write-port-file [port directory]
  "Write port to directory/.nrepl-port for editor auto-discovery; return the
   path, or None when the directory is unwritable.  The file is a
   convenience, so failing to write it must not stop the server."
  (= path (osp.join directory NREPL-PORT-FILE))
  (try
    (with [(open path "w") as f]
      (f.write (str port)))
    (except [OSError as err]
      (print f"nREPL: could not write {path}: {err.strerror}" :file sys.stderr)
      (return None)))
  (return path))

(def _remove-port-file [path port]
  "Remove the port file at path if it still names port.  A second server
   started in the same directory overwrites the file, and stopping the
   first must not delete the second's."
  (if (is path None)
      (return))
  (try
    (with [(open path) as f]
      (= current (.strip (f.read))))
    (if (== current (str port))
        (os.unlink path))
    (except [OSError] (pass))))

(def nrepl-server [:host "127.0.0.1" :port 0]
  (global _NREPL-IMPORT-ROOTS)
  (= cwd (os.getcwd))
  (if (not (in cwd sys.path))
      (sys.path.insert 0 cwd))
  (= _NREPL-IMPORT-ROOTS (list sys.path))
  (= scope SCOPE)
  (nrepl-eval "(from pprint [pprint])" scope)

  (= srv (socket.socket socket.AF-INET socket.SOCK-STREAM))
  (srv.setsockopt socket.SOL-SOCKET socket.SO-REUSEADDR 1)
  (srv.bind (, host port))
  (srv.listen 5)
  (= [_ actual-port] (srv.getsockname))

  (print f"nREPL server started on {host}:{actual-port}")
  (sys.stdout.flush)

  (= port-file (_write-port-file actual-port cwd))

  (try
    (while True
      (= [conn addr] (srv.accept))
      (= t (threading.Thread :target _nrepl-handle-client
                              :args (, conn addr scope)
                              :daemon True))
      (t.start))
    (except [KeyboardInterrupt]
      (print "\nnREPL server stopped."))
    (finally
      (srv.close)
      (_remove-port-file port-file actual-port))))

(def run []
  (try
    (_run)
    (except [LispyCompileError as e]
      (report-compile-error e)
      (sys.exit 1))))

(def _run []
  (cond (< (len sys.argv) 2)
        (repl)

        (== (sub sys.argv 1) "-m")
        (do (sys.argv.pop 1)
            (= mname (sys.argv.pop 1))
            ;; python -m prepends the cwd unless -P / PYTHONSAFEPATH is set
            (if (not sys.flags.safe-path)
                (sys.path.insert 0 (os.getcwd)))
            ;; the module name is the one `import` gives (module-import-name)
            (with [(compile-errors "<command line>" mname)]
              (= modname (module-import-name
                          (Symbol mname :lineno 1 :end-lineno 1 :col-offset 0
                                  :end-col-offset (len mname)))))
            (runpy.run-module modname :run-name "__main__" :alter-sys True))

        (== (sub sys.argv 1) "-c")
        (do (sys.argv.pop 1)
            (= src (sys.argv.pop 1))
            (eval-and-print src))

        (== (sub sys.argv 1) "--nrepl")
        (do (sys.argv.pop 1)
            (= port (ife (> (len sys.argv) 1) (int (sys.argv.pop 1)) 0))
            (nrepl-server :port port))

        (== (sub sys.argv 1) "-t")
        (repl True)

        (do (= fpath (sys.argv.pop 1))
            (= script-dir (osp.dirname (osp.abspath fpath)))
            (if (not (in script-dir sys.path))
                (sys.path.insert 0 script-dir))
            (runpy.run-path fpath :run-name "__main__"))))

(if (== __name__ "__main__")
    (run))
