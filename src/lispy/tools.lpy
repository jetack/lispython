(require lispy.macros *)

(import argparse)
(import ast)
(import copy)
(import functools)
(import importlib)
(import inspect)
(import io)
(import json)
(import keyword)
(import os)
(import os.path as osp)
(import runpy)
(import socket)
(import sys)
(import threading)
(import traceback)
(import types)

(import subprocess)
(import shutil)
(import tempfile)

(= HAS_RUFF (shutil.which "ruff"))

(from lispy.core.nodes *)
(from lispy.core.parser [parse])
(from lispy.core.macro [macroexpand macroexpand-then-compile])
(from lispy.core.errors [LispyCompileError attach-source compile-errors
                         format-compile-error])

(def report-compile-error [err :filename None :source None]
  "Print a LispyCompileError compiler-style (path:line:col, source, caret) to stderr."
  (print (format-compile-error (attach-source err filename source))
         :file sys.stderr))

(def has-init-file [dir-path]
  (return (or (osp.exists (osp.join dir-path "__init__.py"))
              (osp.exists (osp.join dir-path "__init__.lpy")))))

(def detect-package-name [:path None]
  "Detect package name from directory by checking for __init__.py or __init__.lpy"
  (= dir-path (ife (is path None)
                   (os.getcwd)
                   (osp.dirname (osp.abspath path))))
  (if (not (has-init-file dir-path))
      (return ""))
  ;; Walk up to find package root
  (= parts [])
  (= current dir-path)
  (while (has-init-file current)
    (parts.insert 0 (osp.basename current))
    (= parent (osp.dirname current))
    (if (== parent current)
        (break))
    (= current parent))
  ;; Add parent of package root to sys.path if needed
  (if (and parts (not (in current sys.path)))
      (sys.path.insert 0 current))
  (return (.join "." parts)))

(= SCOPE {"__builtins__" __builtins__
          "__name__" "__main__"
          "__package__" (detect-package-name)
          "__macro_namespace" {}})

(def _python-interpolations [st]
  "Copy of st whose t-string interpolations unparse from their values.
   The compiler sets Interpolation.str to the lispython text, which is what a
   Template reports at runtime; ast.unparse writes str verbatim unless it is
   None, and Python source needs the Python text."
  (= interpolation (getattr ast "Interpolation" None))
  (if (or (is interpolation None)
          (not (any ((isinstance n interpolation) for n in (ast.walk st)))))
      (return st))
  (= st (copy.deepcopy st))
  (for n in (ast.walk st)
    (if (isinstance n interpolation)
        (= n.str None)))
  (return st))

(def ast-to-python [st]
  (return (str (ast.unparse (_python-interpolations st)))))

(def src-to-python-org [src :include-meta False :scope None]
  (if (is scope None)
      (= scope SCOPE))
  (return (.join "\n" (map ast-to-python
                           (macroexpand-then-compile
                             (parse src)
                             scope
                             :include-meta include-meta)))))

(def src-to-python [src :include-meta False :scope None :format True]
  (if (is scope None)
      (= scope SCOPE))
  (= raw-pysrc (src-to-python-org src :include-meta include-meta :scope scope))
  (if format
      (return (format-python-source raw-pysrc))
      (return raw-pysrc)))

(def format-python-source [pysrc]
  (if (not HAS_RUFF)
      (return pysrc))
  (try
    (with [(tempfile.NamedTemporaryFile :mode "w" :suffix ".py" :delete False) as f]
      (f.write pysrc)
      (= tmppath f.name))
    ;; Run ruff check --fix for import sorting (modifies file in place)
    (subprocess.run ["ruff" "check" "--fix" "--select" "I" tmppath]
                    :capture-output True)
    ;; Run ruff format (modifies file in place)
    (subprocess.run ["ruff" "format" tmppath]
                    :capture-output True)
    ;; Read back the formatted code
    (with [(open tmppath "r") as f]
      (= pysrc (.rstrip (f.read) "\n")))
    (os.unlink tmppath)
    (except [Exception as e]
      (print f"Ruff formatting failed: {e}")))
  (return pysrc))

(= argparser (argparse.ArgumentParser))
(argparser.add-argument "--meta"
                        :dest "include_meta"
                        :action "store_true")
(argparser.add-argument "--no-lispy"
                        :dest "no_lispy"
                        :action "store_true")

(def l2py-s [src :include-meta False :fresh-scope False :package "" :no-lispy False :format True]
  "Translate lispy source string to Python source string"
  (if fresh-scope
      (= scope {"__builtins__" __builtins__
                "__package__" package
                "__macro_namespace" {}})
      (= scope SCOPE))
  (= pysrc (src-to-python src :include-meta include_meta :scope scope :format format))
  (if no_lispy
      (return pysrc))
  (return (+ "import lispy\n\n" pysrc)))

(def l2py-f [file-path :include-meta False :no-lispy False :format True]
  "Translate lispy file to Python source string (standalone with sys.path setup)"
  ;; Detect package first so we add the right directory to sys.path
  (= pkg (detect-package-name :path file-path))
  (if (not pkg)
      (do (= script-dir (osp.dirname (osp.abspath file-path)))
          (if (not (in script-dir sys.path))
              (sys.path.insert 0 script-dir))))

  ;; Clear cached macro modules to ensure fresh reload
  (= modules-to-remove [])
  (for [mod-name mod] in (sys.modules.items)
    (if (or (mod-name.startswith "lispy.macros")
            (and mod
                 (hasattr mod "__file__")
                 mod.__file__
                 (mod.__file__.endswith ".lpy")))
        (modules-to-remove.append mod-name)))
  (for mod-name in modules-to-remove
    (sys.modules.pop mod-name))

  (with [(open file-path "rb") as f]
    (= src (.decode (f.read) "utf-8")))
  (with [(compile-errors file-path src)]
    (return (+ (l2py-s src :include-meta include_meta :fresh-scope True :package pkg :no-lispy no_lispy :format format) "\n"))))

(def l2py []
  "CLI entry point: parse args and translate file"
  (= [args more-args] (argparser.parse-known-args))
  (try
    (if (and (>= (len more-args) 2) (== (sub more-args 0) "-c"))
        (do (= src (sub more-args 1))
            (with [(compile-errors "<string>" src)]
              (print (l2py-s src :include-meta args.include_meta :no-lispy args.no_lispy))))
        (do (= file (osp.join (os.getcwd) (sub more-args 0)))
            (print (l2py-f file :include-meta args.include_meta :no-lispy args.no_lispy))))
    (except [LispyCompileError as e]
      (report-compile-error e)
      (sys.exit 1))))

(def _make-open-handler [o c]
  (def handler [event]
    (= buf event.app.current-buffer)
    (buf.insert-text (+ o c))
    (buf.cursor-left))
  (return handler))

(def _make-close-handler [c]
  (def handler [event]
    (= buf event.app.current-buffer)
    (if (== buf.document.current-char c)
        (buf.cursor-right)
        (buf.insert-text c)))
  (return handler))

(def _make-quote-handler [q]
  (def handler [event]
    (= buf event.app.current-buffer)
    (if (== buf.document.current-char q)
        (buf.cursor-right)
        (do
          (buf.insert-text (+ q q))
          (buf.cursor-left))))
  (return handler))

(= _SPECIAL-FORMS
   {, "def" "defn" "defmacro" "async-def"
      "if" "cond" "conde" "when" "unless"
      "while" "for" "async-for"
      "do" "try" "with" "async-with"
      "class" "deco"
      "lambda" "fn"
      "let" "match" "case"
      "except" "except*" "finally" "else"})

(def _col-of [text pos]
  "Column of position pos in text (0-based)."
  (= nl (.rfind text "\n" 0 pos))
  (return (- pos nl 1)))

(def _calc-indent [text]
  "Calculate indent for the next line based on text before cursor."
  (= in-string False)
  (= stack [])
  (= i 0)
  (= n (len text))
  (while (< i n)
    (= c (sub text i))
    (cond in-string
          (if (== c "\"")
              (= in-string False))

          (== c "\"")
          (= in-string True)

          (== c ";")
          (break)

          (in c "([{")
          (do
            (= paren-col (_col-of text i))
            (if (!= c "(")
                ;; [ and {: align to first element
                (do
                  (= j (+ i 1))
                  (while (and (< j n) (== (sub text j) " "))
                    (+= j 1))
                  (if (and (< j n) (not (in (sub text j) "\n")))
                      (stack.append (_col-of text j))
                      (stack.append (+ paren-col 1))))
                ;; (: special form vs function call
                (do
                  (= j (+ i 1))
                  (while (and (< j n) (== (sub text j) " "))
                    (+= j 1))
                  (= op-start j)
                  (while (and (< j n) (not (in (sub text j) " \n\t()[]{}'\"")))
                    (+= j 1))
                  (= op (sub text [: op-start j]))
                  (if (or (== op "") (in op _SPECIAL-FORMS))
                      (stack.append (+ paren-col 2))
                      (do
                        (= arg-pos j)
                        (while (and (< arg-pos n) (== (sub text arg-pos) " "))
                          (+= arg-pos 1))
                        (if (and (< arg-pos n) (not (in (sub text arg-pos) "\n")))
                            (stack.append (_col-of text arg-pos))
                            (stack.append (+ paren-col 2))))))))

          (in c ")]}")
          (if stack
              (stack.pop)))
    (+= i 1))
  (if stack
      (return (sub stack -1))
      (return 0)))

(def _parens-balanced? [text]
  (= depth 0)
  (= in-string False)
  (for c in text
    (cond in-string
          (if (== c "\"")
              (= in-string False)
              (continue))

          (== c "\"")
          (= in-string True)

          (in c "([{")
          (+= depth 1)

          (in c ")]}")
          (-= depth 1)))
  (return (<= depth 0)))

(def make-repl-session []
  (from prompt-toolkit [PromptSession])
  (from prompt-toolkit.history [FileHistory])
  (from prompt-toolkit.key-binding [KeyBindings])
  (from prompt-toolkit.keys [Keys])

  (= kb (KeyBindings))
  (= _pairs {"(" ")" "[" "]" "{" "}" "'" "'" "\"" "\""})

  (for [o c] in (_pairs.items)
    ((kb.add o) (_make-open-handler o c)))

  (for c in (_pairs.values)
    ((kb.add c) (_make-close-handler c)))

  (for q in ["'" "\""]
    ((kb.add q) (_make-quote-handler q)))

  ;; Backspace deletes both chars of an empty pair
  (= _bp _pairs)
  (def handle-backspace [event]
    (= buf event.app.current-buffer)
    (= doc buf.document)
    (= before doc.char-before-cursor)
    (= after doc.current-char)
    (if (and (in before _bp) (== (sub _bp before) after))
        (do (buf.delete) (buf.delete-before-cursor))
        (buf.delete-before-cursor)))
  ((kb.add Keys.Backspace) handle-backspace)

  ;; Enter: submit
  (def handle-enter [event]
    (event.app.current-buffer.validate-and-handle))
  ((kb.add Keys.Enter) handle-enter)

  ;; Ctrl+J: insert newline with auto-indent
  (def handle-newline [event]
    (= buf event.app.current-buffer)
    (= text-before buf.document.text-before-cursor)
    (= indent (_calc-indent text-before))
    (buf.insert-text (+ "\n" (* " " indent))))
  ((kb.add "c-j") handle-newline)

  ;; Tab: auto-indent current line
  (def handle-tab [event]
    (= buf event.app.current-buffer)
    (= doc buf.document)
    ;; Get all text up to start of current line
    (= lines (.split doc.text-before-cursor "\n"))
    (if (> (len lines) 1)
        (= text-before (.join "\n" (sub lines [: -1])))
        (= text-before ""))
    (= indent (_calc-indent text-before))
    ;; Replace leading whitespace on current line
    (= current-line doc.current-line-before-cursor)
    (= stripped (.lstrip current-line))
    (= old-indent (- (len current-line) (len stripped)))
    (= new-indent-str (* " " indent))
    ;; Delete old indent, insert new
    (buf.cursor-left :count old-indent)
    (buf.delete :count old-indent)
    (buf.insert-text new-indent-str))
  ((kb.add "c-i") handle-tab)

  (= histfile (osp.join (osp.expanduser "~") ".lpy_history"))
  (return (PromptSession :history (FileHistory histfile)
                         :key-bindings kb
                         :multiline True
                         :prompt-continuation "...   ")))

(def eval-and-print [src :scope SCOPE :translate False :filename "<string>"]
  ;; Compile every statement before running any, so compile-errors covers
  ;; compiling only.
  (with [(compile-errors filename src)]
    (= stl (macroexpand-then-compile (parse src) scope))
    (= codes [(compile (ast.Interactive :body [st]) filename "single")
              for st in stl]))
  (if translate
      (do ;; (print "python translation")
        (-> (.join "\n" (list (map ast-to-python stl)))
            (format-python-source)
            (print))
        ;; (print "")
        ))
  ;; (print "result")
  (for code codes
    (eval code scope))
  ;; (print "\n")
  )

(def repl [:translate False]
  ;; Add current directory to sys.path for local imports
  (= cwd (os.getcwd))
  (if (not (in cwd sys.path))
      (sys.path.insert 0 cwd))

  (= session (make-repl-session))
  (= scope SCOPE)
  (eval-and-print "(require lispy.macros *)
(from pprint [pprint])" scope)
  (while True
    (try
      (do
        (= src (session.prompt "repl> "))
        (eval-and-print src scope translate :filename "<repl>"))
      (except [SystemExit]
        (print "SystemExit caught. Exiting REPL.")
        (break))
      (except [EOFError as e]
        (print "Ctrl-d input. Exiting REPL.")
        (break))
      (except [KeyboardInterrupt]
        (print "\nKeyboard Interrupt")
        (continue))
      (except [LispyCompileError as e]
        (report-compile-error e))
      (except [Exception as e]
        (print "An error occurred:\n====================================")
        (traceback.print_exc)
        (print "====================================")))))

(def nrepl-eval [src scope :filename "<nrepl>"]
  "Evaluate LisPython source, capturing stdout/stderr and return value."
  (= result {"value" None "stdout" "" "error" None})
  (= stdout-capture (io.StringIO))
  (= stderr-capture (io.StringIO))
  (= old-stdout sys.stdout)
  (= old-stderr sys.stderr)
  (try
    (= sys.stdout stdout-capture)
    (= sys.stderr stderr-capture)
    ;; Compile every statement before running any (see eval-and-print).
    (with [(compile-errors filename src)]
      (= stl (macroexpand-then-compile (parse src) scope))
      (= codes [(ife (isinstance st ast.Expr)
                     (, eval (compile (ast.Expression :body st.value) filename "eval"))
                     (, exec (compile (ast.Module :body [st] :type-ignores [])
                                      filename "exec")))
                for st in stl]))
    (= last-val None)
    (for [run code] codes
      (= last-val (run code scope)))
    (if (is-not last-val None)
        (= (sub result "value") (repr last-val)))
    (except [LispyCompileError as e]
      (= (sub result "error") (format-compile-error e)))
    ;; SystemExit is a BaseException, so (exit) in client code would otherwise
    ;; escape and kill the connection; report it like any other eval error.
    (except [SystemExit as e]
      (= (sub result "error") (+ "SystemExit: " (str e.code))))
    (except [Exception as e]
      (= (sub result "error") (.rstrip (traceback.format-exc))))
    (finally
      (= sys.stdout old-stdout)
      (= sys.stderr old-stderr)))
  (= (sub result "stdout") (.getvalue stdout-capture))
  (= stderr-out (.getvalue stderr-capture))
  (if stderr-out
      (= (sub result "stderr") stderr-out))
  (return result))

(def nrepl-load-file [file-path scope]
  "Load a .lpy file into the REPL scope."
  (= script-dir (osp.dirname (osp.abspath file-path)))
  (if (not (in script-dir sys.path))
      (sys.path.insert 0 script-dir))
  (with [(open file-path "rb") as f]
    (= src (.decode (f.read) "utf-8")))
  (return (nrepl-eval src scope :filename file-path)))

(def nrepl-macroexpand [src scope]
  "Macroexpand LisPython source and return the expanded s-expression."
  (try
    (= parsed (parse src))
    (= expanded [])
    (for sexp in parsed
      (expanded.append (str (macroexpand sexp scope))))
    (return {"op" "macroexpand-result"
             "expansion" (.join "\n" expanded)
             "error" None})
    (except [Exception as e]
      (return {"op" "macroexpand-result"
               "expansion" None
               "error" (.rstrip (traceback.format-exc))}))))

(def _mangle [s]
  (return (.replace s "-" "_")))

(def _unmangle [s]
  "Convert Python identifier to lispy symbol, preserving leading/trailing underscores."
  (if (not s) (return ""))
  (= leading (- (len s) (len (.lstrip s "_"))))
  (= trailing (- (len s) (len (.rstrip s "_"))))
  (if (>= (+ leading trailing) (len s))
      (return s))
  (= middle (sub s [: leading (ife trailing (- (len s) trailing) None)]))
  (= middle (.replace middle "_" "-"))
  (return (+ (* "_" leading) middle (* "_" trailing))))

(def _resolve-obj [symbol scope]
  "Resolve a symbol string to a Python object in scope."
  (= mangled (_mangle symbol))
  (try
    (return (eval mangled scope))
    (except [Exception]
      (return None))))

;; LisPython syntax offered by nREPL completion and reported as "keyword"
;; (unless a macro of the same name is loaded).  _SPECIAL-FORMS is a
;; different set: the forms the REPL indents as bodies.
(= _COMPLETION-SYNTAX
   [;; Definitions
    "def" "defn" "defmacro" "async-def"
    ;; Looping
    "for" "async-for" "while"
    ;; Flow
    "return" "if" "ife" "when" "unless"
    "cond" "conde" "else"
    "break" "continue" "pass"
    "match" "case" "do" "comment"
    ;; Threading
    "->" "->>" "as->"
    ;; Functional
    "fn" "lambda" "await"
    "yield" "yield-from"
    ;; Context
    "with" "async-with" "deco"
    ;; Error handling
    "try" "except" "except*" "finally" "raise"
    ;; Data
    "del" "sub"
    ;; Import / macro
    "import" "from" "require"
    "global" "nonlocal" "assert"
    ;; Class
    "class"
    ;; Misc
    "gensym" "pprint"])

(def _completion-kind [obj]
  "The nREPL completion kind of a value: class, function or variable."
  (cond (isinstance obj type) (return "class")
        (callable obj) (return "function")
        True (return "variable")))

(= _FUNCTION-DESCRIPTORS
   ;; partialmethod is listed because, unlike other method wrappers, it is
   ;; not callable itself.
   (, staticmethod classmethod functools.partialmethod
      types.FunctionType types.BuiltinFunctionType types.MethodType
      types.MethodDescriptorType types.ClassMethodDescriptorType
      types.WrapperDescriptorType types.MethodWrapperType))

(def _attribute-kind [obj attr]
  "The completion kind of obj.attr, found without running user code.

   getattr would run a property, a descriptor or __getattr__ -- side effects
   and exceptions in the middle of a completion -- so the attribute is read
   with inspect.getattr_static and its raw object classified: functions,
   methods, static/class methods and partialmethods are functions; a class
   is a class; any other callable (an lru_cache wrapper) is a function; a
   non-callable descriptor (property, cached_property, slots) yields a
   value, so it is a variable, as is any other object.  An attribute only
   __getattr__ knows about is a variable."
  (try
    (= raw (inspect.getattr-static obj attr))
    (except [Exception]
      (return "variable")))
  (cond (isinstance raw _FUNCTION-DESCRIPTORS) (return "function")
        True (return (_completion-kind raw))))

(def nrepl-complete [prefix scope]
  "Return completions matching prefix, including dot-completion."
  (= has-dot (in "." prefix))
  (if has-dot
      (do
        ;; Dot completion: resolve object, list its attributes
        (= parts (.split prefix "."))
        (= obj-part (.join "." (sub parts [: -1])))
        (= attr-prefix (sub parts -1))
        (= obj (_resolve-obj obj-part scope))
        (if (is obj None)
            (return {"op" "complete-result" "completions" [] "kinds" {}}))
        (= py-attr (.replace attr-prefix "-" "_"))
        (= matches [])
        (= kinds {})
        (for attr in (dir obj)
          (if (.startswith attr py-attr)
              (do (= full-name (+ obj-part "." (_unmangle attr)))
                  (matches.append full-name)
                  (= (sub kinds full-name) (_attribute-kind obj attr)))))
        (return {"op" "complete-result"
                 "completions" (sorted matches)
                 "kinds" kinds}))
      (do
        ;; Prefix completion from scope, builtins, macros, keywords
        (= matches [])
        (= py-prefix (_mangle prefix))
        (for k in scope
          (if (or (.startswith k prefix) (.startswith k py-prefix))
              (matches.append (_unmangle k))))
        (= builtins (ife (isinstance __builtins__ dict)
                         __builtins__
                         (vars __builtins__)))
        (for k in builtins
          (if (or (.startswith k prefix) (.startswith k py-prefix))
              (matches.append k)))
        (= macros (.get scope "__macro_namespace" {}))
        (for k in macros
          (if (.startswith k prefix)
              (matches.append k)))
        (for k in keyword.kwlist
          (if (.startswith k prefix)
              (matches.append k)))
        ;; LisPython special forms and syntax
        (for k in _COMPLETION-SYNTAX
          (if (.startswith k prefix)
              (matches.append k)))
        ;; Build kinds dict
        (= kinds {})
        (= builtins-dict (ife (isinstance __builtins__ dict)
                              __builtins__
                              (vars __builtins__)))
        (for name in (set matches)
          (= mangled (_mangle name))
          (cond (in name macros)
                (= (sub kinds name) "macro")
                (or (in name _COMPLETION-SYNTAX) (in name keyword.kwlist))
                (= (sub kinds name) "keyword")
                ;; A scope binding shadows the builtin of the same name.
                (in mangled scope)
                (= (sub kinds name) (_completion-kind (sub scope mangled)))
                (in mangled builtins-dict)
                (= (sub kinds name) (_completion-kind (sub builtins-dict mangled)))
                True
                (= (sub kinds name) "variable")))
        (return {"op" "complete-result"
                 "completions" (sorted (set matches))
                 "kinds" kinds}))))

(def nrepl-docs [symbol scope]
  "Return documentation for a symbol."
  (try
    (= obj (_resolve-obj symbol scope))
    ;; Check macros
    (if (is obj None)
        (do (= macros (.get scope "__macro_namespace" {}))
            (= obj (.get macros (_mangle symbol)))))
    (if (is obj None)
        (return {"op" "docs-result" "docs" None "error" None}))
    ;; Build docs string
    (= parts [])
    (= name (_unmangle symbol))
    ;; Signature
    (try
      (= sig (inspect.signature obj))
      (= params [])
      (for [pname p] in (.items sig.parameters)
        (= kind p.kind)
        (cond (== kind inspect.Parameter.VAR-POSITIONAL)
              (params.append (+ "*" (_unmangle pname)))
              (== kind inspect.Parameter.VAR-KEYWORD)
              (params.append (+ "**" (_unmangle pname)))
              (and (!= p.default inspect.Parameter.empty)
                   (in kind [inspect.Parameter.KEYWORD-ONLY
                             inspect.Parameter.POSITIONAL-OR-KEYWORD]))
              (params.append (+ ":" (_unmangle pname) " " (repr p.default)))
              True
              (params.append (_unmangle pname))))
      (parts.append (+ name " [" (.join " " params) "]"))
      (except [TypeError ValueError]
        (parts.append name)))
    ;; Docstring
    (= docstring (getattr obj "__doc__" None))
    (if docstring
        (parts.append (.strip (sub (.splitlines docstring) 0))))
    (return {"op" "docs-result"
             "docs" (.join " - " parts)
             "error" None})
    (except [Exception as e]
      (return {"op" "docs-result"
               "docs" None
               "error" (str e)}))))

(def nrepl-annotate [symbol scope]
  "Return type annotation for a symbol."
  (try
    (= obj (_resolve-obj symbol scope))
    (if (is obj None)
        (do (= macros (.get scope "__macro_namespace" {}))
            (= obj (.get macros (_mangle symbol)))))
    (if (is obj None)
        (return {"op" "annotate-result" "annotation" "unknown"}))
    (= klass (. (type obj) __name__))
    (cond (in klass ["function" "builtin_function_or_method"])
          (= annotation "function")
          (== klass "type")
          (= annotation "class")
          (== klass "module")
          (= annotation "module")
          (in symbol (.get scope "__macro_namespace" {}))
          (= annotation "macro")
          True
          (= annotation "instance"))
    (return {"op" "annotate-result"
             "annotation" (+ "<" annotation " " (_unmangle symbol) ">")})
    (except [Exception as e]
      (return {"op" "annotate-result"
               "annotation" "unknown"}))))

(def _nrepl-encode [msg result]
  "Encode result as one wire line, echoing the request id if present. Raises
  when result is not JSON-serialisable."
  (= req-id (.get msg "id"))
  (if req-id
      (= (sub result "id") req-id))
  (return (.encode (+ (json.dumps result) "\n") "utf-8")))

(def _nrepl-reply [conn msg result]
  "Send result back, echoing the request id if present."
  (conn.sendall (_nrepl-encode msg result)))

(def _nrepl-error-reply [conn msg error]
  "Reply {op: error} for a failed request. The one home of the error shape;
  msg is {} when no request could be parsed, so the reply carries no id."
  (_nrepl-reply conn msg {"op" "error" "error" error}))

(class _NreplUnknownOp [Exception]
  "Raised by _nrepl-dispatch; its message is the reply text as is."
  (pass))

(def _nrepl-dispatch [msg scope]
  "Run one parsed request and return its result dict. Raises on an unknown op
  or when a handler fails; the caller turns that into an error reply."
  (= op (.get msg "op" "eval"))
  (cond (== op "eval")
        (do (= result (nrepl-eval (sub msg "code") scope))
            (= (sub result "op") "eval-result")
            (return result))

        (== op "load-file")
        (do (= result (nrepl-load-file (sub msg "path") scope))
            (= (sub result "op") "load-file-result")
            (return result))

        (== op "macroexpand")
        (return (nrepl-macroexpand (sub msg "code") scope))

        (== op "complete")
        (return (nrepl-complete (sub msg "prefix") scope))

        (== op "docs")
        (return (nrepl-docs (sub msg "symbol") scope))

        (== op "annotate")
        (return (nrepl-annotate (sub msg "symbol") scope))

        (== op "ping")
        (return {"op" "pong"}))
  (raise (_NreplUnknownOp (+ "unknown op: " (str op)))))

(def _nrepl-handle-client [conn addr scope]
  ;; Buffer bytes and decode only whole lines: a multi-byte UTF-8 character can
  ;; straddle two recv reads, and decoding each read on its own would raise.
  (= buf b"")
  (try
    (while True
      (= data (conn.recv 4096))
      (if (not data)
          (break))
      (+= buf data)
      ;; Process complete JSON messages (newline-delimited)
      (while (in b"\n" buf)
        (= [line buf] (.split buf b"\n" 1))
        (if (not (.strip line))
            (continue))
        (try
          (= msg (json.loads (.decode line "utf-8")))
          (except [(, ValueError RecursionError) as e]
            ;; invalid UTF-8, invalid JSON or JSON nested too deeply to parse:
            ;; no id to echo
            (_nrepl-error-reply conn {} (str e))
            (continue)))
        (if (not (isinstance msg dict))
            (do (_nrepl-error-reply conn {} "request must be a JSON object")
                (continue)))
        (try
          ;; Encode inside the boundary so an unserialisable result becomes an
          ;; error reply; only the socket send below may end the connection.
          (= reply (_nrepl-encode msg (_nrepl-dispatch msg scope)))
          (except [Exception as e]
            (_nrepl-error-reply
              conn msg
              (ife (isinstance e _NreplUnknownOp)
                  (str e)
                  (+ (. (type e) __name__) ": " (str e))))
            (continue)))
        (conn.sendall reply)))
    (except [OSError] None)
    (finally
      (conn.close))))

(= NREPL-PORT-FILE ".nrepl-port")

(def _write-port-file [port directory]
  "Write port to directory/.nrepl-port for editor auto-discovery; return the
   path, or None when the directory is unwritable.  The file is a
   convenience, so failing to write it must not stop the server."
  (= path (osp.join directory NREPL-PORT-FILE))
  (try
    (with [(open path "w") as f]
      (f.write (str port)))
    (except [OSError as err]
      (print f"nREPL: could not write {path}: {err.strerror}" :file sys.stderr)
      (return None)))
  (return path))

(def _remove-port-file [path port]
  "Remove the port file at path if it still names port.  A second server
   started in the same directory overwrites the file, and stopping the
   first must not delete the second's."
  (if (is path None)
      (return))
  (try
    (with [(open path) as f]
      (= current (.strip (f.read))))
    (if (== current (str port))
        (os.unlink path))
    (except [OSError] (pass))))

(def nrepl-server [:host "127.0.0.1" :port 0]
  (= cwd (os.getcwd))
  (if (not (in cwd sys.path))
      (sys.path.insert 0 cwd))
  (= scope SCOPE)
  (nrepl-eval "(require lispy.macros *)\n(from pprint [pprint])" scope)

  (= srv (socket.socket socket.AF-INET socket.SOCK-STREAM))
  (srv.setsockopt socket.SOL-SOCKET socket.SO-REUSEADDR 1)
  (srv.bind (, host port))
  (srv.listen 5)
  (= [_ actual-port] (srv.getsockname))

  (print f"nREPL server started on {host}:{actual-port}")
  (sys.stdout.flush)

  (= port-file (_write-port-file actual-port cwd))

  (try
    (while True
      (= [conn addr] (srv.accept))
      (= t (threading.Thread :target _nrepl-handle-client
                              :args (, conn addr scope)
                              :daemon True))
      (t.start))
    (except [KeyboardInterrupt]
      (print "\nnREPL server stopped."))
    (finally
      (srv.close)
      (_remove-port-file port-file actual-port))))

(def run []
  (try
    (_run)
    (except [LispyCompileError as e]
      (report-compile-error e)
      (sys.exit 1))))

(def _run []
  (cond (< (len sys.argv) 2)
        (repl)

        (== (sub sys.argv 1) "-m")
        (do (sys.argv.pop 1)
            (= mname (sys.argv.pop 1))
            ;; python -m prepends the cwd unless -P / PYTHONSAFEPATH is set
            (if (not sys.flags.safe-path)
                (sys.path.insert 0 (os.getcwd)))
            (runpy.run-module (.replace mname "-" "_") :run-name "__main__" :alter-sys True))

        (== (sub sys.argv 1) "-c")
        (do (sys.argv.pop 1)
            (= src (sys.argv.pop 1))
            (eval-and-print src))

        (== (sub sys.argv 1) "--nrepl")
        (do (sys.argv.pop 1)
            (= port (ife (> (len sys.argv) 1) (int (sys.argv.pop 1)) 0))
            (nrepl-server :port port))

        (== (sub sys.argv 1) "-t")
        (repl True)

        (do (= fpath (sys.argv.pop 1))
            (= script-dir (osp.dirname (osp.abspath fpath)))
            (if (not (in script-dir sys.path))
                (sys.path.insert 0 script-dir))
            (runpy.run-path fpath :run-name "__main__"))))

(if (== __name__ "__main__")
    (run))
