(require lispy.macros *)

(import argparse)
(import ast)
(import importlib)
(import inspect)
(import io)
(import json)
(import keyword)
(import os)
(import os.path as osp)
(import runpy)
(import socket)
(import sys)
(import threading)
(import traceback)

(import subprocess)
(import shutil)
(import tempfile)

(= HAS_RUFF (shutil.which "ruff"))

(from lispy.core.nodes *)
(from lispy.core.parser [parse])
(from lispy.core.macro [macroexpand macroexpand-then-compile])

(def detect-package-name [:path None]
  "Detect package name from directory by checking for __init__.py"
  (= dir-path (ife (is path None)
                   (os.getcwd)
                   (osp.dirname (osp.abspath path))))
  (if (not (osp.exists (osp.join dir-path "__init__.py")))
      (return ""))
  ;; Walk up to find package root
  (= parts [])
  (= current dir-path)
  (while (osp.exists (osp.join current "__init__.py"))
    (parts.insert 0 (osp.basename current))
    (= parent (osp.dirname current))
    (if (== parent current)
        (break))
    (= current parent))
  ;; Add parent of package root to sys.path if needed
  (if (and parts (not (in current sys.path)))
      (sys.path.insert 0 current))
  (return (.join "." parts)))

(= SCOPE {"__builtins__" __builtins__
          "__name__" "__main__"
          "__package__" (detect-package-name)
          "__macro_namespace" {}})

(def ast-to-python [st]
  (return (str (ast.unparse st))))

(def src-to-python-org [src :include-meta False :scope None]
  (if (is scope None)
      (= scope SCOPE))
  (return (.join "\n" (map ast-to-python
                           (macroexpand-then-compile
                             (parse src)
                             scope
                             :include-meta include-meta)))))

(def src-to-python [src :include-meta False :scope None :format True]
  (if (is scope None)
      (= scope SCOPE))
  (= raw-pysrc (src-to-python-org src :include-meta include-meta :scope scope))
  (if format
      (return (format-python-source raw-pysrc))
      (return raw-pysrc)))

(def format-python-source [pysrc]
  (if (not HAS_RUFF)
      (return pysrc))
  (try
    (with [(tempfile.NamedTemporaryFile :mode "w" :suffix ".py" :delete False) as f]
      (f.write pysrc)
      (= tmppath f.name))
    ;; Run ruff check --fix for import sorting (modifies file in place)
    (subprocess.run ["ruff" "check" "--fix" "--select" "I" tmppath]
                    :capture-output True)
    ;; Run ruff format (modifies file in place)
    (subprocess.run ["ruff" "format" tmppath]
                    :capture-output True)
    ;; Read back the formatted code
    (with [(open tmppath "r") as f]
      (= pysrc (.rstrip (f.read) "\n")))
    (os.unlink tmppath)
    (except [Exception as e]
      (print f"Ruff formatting failed: {e}")))
  (return pysrc))

(= argparser (argparse.ArgumentParser))
(argparser.add-argument "--meta"
                        :dest "include_meta"
                        :action "store_true")
(argparser.add-argument "--no-lispy"
                        :dest "no_lispy"
                        :action "store_true")

(def l2py-s [src :include-meta False :fresh-scope False :package "" :no-lispy False :format True]
  "Translate lispy source string to Python source string"
  (if fresh-scope
      (= scope {"__builtins__" __builtins__
                "__package__" package
                "__macro_namespace" {}})
      (= scope SCOPE))
  (= pysrc (src-to-python src :include-meta include_meta :scope scope :format format))
  (if no_lispy
      (return pysrc))
  (return (+ "import lispy\n\n" pysrc)))

(def l2py-f [file-path :include-meta False :no-lispy False :format True]
  "Translate lispy file to Python source string (standalone with sys.path setup)"
  (= script-dir (osp.dirname (osp.abspath file-path)))
  (if (not (in script-dir sys.path))
      (sys.path.insert 0 script-dir))

  ;; Clear cached macro modules to ensure fresh reload
  (= modules-to-remove [])
  (for [mod-name mod] in (sys.modules.items)
    (if (or (mod-name.startswith "lispy.macros")
            (and mod
                 (hasattr mod "__file__")
                 mod.__file__
                 (mod.__file__.endswith ".lpy")))
        (modules-to-remove.append mod-name)))
  (for mod-name in modules-to-remove
    (sys.modules.pop mod-name))

  (with [(open file-path "rb") as f]
    (= src (.decode (f.read) "utf-8")))
  (= pkg (detect-package-name :path file-path))
  (return (+ (l2py-s src :include-meta include_meta :fresh-scope True :package pkg :no-lispy no_lispy :format format) "\n")))

(def l2py []
  "CLI entry point: parse args and translate file"
  (= [args more-args] (argparser.parse-known-args))
  (if (and (>= (len more-args) 2) (== (sub more-args 0) "-c"))
      (print (l2py-s (sub more-args 1) :include-meta args.include_meta :no-lispy args.no_lispy))
      (do (= file (osp.join (os.getcwd) (sub more-args 0)))
          (print (l2py-f file :include-meta args.include_meta :no-lispy args.no_lispy)))))

(def _make-open-handler [o c]
  (def handler [event]
    (= buf event.app.current-buffer)
    (buf.insert-text (+ o c))
    (buf.cursor-left))
  (return handler))

(def _make-close-handler [c]
  (def handler [event]
    (= buf event.app.current-buffer)
    (if (== buf.document.current-char c)
        (buf.cursor-right)
        (buf.insert-text c)))
  (return handler))

(def _make-quote-handler [q]
  (def handler [event]
    (= buf event.app.current-buffer)
    (if (== buf.document.current-char q)
        (buf.cursor-right)
        (do
          (buf.insert-text (+ q q))
          (buf.cursor-left))))
  (return handler))

(= _SPECIAL-FORMS
   {, "def" "defn" "defmacro" "async-def"
      "if" "cond" "conde" "when" "unless"
      "while" "for" "async-for"
      "do" "try" "with" "async-with"
      "class" "deco"
      "lambda" "fn"
      "let" "match" "case"
      "except" "except*" "finally" "else"})

(def _col-of [text pos]
  "Column of position pos in text (0-based)."
  (= nl (.rfind text "\n" 0 pos))
  (return (- pos nl 1)))

(def _calc-indent [text]
  "Calculate indent for the next line based on text before cursor."
  (= in-string False)
  (= stack [])
  (= i 0)
  (= n (len text))
  (while (< i n)
    (= c (sub text i))
    (cond in-string
          (if (== c "\"")
              (= in-string False))

          (== c "\"")
          (= in-string True)

          (== c ";")
          (break)

          (in c "([{")
          (do
            (= paren-col (_col-of text i))
            (if (!= c "(")
                ;; [ and {: align to first element
                (do
                  (= j (+ i 1))
                  (while (and (< j n) (== (sub text j) " "))
                    (+= j 1))
                  (if (and (< j n) (not (in (sub text j) "\n")))
                      (stack.append (_col-of text j))
                      (stack.append (+ paren-col 1))))
                ;; (: special form vs function call
                (do
                  (= j (+ i 1))
                  (while (and (< j n) (== (sub text j) " "))
                    (+= j 1))
                  (= op-start j)
                  (while (and (< j n) (not (in (sub text j) " \n\t()[]{}'\"")))
                    (+= j 1))
                  (= op (sub text [: op-start j]))
                  (if (or (== op "") (in op _SPECIAL-FORMS))
                      (stack.append (+ paren-col 2))
                      (do
                        (= arg-pos j)
                        (while (and (< arg-pos n) (== (sub text arg-pos) " "))
                          (+= arg-pos 1))
                        (if (and (< arg-pos n) (not (in (sub text arg-pos) "\n")))
                            (stack.append (_col-of text arg-pos))
                            (stack.append (+ paren-col 2))))))))

          (in c ")]}")
          (if stack
              (stack.pop)))
    (+= i 1))
  (if stack
      (return (sub stack -1))
      (return 0)))

(def _parens-balanced? [text]
  (= depth 0)
  (= in-string False)
  (for c in text
    (cond in-string
          (if (== c "\"")
              (= in-string False)
              (continue))

          (== c "\"")
          (= in-string True)

          (in c "([{")
          (+= depth 1)

          (in c ")]}")
          (-= depth 1)))
  (return (<= depth 0)))

(def make-repl-session []
  (from prompt-toolkit [PromptSession])
  (from prompt-toolkit.history [FileHistory])
  (from prompt-toolkit.key-binding [KeyBindings])
  (from prompt-toolkit.keys [Keys])

  (= kb (KeyBindings))
  (= _pairs {"(" ")" "[" "]" "{" "}" "'" "'" "\"" "\""})

  (for [o c] in (_pairs.items)
    ((kb.add o) (_make-open-handler o c)))

  (for c in (_pairs.values)
    ((kb.add c) (_make-close-handler c)))

  (for q in ["'" "\""]
    ((kb.add q) (_make-quote-handler q)))

  ;; Backspace deletes both chars of an empty pair
  (= _bp _pairs)
  (def handle-backspace [event]
    (= buf event.app.current-buffer)
    (= doc buf.document)
    (= before doc.char-before-cursor)
    (= after doc.current-char)
    (if (and (in before _bp) (== (sub _bp before) after))
        (do (buf.delete) (buf.delete-before-cursor))
        (buf.delete-before-cursor)))
  ((kb.add Keys.Backspace) handle-backspace)

  ;; Enter: submit
  (def handle-enter [event]
    (event.app.current-buffer.validate-and-handle))
  ((kb.add Keys.Enter) handle-enter)

  ;; Ctrl+J: insert newline with auto-indent
  (def handle-newline [event]
    (= buf event.app.current-buffer)
    (= text-before buf.document.text-before-cursor)
    (= indent (_calc-indent text-before))
    (buf.insert-text (+ "\n" (* " " indent))))
  ((kb.add "c-j") handle-newline)

  ;; Tab: auto-indent current line
  (def handle-tab [event]
    (= buf event.app.current-buffer)
    (= doc buf.document)
    ;; Get all text up to start of current line
    (= lines (.split doc.text-before-cursor "\n"))
    (if (> (len lines) 1)
        (= text-before (.join "\n" (sub lines [: -1])))
        (= text-before ""))
    (= indent (_calc-indent text-before))
    ;; Replace leading whitespace on current line
    (= current-line doc.current-line-before-cursor)
    (= stripped (.lstrip current-line))
    (= old-indent (- (len current-line) (len stripped)))
    (= new-indent-str (* " " indent))
    ;; Delete old indent, insert new
    (buf.cursor-left :count old-indent)
    (buf.delete :count old-indent)
    (buf.insert-text new-indent-str))
  ((kb.add "c-i") handle-tab)

  (= histfile (osp.join (osp.expanduser "~") ".lpy_history"))
  (return (PromptSession :history (FileHistory histfile)
                         :key-bindings kb
                         :multiline True
                         :prompt-continuation "...   ")))

(def eval-and-print [src :scope SCOPE :translate False]
  (= parsed (parse src))
  (= stl (macroexpand-then-compile parsed scope))
  (if translate
      (do ;; (print "python translation")
        (-> (.join "\n" (list (map ast-to-python stl)))
            (format-python-source)
            (print))
        ;; (print "")
        ))
  ;; (print "result")
  (for st stl
    (eval (compile (ast.Interactive :body [st]) "" "single")
          scope))
  ;; (print "\n")
  )

(def repl [:translate False]
  ;; Add current directory to sys.path for local imports
  (= cwd (os.getcwd))
  (if (not (in cwd sys.path))
      (sys.path.insert 0 cwd))

  (= session (make-repl-session))
  (= scope SCOPE)
  (eval-and-print "(require lispy.macros *)
(from pprint [pprint])" scope)
  (while True
    (try
      (do
        (= src (session.prompt "repl> "))
        (eval-and-print src scope translate))
      (except [SystemExit]
        (print "SystemExit caught. Exiting REPL.")
        (break))
      (except [EOFError as e]
        (print "Ctrl-d input. Exiting REPL.")
        (break))
      (except [KeyboardInterrupt]
        (print "\nKeyboard Interrupt")
        (continue))
      (except [Exception as e]
        (print "An error occurred:\n====================================")
        (traceback.print_exc)
        (print "====================================")))))

(def nrepl-eval [src scope]
  "Evaluate LisPython source, capturing stdout/stderr and return value."
  (= result {"value" None "stdout" "" "error" None})
  (= stdout-capture (io.StringIO))
  (= stderr-capture (io.StringIO))
  (= old-stdout sys.stdout)
  (= old-stderr sys.stderr)
  (try
    (= sys.stdout stdout-capture)
    (= sys.stderr stderr-capture)
    (= parsed (parse src))
    (= stl (macroexpand-then-compile parsed scope))
    (= last-val None)
    (for st stl
      (if (isinstance st ast.Expr)
          (= last-val
             (eval (compile (ast.Expression :body st.value) "" "eval")
                   scope))
          (do
            (exec (compile (ast.Module :body [st] :type-ignores []) "" "exec")
                  scope)
            (= last-val None))))
    (if (is-not last-val None)
        (= (sub result "value") (repr last-val)))
    (except [Exception as e]
      (= (sub result "error") (.rstrip (traceback.format-exc))))
    (finally
      (= sys.stdout old-stdout)
      (= sys.stderr old-stderr)))
  (= (sub result "stdout") (.getvalue stdout-capture))
  (= stderr-out (.getvalue stderr-capture))
  (if stderr-out
      (= (sub result "stderr") stderr-out))
  (return result))

(def nrepl-load-file [file-path scope]
  "Load a .lpy file into the REPL scope."
  (= script-dir (osp.dirname (osp.abspath file-path)))
  (if (not (in script-dir sys.path))
      (sys.path.insert 0 script-dir))
  (with [(open file-path "rb") as f]
    (= src (.decode (f.read) "utf-8")))
  (return (nrepl-eval src scope)))

(def nrepl-macroexpand [src scope]
  "Macroexpand LisPython source and return the expanded s-expression."
  (try
    (= parsed (parse src))
    (= expanded [])
    (for sexp in parsed
      (expanded.append (str (macroexpand sexp scope))))
    (return {"op" "macroexpand-result"
             "expansion" (.join "\n" expanded)
             "error" None})
    (except [Exception as e]
      (return {"op" "macroexpand-result"
               "expansion" None
               "error" (.rstrip (traceback.format-exc))}))))

(def _mangle [s]
  (return (.replace s "-" "_")))

(def _unmangle [s]
  "Convert Python identifier to lispy symbol, preserving leading/trailing underscores."
  (if (not s) (return ""))
  (= leading (- (len s) (len (.lstrip s "_"))))
  (= trailing (- (len s) (len (.rstrip s "_"))))
  (if (>= (+ leading trailing) (len s))
      (return s))
  (= middle (sub s [: leading (ife trailing (- (len s) trailing) None)]))
  (= middle (.replace middle "_" "-"))
  (return (+ (* "_" leading) middle (* "_" trailing))))

(def _resolve-obj [symbol scope]
  "Resolve a symbol string to a Python object in scope."
  (= mangled (_mangle symbol))
  (try
    (return (eval mangled scope))
    (except [Exception]
      (return None))))

(def nrepl-complete [prefix scope]
  "Return completions matching prefix, including dot-completion."
  (= has-dot (in "." prefix))
  (if has-dot
      (do
        ;; Dot completion: resolve object, list its attributes
        (= parts (.split prefix "."))
        (= obj-part (.join "." (sub parts [: -1])))
        (= attr-prefix (sub parts -1))
        (= obj (_resolve-obj obj-part scope))
        (if (is obj None)
            (return {"op" "complete-result" "completions" []}))
        (= py-attr (.replace attr-prefix "-" "_"))
        (= matches [])
        (for attr in (dir obj)
          (if (.startswith attr py-attr)
              (matches.append (+ obj-part "." (_unmangle attr)))))
        (return {"op" "complete-result"
                 "completions" (sorted matches)}))
      (do
        ;; Prefix completion from scope, builtins, macros, keywords
        (= matches [])
        (= py-prefix (_mangle prefix))
        (for k in scope
          (if (or (.startswith k prefix) (.startswith k py-prefix))
              (matches.append (_unmangle k))))
        (= builtins (ife (isinstance __builtins__ dict)
                         __builtins__
                         (vars __builtins__)))
        (for k in builtins
          (if (or (.startswith k prefix) (.startswith k py-prefix))
              (matches.append k)))
        (= macros (.get scope "__macro_namespace" {}))
        (for k in macros
          (if (.startswith k prefix)
              (matches.append k)))
        (for k in keyword.kwlist
          (if (.startswith k prefix)
              (matches.append k)))
        ;; LisPython special forms and syntax
        (for k in [;; Definitions
                   "def" "defn" "defmacro" "async-def"
                   ;; Looping
                   "for" "async-for" "while"
                   ;; Flow
                   "return" "if" "ife" "when" "unless"
                   "cond" "conde" "else"
                   "break" "continue" "pass"
                   "match" "case" "do" "comment"
                   ;; Threading
                   "->" "->>" "as->"
                   ;; Functional
                   "fn" "lambda" "await"
                   "yield" "yield-from"
                   ;; Context
                   "with" "async-with" "deco"
                   ;; Error handling
                   "try" "except" "except*" "finally" "raise"
                   ;; Data
                   "del" "sub"
                   ;; Import / macro
                   "import" "from" "require"
                   "global" "nonlocal" "assert"
                   ;; Class
                   "class"
                   ;; Misc
                   "gensym" "pprint"]
          (if (.startswith k prefix)
              (matches.append k)))
        (return {"op" "complete-result"
                 "completions" (sorted (set matches))}))))

(def nrepl-docs [symbol scope]
  "Return documentation for a symbol."
  (try
    (= obj (_resolve-obj symbol scope))
    ;; Check macros
    (if (is obj None)
        (do (= macros (.get scope "__macro_namespace" {}))
            (= obj (.get macros (_mangle symbol)))))
    (if (is obj None)
        (return {"op" "docs-result" "docs" None "error" None}))
    ;; Build docs string
    (= parts [])
    (= name (_unmangle symbol))
    ;; Signature
    (try
      (= sig (inspect.signature obj))
      (= params [])
      (for [pname p] in (.items sig.parameters)
        (= kind p.kind)
        (cond (== kind inspect.Parameter.VAR-POSITIONAL)
              (params.append (+ "*" (_unmangle pname)))
              (== kind inspect.Parameter.VAR-KEYWORD)
              (params.append (+ "**" (_unmangle pname)))
              (and (!= p.default inspect.Parameter.empty)
                   (in kind [inspect.Parameter.KEYWORD-ONLY
                             inspect.Parameter.POSITIONAL-OR-KEYWORD]))
              (params.append (+ ":" (_unmangle pname) " " (repr p.default)))
              True
              (params.append (_unmangle pname))))
      (parts.append (+ name " [" (.join " " params) "]"))
      (except [TypeError ValueError]
        (parts.append name)))
    ;; Docstring
    (= docstring (getattr obj "__doc__" None))
    (if docstring
        (parts.append (.strip (sub (.splitlines docstring) 0))))
    (return {"op" "docs-result"
             "docs" (.join " - " parts)
             "error" None})
    (except [Exception as e]
      (return {"op" "docs-result"
               "docs" None
               "error" (str e)}))))

(def nrepl-annotate [symbol scope]
  "Return type annotation for a symbol."
  (try
    (= obj (_resolve-obj symbol scope))
    (if (is obj None)
        (do (= macros (.get scope "__macro_namespace" {}))
            (= obj (.get macros (_mangle symbol)))))
    (if (is obj None)
        (return {"op" "annotate-result" "annotation" "unknown"}))
    (= klass (. (type obj) __name__))
    (cond (in klass ["function" "builtin_function_or_method"])
          (= annotation "function")
          (== klass "type")
          (= annotation "class")
          (== klass "module")
          (= annotation "module")
          (in symbol (.get scope "__macro_namespace" {}))
          (= annotation "macro")
          True
          (= annotation "instance"))
    (return {"op" "annotate-result"
             "annotation" (+ "<" annotation " " (_unmangle symbol) ">")})
    (except [Exception as e]
      (return {"op" "annotate-result"
               "annotation" "unknown"}))))

(def _nrepl-reply [conn msg result]
  "Send result back, echoing the request id if present."
  (= req-id (.get msg "id"))
  (if req-id
      (= (sub result "id") req-id))
  (conn.sendall (.encode (+ (json.dumps result) "\n") "utf-8")))

(def _nrepl-handle-client [conn addr scope]
  (= buf "")
  (try
    (while True
      (= data (.decode (conn.recv 4096) "utf-8"))
      (if (not data)
          (break))
      (+= buf data)
      ;; Process complete JSON messages (newline-delimited)
      (while (in "\n" buf)
        (= [line buf] (.split buf "\n" 1))
        (= line (.strip line))
        (if (not line)
            (continue))
        (try
          (= msg (json.loads line))
          (= op (.get msg "op" "eval"))
          (cond (== op "eval")
                (do (= src (sub msg "code"))
                    (= result (nrepl-eval src scope))
                    (= (sub result "op") "eval-result")
                    (_nrepl-reply conn msg result))

                (== op "load-file")
                (do (= result (nrepl-load-file (sub msg "path") scope))
                    (= (sub result "op") "load-file-result")
                    (_nrepl-reply conn msg result))

                (== op "macroexpand")
                (do (= result (nrepl-macroexpand (sub msg "code") scope))
                    (_nrepl-reply conn msg result))

                (== op "complete")
                (do (= result (nrepl-complete (sub msg "prefix") scope))
                    (_nrepl-reply conn msg result))

                (== op "docs")
                (do (= result (nrepl-docs (sub msg "symbol") scope))
                    (_nrepl-reply conn msg result))

                (== op "annotate")
                (do (= result (nrepl-annotate (sub msg "symbol") scope))
                    (_nrepl-reply conn msg result))

                (== op "ping")
                (_nrepl-reply conn msg {"op" "pong"}))
          (except [json.JSONDecodeError as e]
            (conn.sendall
              (.encode (+ (json.dumps {"op" "error" "error" (str e)}) "\n")
                       "utf-8"))))))
    (except [ConnectionResetError] None)
    (except [BrokenPipeError] None)
    (finally
      (conn.close))))

(def nrepl-server [:host "127.0.0.1" :port 0]
  (= cwd (os.getcwd))
  (if (not (in cwd sys.path))
      (sys.path.insert 0 cwd))
  (= scope SCOPE)
  (nrepl-eval "(require lispy.macros *)\n(from pprint [pprint])" scope)

  (= srv (socket.socket socket.AF-INET socket.SOCK-STREAM))
  (srv.setsockopt socket.SOL-SOCKET socket.SO-REUSEADDR 1)
  (srv.bind (, host port))
  (srv.listen 5)
  (= [_ actual-port] (srv.getsockname))

  (print f"nREPL server started on {host}:{actual-port}")
  (sys.stdout.flush)

  (try
    (while True
      (= [conn addr] (srv.accept))
      (= t (threading.Thread :target _nrepl-handle-client
                              :args (, conn addr scope)
                              :daemon True))
      (t.start))
    (except [KeyboardInterrupt]
      (print "\nnREPL server stopped."))
    (finally
      (srv.close))))

(def run []
  (cond (< (len sys.argv) 2)
        (repl)

        (== (sub sys.argv 1) "-m")
        (do (sys.argv.pop 1)
            (= mname (sys.argv.pop 1))
            (runpy.run-module (.replace mname "-" "_") :run-name "__main__" :alter-sys True))

        (== (sub sys.argv 1) "-c")
        (do (sys.argv.pop 1)
            (= src (sys.argv.pop 1))
            (eval-and-print src))

        (== (sub sys.argv 1) "--nrepl")
        (do (sys.argv.pop 1)
            (= port (ife (> (len sys.argv) 1) (int (sys.argv.pop 1)) 0))
            (nrepl-server :port port))

        (== (sub sys.argv 1) "-t")
        (repl True)

        (do (= fpath (sys.argv.pop 1))
            (= script-dir (osp.dirname (osp.abspath fpath)))
            (if (not (in script-dir sys.path))
                (sys.path.insert 0 script-dir))
            (runpy.run-path fpath :run-name "__main__"))))

(if (== __name__ "__main__")
    (run))
