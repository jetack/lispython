;; The modules the LSP's own compiles imported (a require's macro module and
;; whatever its macros import), and dropping them once one is stale.  The
;; LSP compiles in its own process, so a module a require imported stays in
;; sys.modules: without this, an edit to it would never reach a later view,
;; shadow or diagnostic.  Pygls-free.

(require lispy.macros *)

(import contextlib)
(import contextvars)
(import importlib)
(import importlib.machinery)
(import importlib.util)
(import logging)
(import os)
(import os.path as osp)
(import sys)
(import sysconfig)
(import threading)
(import time)

(import lispy)
(from lispy.core.importer [lpy-cache-path lpy-record])
(from lispy.core.macro [REQUIRE-FILENAME])

(= logger (logging.getLogger __name__))

;; Every mutable piece of this module's state, one object per process (_SHARED,
;; kept on the loader): a second instance of this module (a reload, or an
;; import after it was dropped from sys.modules) takes that same object, so
;; its compiles and drops wait for one another's.  local holds each thread's
;; open windows; condition guards the rest.  files maps each tracked file's
;; path to (st_mtime_ns, st_size), the first stamp it had when read in this
;; epoch (an earlier stamp can only make it stale, never missed); it is keyed
;; by path, never by module name, because one name may be read from two
;; source roots in one epoch.  names holds the modules a drop pops from
;; sys.modules.  dep-files maps each trackable file in the cache record of a
;; tracked .lpy (lpy-record) to its recorded stamp: a module loaded from its
;; cache reads none of the files its compile read (a module a macro imported
;; as it expanded), so no window sees them.  dirs maps a directory searched
;; for a module no finder found, or holding a namespace package, to its
;; st_mtime_ns then.  running maps a token per compile in progress (one
;; object per fresh-modules entry) to its search dirs, hung holds the running
;; ones a wait timed out on: a token leaves both when its compile ends.
;; loaded-dirs are the search dirs the modules in names were imported under
;; (None: mixed); every running compile that is not hung has those dirs.
;; switching counts the compiles waiting to change them.  search-dirs is the
;; running compile's search dirs, per thread (_SearchDirsFinder).  epoch is
;; the macro environment's version.
(class _Shared []
  (def __init__ [self original-path-stats original-namespace-exec]
    (= self.local (threading.local))
    (= self.condition (threading.Condition))
    (= self.original-path-stats original-path-stats)
    (= self.original-namespace-exec original-namespace-exec)
    (= self.files {})
    (= self.names (set))
    (= self.dep-files {})
    (= self.dirs {})
    (= self.running {})
    (= self.hung (set))
    (= self.loaded-dirs None)
    (= self.switching 0)
    (= self.search-dirs (contextvars.ContextVar "lispy_search_dirs" :default (,)))
    (= self.epoch 0)))

;; How long, in seconds, a compile waits for the running ones to end before
;; it drops stale modules.  Unbounded, a macro hung in one compile would hold
;; every later one (filling the worker threads, and write-shadows holds the
;; view root's lock while it waits).  A compile still running when the wait
;; ends is marked hung (it may only be slow): no drop waits for it again, so
;; it costs one WAIT-LIMIT.
(= WAIT-LIMIT 5.0)

(= _LIBRARY-PARTS (frozenset ["site-packages" "dist-packages"]))
(= _LISPY-DIR (osp.dirname (osp.realpath lispy.__file__)))
;; The interpreter's library directories.
(= _LIBRARY-DIRS
   (tuple (sorted {, (osp.realpath (sub (sysconfig.get-paths) key))
                     for key in ["stdlib" "platstdlib" "purelib" "platlib"]})))

(def _stamp [path]
  "(st_mtime_ns, st_size) of path; OSError when it cannot be read."
  (= st (os.stat path))
  (return (, st.st_mtime_ns st.st_size)))

(def _windows []
  "This thread's open windows."
  (= windows (getattr _SHARED.local "windows" None))
  (if (is windows None)
      (do (= windows [])
          (= _SHARED.local.windows windows)))
  (return windows))

;; The stamp is taken where a module's source is read, never off sys.modules
;; afterwards: SourceFileLoader.get_code calls path_stats before it reads the
;; source, so the stamp predates the text that was compiled (an edit during
;; the import makes it stale, never missed), only the thread that loads the
;; module records it, and a module whose import failed (a parse error in it)
;; is tracked too, so fixing its file moves the epoch.
(def _recording-path-stats [self path]
  (= windows (getattr _SHARED.local "windows" None))
  (if windows
      (try
        (.append (sub windows -1) (, self.name path (_stamp path)))
        (except [OSError]
          (pass))))
  (return (_SHARED.original-path-stats self path)))

;; A namespace package has no file, so path_stats never sees it: a require of
;; a directory with no __init__ yet binds an empty namespace module.  Its
;; name is recorded to drop, with each portion directory by mtime (where a
;; later __init__ goes) and the module files that would replace it beside
;; that directory (<name>.py, <name>.lpy) by their stamp, None while absent,
;; when every portion is trackable.  Never the parent directory's mtime:
;; for a top-level namespace in a flat layout that is the import root, where
;; every lock or backup file would drop every module.
(def _recording-namespace-exec [self module]
  (= windows (getattr _SHARED.local "windows" None))
  (if windows
      (do (= portions (list (getattr module "__path__" [])))
          (if (and portions
                   (all ((and (isinstance portion str)
                              (_trackable-path-p (osp.realpath portion)))
                         for portion in portions)))
              (do (= reads (sub windows -1))
                  (= stem (sub (.rpartition module.__name__ ".") 2))
                  (.append reads (, module.__name__ None None))
                  (for portion in portions
                    (try
                      (.append reads (, None portion (. (os.stat portion) st-mtime-ns)))
                      (except [OSError]
                        (pass)))
                    (for suffix in [".py" ".lpy"]
                      (= candidate (osp.join (osp.dirname portion) (+ stem suffix)))
                      (try
                        (= stamp (_stamp candidate))
                        (except [OSError]
                          (= stamp None)))
                      (.append reads (, module.__name__ candidate stamp))))))))
  (return (_SHARED.original-namespace-exec self module)))

;; A missing module is never read, so path_stats cannot see it, and a require
;; swallows the ModuleNotFoundError (core/macro.py require_macro), so no
;; exception says so either.  The import system asks this finder, last on
;; sys.meta_path, only once every other finder found nothing; it records the
;; directories that were searched (the parent package's __path__, or the
;; compile's search dirs and sys.path for a top-level name a require asked
;; for, _top-level-path) with their mtime.
;; Creating a file there, or saving one by an atomic rename, changes that
;; mtime: the signal FileFinder itself uses.  A top-level miss of any other
;; import (a module's try: import optional) is not recorded, because sys.path
;; holds the import root: in a flat layout every file written there (a lock,
;; a backup) would drop every module.  The module is never probed again with
;; find_spec instead: that imports its parents outside any window, and the
;; search dirs are searched only while a compile runs.
(= _IMPORTLIB-FILE importlib.__file__)

(def _asked-by-require-p [frame]
  "Whether the import running at frame was asked for by a require's own
   code (REQUIRE-FILENAME): the first frame up from it that is not
   importlib's."
  (while (and (is-not frame None)
              (or (.startswith frame.f-code.co-filename "<frozen importlib")
                  (== frame.f-code.co-filename _IMPORTLIB-FILE)))
    (= frame frame.f-back))
  (return (and (is-not frame None) (== frame.f-code.co-filename REQUIRE-FILENAME))))

(class _MissingModuleObserver []
  (deco staticmethod
    (def find-spec [name path :target None]
      (= windows (getattr _SHARED.local "windows" None))
      (if (or (not windows)
              (and (is path None) (not (_asked-by-require-p (sys._getframe 1)))))
          (return None))
      (for directory in (ife (is path None) (_top-level-path) (list path))
        (if (isinstance directory str)
            (try
              (.append (sub windows -1)
                       (, None directory
                          (. (os.stat (or directory os.curdir)) st-mtime-ns)))
              (except [OSError]
                (pass)))))
      (return None))))

;; A compile's search dirs come before sys.path for a top-level name, as
;; `lpy` puts a script's directory first, but only for the thread compiling:
;; sys.path is shared by every thread, so a dir inserted there would serve
;; another compile, or land behind one already present.  Sits right before
;; PathFinder, so the built-in and frozen importers still come first.
(def _top-level-path []
  "The search path of a top-level import on this thread: the running
   compile's search dirs, then sys.path."
  (return (+ (list (.get _SHARED.search-dirs)) sys.path)))

(class _SearchDirsFinder []
  (deco staticmethod
    (def find-spec [name path :target None]
      (if (or (is-not path None) (not (.get _SHARED.search-dirs)))
          (return None))
      (= spec (importlib.machinery.PathFinder.find-spec name (_top-level-path) target))
      ;; A namespace package's NamespacePath recomputes its portions from
      ;; sys.path alone (on invalidate_caches or a sys.path change), which
      ;; would lose those under the search dirs.
      (if (and (is-not spec None)
               (is-not spec.submodule-search-locations None)
               (not (isinstance spec.submodule-search-locations list)))
          (= spec.submodule-search-locations (list spec.submodule-search-locations)))
      (return spec))))

;; The fresh-modules windows open on each thread, innermost last: each a list
;; of the (name, path, stamp) reads made in it, (None, directory,
;; st_mtime_ns) for each directory searched for a module no finder found or
;; holding a namespace package, and (name, None, None) for a namespace
;; package.  The wrappers and the finders are installed once per process,
;; with the _Shared they write to, by the first import of this module; a
;; later instance installs nothing, so nothing is wrapped twice.
(= _SOURCE-LOADER importlib.machinery.SourceFileLoader)
(= _NAMESPACE-LOADER importlib.machinery.NamespaceLoader)
(= _SHARED (getattr _SOURCE-LOADER "_lispy_fresh_modules" None))
(if (is _SHARED None)
    (do (= _SHARED (_Shared _SOURCE-LOADER.path-stats _NAMESPACE-LOADER.exec-module))
        (setattr _SOURCE-LOADER "_lispy_fresh_modules" _SHARED)
        (= _SOURCE-LOADER.path-stats _recording-path-stats)
        (= _NAMESPACE-LOADER.exec-module _recording-namespace-exec)
        (.insert sys.meta-path
                 (ife (in importlib.machinery.PathFinder sys.meta-path)
                      (.index sys.meta-path importlib.machinery.PathFinder)
                      (len sys.meta-path))
                 _SearchDirsFinder)
        (.append sys.meta-path _MissingModuleObserver)))

(def _stale-state []
  "(the paths of tracked files that now stat differently or not at all,
   whether anything tracked is stale: such a file, or a searched directory
   whose mtime changed or that is gone).  A module is stale by its file
   alone, never by being absent from sys.modules: a module whose import
   failed is in none, and stays tracked until its file changes.  Under
   _SHARED.condition."
  (= changed [])
  ;; A None stamp is a file tracked while absent: stale once it exists.
  (for [path stamp] in (+ (list (.items _SHARED.files)) (list (.items _SHARED.dep-files)))
    (try
      (if (!= (_stamp path) stamp)
          (.append changed path))
      (except [OSError]
        (if (is-not stamp None)
            (.append changed path)))))
  (if changed
      (return (, changed True)))
  (for [directory mtime] in (list (.items _SHARED.dirs))
    (try
      (if (!= (. (os.stat directory) st-mtime-ns) mtime)
          (return (, changed True)))
      (except [OSError]
        (return (, changed True)))))
  (return (, changed False)))

(def _remove-bytecode [path]
  "Remove path's cached bytecode (an .lpy's lispython cache, a .py's pyc),
   if any; a failure other than its absence is logged."
  (try
    (= cache (ife (.endswith path ".lpy")
                  (lpy-cache-path path)
                  (importlib.util.cache-from-source path)))
    (if (is-not cache None)
        (os.remove cache))
    (except [(, FileNotFoundError NotImplementedError ValueError)]
      (pass))
    (except [OSError as e]
      (.warning logger "lispython LSP: cannot remove the bytecode of %s: %s"
                path e))))

(def _drop-stale [wait]
  "Drop every tracked module once one is stale, once the compiles running
   (less the hung ones) have ended.  wait: wait for them up to WAIT-LIMIT,
   then mark those still running hung and drop all the same; else drop
   only when none is running.  True when nothing is stale afterwards (no
   drop was due, or it was made).  Under _SHARED.condition."
  ;; A wait rather than a drop at once: deleting a sys.modules entry while
  ;; another thread is importing it makes that import raise (importlib's
  ;; _load_unlocked pops the entry back out).  A compile arriving while a
  ;; module is stale waits too, so none goes on with stale modules.
  (= deadline (+ (time.monotonic) WAIT-LIMIT))
  (while True
    (= [changed stale] (_stale-state))
    (if (not stale)
        (return True))
    (= blockers (- (.keys _SHARED.running) _SHARED.hung))
    (if blockers
        (do (if (not wait)
                (return False))
            (= remaining (- deadline (time.monotonic)))
            (if (> remaining 0)
                (do (.wait _SHARED.condition remaining)
                    (continue)))
            ;; A compile past WAIT-LIMIT may only be slow.  Dropping under it
            ;; can fail an import it has in progress; its result is keyed by
            ;; the epoch it began under, now outdated, so it is compiled
            ;; again.
            (.update _SHARED.hung blockers)))
    ;; A pyc keeps its source's mtime in whole seconds and its size, so an
    ;; edit of the same size within that second would load the old pyc: a
    ;; changed .py loses its pyc.  Every tracked .lpy loses its cache too,
    ;; though its record validates itself (core/importer.py): this process
    ;; keeps modules across edits, so a helper a macro module imported at
    ;; top level can be in no record (the importer's accepted gap), and the
    ;; next compile must read and track everything anew.
    (for path in changed
      (if (.endswith path ".py")
          (_remove-bytecode path)))
    (for path in (list _SHARED.files)
      (if (.endswith path ".lpy")
          (_remove-bytecode path)))
    ;; Every tracked module goes, not just the changed one: the import graph
    ;; is unknown, and a module importing the changed one holds its old
    ;; functions.
    (for name in (list _SHARED.names)
      (.pop sys.modules name None))
    (.clear _SHARED.files)
    (.clear _SHARED.names)
    (.clear _SHARED.dep-files)
    (.clear _SHARED.dirs)
    (importlib.invalidate-caches)
    (+= _SHARED.epoch 1)
    (.notify-all _SHARED.condition)
    (return True)))

(def _within-p [real directory]
  "Whether the real path real is directory (already real) or below it."
  (try
    (return (== (osp.commonpath [real directory]) directory))
    ;; Paths on different drives (Windows) share no root.
    (except [ValueError]
      (return False))))

(def library-path-p [real]
  "Whether the file or directory at the real path real is installed code,
   never the user's: it lies in the interpreter's library directories
   (_LIBRARY-DIRS) or in any site-packages or dist-packages directory.  The
   one home of that rule: tracking (_trackable-path-p) and the server's
   module naming (renaming-file-p) read it."
  (if (not (.isdisjoint _LIBRARY-PARTS (.split real os.sep)))
      (return True))
  (return (any ((_within-p real directory) for directory in _LIBRARY-DIRS))))

(def _trackable-path-p [real]
  "Whether the file or directory at the real path real may be tracked: it
   is no library path (library-path-p) and lies outside lispython's own
   package, which a drop never re-imports.  Any other source root qualifies
   (a workspace member, an editable install, a PYTHONPATH entry), not only
   the compiling file's."
  (return (not (or (library-path-p real) (_within-p real _LISPY-DIR)))))

(def _lispy-module-p [name]
  (return (or (== name "lispy") (.startswith name "lispy."))))

(def _trackable-p [name path]
  "Whether the module name read from path in a window may be dropped: a .py
   or .lpy file at a trackable path (_trackable-path-p) and no module of
   lispython itself.  The server's own modules (a user may edit lispython
   itself) and third-party or extension modules (numpy refuses a second
   load) must never be dropped."
  (if (_lispy-module-p name)
      (return False))
  (if (or (not (isinstance path str)) (not (.endswith path (, ".py" ".lpy"))))
      (return False))
  (return (_trackable-path-p (osp.realpath path))))

(def _track-record [path]
  "Track the trackable files in the cache record of the .lpy at path, the
   record of the code loaded from it (none while its latest compile failed,
   so a broken file is tracked by its own stamp alone).  Under
   _SHARED.condition."
  (= record (lpy-record path))
  (if (is record None)
      (return))
  (for [real mtime size] in record
    (if (_trackable-path-p real)
        (.setdefault _SHARED.dep-files real (, mtime size)))))

(def _enter [token search-dirs]
  "Admit the compile token with search-dirs: once nothing tracked is stale
   (_drop-stale), and once the modules in names were imported under the
   same search dirs.  Else it switches them: it waits until no compile
   (less the hung ones) runs, up to WAIT-LIMIT, then drops the modules in
   names.  Under _SHARED.condition."
  ;; A module two search dirs both hold (a script's sibling helper) is one
  ;; sys.modules entry, so it may serve only compiles of the dirs it was
  ;; imported under.  A switch keeps files, dep-files and dirs: no file
  ;; changed, so they still say when the epoch's modules are stale, and the
  ;; epoch stays, or every other open document would recompile and switch
  ;; back.  Compiles arriving with the loaded dirs wait behind a switch, so
  ;; a stream of them cannot starve it.
  (= switching False)
  (= target None)
  (try
    (while True
      (_drop-stale True)
      (if (== _SHARED.loaded-dirs search-dirs)
          (do (if (or switching (not _SHARED.switching))
                  (break))
              (.wait _SHARED.condition)
              (continue)))
      (if (not switching)
          (do (= switching True)
              (+= _SHARED.switching 1)))
      ;; WAIT-LIMIT per loaded dirs: another switch landing meanwhile brings
      ;; new compiles, which get their own WAIT-LIMIT before they are hung.
      (if (or (is target None) (!= (sub target 0) _SHARED.loaded-dirs))
          (= target (, _SHARED.loaded-dirs (+ (time.monotonic) WAIT-LIMIT))))
      (= blockers (- (.keys _SHARED.running) _SHARED.hung))
      (if blockers
          (do (= remaining (- (sub target 1) (time.monotonic)))
              (if (> remaining 0)
                  (do (.wait _SHARED.condition remaining)
                      (continue)))
              ;; As in _drop-stale: the drop may fail an import a slow compile
              ;; has in progress, so its result must be compiled again.
              (.update _SHARED.hung blockers)
              (+= _SHARED.epoch 1)))
      (for name in (list _SHARED.names)
        (.pop sys.modules name None))
      (.clear _SHARED.names)
      (= _SHARED.loaded-dirs search-dirs)
      (break))
    (finally
      (if switching
          (do (-= _SHARED.switching 1)
              (.notify-all _SHARED.condition)))))
  (= (sub _SHARED.running token) search-dirs))

(deco contextlib.contextmanager
  (def fresh-modules [:search-dirs (,)]
    "Wrap one compile whose top-level imports search search-dirs (a tuple)
     before sys.path (_SearchDirsFinder), on this thread only: first drop
     every tracked module once one is stale or was imported under other
     search dirs (_enter, waiting), then track every .py or .lpy source the
     compile reads (_trackable-p) by the stamp its file had when read, the
     trackable files in each such .lpy's cache record (_track-record),
     every trackable directory searched for a module no finder found by its
     mtime, and every namespace package it imports by its directories
     (_recording-namespace-exec).  Yields the epoch the compile runs under."
    (= search-dirs (tuple search-dirs))
    (= reads [])
    (= token (object))
    (with [_SHARED.condition]
      (_enter token search-dirs)
      (= current _SHARED.epoch))
    (= reset (.set _SHARED.search-dirs search-dirs))
    (try
      (.append (_windows) reads)
      (yield current)
      (finally
        (.reset _SHARED.search-dirs reset)
        (= windows (_windows))
        (if (and windows (is (sub windows -1) reads))
            (.pop windows))
        (with [_SHARED.condition]
          (try
            (= added False)
            (for [name path stamp] in reads
              (cond
                (is name None)
                (do (= directory (osp.realpath path))
                    (if (_trackable-path-p directory)
                        (.setdefault _SHARED.dirs directory stamp)))

                (is path None)
                (if (not (_lispy-module-p name))
                    (do (.add _SHARED.names name)
                        (= added True)))

                (_trackable-p name path)
                (do (.setdefault _SHARED.files path stamp)
                    (.add _SHARED.names name)
                    (= added True)
                    (if (and (is-not stamp None) (.endswith path ".lpy"))
                        (_track-record path)))))
            ;; Only a hung compile can end under other dirs than the loaded
            ;; ones: its modules are mixed in, so the next compile drops them.
            (if (and added (!= search-dirs _SHARED.loaded-dirs))
                (= _SHARED.loaded-dirs None))
            (finally
              (.pop _SHARED.running token None)
              (.discard _SHARED.hung token)
              (.notify-all _SHARED.condition))))))))

(def epoch []
  "The macro environment's version, never waiting: it moves whenever the
   tracked modules are dropped as stale (which this does first when one is
   and no compile, less the hung ones, runs) and whenever a search-dirs
   switch dropped them under a hung compile (_enter).  None while such a drop is
   due but compiles run: every view or shadow made before is stale then.  A
   view or shadow made under one epoch is stale under another."
  (with [_SHARED.condition]
    (if (_drop-stale False)
        (return _SHARED.epoch))
    (return None)))

(def epoch-and-target []
  "(now, target) read under one hold of the shared lock: now, epoch's
   answer; target, the least epoch a compile starting from now runs under:
   now, or the counter + 1 while a drop is due.  Read apart, a drop landing
   between the two reads would give a target no compile ever reaches."
  (with [_SHARED.condition]
    (if (_drop-stale False)
        (return (, _SHARED.epoch _SHARED.epoch)))
    (return (, None (+ _SHARED.epoch 1)))))

(def current-epoch []
  "The epoch counter as it is, with no staleness check: the version of a
   result no macro took part in (a parse error)."
  (with [_SHARED.condition]
    (return _SHARED.epoch)))
