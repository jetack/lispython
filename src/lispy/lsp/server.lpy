(require lispy.macros *)

(import asyncio)
(import builtins)
(import contextvars)
(import functools)
(import glob)
(import inspect)
(import logging)
(import os)
(import os.path as osp)
(import re)
(import pathlib)
(import threading)

(from lsprotocol [types as lsp])
(from pygls.lsp.server [LanguageServer])
(from pygls.uris [to-fs-path])
(from pygls.workspace [PositionCodec TextDocument])

(from lispy.core.nodes *)
(from lispy.core.errors [compile-errors LispyCompileError])
(from lispy.core.macro [prelude-opted-out])
(from lispy.core.parser [parse tokenize])
(from lispy.core.compiler.stmt [import-bindings type-alias-p])
(from lispy.core.meta-functions [require-selection REQUIRE-QUALIFIED REQUIRE-ALL])
;; Hover, signature help and completion read the form docs from their one
;; home, which the docs site reads too.
(from lispy.form-docs [BINDABLE-FORMS BUILTIN-MACROS BUILTIN-MACRO-MODULES MACRO-TAG
                       OWN-NAME-TAGS OWN-TAG-KINDS SPECIAL-FORM-DOCS
                       TYPE-ALIAS-DOC hover-markdown])
(from lispy.lsp.python-view [COMPILE-STAGE DEFAULT-PYREFLY-PRESET PARSE-STAGE
                             ViewCache compile-buffer glued-base hyphen-spelling
                             lpy-diagnostic-range lpy-range module-names name-key
                             name-spelling-p open-form-closers partial-span py-name
                             pyrefly-fallback source-lines source-prefix
                             spelled-in suppression-comments view-at-cursor])
(from lispy.lsp.backend [Backends REQUEST-TIMEOUT suppression-tool])
;; Read through the module, so WAIT-LIMIT and epoch are looked up at each use.
(import lispy.lsp.macro-modules as macro-modules)

(= logger (logging.getLogger __name__))

;; ---------------------------------------------------------------------------
;; Server instance
;; ---------------------------------------------------------------------------

(= server (LanguageServer "lpy-lsp" "v0.1.0"))

;; ---------------------------------------------------------------------------
;; Python builtins introspection
;; ---------------------------------------------------------------------------

(def builtin-p [name]
  "Whether name, a Python name, is a public builtin function or class."
  (if (.startswith name "_")
      (return False))
  (= obj (getattr builtins name None))
  (return (or (isinstance obj type) (callable obj))))

;; Read one name at a time, on a hover or signature help only: inspecting
;; every builtin up front costs the server's start, and completion needs
;; only the names (builtin-names).
(def builtin-info [name]
  "(signature, doc) of the builtin whose Python name is name, or None when
   it is no builtin-p: the signature as name(params) (the bare name when
   inspect cannot read one) and the first paragraph of its docstring
   (empty when it has none).  The test comes before the cache
   (inspect-builtin), so every name hovered does not stay in it."
  (if (not (builtin-p name))
      (return None))
  (return (inspect-builtin name)))

(deco functools.cache
(def inspect-builtin [name]
  "builtin-info of name, a builtin-p name."
  (= obj (getattr builtins name))
  (try
    (= signature f"{name}{(inspect.signature obj)}")
    (except [(, ValueError TypeError)]
      (= signature name)))
  (= doc (inspect.getdoc obj))
  (return (, signature (ife doc (sub (.split doc "\n\n") 0) "")))))

(deco functools.cache
(def builtin-names []
  "(name, CompletionItemKind) of every builtin-p name, in dir order: Class
   for a class, else Function."
  (return (tuple [(, name (ife (isinstance (getattr builtins name) type)
                               lsp.CompletionItemKind.Class
                               lsp.CompletionItemKind.Function))
                  for name in (dir builtins) if (builtin-p name)]))))

;; ---------------------------------------------------------------------------
;; Workspace index
;; ---------------------------------------------------------------------------

;; Global index: {symbol_name: [Location, ...]} across all .lpy files
(= WORKSPACE-INDEX {})
;; Cache of parsed trees per URI: {uri: tree}
(= FILE-TREES {})
;; workspace/symbol results per URI: {uri: [SymbolInformation, ...]}
(= WORKSPACE-SYMBOLS {})

(def uri-to-path [uri]
  "Convert a file:// URI to a filesystem path."
  (if (.startswith uri "file://")
      (return (sub uri [: 7 None]))
      (return uri)))

(def path-to-uri [path]
  "Convert a filesystem path to a file:// URI."
  (return (.as-uri (pathlib.Path path))))

(def under-workspace [path folders]
  "True when path lies inside one of the workspace folders.  Real paths are
   compared by components, not by string prefix, so /ws-other is not inside
   /ws and a symlink counts where its target lives."
  (= real (pathlib.Path (osp.realpath path)))
  (for folder in folders
    (if (.is-relative-to real (osp.realpath (uri-to-path folder.uri)))
        (return True)))
  (return False))

(def workspace-folders []
  "The client's workspace folders, read from the pygls workspace itself.
   It is the one record of them (pygls keeps it current through
   didChangeWorkspaceFolders), so nothing here copies the list; before
   initialize there is no workspace and so no folders."
  (try
    (return (list (.values server.workspace.folders)))
    (except [RuntimeError]
      ;; Not (return []): an empty bracket compiles to a bare return.
      (return (list)))))

;; The Python backend of each workspace project (lispy.lsp.backend).  Its
;; document hooks never raise; only an open starts a backend, and only when
;; its diagnostics are forwarded.
(= backends (Backends workspace-folders))

(def index-required-modules [tree]
  "Find all (require module-name ...) forms in tree and index those packages."
  (for node in tree
    (if (and (isinstance node Paren)
             (> (len node) 1)
             (isinstance node.op Symbol)
             (== node.op.value "require")
             (isinstance (sub node 1) Symbol))
        (do (= module-name (. (sub node 1) value))
            (index-installed-package module-name)))))

(def index-file [uri]
  "Parse a .lpy file and add its definitions to the workspace index.
   Removes old entries for this URI before re-indexing.  Only a file inside
   a workspace folder publishes workspace/symbol results: a dependency
   indexed so that go-to-definition can reach it is not the user's code and
   would flood the symbol search.  Membership is decided here from the
   file's path, never by the caller, so every route to index-file (startup
   scan, didOpen/didSave, a require, go-to-definition) agrees about a file."
  ;; Remove old entries for this URI
  (= to-remove [])
  (for [name locs] in (.items WORKSPACE-INDEX)
    (= (sub WORKSPACE-INDEX name)
       [loc for loc in locs if (!= loc.uri uri)])
    (if (== (len (sub WORKSPACE-INDEX name)) 0)
        (.append to-remove name)))
  (for name in to-remove
    (del (sub WORKSPACE-INDEX name)))
  (.pop WORKSPACE-SYMBOLS uri None)

  ;; Parse and collect definitions
  (= fpath (uri-to-path uri))
  (if (not (osp.isfile fpath))
      (return))
  (try
    (with [(open fpath "rb") as f]
      (= src (.decode (f.read) "utf-8")))
    (= tree (parse src :partial True))
    (= (sub FILE-TREES uri) tree)
    (= workspace-file (under-workspace fpath (workspace-folders)))
    (= symbols (ife workspace-file [] None))
    (collect-definitions tree uri :defs WORKSPACE-INDEX :symbols symbols)
    (if workspace-file
        (= (sub WORKSPACE-SYMBOLS uri) symbols))
    ;; Also eagerly index any packages this file requires so defmacros
    ;; from required modules are discoverable for go-to-definition.
    (index-required-modules tree)
    (except [Exception as exc]
      (logger.debug f"Failed to index {fpath}: {exc}"))))

(def index-workspace [workspace-folders]
  "Scan all .lpy files in workspace folders and index them."
  (for folder in workspace-folders
    (= root (uri-to-path folder.uri))
    (for fpath in (glob.glob (osp.join root "**" "*.lpy") :recursive True)
      (index-file (path-to-uri fpath))))
  (logger.info f"Indexed {(len WORKSPACE-INDEX)} symbols from workspace"))

(def resolve-module-to-file [module-name workspace-folders]
  "Resolve a LisPython module name to a .lpy file path.
   e.g., 'lispy.tools' -> '/path/to/src/lispy/tools.lpy'"
  (= parts (.split (.replace module-name "-" "_") "."))
  (= rel-path (+ (osp.join *parts) ".lpy"))
  ;; 1. Workspace folders (direct or in src/)
  (for folder in workspace-folders
    (= root (uri-to-path folder.uri))
    (= candidate (osp.join root rel-path))
    (if (osp.isfile candidate)
        (return candidate))
    (= candidate (osp.join root "src" rel-path))
    (if (osp.isfile candidate)
        (return candidate)))
  ;; 2. Python's sys.path (finds installed packages, including lispython itself)
  (try
    (do (import importlib.util)
        (= spec (importlib.util.find-spec (.replace module-name "-" "_")))
        (if (and spec spec.origin (.endswith spec.origin ".lpy"))
            (return spec.origin))
        ;; Package without __init__.lpy but has submodule files
        (if (and spec spec.submodule-search-locations)
            (for search-path in spec.submodule-search-locations
              (= candidate (osp.join search-path "init.lpy"))
              (if (osp.isfile candidate)
                  (return candidate)))))
    (except [Exception]
      (pass)))
  (return None))

(def index-installed-package [module-name]
  "Index all .lpy files in an installed Python package (e.g., lispython).
   Used to make defmacros in required modules discoverable."
  (try
    (do (import importlib.util)
        (= spec (importlib.util.find-spec (.replace module-name "-" "_")))
        (if (and spec spec.submodule-search-locations)
            (for search-path in spec.submodule-search-locations
              (for fpath in (glob.glob (osp.join search-path "**" "*.lpy") :recursive True)
                (index-file (path-to-uri fpath))))))
    (except [Exception]
      (pass))))

(= FROM-HEADS (, "from" "lazy-from"))
(= IMPORT-ONLY-HEADS (, "import" "lazy-import"))
(= IMPORT-HEADS (+ IMPORT-ONLY-HEADS FROM-HEADS))

(def find-import-target [node workspace-folders]
  "Given an import/from/require node, resolve where the imported name is defined."
  (= form (. node op value))
  (cond
    (in form FROM-HEADS)
    (do ;; (from module [names...])
        (if (< (len node) 3)
            (return None))
        (= module-name (. (sub node 1) value))
        (= fpath (resolve-module-to-file module-name workspace-folders))
        (if fpath
            (return fpath))
        (return None))

    (in form IMPORT-ONLY-HEADS)
    (do ;; (import module)
        (if (< (len node) 2)
            (return None))
        (= module-name (. (sub node 1) value))
        (= fpath (resolve-module-to-file module-name workspace-folders))
        (if fpath
            (return fpath))
        (return None))

    (== form "require")
    (do ;; (require module *)
        (if (< (len node) 2)
            (return None))
        (= module-name (. (sub node 1) value))
        (= fpath (resolve-module-to-file module-name workspace-folders))
        (if fpath
            (return fpath))
        (return None))

    (return None)))

(def buffer-import-bindings [node]
  "The [name symbol] pairs an import form binds, by the compiler's own rule
   (import-bindings). The buffer may be mid-edit: a form the compiler would
   reject binds nothing rather than raising."
  (try
    (return (import-bindings node))
    (except [LispyCompileError]
      (return []))))

(def require-registered-name [node name]
  "The name, in the required module, of the macro a (require ...) node
   registers as `name`, or None when it registers no such name. The
   compiler's own rule (require-selection) decides; the buffer may be
   mid-edit, so a require the compiler would reject registers nothing."
  (try
    (= [kind names] (require-selection (sub node.list [: 2 None])))
    (except [(, TypeError ValueError)]
      (return None)))
  (cond
    ;; (require module): macros are registered as module.name
    (== kind REQUIRE-QUALIFIED)
    (do (= prefix (ife (> (len node) 1) (+ (str (sub node 1)) ".") None))
        (if (and prefix (.startswith name prefix))
            (return (sub name [: (len prefix) None]))))
    ;; (require module *): every macro, names unknown without importing
    (== kind REQUIRE-ALL)
    (return name)
    ;; (require module [a b]): exactly those; [] imports nothing
    (in name names)
    (return name))
  (return None))

(def find-import-for-name [tree name]
  "Find the import/from/require node that imports a given name."
  (for node in tree
    (if (not (isinstance node Paren))
        (continue))
    (if (== (len node) 0)
        (continue))
    (= form (ife (isinstance node.op Symbol) node.op.value ""))
    (cond
      (in form IMPORT-HEADS)
      (for [bound _] in (buffer-import-bindings node)
        (if (== bound name)
            (return node)))
      (and (== form "require")
           (is-not (require-registered-name node name) None))
      (return node)))
  (return None))

(def builtin-macro-name-p [name]
  "Whether `name` could be a built-in macro in some buffer: its last dotted
   part (a qualified (require module) call is module.name) is one. A cheap
   test to make before parsing the buffer for builtin-macro-doc."
  (return (in (sub (.rpartition name ".") 2) BUILTIN-MACROS)))

(def builtin-macro-doc [tree name :view None]
  "The hover markdown of the built-in macro `name` refers to in the buffer
   tree, or None.  With view, the buffer's full PythonView, its compile
   decides (view.builtin-macros): a name the buffer's defmacro or another
   module's require took is not the built-in.  Without one the syntax
   scan decides: the prelude, unless the buffer opts out of it
   (prelude-opted-out), plus whatever its requires of the built-in macro
   modules register.  The opt-out is itself such a require, so the scan
   gives exactly its selection; a name the buffer has no macro for (`fn`
   after the opt-out (require lispy.macros [when])) is then just a name."
  (if (is-not view None)
      (do (= macro (.get view.builtin-macros (name-key name)))
          (return (ife (in macro BUILTIN-MACROS)
                       (hover-markdown (sub BUILTIN-MACROS macro))
                       None))))
  (if (and (in name BUILTIN-MACROS) (not (prelude-opted-out tree)))
      (return (hover-markdown (sub BUILTIN-MACROS name))))
  (for node in tree
    (if (and (isinstance node Paren)
             (> (len node) 1)
             (isinstance node.op Symbol)
             (== node.op.value "require")
             (in (str (sub node 1)) BUILTIN-MACRO-MODULES))
        (do (= macro (require-registered-name node name))
            (if (in macro BUILTIN-MACROS)
                (return (hover-markdown (sub BUILTIN-MACROS macro)))))))
  (return None))

;; ---------------------------------------------------------------------------
;; Helpers
;; ---------------------------------------------------------------------------

(def make-position [line char]
  (return (lsp.Position :line line :character char)))

(def make-range [start-line start-char end-line end-char]
  (return (lsp.Range
    :start (make-position start-line start-char)
    :end (make-position end-line end-char))))

(def node-range [node]
  "Convert a LisPython AST node's position info to an LSP Range.
   The parser uses 1-based line numbers; LSP uses 0-based."
  (return (make-range
    (- node.lineno 1)
    node.col_offset
    (- node.end_lineno 1)
    node.end_col_offset)))

(def extract-error-position [exc src]
  "Best-effort extraction of line/col from a parse or compile error."
  ;; Some Python exceptions carry lineno/offset
  (= lineno (getattr exc "lineno" None))
  (if (is-not lineno None)
      (do (= col (- (or (getattr exc "offset" None) 1) 1))
          (return (, (- lineno 1) col (- lineno 1) col))))
  ;; Try to extract from the message
  (= msg (str exc))
  (= m (re.search "line\\s+(\\d+)" msg re.IGNORECASE))
  (if m
      (do (= line (- (int (.group m 1)) 1))
          (= col 0)
          (= mc (re.search "col(?:umn)?\\s+(\\d+)" msg re.IGNORECASE))
          (if mc
              (= col (int (.group mc 1))))
          (return (, line col line col))))
  (return None))

;; ---------------------------------------------------------------------------
;; Compiles that may never return
;; ---------------------------------------------------------------------------

;; A compile runs the user's macros, which may never return (a macro looping
;; forever).  Run in the loop's default executor, a few such compiles would
;; park every worker, stalling each later asyncio.to-thread of the server;
;; a thread of its own parks only itself.
(class OwnThread []
  "A call running in a thread of its own (in-own-thread): future, an
   asyncio future of its outcome; ended, set once the call returned or
   raised, whatever became of future; parked, whether it was given up on
   while running (_park)."
  (def __init__ [self future]
    (= self.future future)
    (= self.ended False)
    (= self.parked False)))

(def in-own-thread [func *args]
  "An OwnThread of func(*args), run in a new daemon thread of its own in a
   copy of the caller's context.  Its future is settled from the thread
   only while it is not done (its waiter may have cancelled it), so a late
   result or exception is dropped; func's exception becomes the future's,
   and a BaseException that is no Exception (a macro's sys.exit) a
   RuntimeError caused by it, so the caller's except Exception takes it
   rather than the loop stopping; a loop closed meanwhile is ignored."
  (= loop (asyncio.get-running-loop))
  (= future (.create-future loop))
  (= thread (OwnThread future))
  (= context (contextvars.copy-context))
  (def settle [result error]
    (cond (.done future)
          (return)
          (is error None)
          (.set-result future result)
          True
          (.set-exception future error)))
  (def run []
    (= outcome (, None None))
    (try
      (= outcome (, (.run context func *args) None))
      (except [Exception as e]
        (= outcome (, None e)))
      (except [BaseException as e]
        (= wrapped (RuntimeError f"the compile raised {(. (type e) __name__)}: {e!r}"))
        (= wrapped.__cause__ e)
        (= outcome (, None wrapped)))
      (finally
        (_thread-ended thread)))
    (try
      (.call-soon-threadsafe loop settle *outcome)
      (except [RuntimeError]
        (pass))))
  (.start (threading.Thread :target run :daemon True :name "lpy-compile"))
  (return thread))

;; The most given-up compiles whose threads still run, for the process: each
;; is a thread spinning in a macro, so past this many a compile is waited
;; for again rather than given up on.
(= MAX-PARKED-COMPILES 4)

(class _ParkedCompiles []
  "count, the given-up compiles whose threads still run; warned, whether
   the cap's error was logged since the count last fell; lock, guarding
   both and every OwnThread's ended and parked."
  (def __init__ [self]
    (= self.count 0)
    (= self.warned False)
    (= self.lock (threading.Lock))))

(= PARKED-COMPILES (_ParkedCompiles))

(def _park [thread]
  "Count thread's compile given up on, while its call still runs and fewer
   than MAX-PARKED-COMPILES are; whether it was."
  (with [PARKED-COMPILES.lock]
    (if (or thread.ended (>= PARKED-COMPILES.count MAX-PARKED-COMPILES))
        (return False))
    (+= PARKED-COMPILES.count 1)
    (= thread.parked True)
    (return True)))

(def _thread-ended [thread]
  "thread's call returned or raised (in its own thread): a parked one no
   longer counts."
  (with [PARKED-COMPILES.lock]
    (= thread.ended True)
    (if thread.parked
        (do (-= PARKED-COMPILES.count 1)
            (= PARKED-COMPILES.warned False)))))

(def _cap-warning-due [thread]
  "Whether thread's compile, still running, is held at the cap with no
   error logged since the count last fell; marks it logged."
  (with [PARKED-COMPILES.lock]
    (if (or thread.ended PARKED-COMPILES.warned)
        (return False))
    (= PARKED-COMPILES.warned True)
    (return True)))

;; What compile-or-give-up returns for a compile it stopped waiting for.
(= GAVE-UP (object))

(async-def compile-or-give-up [thread superseded started]
  "The result of thread's compile (an OwnThread), raising its exception;
   or GAVE-UP once superseded (an asyncio.Event: a newer version of the
   document, or its close, came) is set and the compile has run
   macro_modules.WAIT-LIMIT seconds since started (the loop's clock), while
   fewer than MAX-PARKED-COMPILES given-up compiles still run.  At the cap
   it waits on, trying again every WAIT-LIMIT, and logs one error per
   reaching the cap.  Giving up, or being cancelled, cancels the future, so
   the compile's late outcome is dropped."
  ;; A given-up compile's thread keeps running (a parked thread per hung
  ;; macro, capped); its fresh-modules token is marked hung by the next
  ;; drop's wait (macro_modules), so it holds up no later drop either.  The
  ;; same WAIT-LIMIT: past it a compile counts as hung for both.
  (= future thread.future)
  (= loop (asyncio.get-running-loop))
  (= waiter (asyncio.ensure-future (.wait superseded)))
  (try
    (await (asyncio.wait [future waiter] :return-when asyncio.FIRST-COMPLETED))
    (= wait (max 0 (- (+ started macro-modules.WAIT-LIMIT) (.time loop))))
    (while (not (.done future))
      (await (asyncio.wait [future] :timeout wait))
      (if (.done future)
          (break))
      (if (_park thread)
          (do (.cancel future)
              (return GAVE-UP)))
      (if (_cap-warning-due thread)
          (.error logger (+ "lispython LSP: %s compiles were given up on and still run: "
                            "a macro does not return.  Restart the language server.")
                  MAX-PARKED-COMPILES))
      (= wait macro-modules.WAIT-LIMIT))
    (return (.result future))
    (except [asyncio.CancelledError]
      (if (and (not (.cancel future)) (not (.cancelled future)))
          (.exception future))
      (raise))
    (finally
      (.cancel waiter))))

;; ---------------------------------------------------------------------------
;; Diagnostics
;; ---------------------------------------------------------------------------

(def compile-document [uri version source :generation None :fresh False]
  "The CompiledBuffer of document uri's source (python_view.compile-buffer),
   named as Python imports its file (module-names) so the prelude, its
   opt-out and the macros it defines apply as when the module compiles,
   with its import root on sys.path, and its parse warnings naming the
   file.  One compile per version (view-cache): a change's diagnostics,
   its backend push and every request on that version share it; fresh
   compiles again all the same and caches the result.  It runs
   the buffer's macros, so callers on the loop run it in a thread, reading
   view-cache's generation before the hand-off."
  (= path (to-fs-path uri))
  (= [name package import-root] (ife (is path None)
                                     (, "__main__" "" None)
                                     (module-names path)))
  (if (is version None)
      (return (compile-buffer source :package package :name name :import-root import-root
                              :filename (uri-to-path uri))))
  (return (.compiled view-cache uri version source :package package :name name
                     :import-root import-root :filename (uri-to-path uri)
                     :generation generation :fresh fresh)))

(def error-diagnostic [exc source severity message]
  (= pos (extract-error-position exc source))
  (if (is pos None)
      (= pos (, 0 0 0 0)))
  (return (lsp.Diagnostic :range (make-range *pos) :severity severity :source "lpy-lsp"
                          :message message)))

(def compute-diagnostics [source uri :compiled None]
  "lispython's own diagnostics of source, document uri's text: its parse
   error, an Error, or its compile error, a Warning, since macro expansion
   depends on the runtime environment (imports must resolve); a module the
   compile cannot import is none.  compiled is source's CompiledBuffer
   (compile-document), compiled here when None."
  (if (is compiled None)
      (= compiled (compile-document uri None source)))
  (= exc compiled.error)
  (cond (== compiled.stage PARSE-STAGE)
        (return [(error-diagnostic exc source lsp.DiagnosticSeverity.Error
                                   f"Parse error: {exc}")])
        (and (== compiled.stage COMPILE-STAGE) (not (isinstance exc ModuleNotFoundError)))
        (return [(error-diagnostic exc source lsp.DiagnosticSeverity.Warning
                                   f"Compile warning: {exc}")]))
  (return (list)))

;; Seconds a change's diagnostics wait for the backend's, once its view
;; reached a running backend: past it lispython's own are published alone,
;; and the backend's republish the set when they come.
(= DIAGNOSTICS-TIMEOUT 2)

(class DiagnosticRun []
  "The diagnostics of one change of a document: ls, the server to publish
   through; doc, a snapshot of the document (document-snapshot); recompile,
   whether its compile bypasses the view cache (a save); then, once
   compiled (compiled), lispy, lispython's own diagnostics, and view, the
   buffer's full PythonView or None; epoch, the macro environment its
   compile ran under (CompiledBuffer.epoch), None until its compile
   returned, and for good when the compile raised or was given up on.
   superseded is set once a newer change or a close replaced the run
   (_supersede), so its compile may be given up on (compile-or-give-up).
   arrived is set while the run waits for the backend's diagnostics;
   published counts its publishes, so an older one finishing last never
   replaces a newer; ignores memoises the buffer's suppression-comments of
   the backend's tool for every publish of the run.  refresh: the run was
   started by refresh-outdated or finish-run, so it starts no refresh
   itself.  rerun: the refresh target (_REFRESH-TARGET) finish-run started
   it for, a compile having missed that target; None when it is no rerun.
   It is rerun again only for a greater target."
  (def __init__ [self ls doc :recompile False :refresh False :rerun None]
    (= self.ls ls)
    (= self.doc doc)
    (= self.recompile recompile)
    (= self.refresh refresh)
    (= self.rerun rerun)
    (= self.compiled False)
    (= self.epoch None)
    (= self.superseded (asyncio.Event))
    (= self.lispy None)
    (= self.view None)
    (= self.arrived None)
    (= self.published 0)
    (= self.ignores None)))

;; uri -> the DiagnosticRun of the document's latest change, the only one
;; that may publish.
(= DIAGNOSTIC-RUNS {})
;; The uris whose compile-latest is running: at most one per document.
(= _COMPILING (set))
;; The runs' tasks, referenced while they run (the loop holds tasks only
;; weakly).
(= _DIAGNOSTIC-TASKS (set))

(def _supersede [run]
  "Run (or None) is replaced by a newer change or a close: its compile may
   be given up on, and its wait for the backend's diagnostics ends."
  (if (is run None)
      (return))
  (.set run.superseded)
  (if (is-not run.arrived None)
      (.set run.arrived)))

(def _current-p [run]
  (return (is (.get DIAGNOSTIC-RUNS run.doc.uri) run)))

(def _schedule-run [coroutine]
  (= task (asyncio.ensure-future coroutine))
  (.add _DIAGNOSTIC-TASKS task)
  (.add-done-callback task _DIAGNOSTIC-TASKS.discard)
  (.add-done-callback task _diagnostics-done))

(def _diagnostics-done [task]
  (if (and (not (.cancelled task)) (is-not (.exception task) None))
      (.error logger "lispython LSP: diagnostics failed" :exc-info (.exception task))))

(def publish-diagnostics [ls uri :opened False :recompile False :refresh False
                          :rerun None]
  "Publish document uri's diagnostics as it is now, from tasks of the loop
   (the handlers that call this are synchronous): the change becomes the
   document's latest run, which compile-latest compiles unless a newer
   change supersedes it first.  opened: the document was just opened,
   which starts its backend now (Backends.document-opened, never waiting),
   so a change before the open's compile cannot skip the start.
   recompile: compile again even at a cached version (a save: the macros
   may read what changed on disk).  refresh, rerun: DiagnosticRun's.  A
   run replaced before its compile began hands on its own: the new run
   recompiles if either does, and is a refresh run only if both are, so a
   refresh never drops a pending change's refresh or a save's recompile."
  (= doc (document-snapshot (.get-text-document ls.workspace uri)))
  (= prev (.get DIAGNOSTIC-RUNS uri))
  (if (and (is-not prev None) (not prev.compiled))
      (do (= recompile (or recompile prev.recompile))
          (= refresh (and refresh prev.refresh))))
  (= run (DiagnosticRun ls doc :recompile recompile :refresh refresh :rerun rerun))
  (_supersede prev)
  (= (sub DIAGNOSTIC-RUNS uri) run)
  (if opened
      (.document-opened backends uri))
  (if (not-in uri _COMPILING)
      (do (.add _COMPILING uri)
          (_schedule-run (compile-latest uri)))))

;; The project roots told of their pyrefly preset fallback, for this
;; server's life.
(= _PRESET-FALLBACK-NOTIFIED (set))

(def preset-fallback-message [root fallback]
  "The notice that project root's pyrefly diagnostics run
   DEFAULT-PYREFLY-PRESET, saying why (fallback, a PyreflyFallback)."
  (= preset f"pyrefly's \"{DEFAULT-PYREFLY-PRESET}\" preset")
  (cond (== fallback.reason "missing")
        (return (+ f"lispython: {root} has no pyrefly config, so its Python diagnostics "
                   f"use {preset}. To choose, add a [tool.pyrefly] table in pyproject.toml "
                   f"or a pyrefly.toml, e.g. preset = \"{DEFAULT-PYREFLY-PRESET}\"."))
        (== fallback.reason "malformed")
        (return (+ f"lispython: {fallback.source} could not be read as a pyrefly config "
                   "(the LSP log has the detail), so the Python diagnostics of "
                   f"{root} use {preset}.")))
  (return (+ f"lispython: pyrefly refused the settings in {fallback.source} "
             "(the LSP log has the detail), so the Python diagnostics of "
             f"{root} use {preset}.")))

(def notify-preset-fallback [client]
  "Tell the user once per project root, when backend client started
   (Backends' on-view-prepared), that its pyrefly diagnostics run
   DEFAULT-PYREFLY-PRESET, and why, as the config writer recorded it
   (pyrefly-fallback); also called when a save changed the view's config
   file.  A start with no fallback marks nothing, so a config that later
   breaks is told at the save that rewrites the view's config, or the next
   start.  Never raises."
  ;; A showMessage, once: the view's preset may differ from what pyrefly
  ;; check runs over the same project, and the user must learn which one is
  ;; in effect and how to choose; a logMessage alone sits unread in an
  ;; output channel.  Once per root, never per start or change, so it never
  ;; nags; and read from the writer's record (a dict lookup), so the
  ;; project config is neither parsed on the loop nor checked by pyrefly
  ;; twice.
  (try
    (if (or (!= client.name "pyrefly") (in client.project-root _PRESET-FALLBACK-NOTIFIED))
        (return))
    (= fallback (pyrefly-fallback client.view-root))
    (if (is fallback None)
        (return))
    (.add _PRESET-FALLBACK-NOTIFIED client.project-root)
    (= message (preset-fallback-message client.project-root fallback))
    (.info logger "%s" message)
    (.window-show-message server (lsp.ShowMessageParams :type lsp.MessageType.Info
                                                        :message message))
    (except [Exception]
      (.exception logger "lispython LSP: cannot tell of the pyrefly preset for %s"
                  client.project-root))))

(= backends.on-view-prepared notify-preset-fallback)

(def internal-error-diagnostics [exc]
  "lispython's diagnostics of a document whose compile-document raised exc:
   one Error at its start, so the editor drops the set of an older text."
  (return [(lsp.Diagnostic :range (make-range 0 0 0 0)
                           :severity lsp.DiagnosticSeverity.Error :source "lpy-lsp"
                           :message (+ f"Internal error: cannot compile this document: {exc}"
                                       " (the LSP log has the traceback)"))]))

(async-def compile-latest [uri]
  "Compile document uri's latest run (compile-document, in a thread of its
   own), and again while a newer change came during that compile: one
   compile in flight per document, and none for a change superseded before
   its compile began, since every compile runs the buffer's macros.  Each
   compiled run that is still the latest records its epoch and goes on in a
   task of its own (finish-run).  A compile superseded and running past
   macro_modules.WAIT-LIMIT is given up on (compile-or-give-up), so a macro
   that never returns stops holding up the document's later changes.  A
   compile that raises (an error outside compile-buffer's stages) is
   logged, and its run, while still the latest, publishes one internal
   error.  Either way the loop goes on, so a change recorded meanwhile is
   still compiled."
  (= loop (asyncio.get-running-loop))
  (try
    (while True
      (= run (.get DIAGNOSTIC-RUNS uri))
      (if (or (is run None) run.compiled)
          (break))
      (= run.compiled True)
      (= doc run.doc)
      (try
        ;; The generation is read here, on the loop, before the hand-off.
        (= work (functools.partial compile-document doc.uri doc.version doc.source
                                   :generation view-cache.generation
                                   :fresh run.recompile))
        (= compiled (await (compile-or-give-up (in-own-thread work) run.superseded
                                               (.time loop))))
        (except [Exception as e]
          (.exception logger "lispython LSP: cannot compile %s" uri)
          (if (_current-p run)
              (do (= run.lispy (internal-error-diagnostics e))
                  (= run.view None)
                  (_schedule-run (publish-run run))))
          (continue)))
      (if (is compiled GAVE-UP)
          (do (.warning logger "lispython LSP: gave up on the compile of %s version %s"
                        uri doc.version)
              (continue)))
      (if (_current-p run)
          (do (= run.epoch compiled.epoch)
              (_schedule-run (finish-run run compiled)))))
    (finally
      (.discard _COMPILING uri))))

(async-def finish-run [run compiled]
  "Turn run's compile into lispython's diagnostics, push its view to the
   backend, and publish them with the backend's for that view: waited for
   up to DIAGNOSTICS-TIMEOUT when the view reached a running backend,
   published at once otherwise.  Nothing is pushed or published once a
   newer change or a close superseded run, which may come between the
   compile and this task: a push then would reopen a closed document in
   the backend, or send it a stale view.  A run that is not a refresh then
   refreshes the other documents (refresh-outdated); a run still the latest
   whose compile ran under an older macro environment than the last
   refresh's target (_REFRESH-TARGET) publishes again, as a refresh run and
   a rerun for that target, unless it is a parse error or a rerun for that
   target already."
  (if (not (_current-p run))
      (return))
  (= doc run.doc)
  (= run.lispy (compute-diagnostics doc.source doc.uri :compiled compiled))
  (= run.view compiled.view)
  (if (and (is-not run.view None)
           (.document-changed backends doc.uri doc.source run.view))
      (await (wait-backend-diagnostics run)))
  (await (publish-run run))
  (if (not run.refresh)
      (await (refresh-outdated run.ls doc.uri compiled)))
  ;; A refresh skips a document whose run is compiling (it has no epoch
  ;; yet), so that run may have published a compile from before the
  ;; environment the refresh brought the documents to, and would stay
  ;; stale: it runs once more, for that target.  A rerun's own compile can
  ;; miss a later refresh the same way (it ran past a second drop), so it
  ;; reruns for a greater target.  The target may never be reached (no
  ;; drop happens while a hung compile blocks it, or the staleness
  ;; vanishes), so termination rests on no epoch: a parse error ran no
  ;; macro and is never rerun, and each rerun of a chain needs a target
  ;; greater than its own (DiagnosticRun.rerun), which only a refresh
  ;; sets, so a chain ends with the refreshes.
  (if (and (_current-p run) (!= compiled.stage PARSE-STAGE)
           (is-not compiled.epoch None)
           (is-not _REFRESH-TARGET None) (< compiled.epoch _REFRESH-TARGET)
           (or (is run.rerun None) (> _REFRESH-TARGET run.rerun)))
      (publish-diagnostics run.ls doc.uri :refresh True :rerun _REFRESH-TARGET)))

;; The epoch of the compile that last started a refresh (refresh-outdated):
;; a run under no newer one starts none.
(= _REFRESHED-EPOCH None)
;; The macro environment the last refresh brought the open documents to
;; (refresh-epochs' target), the greatest so far.
(= _REFRESH-TARGET None)

(def refresh-epochs []
  "(now, target) of the macro environment (macro_modules.epoch-and-target,
   read under one hold of its lock).  It stats the tracked files, so
   callers on the loop run it in a thread."
  (return (macro-modules.epoch-and-target)))

(async-def refresh-outdated [ls uri compiled]
  "Run when a diagnostic run of document uri published a compile under a
   newer macro environment than the open documents were refreshed for:
   publish again every other open document whose latest run published a
   compile under another one than now (refresh-epochs; every run with an
   epoch while a drop is due), so an edit to a macro module reaches the
   documents requiring it.  A run with no epoch (not compiled yet,
   compiling, or its compile raised or was given up on) is left alone: a
   compiling one reruns once it finished under an older environment than
   this refresh's target (finish-run; a rerun only for a target newer than
   its own), and one whose compile always raises is not compiled again
   every round.  Any run can see the new epoch first, not only a save's,
   because a newer change can supersede the save's run.  The runs it
   starts are refresh runs, which never refresh: a macro that rewrites a
   file it imports moves the epoch on every compile, so a refreshed run
   refreshing again would never end.  The runs are read after the epoch,
   so a document closed meanwhile is skipped: publishing it would reopen
   it.  The refresh's target environment becomes _REFRESH-TARGET, which a
   run compiling meanwhile is checked against (finish-run)."
  (global _REFRESHED-EPOCH _REFRESH-TARGET)
  ;; The maximum: a slow run finishing under an older epoch moves nothing.
  (if (or (is compiled.epoch None)
          (and (is-not _REFRESHED-EPOCH None) (<= compiled.epoch _REFRESHED-EPOCH)))
      (return))
  (= _REFRESHED-EPOCH compiled.epoch)
  (= [now target] (await (asyncio.to-thread refresh-epochs)))
  (if (or (is _REFRESH-TARGET None) (> target _REFRESH-TARGET))
      (= _REFRESH-TARGET target))
  (for [other run] in (list (.items DIAGNOSTIC-RUNS))
    (if (and (!= other uri) (is-not run.epoch None)
             (or (is now None) (!= run.epoch now)))
        (try
          (publish-diagnostics ls other :refresh True)
          (except [Exception]
            (.exception logger "lispython LSP: cannot refresh %s" other))))))

(async-def wait-backend-diagnostics [run]
  "Wait until the backend's diagnostics for run's view are known, at most
   DIAGNOSTICS-TIMEOUT, and no longer once a newer change superseded run."
  (= deadline (+ (.time (asyncio.get-running-loop)) DIAGNOSTICS-TIMEOUT))
  (= run.arrived (asyncio.Event))
  (try
    (while (and (_current-p run)
                (is (.backend-diagnostics backends run.doc.uri run.view.text) None))
      (.clear run.arrived)
      (if (not (await (within deadline (.wait run.arrived) False)))
          (break)))
    (finally
      (= run.arrived None))))

(def backend-diagnostics-arrived [uri]
  "The backend published diagnostics for document uri (Backends'
   on-diagnostics): the latest run waiting for them takes them, else one
   already published publishes again, so a set that came late, or after a
   start or a change elsewhere in the project, reaches the editor."
  (= run (.get DIAGNOSTIC-RUNS uri))
  (cond (is run None)
        (return)
        (is-not run.arrived None)
        (.set run.arrived)
        (> run.published 0)
        (_schedule-run (publish-run run))))

(= backends.on-diagnostics backend-diagnostics-arrived)

(async-def publish-run [run]
  "Publish run's diagnostics if it is still its document's latest: lispython's
   own, and the backend's only when the buffer made a view (a parse or
   compile error wins: the backend's last set is for another text) and they
   were published for that view's text (mapped-backend-diagnostics)."
  (+= run.published 1)
  (= number run.published)
  (= diagnostics (list run.lispy))
  (if (is-not run.view None)
      (.extend diagnostics (await (mapped-backend-diagnostics run))))
  (if (and (_current-p run) (== run.published number))
      (.text-document-publish-diagnostics run.ls
        (lsp.PublishDiagnosticsParams :uri run.doc.uri :diagnostics diagnostics))))

(def forget-diagnostics [ls uri]
  "Document uri closed: no run of it publishes any more, and its
   diagnostics are cleared, so the backend's do not linger in the editor."
  (_supersede (.pop DIAGNOSTIC-RUNS uri None))
  (.text-document-publish-diagnostics ls
    (lsp.PublishDiagnosticsParams :uri uri :diagnostics (list))))

;; ---------------------------------------------------------------------------
;; Document symbols
;; ---------------------------------------------------------------------------

(def def-name-symbol [node]
  "The Symbol naming a def/class: the node itself, or the head of f[T]."
  (cond (isinstance node Symbol)
        (return node)
        (isinstance node GluedHead)
        (return node.head)
        True
        (return None)))

(def symbol-name [node]
  "Extract a string name from a node."
  (cond (isinstance node Symbol)
        (return node.value)
        (isinstance node GluedHead)
        (return (symbol-name node.head))
        (isinstance node Annotation)
        (return (symbol-name node.value))
        (isinstance node String)
        (return (.strip node.value "\"'"))
        (return (str node))))

(= _DEFINITION-KINDS
   {"def" lsp.SymbolKind.Function
    "async-def" lsp.SymbolKind.Function
    ;; SymbolKind has no macro kind, and Operator would misdescribe a named
    ;; form, so a macro is a Function.
    "defmacro" lsp.SymbolKind.Function
    "class" lsp.SymbolKind.Class
    ;; A (type NAME ...) alias; callers check type-alias-p first, since a
    ;; call to the builtin type is not a definition.
    "type" lsp.SymbolKind.Class
    "=" lsp.SymbolKind.Variable})

(def definition-kind [form]
  "The SymbolKind of a definition form (def, async-def, defmacro, class, type, =),
   or None.  Document symbols and workspace/symbol both report it."
  (return (.get _DEFINITION-KINDS form)))

(def walk-symbols [nodes]
  "Walk top-level parsed forms and produce DocumentSymbol entries."
  (= symbols [])
  (for node in nodes
    (if (or (not (isinstance node Paren)) (== (len node) 0))
        (continue))
    (= op node.op)
    (if (not (isinstance op Symbol))
        (continue))
    (= form op.value)

    (cond
      (in form (, "def" "async-def"))
      (do (if (< (len node) 2) (continue))
          (= name (symbol-name (sub node 1)))
          (= rng (node-range node))
          (= sel (node-range (sub node 1)))
          (= children (ife (> (len node) 3)
                           (walk-symbols (sub node.list [: 3 None]))
                           []))
          (.append symbols
            (lsp.DocumentSymbol
              :name name
              :kind (definition-kind form)
              :range rng
              :selection-range sel
              :children (or children None))))

      (== form "class")
      (do (if (< (len node) 2) (continue))
          (= name (symbol-name (sub node 1)))
          (= rng (node-range node))
          (= sel (node-range (sub node 1)))
          (= body-nodes (ife (> (len node) 3)
                             (sub node.list [: 3 None])
                             (sub node.list [: 2 None])))
          (= children (walk-symbols body-nodes))
          (.append symbols
            (lsp.DocumentSymbol
              :name name
              :kind (definition-kind form)
              :range rng
              :selection-range sel
              :children (or children None))))

      (and (== form "type") (type-alias-p node))
      (.append symbols
        (lsp.DocumentSymbol
          :name (symbol-name (sub node 1))
          :kind (definition-kind form)
          :range (node-range node)
          :selection-range (node-range (sub node 1))
          :detail "type alias"))

      (== form "defmacro")
      (do (if (< (len node) 2) (continue))
          (.append symbols
            (lsp.DocumentSymbol
              :name (symbol-name (sub node 1))
              :kind (definition-kind form)
              :range (node-range node)
              :selection-range (node-range (sub node 1))
              :detail "macro")))

      (== form "=")
      (do (if (< (len node) 2) (continue))
          (.append symbols
            (lsp.DocumentSymbol
              :name (symbol-name (sub node 1))
              :kind (definition-kind form)
              :range (node-range node)
              :selection-range (node-range (sub node 1)))))

      (in form IMPORT-HEADS)
      (do (if (< (len node) 2) (continue))
          (.append symbols
            (lsp.DocumentSymbol
              :name (symbol-name (sub node 1))
              :kind lsp.SymbolKind.Module
              :range (node-range node)
              :selection-range (node-range (sub node 1)))))

      (== form "require")
      (do (if (< (len node) 2) (continue))
          (.append symbols
            (lsp.DocumentSymbol
              :name (symbol-name (sub node 1))
              :kind lsp.SymbolKind.Module
              :range (node-range node)
              :selection-range (node-range (sub node 1))
              :detail "macro require")))))

  (return symbols))

;; ---------------------------------------------------------------------------
;; Hover
;; ---------------------------------------------------------------------------

(def node-at-position [nodes line-0 col]
  "Find the most specific node at the given 0-based position."
  (for node in nodes
    (= n-start-line (- node.lineno 1))
    (= n-start-col node.col_offset)
    (= n-end-line (- node.end_lineno 1))
    (= n-end-col node.end_col_offset)
    ;; Check if position is inside this node's range
    (if (< (, line-0 col) (, n-start-line n-start-col))
        (continue))
    (if (> (, line-0 col) (, n-end-line n-end-col))
        (continue))
    ;; Position is within this node — try to go deeper
    (if (isinstance node Expression)
        (do (= deeper (node-at-position node.list line-0 col))
            (if (is-not deeper None)
                (return deeper))))
    (if (isinstance node (, Wrapper MetaIndicator))
        (do (= deeper (node-at-position [node.value] line-0 col))
            (if (is-not deeper None)
                (return deeper))))
    (if (isinstance node GluedHead)
        (do (= deeper (node-at-position [node.head node.params] line-0 col))
            (if (is-not deeper None)
                (return deeper))))
    (return node))
  (return None))

(def form-heads [nodes]
  "The ids of every form head in nodes, a parsed tree: the first element of
   each Paren, the one place the compiler dispatches a special form.  Valid
   while the tree lives."
  (= heads (set))
  (= pending [nodes])
  (while pending
    (for node in (.pop pending)
      (cond (isinstance node Expression)
            (do (if (and (isinstance node Paren) (> (len node.list) 0))
                    (.add heads (id (sub node.list 0))))
                (.append pending node.list))
            (and (isinstance node (, Wrapper MetaIndicator)) (is-not node.value None))
            (.append pending [node.value])
            (isinstance node GluedHead)
            (.append pending [node.head node.params]))))
  (return heads))

(def form-at-p [nodes target]
  "True when Symbol target in nodes, a parsed tree, stands for its special
   form (SPECIAL-FORM-DOCS): a name a user can bind (BINDABLE-FORMS) only at
   a form head (form-heads), where the compiler reads it as the form; every
   other special form wherever it stands."
  (= name target.value)
  (if (not-in name SPECIAL-FORM-DOCS)
      (return False))
  (return (or (not-in name BINDABLE-FORMS)
              (in (id target) (form-heads nodes)))))

;; ---------------------------------------------------------------------------
;; Definition index
;; ---------------------------------------------------------------------------

(def _add-symbol [symbols name kind loc]
  (if (is-not symbols None)
      (.append symbols (lsp.SymbolInformation :name name :kind kind :location loc))))

(def collect-definitions [nodes uri :defs None :symbols None :in-function False]
  "Walk AST and collect all definition locations keyed by symbol name.

   defs feeds go-to-definition and completion, so it also holds the names
   bound by import/from and for/async-for.  When symbols is a list, the same
   pass appends an lsp.SymbolInformation for each declaration a user searches
   for with workspace/symbol -- def, async-def, defmacro, class and = --
   with the kind definition-kind gives it.  Imports and loop variables bind
   names but declare nothing, so they get no symbol, and an = inside a def
   body (in-function) is a local, so it gets none either; module and
   class-body assignments do."
  (if (is defs None)
      (= defs {}))

  (for node in nodes
    (if (or (not (isinstance node Paren)) (== (len node) 0))
        (continue))
    (= op node.op)
    (if (not (isinstance op Symbol))
        (continue))
    (= form op.value)

    (cond
      (in form (, "def" "async-def" "defmacro"))
      (do (if (and (>= (len node) 2) (is-not (def-name-symbol (sub node 1)) None))
              (do (= name-node (def-name-symbol (sub node 1)))
                  (= name name-node.value)
                  (= loc (lsp.Location :uri uri :range (node-range name-node)))
                  (.append (.setdefault defs name []) loc)
                  (_add-symbol symbols name (definition-kind form) loc)
                  (if (> (len node) 3)
                      (collect-definitions (sub node.list [: 3 None]) uri
                                           :defs defs :symbols symbols
                                           :in-function True)))))

      (== form "class")
      (do (if (and (>= (len node) 2) (is-not (def-name-symbol (sub node 1)) None))
              (do (= name-node (def-name-symbol (sub node 1)))
                  (= name name-node.value)
                  (= loc (lsp.Location :uri uri :range (node-range name-node)))
                  (.append (.setdefault defs name []) loc)
                  (_add-symbol symbols name (definition-kind form) loc)
                  (= body (ife (> (len node) 3)
                               (sub node.list [: 3 None])
                               (sub node.list [: 2 None])))
                  (collect-definitions body uri :defs defs :symbols symbols))))

      (and (== form "type") (type-alias-p node))
      (do (= name-node (def-name-symbol (sub node 1)))
          (= loc (lsp.Location :uri uri :range (node-range name-node)))
          (.append (.setdefault defs name-node.value []) loc)
          (if (not in-function)
              (_add-symbol symbols name-node.value (definition-kind form) loc)))

      (== form "=")
      (do (if (and (>= (len node) 2) (isinstance (sub node 1) Symbol))
              (do (= name (. (sub node 1) value))
                  (= loc (lsp.Location :uri uri :range (node-range (sub node 1))))
                  (.append (.setdefault defs name []) loc)
                  (if (not in-function)
                      (_add-symbol symbols name (definition-kind form) loc)))))

      (in form (, "for" "async-for"))
      (do (if (and (>= (len node) 2) (isinstance (sub node 1) Symbol))
              (do (= name (. (sub node 1) value))
                  (= loc (lsp.Location :uri uri :range (node-range (sub node 1))))
                  (.append (.setdefault defs name []) loc)))
          (collect-definitions (sub node.list [: 1 None]) uri
                               :defs defs :symbols symbols
                               :in-function in-function))

      (in form IMPORT-HEADS)
      (for [name name-node] in (buffer-import-bindings node)
        (= loc (lsp.Location :uri uri :range (node-range name-node)))
        (.append (.setdefault defs name []) loc))

      ;; Default: recurse into nested paren forms
      (do (collect-definitions
            [c for c in node.list if (isinstance c Paren)]
            uri :defs defs :symbols symbols :in-function in-function))))

  (return defs))

;; ---------------------------------------------------------------------------
;; References
;; ---------------------------------------------------------------------------

(def collect-references [nodes name uri :among None]
  "The Location of every Symbol in nodes that stands for the same name as
   name (name-key: my-x and my_x are one name, - and _ are not), in source
   order; with among, a set of node ids (form-heads), only those Symbols."
  (= target (name-key name))
  (= refs [])
  (= stack (list (reversed nodes)))
  (while stack
    (= node (.pop stack))
    (cond (isinstance node Symbol)
          (if (and (== (name-key node.value) target)
                   (or (is among None) (in (id node) among)))
              (.append refs (lsp.Location :uri uri :range (node-range node))))
          (isinstance node Expression)
          (.extend stack (reversed node.list))
          (isinstance node (, Wrapper MetaIndicator))
          (if (is-not node.value None)
              (.append stack node.value))
          (isinstance node GluedHead)
          (.extend stack [node.params node.head])))
  (return refs))

;; ---------------------------------------------------------------------------
;; LSP event handlers
;; ---------------------------------------------------------------------------

(deco (server.feature lsp.INITIALIZE)
(def on-initialize [ls params]
  (.configure backends params.initialization_options)))

(deco (server.feature lsp.INITIALIZED)
(def on-initialized [ls params]
  (= folders (ife ls.workspace.folders
                  (list (.values ls.workspace.folders))
                  []))
  (if folders
      (index-workspace folders))))

(deco (server.feature lsp.TEXT_DOCUMENT_DID_OPEN)
(def did-open [ls params]
  (= uri params.text_document.uri)
  (index-file uri)
  (publish-diagnostics ls uri :opened True)))

(deco (server.feature lsp.TEXT_DOCUMENT_DID_CHANGE)
(def did-change [ls params]
  (publish-diagnostics ls params.text_document.uri)))

(deco (server.feature lsp.TEXT_DOCUMENT_DID_SAVE)
(def did-save [ls params]
  (= uri params.text_document.uri)
  (index-file uri)
  (publish-diagnostics ls uri :recompile True)
  (.document-saved backends uri)))

(deco (server.feature lsp.TEXT_DOCUMENT_DID_CLOSE)
(def did-close [ls params]
  (forget-diagnostics ls params.text_document.uri)
  (.forget view-cache params.text_document.uri)
  (.document-closed backends params.text_document.uri)))

;; pygls' own shutdown awaits this before it answers, so every backend has
;; exited by the time the client sends exit.
(deco (server.feature lsp.SHUTDOWN)
(async-def on-shutdown [ls *args]
  (await (.shutdown-all backends))))

;; A client that exits without shutdown: kill what still runs, since the LSP
;; process ends right after this.
(deco (server.feature lsp.EXIT)
(def on-exit [ls *args]
  (.kill-all backends)))

(deco (server.feature lsp.TEXT_DOCUMENT_DOCUMENT_SYMBOL)
(def document-symbol [ls params]
  (= doc (.get-text-document ls.workspace params.text_document.uri))
  (try
    (= tree (parse doc.source :partial True))
    (except [Exception]
      (return [])))
  (return (walk-symbols tree))))

;; TYPE-ALIAS-DOC is not in SPECIAL-FORM-DOCS: `type` is also the builtin, so
;; the alias doc applies only where type-alias-p (the compiler's own test)
;; accepts the form.

(def alias-keyword-p [nodes target]
  "True when target is the `type` of a (type NAME value) alias statement."
  (for node in nodes
    (if (isinstance node Paren)
        (if (or (and (is node.op target) (type-alias-p node))
                (alias-keyword-p node.list target))
            (return True))))
  (return False))

(def markdown-hover [value target]
  (return (lsp.Hover
            :contents (lsp.MarkupContent :kind lsp.MarkupKind.Markdown :value value)
            :range (node-range target))))

(def form-hover [tree target :view None]
  "lispython's own hover of Symbol target, or None: the alias doc on the
   type of a type alias, else the doc of the special form target stands for
   (form-at-p), else the docstring of one of the buffer's built-in macros (builtin-macro-doc, over view, the
   buffer's full view, when there is one).  It answers before any backend,
   which knows no lispython form."
  (if (and (== target.value "type") (alias-keyword-p tree target))
      (return (markdown-hover TYPE-ALIAS-DOC target)))
  (= doc-text (or (and (form-at-p tree target) (.get SPECIAL-FORM-DOCS target.value))
                  (builtin-macro-doc tree target.value :view view)))
  (if doc-text
      (return (markdown-hover doc-text target)))
  (return None))

(def compiled-view [doc]
  "The full view of snapshot doc's version, compiled under the macro
   environment of now (ViewCache.cached-view), or None: none compiled
   yet, or the compile failed.  Hover and signature help read it, never
   compile: they answer locally before any backend."
  (return (.cached-view view-cache doc.uri doc.version)))

(def builtin-hover [target]
  "The builtin-info hover of Symbol target, or None: the answer when no
   backend gives one.  Its signature is spelled as a backend's is
   (python-to-buffer: class-or-tuple), its docstring kept as it is."
  (= info (builtin-info (py-name target.value)))
  (if (is info None)
      (return None))
  (= [signature doc] info)
  (= signature (sub (python-to-buffer signature {}) 0))
  (= hover-md f"```python\n{signature}\n```\n\n*(Python builtin)*")
  (if doc
      (+= hover-md f"\n\n{doc}"))
  (return (markdown-hover hover-md target)))

(deco (server.feature lsp.TEXT_DOCUMENT_HOVER)
(async-def hover [ls params]
  (= doc (document-snapshot (.get-text-document ls.workspace params.text_document.uri)))
  (try
    (= tree (parse doc.source :partial True))
    (= [line col] (cursor-of doc params.position))
    (except [Exception]
      (return None)))
  (= target (node-at-position tree (- line 1) col))
  (if (not (isinstance target Symbol))
      (return None))
  (= local (form-hover tree target :view (compiled-view doc)))
  (if (is-not local None)
      (return local))
  (try
    (= result (await (backend-hover doc line col target)))
    (except [Exception]
      (.debug logger "backend hover failed" :exc-info True)
      (= result None)))
  (if (is-not result None)
      (return result))
  (return (builtin-hover target))))

(deco (server.feature lsp.TEXT_DOCUMENT_DEFINITION)
(async-def definition [ls params]
  (= found (cursor-symbol ls params))
  (if (is found None)
      (return None))
  (= [doc tree line col target] found)
  (= name target.value)
  (if (form-at-p tree target)
      (return None))
  ;; Every Python name goes to the backend, the buffer's own bindings too:
  ;; it knows scopes (a function's local never answers for a global of the
  ;; same name), and maps a buffer binding back to the same .lpy place.
  ;; Once it answered, its answer is final, an empty or null one included:
  ;; the local lookup matches by name alone and would name some other
  ;; binding (another function's local of a name undefined here).
  ;; The exception is an answer none of whose locations maps to the editor
  ;; (UNMAPPED, e.g. a name bound only by a macro's expansion): the name
  ;; exists, so the buffer's own definition of it answers, but never the
  ;; import or workspace steps, which would jump to another file's name.
  (try
    (= result (await (backend-locations doc line col target lsp.TEXT_DOCUMENT_DEFINITION
                                        (fn [document position]
                                          (lsp.DefinitionParams :text-document document
                                                                :position position)))))
    (except [Exception]
      (.debug logger "backend definition failed" :exc-info True)
      (= result None)))
  (cond (is result UNMAPPED)
        (return (buffer-definition doc tree name))
        (is-not result None)
        (return result))
  (return (local-definition ls doc tree name))))

(def buffer-definition [doc tree name]
  "The buffer's own definitions of name (collect-definitions of tree,
   imports included), or None."
  (return (or (.get (collect-definitions tree doc.uri) name) None)))

(def local-definition [ls doc tree name]
  "go-to-definition of name without the backend: the buffer's definitions
   (imports included), the module an import names, then the workspace
   index."
  ;; 1. Local definitions in the file
  (= local (buffer-definition doc tree name))
  (if local
      (return local))

  ;; 2. Resolve via import statements — find which module imports this name
  (= folders (ife ls.workspace.folders
                  (list (.values ls.workspace.folders))
                  []))
  (= import-node (find-import-for-name tree name))
  (if import-node
      (do (= fpath (find-import-target import-node folders))
          (if fpath
              (do (= target-uri (path-to-uri fpath))
                  ;; Make sure the target file is indexed
                  (if (not-in target-uri FILE-TREES)
                      (index-file target-uri))
                  ;; Look up the name in the target file's definitions
                  (= target-tree (.get FILE-TREES target-uri))
                  (if target-tree
                      (do (= target-defs (collect-definitions target-tree target-uri))
                          ;; (require module) registers module.name; the target
                  ;; file defines the bare name.
                  (= prefix (+ (str (sub import-node 1)) "."))
                  (= result (.get target-defs
                                  (ife (and (== import-node.op.value "require")
                                            (.startswith name prefix))
                                       (sub name [: (len prefix) None])
                                       name)))
                          (if result
                              (return result))))))))

  ;; 3. Workspace-wide index lookup
  (= ws-result (.get WORKSPACE-INDEX name))
  (if ws-result
      ;; Filter out definitions from the current file (already checked)
      (do (= external [loc for loc in ws-result if (!= loc.uri doc.uri)])
          (if external
              (return external))))
  (return None))

;; ---------------------------------------------------------------------------
;; Signature help
;; ---------------------------------------------------------------------------

(def open-form-heads [source line col]
  "The heads of the forms open at the cursor, outermost first.

   line is 1-based and col a 0-based code-point column: the coordinates
   tokenize() reports.  The scan runs over the lexer's own tokens, so
   strings (prefixed, raw, triple-quoted, f/t-string fields), comments and
   opening tokens such as *( or ^( are delimited exactly as the parser
   delimits them.  An opening ending in ( contributes its head symbol (None
   when the head is not a symbol, or when a ' or ` quotes the form as data;
   an unquote ~( is code again); [ and { contribute None.  Never raises: a
   buffer the lexer cannot read has no open form."
  (try
    (= tokens (list (tokenize source)))
    (except [Exception]
      (return (list))))
  (= cursor (, line col))
  (= stack [])
  (for i in (range (len tokens))
    (= [text tktype info _] (sub tokens i))
    (if (> (, (sub info "end_lineno") (sub info "end_col_offset")) cursor)
        (break))
    (cond
      (== tktype "opening")
      (if (.endswith text "(")
          (do (= head (ife (< (+ i 1) (len tokens)) (sub tokens (+ i 1)) None))
              (= before (ife (> i 0) (sub tokens (- i 1)) None))
              (= quoted (and before
                             (== (sub before 1) "meta-indicator")
                             (in (sub (sub before 0) -1) "'`")))
              (.append stack (ife (and head (not quoted) (== (sub head 1) "symbol"))
                                  (sub head 0)
                                  None)))
          (.append stack None))

      ;; ^*( is refused by the parser but still opens a form its ) closes.
      (and (== tktype "bad-prefix") (in (sub text -1) "([{"))
      (.append stack None)

      (and (== tktype "closing") stack)
      (.pop stack)))
  (return stack))

(def innermost-named [heads]
  "The innermost head symbol among open-form-heads' heads, or None."
  (for name in (reversed heads)
    (if (is-not name None)
        (return name)))
  (return None))

(def cursor-of [doc pos]
  "The LSP position pos as tokenize() coordinates: (1-based line, code-point column).
   LSP counts character in the negotiated encoding (UTF-16 by default), which
   differs from a str index after a non-BMP character; pygls' position codec
   converts it.  A document without a codec (a test double) is taken as code
   points."
  (= codec (getattr doc "position_codec" None))
  (if (is codec None)
      (return (, (+ pos.line 1) pos.character)))
  (= server-pos (.position-from-client-units
                  codec doc.lines
                  (lsp.Position :line pos.line :character pos.character)))
  (return (, (+ server-pos.line 1) server-pos.character)))

(def form-signature-help [source func-name :view None]
  "lispython's own SignatureHelp for a form headed func-name (None: no head),
   or None: a special form's documented usage, else the docstring usage of
   one of the buffer's built-in macros (builtin-macro-doc, over view, the
   buffer's full view, when there is one).  The buffer is parsed only when
   there is no view and func-name could name a built-in macro
   (builtin-macro-name-p)."
  (if (is func-name None)
      (return None))
  (= doc-text (or (.get SPECIAL-FORM-DOCS func-name)
                  (and (builtin-macro-name-p func-name)
                       (builtin-macro-doc (ife (is view None)
                                               (parse source :partial True)
                                               None)
                                          func-name :view view))))
  (if (not doc-text)
      (return None))
  (= m (re.search "```\\n(.+?)\\n```" doc-text re.DOTALL))
  (return (lsp.SignatureHelp
            :signatures [(lsp.SignatureInformation
                           :label (ife m (.strip (.group m 1)) func-name)
                           :documentation (lsp.MarkupContent
                                            :kind lsp.MarkupKind.Markdown
                                            :value doc-text))])))

(def builtin-signature-help [func-name]
  "The builtin-info SignatureHelp of a call of func-name, or None: the
   answer when neither lispython nor a backend gives one, its label spelled
   as a backend's is (python-to-buffer)."
  (if (is func-name None)
      (return None))
  (= info (builtin-info (py-name func-name)))
  (if (is info None)
      (return None))
  (= [signature doc-str] info)
  (return (lsp.SignatureHelp
            :signatures [(lsp.SignatureInformation
                           :label (sub (python-to-buffer signature {}) 0)
                           :documentation (ife doc-str
                                              (lsp.MarkupContent
                                                :kind lsp.MarkupKind.Markdown
                                                :value doc-str)
                                              None))])))

;; The innermost open form decides, not the innermost named one: in
;; (print ((. x sort) |)) the call being typed is the method's, which only
;; the backend knows, while (print (when x |)) is inside a form no backend
;; knows, so the local answer (when's usage where the buffer has it by the
;; prelude rule, else none) stands rather than print's.  lispython's own
;; forms answer first (form-signature-help); a macro the buffer defines has
;; no usage to show, and the backend is not asked about it
;; (signature-request).
(deco (server.feature
        lsp.TEXT_DOCUMENT_SIGNATURE_HELP
        (lsp.SignatureHelpOptions :trigger-characters ["("]))
(async-def signature-help [ls params]
  (= doc (document-snapshot (.get-text-document ls.workspace params.text_document.uri)))
  (= [line col] (cursor-of doc params.position))
  (= heads (open-form-heads doc.source line col))
  (if (not heads)
      (return None))
  (= head (sub heads -1))
  (= view (compiled-view doc))
  (= local (form-signature-help doc.source head :view view))
  (if (is-not local None)
      (return local))
  (try
    (= result (await (backend-signature-help
                       doc line col head
                       :offsets (label-offset-support ls))))
    (except [Exception]
      (.debug logger "backend signature help failed" :exc-info True)
      (= result None)))
  (if (is-not result None)
      (return result))
  (= name (innermost-named heads))
  (if (is-not name head)
      (do (= local (form-signature-help doc.source name :view view))
          (if (is-not local None)
              (return local))))
  (return (builtin-signature-help name))))

;; ---------------------------------------------------------------------------
;; Completion context
;; ---------------------------------------------------------------------------

;; Every walk here runs on an explicit stack, so nesting depth costs no
;; Python frames.

(def head-of [node]
  "The head symbol's text of a non-empty Paren, else None."
  (if (and (isinstance node Paren) (> (len node) 0) (isinstance node.op Symbol))
      (return node.op.value))
  (return None))

(def node-end [node]
  (return (, node.end_lineno node.end_col_offset)))

(def open-path [tree line col]
  "The forms open at the cursor, outermost first, and the leaf touching it.
   tree is the parse of the prefix with its closers right after the cursor,
   so a form is open iff it ends past the cursor.  The leaf is the innermost
   open form's last element that starts before the cursor (inside an f/t-string
   field or format spec too) when it ends exactly at the cursor, else None."
  (= cursor (, line col))
  (= path [])
  (= node (ife tree (sub tree -1) None))
  (while (is-not node None)
    (while (and (isinstance node (, Wrapper MetaIndicator))
                (is-not node.value None))
      (= node node.value))
    (if (and (isinstance node Expression) (> (node-end node) cursor))
        (do (.append path node)
            ;; The last element that starts before the cursor: past an f/t-string
            ;; field the form's last element is the literal text after it.
            (= node None)
            (for child in (reversed (sub path -1))
              (if (< (, child.lineno child.col_offset) cursor)
                  (do (= node child)
                      (break))))
            ;; A cursor in a field's format spec is in the spec's own fields.
            (= spec (getattr node "format_spec" None))
            (if (and (is-not spec None)
                     (< (, spec.lineno spec.col_offset) cursor))
                (= node spec)))
        (return (, path (ife (== (node-end node) cursor) node None)))))
  (return (, path None)))

(def line-text [source line]
  "The text of source's 1-based line, the empty string past its end."
  (= lines (.split source "\n"))
  (return (ife (<= 1 line (len lines)) (sub lines (- line 1)) "")))

(def client-position [doc line character :lines None]
  "The 1-based line and code-point character as an LSP Position in client
   units, through the document's position codec (a test double without one
   is taken as code points), over lines (default the document's own: a
   location in another file counts over that file's)."
  (= pos (lsp.Position :line (- line 1) :character character))
  (= codec (getattr doc "position_codec" None))
  (if (is codec None)
      (return pos))
  (return (.position-to-client-units codec (ife (is lines None) doc.lines lines) pos)))

(def completion-ranges [doc line col]
  "The ranges a completion item edits at the 1-based line and code-point
   col, and the word typed so far: (insert, replace, typed).  insert covers
   the partial word before the cursor (partial-span, the word the Python
   view restores), replace that and the rest of the name run after the
   cursor; both in client units."
  (= text (line-text doc.source line))
  (= [start end] (partial-span text (min col (len text))))
  (= start-pos (client-position doc line start))
  (return (, (lsp.Range :start start-pos :end (client-position doc line col))
             (lsp.Range :start start-pos :end (client-position doc line end))
             (sub text [: start col]))))

(def completion-edit [ranges new-text insert-replace]
  "The edit of a completion item putting new-text over the word at the
   cursor (ranges from completion-ranges): an InsertReplaceEdit when the
   client supports one (insert-replace), else a TextEdit over the insert
   range."
  (= [insert replace _] ranges)
  (if insert-replace
      (return (lsp.InsertReplaceEdit :new-text new-text :insert insert :replace replace)))
  (return (lsp.TextEdit :range insert :new-text new-text)))

;; filterText decides whether the client keeps an item while the user types
;; (VS Code and eglot's flex matching read it, not the label).  `-` is a
;; completion trigger character, so the client asks again right after one
;; and filters that answer by the word typed so far, hyphen included; `_` is
;; not, so after a `_` the client filters the answer it already holds.  So
;; an item carries the spelling being typed: its label, the hyphen spelling
;; (hyphen-spelling), once the typed word holds a `-` (my-|), else the
;; Python name, which also matches what a user typing `_` spells (my_|).
(def completion-label [name spellings]
  "The label of a backend item for Python name name: the buffer's own
   spelling (spellings, buffer-spellings' map) when that is no hyphenated
   spelling of name (ok? for ok_p, ->foo for _to_foo: name-key keeps it
   apart from name), else the hyphen spelling (hyphen-spelling), so the
   buffer's plain my_x never wins over my-x."
  (= spelled (.get spellings name))
  (if (and (is-not spelled None) (!= (name-key spelled) name))
      (return spelled))
  (return (hyphen-spelling name)))

(def filter-text [label name typed]
  "The filterText of a completion item labelled label (completion-label)
   for Python name name, when typed is the word typed so far: a label that
   is no hyphen spelling of name (the buffer's ok?, ->foo) itself, since
   the user types it as written (? is no trigger character); else name
   while typed holds no -, then label."
  (if (!= label (hyphen-spelling name))
      (return label))
  (return (ife (in "-" typed) label name)))

(def client-capability-p [ls path]
  "Whether the client advertises the capability at path (attribute names
   below ClientCapabilities) as True; False before initialize and for a
   test double without capabilities."
  (try
    (= value (getattr ls "client_capabilities" None))
    (for attr in path
      (= value (getattr value attr None)))
    (except [Exception]
      (return False)))
  (return (is value True)))

(def insert-replace-support [ls]
  "Whether the client takes an InsertReplaceEdit in a completion item
   (textDocument.completion.completionItem.insertReplaceSupport)."
  (return (client-capability-p
            ls ["text_document" "completion" "completion_item" "insert_replace_support"])))

(def label-offset-support [ls]
  "Whether the client takes a signature parameter label as offsets into the
   signature's label (textDocument.signatureHelp.signatureInformation
   .parameterInformation.labelOffsetSupport)."
  (return (client-capability-p
            ls ["text_document" "signature_help" "signature_information"
                "parameter_information" "label_offset_support"])))

;; ---------------------------------------------------------------------------
;; Completion
;; ---------------------------------------------------------------------------

;; The (tag, kind) of a macro, the one home for built-in and view macros alike.
(= _MACRO-STYLE
   (, MACRO-TAG (lsp.CompletionItemKind (sub OWN-TAG-KINDS MACRO-TAG))))

;; lispython's own names as (names, tag, kind) rows, from OWN-NAME-TAGS and
;; OWN-TAG-KINDS.
(= _LPY-OWN-TAGS
   [(, names tag (lsp.CompletionItemKind (sub OWN-TAG-KINDS tag))) for [names tag] in OWN-NAME-TAGS])

(def own-item [label tag kind]
  "One of lispython's own completion items (the one home of their shape):
   its short tag (\"macro\", ...) is labelDetails.description, drawn inline,
   not detail, which lpy-mode shows as the focused item's signature.  The kind
   is the caller's, from OWN-TAG-KINDS (form_docs) for every own tag.
   Sent whatever the client advertises: eglot never sets labelDetailsSupport
   and clients ignore a field they do not know."
  (return (lsp.CompletionItem
            :label label
            :kind kind
            :label-details (lsp.CompletionItemLabelDetails :description tag))))

(def lispython-items []
  "lispython's own completion items: the special forms, then the built-in
   macros and gensym (_LPY-OWN-TAGS), each once (own-item)."
  (= items [])
  (= seen (set))
  (for [names tag kind] in _LPY-OWN-TAGS
    (for name in names
      (if (not-in name seen)
          (do (.add seen name)
              (.append items (own-item name tag kind))))))
  (return items))

(def general-items [doc :line None]
  "The completion items offered with no Python backend's answer:
   lispython's own (lispython-items), the Python builtins (builtin-names),
   then the buffer's definitions (buffer-definition-names), each name once
   (name-key); builtins labelled by their hyphen spelling (hyphen-spelling),
   the buffer's definitions, macros included, as buffer-definition-names
   labels them (completion-label)."
  (= items (lispython-items))
  (= seen (set [(name-key item.label) for item in items]))
  (for [label kind] in [*[(, (hyphen-spelling name) kind)
                          for [name kind] in (builtin-names)]
                        *[(, name lsp.CompletionItemKind.Variable)
                          for name in (buffer-definition-names doc line)]]
    ;; One item per name (name-key), so a buffer's my_x and my-x are one.
    (if (not-in (name-key label) seen)
        (do (.add seen (name-key label))
            (.append items (lsp.CompletionItem :label label :kind kind)))))
  (return items))

(def local-completion [doc :line None :col None]
  "The completion answer when no Python backend gives one: the general
   list, or none at all on an attribute (attribute-context-p at line and
   col), because only the backend knows a base's members and a base it
   cannot resolve has none."
  (if (and (is-not line None) (is-not col None)
           (attribute-context-p doc.source line col))
      (return (lsp.CompletionList :is-incomplete False :items [])))
  (return (lsp.CompletionList :is-incomplete False
                              :items (general-items doc :line line))))

;; ---------------------------------------------------------------------------
;; Completion through the Python backend
;; ---------------------------------------------------------------------------

;; The cursor views of the open documents, by version (python_view.ViewCache).
(= view-cache (ViewCache))

(def cursor-view [uri version source line col name package import-root generation]
  "view-at-cursor of source, through view-cache when the document has a
   version.  It runs the buffer's macros, so callers run it in a thread,
   reading view-cache's generation before the hand-off."
  (if (is version None)
      (return (view-at-cursor source line col :package package :name name
                              :import-root import-root)))
  (return (.view-at-cursor view-cache uri version source line col
                           :package package :name name :import-root import-root
                           :generation generation)))

;; Cursor-view compiles are scheduled apart from compile-latest's diagnostics
;; loop on purpose: that loop keeps only a document's latest run, while a
;; cursor view is asked at a position by many handlers at once, and every live
;; caller of the latest version gets the view it asked for.

(class CursorCompile []
  "One cursor-view compile of a document: args, cursor-view's arguments
   (generation, read on the loop, included); waiters, the futures of the
   callers awaiting its view; superseded, set once a request at another
   version came while it runs, so it may be given up on
   (compile-or-give-up)."
  (def __init__ [self args]
    (= self.args args)
    (= self.waiters [])
    (= self.superseded (asyncio.Event))))

(def _live-waiters-p [entry]
  (return (any ((not (.done waiter)) for waiter in entry.waiters))))

(class CursorCompiles []
  "A document's cursor-view compiles: version, the latest version asked;
   pending, args -> the CursorCompile not yet started, all of that version;
   running, the one in flight (its thread cannot be stopped, only given up
   on), or None;
   task, the task running them one after another, or None."
  (def __init__ [self]
    (= self.version None)
    (= self.pending {})
    (= self.running None)
    (= self.task None)))

;; uri -> the CursorCompiles of a document with a cursor-view compile pending
;; or running; dropped once it has neither.
(= CURSOR-COMPILES {})

(def scheduled-cursor-view [uri version source line col name package import-root]
  "A future of cursor-view at the 1-based line and code-point col of
   document uri's source at version, of its own for each caller, so a
   timeout or cancellation of one caller never stops the compile others
   wait for.  Per document one compile runs at a time (run-cursor-compiles);
   a request with the same arguments as one pending or running shares its
   view, and one at another version gives every waiter of a pending older
   compile None and supersedes the running one, which is given up on once
   it ran macro_modules.WAIT-LIMIT (run-cursor-compiles).  A pending
   compile whose callers all gave up is never started, so abandoned
   keystrokes queue no compiles behind a slow one."
  (= future (.create-future (asyncio.get-running-loop)))
  (= args (, uri version source line col name package import-root
             view-cache.generation))
  (= state (.get CURSOR-COMPILES uri))
  (if (is state None)
      (do (= state (CursorCompiles))
          (= (sub CURSOR-COMPILES uri) state)))
  (if (and (is-not state.running None) (== state.running.args args))
      (do (.append state.running.waiters future)
          (return future)))
  (if (and (is-not state.running None) (!= (sub state.running.args 1) version))
      (.set state.running.superseded))
  (if (!= version state.version)
      (do (for entry in (.values state.pending)
            (for waiter in entry.waiters
              (if (not (.done waiter))
                  (.set-result waiter None))))
          (.clear state.pending)
          (= state.version version)))
  (for [key entry] in (list (.items state.pending))
    (if (not (_live-waiters-p entry))
        (del (sub state.pending key))))
  (= entry (.setdefault state.pending args (CursorCompile args)))
  (.append entry.waiters future)
  (if (is state.task None)
      (= state.task (asyncio.ensure-future (run-cursor-compiles uri state))))
  (return future))

(async-def run-cursor-compiles [uri state]
  "Run state's pending cursor-view compiles in order, each in a thread of
   its own, skipping one with no live waiter, and hand each live waiter its
   view or its exception; then forget the document's state.  A compile
   superseded by a newer version and running past macro_modules.WAIT-LIMIT
   is given up on (compile-or-give-up): its waiters get None and the
   pending compiles go on, so a macro that never returns stops holding up
   the document's later requests."
  (= loop (asyncio.get-running-loop))
  (try
    (while state.pending
      (= args (next (iter state.pending)))
      (= entry (.pop state.pending args))
      (if (not (_live-waiters-p entry))
          (continue))
      (= state.running entry)
      (= error None)
      (= view None)
      (try
        (= view (await (compile-or-give-up (in-own-thread cursor-view *args)
                                           entry.superseded (.time loop))))
        (except [Exception as e]
          (= error e)))
      (if (is view GAVE-UP)
          (do (.warning logger
                        "lispython LSP: gave up on a cursor view of %s version %s"
                        uri (sub args 1))
              (= view None)))
      ;; Left set when the task is cancelled, so its waiters are cancelled.
      (= state.running None)
      (for waiter in entry.waiters
        (cond (.done waiter)
              (continue)
              (is error None)
              (.set-result waiter view)
              True
              (.set-exception waiter error))))
    (finally
      (= state.task None)
      (for entry in (+ (list (.values state.pending))
                       (ife (is state.running None) [] [state.running]))
        (for waiter in entry.waiters
          (.cancel waiter)))
      (if (is (.get CURSOR-COMPILES uri) state)
          (del (sub CURSOR-COMPILES uri))))))

(def generated-position [view :offset 0]
  "view.cursor, offset code points along its line, as an LSP Position over
   view.text, in UTF-16 units: the backend client negotiates no position
   encoding, so the backend counts in the protocol's default."
  (= [line col] view.cursor)
  (return (.position-to-client-units (PositionCodec) (.split view.text "\n")
                                     (lsp.Position :line (- line 1)
                                                   :character (+ col offset)))))

(def completion-items [answer]
  "The items of a completion answer: a list, a CompletionList or None."
  (cond (is answer None)
        (return (list))
        (isinstance answer lsp.CompletionList)
        (return (list answer.items))
        True
        (return (list answer))))

(def buffer-texts [source line]
  "The texts whose partial parses together read source: source itself and,
   since a form left open at the 1-based line (None: no cursor) swallows the
   rest of that parse, the text from the first later line that opens a form
   in column 0, read as a top-level form (as Emacs's beginning-of-defun
   reads one).  Limits: only the form open at the cursor is skipped, so a
   second form left open after it loses what follows it; and a ( in column
   0 inside a multi-line string is taken for a form's start."
  (= lines (.split source "\n"))
  (= texts [source])
  (for i in (range (ife (is line None) (len lines) line) (len lines))
    (if (.startswith (sub lines i) "(")
        (do (.append texts (.join "\n" (sub lines [: i None])))
            (break))))
  (return texts))

(def buffer-spellings [source :line None]
  "Python name -> the buffer's first spelling of it in source order: every
   Symbol counts, a dotted one (a.my-b) by each of its parts, each only
   when it spells a name (name-spelling-p); with a 1-based line, also past
   the form open there (buffer-texts)."
  (= tree [])
  (for text in (buffer-texts source line)
    (try
      (.extend tree (parse text :partial True))
      (except [Exception]
        (pass))))
  (= spellings {})
  (= stack (list (reversed tree)))
  (while stack
    (= node (.pop stack))
    (cond (isinstance node Symbol)
          (for part in (.split node.value ".")
            (if (name-spelling-p part)
                (.setdefault spellings (py-name part) part)))
          (isinstance node Expression)
          (.extend stack (reversed node.list))
          (isinstance node (, Wrapper MetaIndicator))
          (if (is-not node.value None)
              (.append stack node.value))
          (isinstance node GluedHead)
          (.extend stack [node.params node.head])))
  (return spellings))

(def python-syntax-p [item]
  "Whether a backend completion item is Python syntax (else, yield), which
   no lispython form spells: a Keyword item other than a constant the
   builtins module holds (True, False, None), which lispython writes as
   Python does."
  (return (and (== item.kind lsp.CompletionItemKind.Keyword)
               (not-in item.label (vars builtins)))))

(def backend-items [doc line col items insert-replace spellings]
  "The backend's completion items as the buffer's: labelled by
   completion-label (the hyphen spelling, move-to-end, never move_to_end
   whatever the buffer writes; the buffer's own spelling only where the
   hyphen rule cannot spell it, ok?), with filterText and edit over the
   .lpy word at the cursor.  What is positioned in or tied to the generated code
   (text_edit, insert_text, command, data) is dropped: it would land on
   lines the user never wrote.  So is an item with additional_text_edits
   (an auto-import of a symbol the buffer never binds), and a Python
   keyword (python-syntax-p)."
  (= ranges (completion-ranges doc line col))
  (= typed (sub ranges 2))
  (= result [])
  (for item in items
    (if (or (python-syntax-p item) item.additional-text-edits)
        (continue))
    (= name item.label)
    (= label (completion-label name spellings))
    (.append result
      (lsp.CompletionItem
        :label label
        :kind item.kind
        :detail item.detail
        :label-details item.label-details
        :documentation item.documentation
        :sort-text item.sort-text
        :tags item.tags
        :deprecated item.deprecated
        :preselect item.preselect
        :filter-text (filter-text label name typed)
        :text-edit (completion-edit ranges label insert-replace))))
  (return result))

(def buffer-definition-names [doc line]
  "The names doc's definitions bind (collect-definitions), in source order
   and as completion offers them: each labelled as a backend item of its
   Python name is (completion-label over buffer-spellings at line), so one
   name gives one label, a defmacro's included.  The one home of that list,
   over the partial parses of buffer-texts at the 1-based line (None: no
   cursor)."
  (= names {})
  (for text in (buffer-texts doc.source line)
    (try
      (.update names (collect-definitions (parse text :partial True) doc.uri))
      (except [Exception]
        (pass))))
  (= spellings (buffer-spellings doc.source :line line))
  (return [(completion-label (py-name name) spellings) for name in names]))

(def merged-items [doc line view items]
  "lispython's own items (lispython-items, then each macro of the view under
   the hyphen spelling of its registered key, view.macros) followed by
   items, the backend's (backend-items), whose name (name-key) none of them
   has: a
   special form or macro wins over whatever the backend offers by that
   name.  Over a fallback view (only the text before the cursor compiled)
   the buffer's definitions the backend could not see
   (buffer-definition-names at the 1-based line) follow."
  (= merged (lispython-items))
  (= taken (set [(name-key item.label) for item in merged]))
  ;; view.macros is keyed by name-key, as taken is, and holds the spelling.
  (for name in (sorted view.macros)
    ;; A qualified macro (module.name) is typed as an attribute
    ;; (qualified-macro-items).
    (if (and (not-in "." name) (not-in name taken))
        (do (= label (hyphen-spelling (sub view.macros name)))
            (.add taken name)
            (.append merged (own-item label *_MACRO-STYLE)))))
  (= rest (list items))
  (if view.fallback
      (.extend rest [(lsp.CompletionItem :label name
                                         :kind lsp.CompletionItemKind.Variable)
                     for name in (buffer-definition-names doc line)]))
  (for item in rest
    (= name (name-key item.label))
    (if (not-in name taken)
        (do (.add taken name)
            (.append merged item))))
  (return merged))

(def qualified-macro-items [doc line col view]
  "The macros of view a (require mod) registered for the base written glued
   to the dot before the word at the 1-based line and code-point col
   (glued-base: mod.|, a.b.ma|; never (. mod |), since such a macro is
   called only as mod.name), as own items labelled by the hyphen spelling
   of the name each was registered under (view.macros, hyphen-spelling:
   my-mac, whether defined as my-mac or my_mac).  The require registers
   them as mod.name keys of the macro table, and no backend knows them: it
   never binds mod at runtime."
  (= text (line-text doc.source line))
  (= base (glued-base text (sub (partial-span text (min col (len text))) 0)))
  (if (is base None)
      (return []))
  (= prefix (+ (name-key base) "."))
  (= items [])
  ;; Matched by name-key, so a key of a.b.c is never one of a's.
  (for key in (sorted view.macros)
    (if (.startswith key prefix)
        (do (= name (sub key [: (len prefix) None]))
            (if (and name (not-in "." name))
                ;; name-key only turns a part's - into _, so the spelling's
                ;; base prefix is as long as the key's.
                (.append items (own-item (hyphen-spelling
                                           (sub (sub view.macros key)
                                                [: (len prefix) None]))
                                         *_MACRO-STYLE))))))
  (return items))

;; Seconds a completion off an attribute waits for a backend already
;; running: its answer only refines the local list, so a slow backend never
;; holds up typing.
(= MERGE-TIMEOUT 0.5)

(def attribute-context-p [source line col]
  "Whether the cursor may be on an attribute name: a dot right before the
   word (x.a|, (.me| x)) or an operand past the receiver of an open
   (. recv ...).  A cheap gate, read before any view is compiled (the
   Python view's attribute decides what the backend is asked); it also
   makes the local answer empty (local-completion) when there is no
   backend answer, no view or no items."
  (= text (line-text source line))
  (= col (min col (len text)))
  (= start (sub (partial-span text col) 0))
  (if (and (> start 0) (== (sub text (- start 1)) "."))
      (return True))
  (= prefix (source-prefix source line col))
  (= closers (open-form-closers prefix :literals True))
  (if (is closers None)
      (return False))
  (= [path leaf] (open-path (parse (+ prefix closers) :partial True) line col))
  (if (or (not path) (!= (head-of (sub path -1)) "."))
      (return False))
  (= form (sub path -1))
  (return (or (> (len form) 2) (and (== (len form) 2) (is leaf None)))))

(async-def backend-request [client doc line col timeout method make-params
                            :failed None]
  "(view, answer): the cursor view of doc at the 1-based line and
   code-point col, or None, and the backend's answer to request method
   there, or failed (default None) when there is none: no view, no
   request, or none answered (view-request).  A backend's null answer is
   None, told apart from failed only when failed is not None.  make-params
   builds the request's params from the backend's TextDocumentIdentifier
   and the view; None sends no request.  timeout (None: REQUEST-TIMEOUT,
   read at each call) bounds the view and the request together, the
   backend's start included."
  (= loop (asyncio.get-running-loop))
  (= deadline (+ (.time loop) (ife (is timeout None) REQUEST-TIMEOUT timeout)))
  (= path (to-fs-path doc.uri))
  (if (is path None)
      (return (, None failed)))
  (= [name package import-root] (module-names path))
  (= making (scheduled-cursor-view doc.uri doc.version doc.source line col
                                   name package import-root))
  (try
    (= view (await (asyncio.wait-for making (max 0 (- deadline (.time loop))))))
    (except [TimeoutError]
      (return (, None failed))))
  (if (is view None)
      (return (, None failed)))
  (= params (make-params (lsp.TextDocumentIdentifier :uri (.backend-uri client doc.uri))
                         view))
  (if (is params None)
      (return (, view failed)))
  (return (, view (await (view-request client doc view method params deadline
                                       :failed failed)))))

(async-def view-request [client doc view method params deadline :failed None]
  "The backend's answer to request method with params over view, doc's
   cursor view, synced as doc's text first; failed (default None) when it
   gives none (BackendClient.request).  deadline is the loop time it must
   answer by, or None for the request's default."
  (return (await (.request client method params
                           :uri doc.uri :text view.text :origin (, doc.source view)
                           :timeout (ife (is deadline None) None
                                         (max 0 (- deadline (.time (asyncio.get-running-loop)))))
                           :failed failed))))

(async-def backend-answer [client doc line col timeout]
  "(view, items, incomplete): the cursor view of doc, the backend's
   completion items there ([] when either is missing, backend-request) and
   whether the backend marked its list incomplete."
  (= [view answer] (await (backend-request
                            client doc line col timeout lsp.TEXT_DOCUMENT_COMPLETION
                            (fn [document view]
                              (lsp.CompletionParams :text-document document
                                                    :position (generated-position view))))))
  (return (, view (completion-items answer)
             (and (isinstance answer lsp.CompletionList) (is answer.is-incomplete True)))))

(async-def backend-completion [doc line col insert-replace]
  "The completion answer with the Python backend's help, or None when it
   gives none (no backend, a buffer with no Python view, no items), and
   local-completion is the answer (empty at an attribute,
   attribute-context-p).  doc is a snapshot (document-snapshot).
   On an attribute the backend's items answer, after the qualified macros
   of its base (qualified-macro-items, winning by name-key), which answer
   alone when the backend gives no items; the request may start the
   backend.  Elsewhere lispython's own items merged with the
   backend's (merged-items) do, from an already running backend within
   MERGE-TIMEOUT, and a backend not yet running is started without
   waiting for it (start-soon)."
  (= client (.available-client backends doc.uri))
  (if (is client None)
      (return None))
  (= attribute (attribute-context-p doc.source line col))
  (if (and (not attribute) (not client.running))
      ;; Start one for the next keystroke, and answer this one now.
      (do (.start-soon client)
          (return None)))
  (= [view items incomplete] (await (backend-answer client doc line col
                                                    (ife attribute None MERGE-TIMEOUT))))
  (if (is view None)
      (return None))
  (= found (backend-items doc line col items insert-replace
                         (buffer-spellings doc.source :line line)))
  (= macros (qualified-macro-items doc line col view))
  (cond macros
        (do (= taken (set [(name-key item.label) for item in macros]))
            (= found (+ macros [item for item in found
                                if (not-in (name-key item.label) taken)])))
        (not found)
        (return None)
        (not view.attribute)
        (= found (merged-items doc line view found)))
  (return (lsp.CompletionList :is-incomplete incomplete :items found)))

(def document-snapshot [doc]
  "doc's text, version and position codec as they are now.  A handler that
   awaits reads the buffer from the snapshot, never from the live document,
   which an edit during the await changes under the cursor it computed.
   A document that is not open is read from disk (pygls); one that cannot
   be read (missing, not UTF-8) is snapshot as empty text, so a handler
   gives its general or empty answer instead of raising."
  (try
    (= source doc.source)
    ;; UnicodeDecodeError is a ValueError.
    (except [(, OSError ValueError)]
      (= source "")))
  (return (TextDocument doc.uri source
                        :version (getattr doc "version" None)
                        :position-codec (getattr doc "position_codec" None))))

;; ---------------------------------------------------------------------------
;; Hover and signature help through the Python backend
;; ---------------------------------------------------------------------------

;; One scan of a backend's Python text: a quoted string literal (group 1,
;; "..." or '...' with backslash escapes, kept as it is: Literal["a_b"] and
;; a default = 'a_b' are values, not names), or a Python identifier, a word
;; that starts with no digit (the e5 of 1e5, the _000 of 1_000 are none).
(= _PY-TEXT (re.compile "(\"(?:[^\"\\\\\\n]|\\\\.)*\"|'(?:[^'\\\\\\n]|\\\\.)*')|(?<!\\w)[^\\W\\d]\\w*"))

(def python-to-buffer [text spellings]
  "(new-text, mapped): text with every Python identifier outside a string
   literal written as completion labels it (completion-label over
   spellings, buffer-spellings' map keyed by Python name: ensure_ascii as
   ensure-ascii, _T_co as _T-co, the buffer's ok? for ok_p), and a
   function taking an offset into text to the same place in new-text.
   String literals keep the library's text."
  (= pieces [])
  ;; (old start, old end, new start, new end) of each replaced name
  (= edits [])
  (= done 0)
  (= shift 0)
  (for m in (.finditer _PY-TEXT text)
    (if (is-not (.group m 1) None)
        (continue))
    (= spelled (completion-label (.group m) spellings))
    (if (== spelled (.group m))
        (continue))
    (.append pieces (sub text [: done (.start m)]))
    (.append pieces spelled)
    (.append edits (, (.start m) (.end m)
                      (+ (.start m) shift) (+ (.start m) shift (len spelled))))
    (+= shift (- (len spelled) (len (.group m))))
    (= done (.end m)))
  (.append pieces (sub text [: done None]))
  (def mapped [offset]
    (= delta 0)
    (for [old-start old-end new-start new-end] in edits
      (cond (>= offset old-end)
            (= delta (- new-end old-end))
            (> offset old-start)
            (return (min (+ new-start (- offset old-start)) new-end))
            True
            (break)))
    (return (+ offset delta)))
  (return (, (.join "" pieces) mapped)))

(def markdown-to-buffer [text spellings]
  "Markdown text with python-to-buffer applied inside its fenced code blocks
   only: the prose around them (a docstring, its inline code spans
   included) is the library's words, written in Python, where a name may
   be an ordinary word."
  (= lines (.split text "\n"))
  (= fenced False)
  (for i in (range (len lines))
    (cond (.startswith (.lstrip (sub lines i)) "```")
          (= fenced (not fenced))
          fenced
          (= (sub lines i) (sub (python-to-buffer (sub lines i) spellings) 0))))
  (return (.join "\n" lines)))

(def marked-markdown [contents]
  "The markdown of a hover's deprecated MarkedString contents: a string
   (markdown already), a {language value} block, or a list of either."
  (cond (isinstance contents str)
        (return contents)
        (isinstance contents lsp.MarkedStringWithLanguage)
        (return f"```{contents.language}\n{contents.value}\n```")
        (isinstance contents (, list tuple))
        (return (.join "\n\n" (map marked-markdown contents))))
  (return ""))

(def documentation-to-buffer [documentation spellings]
  "A backend's documentation (MarkupContent, a string or None) with the
   buffer's spellings in its markdown code blocks; plain text is kept as
   it is, since nothing there tells a name from prose."
  (if (and (isinstance documentation lsp.MarkupContent)
           (== documentation.kind lsp.MarkupKind.Markdown))
      (return (lsp.MarkupContent
                :kind lsp.MarkupKind.Markdown
                :value (markdown-to-buffer documentation.value spellings))))
  (return documentation))

(def hover-contents [contents spellings]
  "A backend Hover's contents as the buffer's MarkupContent, or None when
   it is empty (documentation-to-buffer; MarkedString forms become
   markdown)."
  (if (not (isinstance contents lsp.MarkupContent))
      (= contents (lsp.MarkupContent :kind lsp.MarkupKind.Markdown
                                     :value (marked-markdown contents))))
  (if (not (.strip contents.value))
      (return None))
  (return (documentation-to-buffer contents spellings)))

(def hover-request [head offset]
  "make-params of a hover at the generated start of the restored word
   (offset code points from the view's cursor), or of none when head, the
   hovered symbol's name-key, is a macro of the view."
  (return (fn [document view]
            (ife (in head view.macros)
                 None
                 (lsp.HoverParams :text-document document
                                  :position (generated-position view :offset offset))))))

(def cursor-word [doc line col]
  "(start, end, offset) of the word at the 1-based line and code-point col
   of doc (partial-span), or None when there is none: a backend asks about
   it over a view made with the cursor at end, at offset code points from
   that view's cursor, the word's generated start."
  (= text (line-text doc.source line))
  (= [start end] (partial-span text (min col (len text))))
  (if (== start end)
      (return None))
  (return (, start end (- (len (py-name (sub text [: start end])))))))

(async-def backend-hover [doc line col target]
  "The backend's Hover of the word at the 1-based line and code-point col
   (Symbol target there), or None: no backend, no word, target names a
   macro, no view, no answer.  doc is a snapshot.  The view is made with the
   cursor at the word's end, so its partial is the whole word, and the
   hover asks at the word's generated start.  Its names take the buffer's
   spellings, and its range is the .lpy word: the backend's lies in
   generated code."
  (= client (.available-client backends doc.uri))
  (if (is client None)
      (return None))
  (= word (cursor-word doc line col))
  (if (is word None)
      (return None))
  (= [start end offset] word)
  (= [view answer] (await (backend-request client doc line end None lsp.TEXT_DOCUMENT_HOVER
                                           (hover-request (name-key target.value) offset))))
  (if (not (isinstance answer lsp.Hover))
      (return None))
  (= contents (hover-contents answer.contents (buffer-spellings doc.source)))
  (if (is contents None)
      (return None))
  (return (lsp.Hover :contents contents
                     :range (lsp.Range :start (client-position doc line start)
                                       :end (client-position doc line end)))))

;; The backend is always asked for offset parameter labels (backend.lpy
;; _client-capabilities), which are mapped through the label's relabel;
;; an editor that never advertised labelOffsetSupport gets the text they
;; span instead.  Both count code points; a label holding a character
;; outside the BMP (two UTF-16 units) would put them off by one.
(def signature-to-buffer [signature spellings :offsets False]
  "A backend SignatureInformation with the buffer's spellings: its label, a
   string parameter label, an offset parameter label mapped through the
   label's relabel (as offsets when offsets, label-offset-support's answer
   for the editor, else as the text they span), and the markdown code
   blocks of its documentation."
  (= [label mapped] (python-to-buffer signature.label spellings))
  (def parameter-label [parameter]
    (if (isinstance parameter.label str)
        (return (sub (python-to-buffer parameter.label spellings) 0)))
    (= span (, (mapped (sub parameter.label 0)) (mapped (sub parameter.label 1))))
    (return (ife offsets span (sub label [: (sub span 0) (sub span 1)]))))
  (= parameters None)
  (if (is-not signature.parameters None)
      (= parameters
         [(lsp.ParameterInformation
            :label (parameter-label parameter)
            :documentation (documentation-to-buffer parameter.documentation spellings))
          for parameter in signature.parameters]))
  (return (lsp.SignatureInformation
            :label label
            :documentation (documentation-to-buffer signature.documentation spellings)
            :parameters parameters
            :active-parameter signature.active-parameter)))

(def signature-request [head]
  "make-params of a signature help at the view's cursor, or of none when
   head, the innermost open form's head symbol (or None), is a macro of the
   view."
  (= head (ife (is head None) None (name-key head)))
  (return (fn [document view]
            (ife (in head view.macros)
                 None
                 (lsp.SignatureHelpParams :text-document document
                                          :position (generated-position view))))))

(async-def backend-signature-help [doc line col head :offsets False]
  "The backend's SignatureHelp at the 1-based line and code-point col, its
   names in the buffer's spellings, or None: no backend, head (the
   innermost open form's head symbol, None when it has none) is a macro, no
   view, no signature.  doc is a snapshot.  The cursor view puts the
   sentinel where the argument is typed, so the backend sees the call.
   offsets is signature-to-buffer's."
  (= client (.available-client backends doc.uri))
  (if (is client None)
      (return None))
  (= [view answer] (await (backend-request client doc line col None
                                           lsp.TEXT_DOCUMENT_SIGNATURE_HELP
                                           (signature-request head))))
  (if (or (not (isinstance answer lsp.SignatureHelp)) (not answer.signatures))
      (return None))
  (= spellings (buffer-spellings doc.source))
  (return (lsp.SignatureHelp
            :signatures [(signature-to-buffer signature spellings :offsets offsets)
                         for signature in answer.signatures]
            :active-signature answer.active-signature
            :active-parameter answer.active-parameter)))

(def with-filter-texts [doc line col answer]
  "answer with a filterText (filter-text, the label's py-name as the name)
   on every item that has none, typed from completion-ranges at the 1-based
   line and code-point col: the one pass that puts every item, whichever
   builder made it (own items, macros, the fallback lists), under the rule
   backend-items follows."
  (= typed (sub (completion-ranges doc line col) 2))
  (for item in answer.items
    (if (is item.filter-text None)
        (= item.filter-text (filter-text item.label (py-name item.label) typed))))
  (return answer))

(deco (server.feature
        lsp.TEXT_DOCUMENT_COMPLETION
        (lsp.CompletionOptions :trigger-characters ["." "-"]))
(async-def completion [ls params]
  (= doc (document-snapshot (.get-text-document ls.workspace params.text_document.uri)))
  (try
    (= [line col] (cursor-of doc params.position))
    (except [Exception]
      (.debug logger "completion position failed" :exc-info True)
      (return (local-completion doc))))
  (= insert-replace (insert-replace-support ls))
  (try
    (= result (await (backend-completion doc line col insert-replace)))
    (except [Exception]
      (.debug logger "backend completion failed" :exc-info True)
      (= result None)))
  (if (is result None)
      (= result (local-completion doc :line line :col col)))
  (return (with-filter-texts doc line col result))))

;; ---------------------------------------------------------------------------
;; Definition and references through the Python backend
;; ---------------------------------------------------------------------------

(def cursor-symbol [ls params]
  "(doc, tree, line, col, target) of a request at params' position: a
   snapshot of the document (document-snapshot), its partial parse, the
   cursor as (1-based line, code-point column) and the Symbol there; None
   when there is no Symbol."
  (= doc (document-snapshot (.get-text-document ls.workspace params.text_document.uri)))
  (try
    (= tree (parse doc.source :partial True))
    (= [line col] (cursor-of doc params.position))
    (except [Exception]
      (return None)))
  (= target (node-at-position tree (- line 1) col))
  (if (not (isinstance target Symbol))
      (return None))
  (return (, doc tree line col target)))

;; The views of .lpy files the backend read as shadows on disk, keyed by uri
;; and by the source text itself (python_view.ViewCache).
(= disk-views (ViewCache))

(def answer-locations [answer]
  "(uri, range) of each location of a definition or references answer:
   None, a Location, or a list of Location or LocationLink (its target and
   target selection range)."
  (if (is answer None)
      (return (list)))
  (if (not (isinstance answer (, list tuple)))
      (= answer [answer]))
  (= found [])
  (for item in answer
    (cond (isinstance item lsp.Location)
          (.append found (, item.uri item.range))
          (isinstance item lsp.LocationLink)
          (.append found (, item.target-uri item.target-selection-range))))
  (return found))

(def disk-origin [lpy-uri shadow-path generation]
  "(source, view) of the .lpy file at lpy-uri as it is on disk, or None: its
   view must be exactly the text of shadow-path, the shadow the backend
   read, since the backend's positions lie in that text.  It runs the
   file's macros, so callers run it in a thread, reading disk-views'
   generation before the hand-off.  A file that cannot be read loses its
   disk-views entry, so a deleted file's view does not stay resident."
  (= lpy-path (to-fs-path lpy-uri))
  (if (or (is lpy-path None) (is shadow-path None))
      (return None))
  (try
    (with [(open lpy-path "r" :encoding "utf-8") as f]
      (= source (.read f)))
    (with [(open shadow-path "r" :encoding "utf-8") as f]
      (= shadow (.read f)))
    (except [(, OSError ValueError)]
      (.forget disk-views lpy-uri)
      (return None)))
  (= [name package import-root] (module-names lpy-path))
  (= view (.view disk-views lpy-uri source source :name name :package package
                 :import-root import-root :generation generation))
  (if (or (is view None) (!= view.text shadow))
      (return None))
  (return (, source view)))

(def origin-span [origin rng :map-range lpy-range]
  "rng, a backend range over the text of origin's view in UTF-16 units (the
   protocol's default, which the backend client keeps: generated-position),
   as the ((line col) (line col)) span of origin's .lpy source in code
   points that map-range (lpy-range's arguments and answer) gives, or None
   when it maps nowhere."
  (= [source view] origin)
  (= codec (PositionCodec))
  (= gen-lines view.lines)
  (= start (.position-from-client-units codec gen-lines rng.start))
  (= end (.position-from-client-units codec gen-lines rng.end))
  (return (map-range view source (, (+ start.line 1) start.character)
                     (, (+ end.line 1) end.character))))

(def span-range [doc span lines]
  "The code-point span ((line col) (line col)) over lines as an LSP Range
   in doc's client units."
  (= [[start-line start-col] [end-line end-col]] span)
  (return (lsp.Range :start (client-position doc start-line start-col :lines lines)
                     :end (client-position doc end-line end-col :lines lines))))

(def origin-range [doc origin rng]
  "rng (origin-span's) as the range of origin's .lpy source in doc's
   client units, or None when it maps nowhere (lpy-range)."
  (= span (origin-span origin rng))
  (if (is span None)
      (return None))
  (return (span-range doc span (.split (sub origin 0) "\n"))))

(def utf16-client-p [doc]
  "Whether doc's editor counts positions in UTF-16 units, as the backend
   does (a document without a codec counts code points)."
  (= codec (getattr doc "position_codec" None))
  (return (and (is-not codec None)
               (== (getattr codec "encoding" None) lsp.PositionEncodingKind.Utf16))))

(def file-range [doc uri rng]
  "rng, a backend range in UTF-16 units over the real file at uri, in doc's
   client units: unchanged for an editor that counts UTF-16, else
   converted over the lines it touches, the only ones kept as the file is
   read; unchanged too when the file cannot be read or is shorter."
  (if (utf16-client-p doc)
      (return rng))
  (= path (to-fs-path uri))
  (= first-line (min rng.start.line rng.end.line))
  (= last-line (max rng.start.line rng.end.line))
  (= lines [])
  (try
    (with [(open path "r" :encoding "utf-8") as f]
      (for line in f
        (.append lines (ife (< (len lines) first-line) "" line))
        (if (> (len lines) last-line)
            (break))))
    (except [(, OSError ValueError TypeError)]
      (return rng)))
  (if (<= (len lines) last-line)
      (return rng))
  (= utf16 (PositionCodec))
  (= start (.position-from-client-units utf16 lines rng.start))
  (= end (.position-from-client-units utf16 lines rng.end))
  (return (lsp.Range :start (client-position doc (+ start.line 1) start.character
                                             :lines lines)
                     :end (client-position doc (+ end.line 1) end.character
                                           :lines lines))))

(async-def within [deadline awaitable default]
  "awaitable's result, or default when the loop's clock passes deadline
   first."
  (try
    (return (await (asyncio.wait-for awaitable
                                     (max 0 (- deadline (.time (asyncio.get-running-loop)))))))
    (except [TimeoutError]
      (return default))))

(async-def editor-location [doc place uri rng origins deadline]
  "The backend's location uri, rng, placed by BackendClient.locate (place),
   as the editor's Location, or None when it lies nowhere the editor has,
   or did not map by deadline (the loop's clock): its .lpy view, or a real
   file's range for an editor that does not count UTF-16.  origins caches,
   for one answer, the disk origin (disk-origin) of each .lpy uri, so each
   file compiles at most once."
  (if (is place None)
      (return None))
  (if (== (sub place 0) "file")
      ;; A real .py or stub: the backend's range is in UTF-16 units over
      ;; that file, converted only for an editor counting otherwise.
      (do (= mapped (ife (utf16-client-p doc)
                         rng
                         (await (within deadline
                                        (asyncio.to-thread file-range doc (sub place 1) rng)
                                        None))))
          (return (ife (is mapped None) None (lsp.Location :uri (sub place 1) :range mapped)))))
  (= [_ lpy-uri origin] place)
  (if (is origin None)
      (do (if (not-in lpy-uri origins)
              (= (sub origins lpy-uri)
                 (await (within deadline
                                (asyncio.to-thread disk-origin lpy-uri (to-fs-path uri)
                                                   disk-views.generation)
                                None))))
          (= origin (sub origins lpy-uri))))
  (if (is origin None)
      (return None))
  (= mapped (origin-range doc origin rng))
  (if (is mapped None)
      (return None))
  (return (lsp.Location :uri lpy-uri :range mapped)))

;; ---------------------------------------------------------------------------
;; Diagnostics from the Python backend
;; ---------------------------------------------------------------------------

;; The tags of a hint the editor greys or strikes out, which maps only onto
;; code that is the very thing it marks (lpy-diagnostic-range).
(= HINT-TAGS (frozenset [lsp.DiagnosticTag.Unnecessary lsp.DiagnosticTag.Deprecated]))

;; A quoted Python identifier in a backend's message, as pyright quotes a name
;; in double quotes ("my_x" is not defined) and pyrefly in backticks
;; (Could not find name `my_x`).  Group 1 is the quote, kept as it was; group 2
;; the name.
(= _QUOTED-NAME (re.compile "([\"`])([^\\W\\d]\\w*)\\1"))

(def message-to-buffer [message lines span]
  "A backend's message with each quoted Python name that a symbol inside
   span (the .lpy code the diagnostic maps onto, over lines, source-lines')
   spells in the buffer's spelling (spelled-in, by py-name): my_x as the
   my-x written there.  Anything else quoted stays as it is: a name spelled
   only elsewhere may be no symbol at all (a TypedDict key, a string)."
  (= [start end] span)
  (def spelled [m]
    (= found (spelled-in lines start end (.group m 2)))
    (if (or (is found None) (!= (sub (sub found 0) 0) (sub (sub found 1) 0)))
        (return (.group m 0)))
    (= [[line col] [_ end-col]] found)
    (= quote (.group m 1))
    (return f"{quote}{(sub (sub lines (- line 1)) [: col end-col])}{quote}"))
  (return (.sub _QUOTED-NAME spelled message)))

(async-def editor-diagnostic [doc origin lines diagnostic places origins deadline]
  "The backend's diagnostic over origin's view as the editor's on the .lpy
   document doc (a snapshot of origin's source, split as lines), or None
   to drop it: its range by lpy-diagnostic-range, its message in the
   buffer's spelling (message-to-buffer), each related location from its
   place (located when the backend published, BackendClient.locate) as a
   definition's is (editor-location; one that maps nowhere is dropped), its
   source the backend's name.  Severity, code, its description and tags are
   kept; data is never passed on, since it describes generated code."
  (= tagged (bool (& (set (or diagnostic.tags (list))) HINT-TAGS)))
  (= span (origin-span origin diagnostic.range
                       :map-range (fn [view source start end]
                                    (lpy-diagnostic-range view source start end tagged))))
  (if (is span None)
      (return None))
  (= related None)
  (if diagnostic.related-information
      (do (= related [])
          (for [info place] in (zip diagnostic.related-information places)
            (= location (await (editor-location doc place info.location.uri
                                                info.location.range origins deadline)))
            (if (is-not location None)
                (.append related
                  (lsp.DiagnosticRelatedInformation :location location
                                                    :message info.message))))))
  (return (lsp.Diagnostic
            :range (span-range doc span lines)
            :severity diagnostic.severity
            :code diagnostic.code
            :code-description diagnostic.code-description
            :source backends.name
            :message (message-to-buffer diagnostic.message lines span)
            :tags diagnostic.tags
            :related-information (or related None))))

(def suppressed-p [diagnostic ignores]
  "Whether the editor's diagnostic is suppressed by a suppression comment
   on the .lpy line its range starts on (ignores, suppression-comments'):
   a bare one suppresses every rule, a listed one the rules it names."
  (= line (+ diagnostic.range.start.line 1))
  (if (not-in line ignores)
      (return False))
  (= rules (sub ignores line))
  (return (or (is rules None) (in diagnostic.code rules))))

(async-def mapped-backend-diagnostics [run]
  "The backend's diagnostics published for run's view, the full view of its
   document's source, as the editor's (editor-diagnostic), in the backend's
   order, less those a suppression comment of the backend's tool
   suppresses (; pyright: ignore or ; pyrefly: ignore, suppression-tool;
   suppressed-p; the comments read once per run); [] when it has published none for that
   text.  DIAGNOSTICS-TIMEOUT bounds the mapping of related locations."
  (= doc run.doc)
  (= published (.backend-diagnostics backends doc.uri run.view.text))
  (if (is published None)
      (return (list)))
  (if (is run.ignores None)
      (= run.ignores (suppression-comments doc.source (suppression-tool backends.name))))
  (= origin (, doc.source run.view))
  (= lines (source-lines doc.source))
  (= deadline (+ (.time (asyncio.get-running-loop)) DIAGNOSTICS-TIMEOUT))
  (= origins {})
  (= result [])
  (for [diagnostic places] in published
    (try
      (= mapped (await (editor-diagnostic doc origin lines diagnostic places origins
                                          deadline)))
      (except [Exception]
        (.debug logger "backend diagnostic dropped" :exc-info True)
        (= mapped None)))
    (if (and (is-not mapped None) (not (suppressed-p mapped run.ignores)))
        (.append result mapped)))
  (return result))

(def location-request [head offset make whole]
  "make-params of a definition or references request at the generated start
   of the restored word (offset code points from the view's cursor), built
   by make from the document and that position, or of none when head, the
   symbol's name-key, is a macro of the view, or when whole (the request
   needs the whole buffer, as references do) and the view is a fallback:
   only the text before the cursor compiled, so the backend would miss
   every use after it, and its partial answer would replace the complete
   local one."
  (return (fn [document view]
            (ife (or (in head view.macros) (and whole view.fallback))
                 None
                 (make document (generated-position view :offset offset))))))

;; backend-locations' answer when the backend found locations but none maps
;; to the editor.
(= UNMAPPED (object))

;; view-request's failed value in definition-answer: the check gave no answer.
(= UNCHECKED (object))

;; backend-request's failed value in backend-locations: no answer, as against
;; the backend's null answer (None), which found nothing.
(= NO-ANSWER (object))

(async-def definition-answer [client doc view offset answer deadline]
  "answer, the backend's definition answer at the word offset code points
   from view's cursor, checked: [] when it is for an enclosing node, None
   when that cannot be checked by deadline."
  ;; basedpyright (DEFINITION-WALKS-UP) answers definition on a name with
  ;; no declarations (an undefined name or attribute) for the enclosing
  ;; call or operator: print in (print (+ nosuch 1)).  Its typeDefinition
  ;; never walks up: it gives the class of the name's type, else the name's
  ;; own declarations, so it is empty when the name has neither, and then
  ;; the name has no definition of its own.  The hole: a name with no
  ;; declarations but a class type (an attribute resolved through
  ;; __getattr__) gets that class from typeDefinition and keeps the
  ;; walked-up answer.  A word in an import statement is exempt
  ;; (view.in-import): typeDefinition misses module and source names there
  ;; (path in import os.path), and the walk-up never leaves an import,
  ;; which holds no expression to walk up to.
  (if (or (not client.definition-walks-up) (not (answer-locations answer))
          view.in-import)
      (return answer))
  (= types (await (view-request client doc view lsp.TEXT_DOCUMENT_TYPE_DEFINITION
                                (lsp.TypeDefinitionParams
                                  :text-document (lsp.TextDocumentIdentifier
                                                   :uri (.backend-uri client doc.uri))
                                  :position (generated-position view :offset offset))
                                deadline :failed UNCHECKED)))
  (cond (is types UNCHECKED)
        (return None)
        (not (answer-locations types))
        (return [])
        True
        (return answer)))

(async-def backend-locations [doc line col target method make :whole False]
  "The backend's answer to definition or references request method (params
   from make, location-request) on the word at the 1-based line and
   code-point col (Symbol target there), as editor Locations in answer
   order without repeats: a list (empty only when the backend found
   nothing, a null answer included); UNMAPPED when no location the backend
   gave maps to the editor; None when there is no backend, no word, no view
   or no answer, and for a null answer over a fallback view (only the text
   before the cursor compiled, so a binding after it was never seen).
   doc is a snapshot.  The view
   is made with the cursor at the word's end and the request asks at its
   generated start (cursor-word, as backend-hover).  A location in a compiled view
   maps back to its .lpy (lpy-range), one in a real file passes, one that
   maps nowhere is dropped (editor-location).  whole is
   location-request's: no request over a fallback view.  A definition
   answer is checked (definition-answer).  REQUEST-TIMEOUT bounds the
   requests and the mapping together: a location whose file has not mapped
   by then is dropped."
  (= client (.available-client backends doc.uri))
  (if (is client None)
      (return None))
  (= word (cursor-word doc line col))
  (if (is word None)
      (return None))
  (= [start end offset] word)
  (= deadline (+ (.time (asyncio.get-running-loop)) REQUEST-TIMEOUT))
  (= [view answer] (await (backend-request client doc line end REQUEST-TIMEOUT method
                                           (location-request (name-key target.value)
                                                             offset make whole)
                                           :failed NO-ANSWER)))
  (if (is answer NO-ANSWER)
      (return None))
  ;; A null answer is the backend's: it found nothing (an undefined name
  ;; has no definition, whatever another scope binds by that name), so it
  ;; is final, as an empty list is.
  (if (is answer None)
      (return (ife view.fallback None [])))
  ;; Every location is placed now, before any await: a sync meanwhile (a
  ;; push-buffer, another request) replaces an origin in the client.  The
  ;; buffer's own maps by the view this answer was computed over.
  (= own {doc.uri (, doc.source view)})
  (= placed [(, (.locate client uri :origins own) uri rng)
             for [uri rng] in (answer-locations answer)])
  (if (== method lsp.TEXT_DOCUMENT_DEFINITION)
      (do (= answer (await (definition-answer client doc view offset answer deadline)))
          (cond (is answer None)
                (return None)
                (not (answer-locations answer))
                (return []))))
  (= origins {})
  (= seen (set))
  (= result [])
  (for [place uri rng] in placed
    (= location (await (editor-location doc place uri rng origins deadline)))
    (if (is location None)
        (continue))
    (= key (, location.uri location.range.start.line location.range.start.character
              location.range.end.line location.range.end.character))
    (if (not-in key seen)
        (do (.add seen key)
            (.append result location))))
  ;; Locations the backend found but none of which maps to the editor
  ;; (generated code, a cache file, a stale shadow) are no answer: the
  ;; name exists, so the buffer's own lookup answers.  Only an empty
  ;; answer is final.
  (if (and placed (not result))
      (return UNMAPPED))
  (return result))

(deco (server.feature lsp.TEXT_DOCUMENT_REFERENCES)
(async-def references [ls params]
  (= found (cursor-symbol ls params))
  (if (is found None)
      (return None))
  (= [doc tree line col target] found)
  ;; A form a user can bind counts only its form heads: its other uses are
  ;; the name.
  (if (form-at-p tree target)
      (return (collect-references tree target.value doc.uri
                                  :among (ife (in target.value BINDABLE-FORMS)
                                              (form-heads tree)
                                              None))))
  ;; A local binding goes to the backend too: its uses in other .lpy files
  ;; are what references across files are for.  Its answer, once given, is
  ;; final (as in definition); a macro is never asked (location-request).
  (= context (or (getattr params "context" None)
                 (lsp.ReferenceContext :include-declaration True)))
  (try
    (= result (await (backend-locations doc line col target lsp.TEXT_DOCUMENT_REFERENCES
                                        (fn [document position]
                                          (lsp.ReferenceParams :text-document document
                                                               :position position
                                                               :context context))
                                        :whole True)))
    (except [Exception]
      (.debug logger "backend references failed" :exc-info True)
      (= result None)))
  (if (and (is-not result None) (is-not result UNMAPPED))
      (return result))
  (return (collect-references tree target.value doc.uri))))

(deco (server.feature lsp.WORKSPACE_SYMBOL)
(def workspace-symbol [ls params]
  (= query (.lower params.query))
  (return [symbol
           for symbols in (.values WORKSPACE-SYMBOLS)
           for symbol in symbols
           if (in query (.lower symbol.name))])))
