(require lispy.macros *)

(import asyncio)
(import builtins)
(import glob)
(import inspect)
(import logging)
(import os)
(import os.path as osp)
(import re)
(import pathlib)

(from lsprotocol [types as lsp])
(from pygls.lsp.server [LanguageServer])
(from pygls.uris [to-fs-path])
(from pygls.workspace [PositionCodec])

(from lispy.core.nodes *)
(from lispy.core.errors [compile-errors LispyCompileError])
(from lispy.core.parser [parse tokenize])
(from lispy.core.compiler.stmt [import-bindings type-alias-p])
(from lispy.core.compiler.utils [FORM-USAGE HEADLESS-FORMS])
(from lispy.core.utils [augassignop-dict])
(from lispy.core.meta-functions [require-selection REQUIRE-QUALIFIED REQUIRE-ALL])
(from lispy.lsp.python-view [ViewCache module-names open-form-closers partial-span
                             py-name source-prefix view-at-cursor])
(from lispy.lsp.backend [Backends])

(= logger (logging.getLogger __name__))

;; ---------------------------------------------------------------------------
;; Server instance
;; ---------------------------------------------------------------------------

(= server (LanguageServer "lpy-lsp" "v0.1.0"))

;; ---------------------------------------------------------------------------
;; Special-form documentation (for hover)
;; ---------------------------------------------------------------------------

;; Statement and expression forms: the usage line is FORM-USAGE (the
;; compiler's own error-message table), so hover and compile errors cannot
;; drift apart. Only the explanatory sentence is written here, keyed by
;; FORM-USAGE key.
(= FORM-PROSE
  {"def"       "Define a function. Arguments are given in a bracket list. An optional docstring can follow the argument list."
   "async-def" "Define an async function (coroutine)."
   "class"     "Define a class. Bases are given in a bracket list."
   "if"        "Conditional statement. Compiles to Python `if/else`."
   "while"     "While loop."
   "for"       "For loop. `target` is bound to each element of `iterable`."
   "async-for" "Async for loop — use inside `async-def`."
   "match"     "Structural pattern matching (Python 3.10+)."
   "case"      "One arm of a `match`: a pattern, an optional `as` name and `if` guard, then the body."
   "try"       "Try/except/finally statement."
   "except"    "Exception handler clause of a `try`."
   "except*"   "Exception-group handler clause of a `try` (Python 3.11+)."
   "else"      "Clause of a `try` that runs when no exception was raised."
   "finally"   "Clause of a `try` that always runs on exit."
   "with"      "Context manager statement."
   "async-with" "Async context manager — use inside `async-def`."
   "="         "Assignment statement."
   "raise"     "Raise an exception."
   "assert"    "Assert that a condition is true."
   "del"       "Delete a name or item."
   "global"    "Declare names as global variables."
   "nonlocal"  "Declare names as nonlocal variables."
   "deco"      "Apply a decorator to the following function/class definition."
   "|"         "Bitwise OR as an operator; inside a `case`, an or-pattern matching any alternative."
   ":="        "Walrus operator (assignment expression)."
   "."         "Attribute access (`obj.attr`); `(. obj a b)` is `obj.a.b`."
   "ife"       "Ternary conditional expression (`then if test else else`)."
   "sub"       "Subscript access (`obj[index]`); more indexes subscript again."
   "lambda"    "Anonymous function (lambda expression)."
   "await"     "Await a coroutine."
   "yield"     "Yield a value from a generator."
   "yield-from" "Yield all values from a sub-generator."
   "and"       "Logical AND (short-circuit)."
   "or"        "Logical OR (short-circuit)."
   "=="        "Equality test."
   "!="        "Inequality test."
   "<"         "Less than."
   "<="        "Less than or equal."
   ">"         "Greater than."
   ">="        "Greater than or equal."
   "is"        "Identity test (`x is y`)."
   "is-not"    "Negated identity test (`x is not y`)."
   "in"        "Membership test (`x in y`)."
   "not-in"    "Negated membership test (`x not in y`)."})

(for op in augassignop-dict
  (= (sub FORM-PROSE op) f"Augmented assignment (`target {op} value`)."))

;; Extra usage lines shown above the FORM_USAGE line, for a key that is also
;; an ordinary call: `|` is the n-ary bitwise-OR operator as well as the
;; or-pattern. Signature help uses the whole code block as its label.
(= EXTRA-USAGE {"|" "(| a b ...)"})

(def form-docs [usage prose extras]
  "Hover entries for the FORM-USAGE forms; raises if usage and prose disagree
or an extra usage line names no usage key."
  (= usage-keys (set usage))
  (for kind in HEADLESS-FORMS
    (.discard usage-keys kind))
  (= missing (- usage-keys (set prose)))
  (= extra (- (set prose) usage-keys))
  (if (or missing extra)
      (raise (RuntimeError f"FORM-PROSE out of sync with FORM_USAGE: no prose for {(sorted missing)}, no usage for {(sorted extra)}")))
  (= orphans (- (set extras) (set usage)))
  (if orphans
      (raise (RuntimeError f"EXTRA-USAGE names keys with no FORM_USAGE entry: {(sorted orphans)}")))
  (= docs {})
  (for key in prose
    (= lines (+ (ife (in key extras) [(sub extras key)] []) [(sub usage key)]))
    (= (sub docs key) f"```\n{(.join "\n" lines)}\n```\n\n{(sub prose key)}"))
  (return docs))

(= HAND-WRITTEN-DOCS
  {;; Forms outside FORM-USAGE
   "defmacro"  "```\n(defmacro name [args] body...)\n```\n\nDefine a compile-time macro. The macro receives unevaluated S-expressions and must return an S-expression."
   "do"        "```\n(do body...)\n```\n\nA statement block grouping several statements where one statement is expected (e.g. an `if` branch); not an expression."
   "import"    "```\n(import module)\n(import module as alias)\n```\n\nImport a module."
   "from"      "```\n(from module [names...])\n(from module [name as alias ...])\n```\n\nImport specific names from a module."
   "require"   "```\n(require module)\n(require module *)\n(require module [names...])\n```\n\nImport macros from a LisPython macro module at compile time. `(require module)` registers every macro as `module.name`, `*` registers every macro unqualified, and a list registers exactly those names — an empty `[]` registers none."
   "return"    "```\n(return value)\n```\n\nReturn a value from a function."
   "pass"      "```\n(pass)\n```\n\nNo-op placeholder statement."
   "break"     "```\n(break)\n```\n\nBreak out of a loop."
   "continue"  "```\n(continue)\n```\n\nContinue to the next loop iteration."
   ;; Expression forms
   ","         "```\n(, a b c)\n```\n\nTuple literal."
   "fn"        "```\n(fn [args] body)\n```\n\nLambda alias — same as `lambda`."
   ;; Operators
   "+"  "Arithmetic addition / unary positive."
   "-"  "Arithmetic subtraction / unary negative."
   "*"  "Arithmetic multiplication / iterable unpacking."
   "/"  "True division."
   "//" "Floor (integer) division."
   "%"  "Modulo (remainder)."
   "**" "Exponentiation."
   "@"  "Matrix multiplication."
   "<<" "Bitwise left shift."
   ">>" "Bitwise right shift."
   "^"  "Bitwise XOR."
   "&"  "Bitwise AND."
   "~"  "Bitwise NOT / unquote (inside quasiquote)."
   "not" "Logical NOT."
   ;; Macro-related
   "'"  "Quote — prevent evaluation; return the form as data."
   "`"  "Quasiquote — like quote but allows unquote (`~`) splicing."
   "~@" "Unquote-splice — splice a list into a quasiquote."
   "f-string" "```\nf\"text {expr} more\"\n```\n\nFormatted string literal (f-string)."})

;; A hand-written entry sharing a key with FORM-USAGE would silently override
;; the derived one in the merge below, so it is refused here.
(def refuse-shadowing [hand-written usage]
  "Raises if a hand-written entry shares a key with usage."
  (= shadowed (& (set hand-written) (set usage)))
  (if shadowed
      (raise (RuntimeError f"HAND-WRITTEN-DOCS shadows FORM_USAGE entries: {(sorted shadowed)}"))))

(refuse-shadowing HAND-WRITTEN-DOCS FORM-USAGE)

(= SPECIAL-FORM-DOCS {**(form-docs FORM-USAGE FORM-PROSE EXTRA-USAGE) **HAND-WRITTEN-DOCS})

;; ---------------------------------------------------------------------------
;; Python builtins introspection
;; ---------------------------------------------------------------------------

(def build-builtin-info []
  "Build a dict of Python builtin names -> {signature, doc, source_file, lineno}."
  (= info {})
  (for name in (dir builtins)
    (if (.startswith name "_")
        (continue))
    (= obj (getattr builtins name))
    (if (and (not (callable obj)) (not (isinstance obj type)))
        (continue))
    (= entry {"name" name})
    ;; Signature
    (try
      (do (= sig (inspect.signature obj))
          (= (sub entry "signature") f"{name}{sig}"))
      (except [(, ValueError TypeError)]
        (= (sub entry "signature") name)))
    ;; Docstring
    (= doc (inspect.getdoc obj))
    (if doc
        (= (sub entry "doc") (sub (.split doc "\n\n") 0))
        (= (sub entry "doc") ""))
    ;; Source file
    (try
      (do (= source-file (inspect.getfile obj))
          (try
            (do (= (, _ lineno) (inspect.getsourcelines obj))
                (= (sub entry "lineno") lineno))
            (except [(, OSError TypeError)]
              (= (sub entry "lineno") 1)))
          (= (sub entry "source_file") source-file))
      (except [(, TypeError OSError)]
        (= (sub entry "source_file") None)
        (= (sub entry "lineno") None)))
    (= (sub info name) entry))
  (return info))

(= BUILTIN-INFO (build-builtin-info))

;; ---------------------------------------------------------------------------
;; Workspace index
;; ---------------------------------------------------------------------------

;; Global index: {symbol_name: [Location, ...]} across all .lpy files
(= WORKSPACE-INDEX {})
;; Cache of parsed trees per URI: {uri: tree}
(= FILE-TREES {})
;; workspace/symbol results per URI: {uri: [SymbolInformation, ...]}
(= WORKSPACE-SYMBOLS {})

(def uri-to-path [uri]
  "Convert a file:// URI to a filesystem path."
  (if (.startswith uri "file://")
      (return (sub uri [: 7 None]))
      (return uri)))

(def path-to-uri [path]
  "Convert a filesystem path to a file:// URI."
  (return (.as-uri (pathlib.Path path))))

(def under-workspace [path folders]
  "True when path lies inside one of the workspace folders.  Real paths are
   compared by components, not by string prefix, so /ws-other is not inside
   /ws and a symlink counts where its target lives."
  (= real (pathlib.Path (osp.realpath path)))
  (for folder in folders
    (if (.is-relative-to real (osp.realpath (uri-to-path folder.uri)))
        (return True)))
  (return False))

(def workspace-folders []
  "The client's workspace folders, read from the pygls workspace itself.
   It is the one record of them (pygls keeps it current through
   didChangeWorkspaceFolders), so nothing here copies the list; before
   initialize there is no workspace and so no folders."
  (try
    (return (list (.values server.workspace.folders)))
    (except [RuntimeError]
      ;; Not (return []): an empty bracket compiles to a bare return.
      (return (list)))))

;; The Python backend of each workspace project (lispy.lsp.backend).  Its
;; document hooks never raise and never start a backend, so the handlers
;; below behave as they did whether or not one is installed.
(= backends (Backends workspace-folders))

(def index-required-modules [tree]
  "Find all (require module-name ...) forms in tree and index those packages."
  (for node in tree
    (if (and (isinstance node Paren)
             (> (len node) 1)
             (isinstance node.op Symbol)
             (== node.op.value "require")
             (isinstance (sub node 1) Symbol))
        (do (= module-name (. (sub node 1) value))
            (index-installed-package module-name)))))

(def index-file [uri]
  "Parse a .lpy file and add its definitions to the workspace index.
   Removes old entries for this URI before re-indexing.  Only a file inside
   a workspace folder publishes workspace/symbol results: a dependency
   indexed so that go-to-definition can reach it is not the user's code and
   would flood the symbol search.  Membership is decided here from the
   file's path, never by the caller, so every route to index-file (startup
   scan, didOpen/didSave, a require, go-to-definition) agrees about a file."
  ;; Remove old entries for this URI
  (= to-remove [])
  (for [name locs] in (.items WORKSPACE-INDEX)
    (= (sub WORKSPACE-INDEX name)
       [loc for loc in locs if (!= loc.uri uri)])
    (if (== (len (sub WORKSPACE-INDEX name)) 0)
        (.append to-remove name)))
  (for name in to-remove
    (del (sub WORKSPACE-INDEX name)))
  (.pop WORKSPACE-SYMBOLS uri None)

  ;; Parse and collect definitions
  (= fpath (uri-to-path uri))
  (if (not (osp.isfile fpath))
      (return))
  (try
    (with [(open fpath "rb") as f]
      (= src (.decode (f.read) "utf-8")))
    (= tree (parse src :partial True))
    (= (sub FILE-TREES uri) tree)
    (= workspace-file (under-workspace fpath (workspace-folders)))
    (= symbols (ife workspace-file [] None))
    (collect-definitions tree uri :defs WORKSPACE-INDEX :symbols symbols)
    (if workspace-file
        (= (sub WORKSPACE-SYMBOLS uri) symbols))
    ;; Also eagerly index any packages this file requires so defmacros
    ;; from required modules are discoverable for go-to-definition.
    (index-required-modules tree)
    (except [Exception as exc]
      (logger.debug f"Failed to index {fpath}: {exc}"))))

(def index-workspace [workspace-folders]
  "Scan all .lpy files in workspace folders and index them."
  (for folder in workspace-folders
    (= root (uri-to-path folder.uri))
    (for fpath in (glob.glob (osp.join root "**" "*.lpy") :recursive True)
      (index-file (path-to-uri fpath))))
  (logger.info f"Indexed {(len WORKSPACE-INDEX)} symbols from workspace"))

(def resolve-module-to-file [module-name workspace-folders]
  "Resolve a LisPython module name to a .lpy file path.
   e.g., 'lispy.tools' -> '/path/to/src/lispy/tools.lpy'"
  (= parts (.split (.replace module-name "-" "_") "."))
  (= rel-path (+ (osp.join *parts) ".lpy"))
  ;; 1. Workspace folders (direct or in src/)
  (for folder in workspace-folders
    (= root (uri-to-path folder.uri))
    (= candidate (osp.join root rel-path))
    (if (osp.isfile candidate)
        (return candidate))
    (= candidate (osp.join root "src" rel-path))
    (if (osp.isfile candidate)
        (return candidate)))
  ;; 2. Python's sys.path (finds installed packages, including lispython itself)
  (try
    (do (import importlib.util)
        (= spec (importlib.util.find-spec (.replace module-name "-" "_")))
        (if (and spec spec.origin (.endswith spec.origin ".lpy"))
            (return spec.origin))
        ;; Package without __init__.lpy but has submodule files
        (if (and spec spec.submodule-search-locations)
            (for search-path in spec.submodule-search-locations
              (= candidate (osp.join search-path "init.lpy"))
              (if (osp.isfile candidate)
                  (return candidate)))))
    (except [Exception]
      (pass)))
  (return None))

(def index-installed-package [module-name]
  "Index all .lpy files in an installed Python package (e.g., lispython).
   Used to make defmacros in required modules discoverable."
  (try
    (do (import importlib.util)
        (= spec (importlib.util.find-spec (.replace module-name "-" "_")))
        (if (and spec spec.submodule-search-locations)
            (for search-path in spec.submodule-search-locations
              (for fpath in (glob.glob (osp.join search-path "**" "*.lpy") :recursive True)
                (index-file (path-to-uri fpath))))))
    (except [Exception]
      (pass))))

(= FROM-HEADS (, "from" "lazy-from"))
(= IMPORT-ONLY-HEADS (, "import" "lazy-import"))
(= IMPORT-HEADS (+ IMPORT-ONLY-HEADS FROM-HEADS))

(def find-import-target [node workspace-folders]
  "Given an import/from/require node, resolve where the imported name is defined."
  (= form (. node op value))
  (cond
    (in form FROM-HEADS)
    (do ;; (from module [names...])
        (if (< (len node) 3)
            (return None))
        (= module-name (. (sub node 1) value))
        (= fpath (resolve-module-to-file module-name workspace-folders))
        (if fpath
            (return fpath))
        (return None))

    (in form IMPORT-ONLY-HEADS)
    (do ;; (import module)
        (if (< (len node) 2)
            (return None))
        (= module-name (. (sub node 1) value))
        (= fpath (resolve-module-to-file module-name workspace-folders))
        (if fpath
            (return fpath))
        (return None))

    (== form "require")
    (do ;; (require module *)
        (if (< (len node) 2)
            (return None))
        (= module-name (. (sub node 1) value))
        (= fpath (resolve-module-to-file module-name workspace-folders))
        (if fpath
            (return fpath))
        (return None))

    (return None)))

(def buffer-import-bindings [node]
  "The [name symbol] pairs an import form binds, by the compiler's own rule
   (import-bindings). The buffer may be mid-edit: a form the compiler would
   reject binds nothing rather than raising."
  (try
    (return (import-bindings node))
    (except [LispyCompileError]
      (return []))))

(def find-import-for-name [tree name]
  "Find the import/from/require node that imports a given name."
  (for node in tree
    (if (not (isinstance node Paren))
        (continue))
    (if (== (len node) 0)
        (continue))
    (= form (ife (isinstance node.op Symbol) node.op.value ""))
    (cond
      (in form IMPORT-HEADS)
      (for [bound _] in (buffer-import-bindings node)
        (if (== bound name)
            (return node)))
      (== form "require")
      (do ;; the compiler's own rule decides which names this form registers
          ;; The buffer may be mid-edit: a require the compiler would
          ;; reject binds nothing rather than raising.
          (try
            (= [kind names] (require-selection (sub node.list [: 2 None])))
            (except [(, TypeError ValueError)]
              (continue)))
          (cond
            ;; (require module): macros are registered as module.name
            (== kind REQUIRE-QUALIFIED)
            (if (and (> (len node) 1)
                     (.startswith name (+ (str (sub node 1)) ".")))
                (return node))
            ;; (require module *): every macro, names unknown without importing
            (== kind REQUIRE-ALL)
            (return node)
            ;; (require module [a b]): exactly those; [] imports nothing
            (in name names)
            (return node)))))
  (return None))

;; ---------------------------------------------------------------------------
;; Helpers
;; ---------------------------------------------------------------------------

(def make-position [line char]
  (return (lsp.Position :line line :character char)))

(def make-range [start-line start-char end-line end-char]
  (return (lsp.Range
    :start (make-position start-line start-char)
    :end (make-position end-line end-char))))

(def node-range [node]
  "Convert a LisPython AST node's position info to an LSP Range.
   The parser uses 1-based line numbers; LSP uses 0-based."
  (return (make-range
    (- node.lineno 1)
    node.col_offset
    (- node.end_lineno 1)
    node.end_col_offset)))

(def extract-error-position [exc src]
  "Best-effort extraction of line/col from a parse or compile error."
  ;; Some Python exceptions carry lineno/offset
  (= lineno (getattr exc "lineno" None))
  (if (is-not lineno None)
      (do (= col (- (or (getattr exc "offset" None) 1) 1))
          (return (, (- lineno 1) col (- lineno 1) col))))
  ;; Try to extract from the message
  (= msg (str exc))
  (= m (re.search "line\\s+(\\d+)" msg re.IGNORECASE))
  (if m
      (do (= line (- (int (.group m 1)) 1))
          (= col 0)
          (= mc (re.search "col(?:umn)?\\s+(\\d+)" msg re.IGNORECASE))
          (if mc
              (= col (int (.group mc 1))))
          (return (, line col line col))))
  (return None))

;; ---------------------------------------------------------------------------
;; Diagnostics
;; ---------------------------------------------------------------------------

(def compute-diagnostics [source uri]
  (= diagnostics [])
  ;; 1. Parse, in compile-errors so a warning the parse issues names the
  ;; document's file.
  (try
    (with [(compile-errors (uri-to-path uri) source)]
      (= tree (parse source)))
    (except [Exception as exc]
      (= pos (extract-error-position exc source))
      (if (is pos None)
          (= pos (, 0 0 0 0)))
      (.append diagnostics
        (lsp.Diagnostic
          :range (make-range *pos)
          :severity lsp.DiagnosticSeverity.Error
          :source "lpy-lsp"
          :message f"Parse error: {exc}"))
      (return diagnostics)))
  ;; 2. Compile (best-effort) — reported as warnings, since compile-time
  ;; macro expansion depends on the runtime environment (imports must
  ;; actually resolve). Import errors here are often not real problems.
  (try
    (do (from lispy.core.macro [macroexpand-then-compile])
        (macroexpand-then-compile tree))
    (except [ModuleNotFoundError]
      ;; Silently ignore — the file may be using modules the LSP can't resolve
      (pass))
    (except [Exception as exc]
      (= pos (extract-error-position exc source))
      (if (is pos None)
          (= pos (, 0 0 0 0)))
      (.append diagnostics
        (lsp.Diagnostic
          :range (make-range *pos)
          :severity lsp.DiagnosticSeverity.Warning
          :source "lpy-lsp"
          :message f"Compile warning: {exc}"))))
  (return diagnostics))

(def publish-diagnostics [ls uri]
  (= doc (.get-text-document ls.workspace uri))
  (= diagnostics (compute-diagnostics doc.source uri))
  (.text-document-publish-diagnostics ls
    (lsp.PublishDiagnosticsParams :uri uri :diagnostics diagnostics)))

;; ---------------------------------------------------------------------------
;; Document symbols
;; ---------------------------------------------------------------------------

(def def-name-symbol [node]
  "The Symbol naming a def/class: the node itself, or the head of f[T]."
  (cond (isinstance node Symbol)
        (return node)
        (isinstance node GluedHead)
        (return node.head)
        True
        (return None)))

(def symbol-name [node]
  "Extract a string name from a node."
  (cond (isinstance node Symbol)
        (return node.value)
        (isinstance node GluedHead)
        (return (symbol-name node.head))
        (isinstance node Annotation)
        (return (symbol-name node.value))
        (isinstance node String)
        (return (.strip node.value "\"'"))
        (return (str node))))

(= _DEFINITION-KINDS
   {"def" lsp.SymbolKind.Function
    "async-def" lsp.SymbolKind.Function
    ;; SymbolKind has no macro kind, and Operator would misdescribe a named
    ;; form, so a macro is a Function.
    "defmacro" lsp.SymbolKind.Function
    "class" lsp.SymbolKind.Class
    ;; A (type NAME ...) alias; callers check type-alias-p first, since a
    ;; call to the builtin type is not a definition.
    "type" lsp.SymbolKind.Class
    "=" lsp.SymbolKind.Variable})

(def definition-kind [form]
  "The SymbolKind of a definition form (def, async-def, defmacro, class, type, =),
   or None.  Document symbols and workspace/symbol both report it."
  (return (.get _DEFINITION-KINDS form)))

(def walk-symbols [nodes]
  "Walk top-level parsed forms and produce DocumentSymbol entries."
  (= symbols [])
  (for node in nodes
    (if (or (not (isinstance node Paren)) (== (len node) 0))
        (continue))
    (= op node.op)
    (if (not (isinstance op Symbol))
        (continue))
    (= form op.value)

    (cond
      (in form (, "def" "async-def"))
      (do (if (< (len node) 2) (continue))
          (= name (symbol-name (sub node 1)))
          (= rng (node-range node))
          (= sel (node-range (sub node 1)))
          (= children (ife (> (len node) 3)
                           (walk-symbols (sub node.list [: 3 None]))
                           []))
          (.append symbols
            (lsp.DocumentSymbol
              :name name
              :kind (definition-kind form)
              :range rng
              :selection-range sel
              :children (or children None))))

      (== form "class")
      (do (if (< (len node) 2) (continue))
          (= name (symbol-name (sub node 1)))
          (= rng (node-range node))
          (= sel (node-range (sub node 1)))
          (= body-nodes (ife (> (len node) 3)
                             (sub node.list [: 3 None])
                             (sub node.list [: 2 None])))
          (= children (walk-symbols body-nodes))
          (.append symbols
            (lsp.DocumentSymbol
              :name name
              :kind (definition-kind form)
              :range rng
              :selection-range sel
              :children (or children None))))

      (and (== form "type") (type-alias-p node))
      (.append symbols
        (lsp.DocumentSymbol
          :name (symbol-name (sub node 1))
          :kind (definition-kind form)
          :range (node-range node)
          :selection-range (node-range (sub node 1))
          :detail "type alias"))

      (== form "defmacro")
      (do (if (< (len node) 2) (continue))
          (.append symbols
            (lsp.DocumentSymbol
              :name (symbol-name (sub node 1))
              :kind (definition-kind form)
              :range (node-range node)
              :selection-range (node-range (sub node 1))
              :detail "macro")))

      (== form "=")
      (do (if (< (len node) 2) (continue))
          (.append symbols
            (lsp.DocumentSymbol
              :name (symbol-name (sub node 1))
              :kind (definition-kind form)
              :range (node-range node)
              :selection-range (node-range (sub node 1)))))

      (in form IMPORT-HEADS)
      (do (if (< (len node) 2) (continue))
          (.append symbols
            (lsp.DocumentSymbol
              :name (symbol-name (sub node 1))
              :kind lsp.SymbolKind.Module
              :range (node-range node)
              :selection-range (node-range (sub node 1)))))

      (== form "require")
      (do (if (< (len node) 2) (continue))
          (.append symbols
            (lsp.DocumentSymbol
              :name (symbol-name (sub node 1))
              :kind lsp.SymbolKind.Module
              :range (node-range node)
              :selection-range (node-range (sub node 1))
              :detail "macro require")))))

  (return symbols))

;; ---------------------------------------------------------------------------
;; Hover
;; ---------------------------------------------------------------------------

(def node-at-position [nodes line-0 col]
  "Find the most specific node at the given 0-based position."
  (for node in nodes
    (= n-start-line (- node.lineno 1))
    (= n-start-col node.col_offset)
    (= n-end-line (- node.end_lineno 1))
    (= n-end-col node.end_col_offset)
    ;; Check if position is inside this node's range
    (if (< (, line-0 col) (, n-start-line n-start-col))
        (continue))
    (if (> (, line-0 col) (, n-end-line n-end-col))
        (continue))
    ;; Position is within this node — try to go deeper
    (if (isinstance node Expression)
        (do (= deeper (node-at-position node.list line-0 col))
            (if (is-not deeper None)
                (return deeper))))
    (if (isinstance node (, Wrapper MetaIndicator))
        (do (= deeper (node-at-position [node.value] line-0 col))
            (if (is-not deeper None)
                (return deeper))))
    (if (isinstance node GluedHead)
        (do (= deeper (node-at-position [node.head node.params] line-0 col))
            (if (is-not deeper None)
                (return deeper))))
    (return node))
  (return None))

;; ---------------------------------------------------------------------------
;; Definition index
;; ---------------------------------------------------------------------------

(def _add-symbol [symbols name kind loc]
  (if (is-not symbols None)
      (.append symbols (lsp.SymbolInformation :name name :kind kind :location loc))))

(def collect-definitions [nodes uri :defs None :symbols None :in-function False]
  "Walk AST and collect all definition locations keyed by symbol name.

   defs feeds go-to-definition and completion, so it also holds the names
   bound by import/from and for/async-for.  When symbols is a list, the same
   pass appends an lsp.SymbolInformation for each declaration a user searches
   for with workspace/symbol -- def, async-def, defmacro, class and = --
   with the kind definition-kind gives it.  Imports and loop variables bind
   names but declare nothing, so they get no symbol, and an = inside a def
   body (in-function) is a local, so it gets none either; module and
   class-body assignments do."
  (if (is defs None)
      (= defs {}))

  (for node in nodes
    (if (or (not (isinstance node Paren)) (== (len node) 0))
        (continue))
    (= op node.op)
    (if (not (isinstance op Symbol))
        (continue))
    (= form op.value)

    (cond
      (in form (, "def" "async-def" "defmacro"))
      (do (if (and (>= (len node) 2) (is-not (def-name-symbol (sub node 1)) None))
              (do (= name-node (def-name-symbol (sub node 1)))
                  (= name name-node.value)
                  (= loc (lsp.Location :uri uri :range (node-range name-node)))
                  (.append (.setdefault defs name []) loc)
                  (_add-symbol symbols name (definition-kind form) loc)
                  (if (> (len node) 3)
                      (collect-definitions (sub node.list [: 3 None]) uri
                                           :defs defs :symbols symbols
                                           :in-function True)))))

      (== form "class")
      (do (if (and (>= (len node) 2) (is-not (def-name-symbol (sub node 1)) None))
              (do (= name-node (def-name-symbol (sub node 1)))
                  (= name name-node.value)
                  (= loc (lsp.Location :uri uri :range (node-range name-node)))
                  (.append (.setdefault defs name []) loc)
                  (_add-symbol symbols name (definition-kind form) loc)
                  (= body (ife (> (len node) 3)
                               (sub node.list [: 3 None])
                               (sub node.list [: 2 None])))
                  (collect-definitions body uri :defs defs :symbols symbols))))

      (and (== form "type") (type-alias-p node))
      (do (= name-node (def-name-symbol (sub node 1)))
          (= loc (lsp.Location :uri uri :range (node-range name-node)))
          (.append (.setdefault defs name-node.value []) loc)
          (if (not in-function)
              (_add-symbol symbols name-node.value (definition-kind form) loc)))

      (== form "=")
      (do (if (and (>= (len node) 2) (isinstance (sub node 1) Symbol))
              (do (= name (. (sub node 1) value))
                  (= loc (lsp.Location :uri uri :range (node-range (sub node 1))))
                  (.append (.setdefault defs name []) loc)
                  (if (not in-function)
                      (_add-symbol symbols name (definition-kind form) loc)))))

      (in form (, "for" "async-for"))
      (do (if (and (>= (len node) 2) (isinstance (sub node 1) Symbol))
              (do (= name (. (sub node 1) value))
                  (= loc (lsp.Location :uri uri :range (node-range (sub node 1))))
                  (.append (.setdefault defs name []) loc)))
          (collect-definitions (sub node.list [: 1 None]) uri
                               :defs defs :symbols symbols
                               :in-function in-function))

      (in form IMPORT-HEADS)
      (for [name name-node] in (buffer-import-bindings node)
        (= loc (lsp.Location :uri uri :range (node-range name-node)))
        (.append (.setdefault defs name []) loc))

      ;; Default: recurse into nested paren forms
      (do (collect-definitions
            [c for c in node.list if (isinstance c Paren)]
            uri :defs defs :symbols symbols :in-function in-function))))

  (return defs))

;; ---------------------------------------------------------------------------
;; References
;; ---------------------------------------------------------------------------

(def collect-references [nodes name uri]
  "Find all occurrences of a symbol name in the AST."
  (= refs [])
  (for node in nodes
    (if (and (isinstance node Symbol) (== node.value name))
        (.append refs (lsp.Location :uri uri :range (node-range node))))
    (if (isinstance node Expression)
        (.extend refs (collect-references node.list name uri)))
    (if (and (isinstance node (, Wrapper MetaIndicator))
             (is-not node.value None))
        (.extend refs (collect-references [node.value] name uri)))
    (if (isinstance node GluedHead)
        (.extend refs (collect-references [node.head node.params] name uri))))
  (return refs))

;; ---------------------------------------------------------------------------
;; LSP event handlers
;; ---------------------------------------------------------------------------

(deco (server.feature lsp.INITIALIZE)
(def on-initialize [ls params]
  (.configure backends params.initialization_options)))

(deco (server.feature lsp.INITIALIZED)
(def on-initialized [ls params]
  (= folders (ife ls.workspace.folders
                  (list (.values ls.workspace.folders))
                  []))
  (if folders
      (index-workspace folders))))

(def buffer-source-getter [ls uri]
  (return (fn [] (. (.get-text-document ls.workspace uri) source))))

(deco (server.feature lsp.TEXT_DOCUMENT_DID_OPEN)
(def did-open [ls params]
  (= uri params.text_document.uri)
  (index-file uri)
  (publish-diagnostics ls uri)
  (.document-changed backends uri (buffer-source-getter ls uri))))

(deco (server.feature lsp.TEXT_DOCUMENT_DID_CHANGE)
(def did-change [ls params]
  (= uri params.text_document.uri)
  (publish-diagnostics ls uri)
  (.document-changed backends uri (buffer-source-getter ls uri))))

(deco (server.feature lsp.TEXT_DOCUMENT_DID_SAVE)
(def did-save [ls params]
  (= uri params.text_document.uri)
  (index-file uri)
  (publish-diagnostics ls uri)
  (.document-saved backends uri)))

(deco (server.feature lsp.TEXT_DOCUMENT_DID_CLOSE)
(def did-close [ls params]
  (.forget view-cache params.text_document.uri)
  (.document-closed backends params.text_document.uri)))

;; pygls' own shutdown awaits this before it answers, so every backend has
;; exited by the time the client sends exit.
(deco (server.feature lsp.SHUTDOWN)
(async-def on-shutdown [ls *args]
  (await (.shutdown-all backends))))

;; A client that exits without shutdown: kill what still runs, since the LSP
;; process ends right after this.
(deco (server.feature lsp.EXIT)
(def on-exit [ls *args]
  (.kill-all backends)))

(deco (server.feature lsp.TEXT_DOCUMENT_DOCUMENT_SYMBOL)
(def document-symbol [ls params]
  (= doc (.get-text-document ls.workspace params.text_document.uri))
  (try
    (= tree (parse doc.source :partial True))
    (except [Exception]
      (return [])))
  (return (walk-symbols tree))))

;; Not in SPECIAL-FORM-DOCS: `type` is also the builtin, so the alias doc applies
;; only where type-alias-p (the compiler's own test) accepts the form.
(= TYPE-ALIAS-DOC
   "```\n(type Name value)\n(type Name[T] value)\n```\n\nDefine a type alias (Python 3.12+).")

(def alias-keyword-p [nodes target]
  "True when target is the `type` of a (type NAME value) alias statement."
  (for node in nodes
    (if (isinstance node Paren)
        (if (or (and (is node.op target) (type-alias-p node))
                (alias-keyword-p node.list target))
            (return True))))
  (return False))

(deco (server.feature lsp.TEXT_DOCUMENT_HOVER)
(def hover [ls params]
  (= doc (.get-text-document ls.workspace params.text_document.uri))
  (try
    (= tree (parse doc.source :partial True))
    (except [Exception]
      (return None)))
  (= pos params.position)
  (= target (node-at-position tree pos.line pos.character))
  (if (is target None)
      (return None))
  ;; Look up documentation for the symbol
  (if (isinstance target Symbol)
      (do
        (= name target.value)
        (if (and (== name "type") (alias-keyword-p tree target))
            (return (lsp.Hover
              :contents (lsp.MarkupContent
                :kind lsp.MarkupKind.Markdown
                :value TYPE-ALIAS-DOC)
              :range (node-range target))))
        ;; 1. LisPython special forms
        (= doc-text (.get SPECIAL-FORM-DOCS name))
        (if doc-text
            (return (lsp.Hover
              :contents (lsp.MarkupContent
                :kind lsp.MarkupKind.Markdown
                :value doc-text)
              :range (node-range target))))
        ;; 2. Python builtins
        (= builtin-name (.replace name "-" "_"))
        (= bi (.get BUILTIN-INFO builtin-name))
        (if bi
            (do (= sig (sub bi "signature"))
                (= doc-body (sub bi "doc"))
                (= hover-md f"```python\n{sig}\n```\n\n*(Python builtin)*")
                (if doc-body
                    (+= hover-md f"\n\n{doc-body}"))
                (return (lsp.Hover
                  :contents (lsp.MarkupContent
                    :kind lsp.MarkupKind.Markdown
                    :value hover-md)
                  :range (node-range target)))))))
  (return None)))

(deco (server.feature lsp.TEXT_DOCUMENT_DEFINITION)
(def definition [ls params]
  (= doc (.get-text-document ls.workspace params.text_document.uri))
  (try
    (= tree (parse doc.source :partial True))
    (except [Exception]
      (return None)))
  (= pos params.position)
  (= target (node-at-position tree pos.line pos.character))
  (if (or (is target None) (not (isinstance target Symbol)))
      (return None))
  (= name target.value)
  (if (in name SPECIAL-FORM-DOCS)
      (return None))

  ;; 1. Local definitions in the file
  (= defs (collect-definitions tree doc.uri))
  (= local (.get defs name))
  (if local
      (return local))

  ;; 2. Resolve via import statements — find which module imports this name
  (= folders (ife ls.workspace.folders
                  (list (.values ls.workspace.folders))
                  []))
  (= import-node (find-import-for-name tree name))
  (if import-node
      (do (= fpath (find-import-target import-node folders))
          (if fpath
              (do (= target-uri (path-to-uri fpath))
                  ;; Make sure the target file is indexed
                  (if (not-in target-uri FILE-TREES)
                      (index-file target-uri))
                  ;; Look up the name in the target file's definitions
                  (= target-tree (.get FILE-TREES target-uri))
                  (if target-tree
                      (do (= target-defs (collect-definitions target-tree target-uri))
                          ;; (require module) registers module.name; the target
                  ;; file defines the bare name.
                  (= prefix (+ (str (sub import-node 1)) "."))
                  (= result (.get target-defs
                                  (ife (and (== import-node.op.value "require")
                                            (.startswith name prefix))
                                       (sub name [: (len prefix) None])
                                       name)))
                          (if result
                              (return result))))))))

  ;; 3. Workspace-wide index lookup
  (= ws-result (.get WORKSPACE-INDEX name))
  (if ws-result
      ;; Filter out definitions from the current file (already checked)
      (do (= external [loc for loc in ws-result if (!= loc.uri doc.uri)])
          (if external
              (return external))))

  ;; 4. Python builtins with source files
  (= builtin-name (.replace name "-" "_"))
  (= bi (.get BUILTIN-INFO builtin-name))
  (if (and bi (sub bi "source_file"))
      (do (= source-path (pathlib.Path (sub bi "source_file")))
          (if (.exists source-path)
              (do (= lineno (- (or (sub bi "lineno") 1) 1))
                  (return [(lsp.Location
                    :uri (.as-uri source-path)
                    :range (make-range lineno 0 lineno 0))])))))
  (return None)))

;; ---------------------------------------------------------------------------
;; Signature help
;; ---------------------------------------------------------------------------

(def find-enclosing-function [source line col]
  "Name of the innermost call open at the cursor, or None.

   line is 1-based and col a 0-based code-point column: the coordinates
   tokenize() reports.  The scan runs over the lexer's own tokens, so
   strings (prefixed, raw, triple-quoted, f/t-string fields), comments and
   opening tokens such as *( or ^( are delimited exactly as the parser
   delimits them.  An opening ending in ( contributes its head symbol (None
   when the head is not a symbol, or when a ' or ` quotes the form as data;
   an unquote ~( is code again); [ and { contribute None.  Never raises: a
   buffer the lexer cannot read has no enclosing call."
  (try
    (= tokens (list (tokenize source)))
    (except [Exception]
      (return None)))
  (= cursor (, line col))
  (= stack [])
  (for i in (range (len tokens))
    (= [text tktype info _] (sub tokens i))
    (if (> (, (sub info "end_lineno") (sub info "end_col_offset")) cursor)
        (break))
    (cond
      (== tktype "opening")
      (if (.endswith text "(")
          (do (= head (ife (< (+ i 1) (len tokens)) (sub tokens (+ i 1)) None))
              (= before (ife (> i 0) (sub tokens (- i 1)) None))
              (= quoted (and before
                             (== (sub before 1) "meta-indicator")
                             (in (sub (sub before 0) -1) "'`")))
              (.append stack (ife (and head (not quoted) (== (sub head 1) "symbol"))
                                  (sub head 0)
                                  None)))
          (.append stack None))

      ;; ^*( is refused by the parser but still opens a form its ) closes.
      (and (== tktype "bad-prefix") (in (sub text -1) "([{"))
      (.append stack None)

      (and (== tktype "closing") stack)
      (.pop stack)))
  (for name in (reversed stack)
    (if (is-not name None)
        (return name)))
  (return None))

(def cursor-of [doc pos]
  "The LSP position pos as tokenize() coordinates: (1-based line, code-point column).
   LSP counts character in the negotiated encoding (UTF-16 by default), which
   differs from a str index after a non-BMP character; pygls' position codec
   converts it.  A document without a codec (a test double) is taken as code
   points."
  (= codec (getattr doc "position_codec" None))
  (if (is codec None)
      (return (, (+ pos.line 1) pos.character)))
  (= server-pos (.position-from-client-units
                  codec doc.lines
                  (lsp.Position :line pos.line :character pos.character)))
  (return (, (+ server-pos.line 1) server-pos.character)))

(deco (server.feature
        lsp.TEXT_DOCUMENT_SIGNATURE_HELP
        (lsp.SignatureHelpOptions :trigger-characters ["("]))
(def signature-help [ls params]
  (= doc (.get-text-document ls.workspace params.text_document.uri))
  (= [line col] (cursor-of doc params.position))
  (= func-name (find-enclosing-function doc.source line col))
  (if (is func-name None)
      (return None))

  ;; 1. Special forms
  (= doc-text (.get SPECIAL-FORM-DOCS func-name))
  (if doc-text
      (do (= m (re.search "```\\n(.+?)\\n```" doc-text re.DOTALL))
          (= sig-text (ife m (.strip (.group m 1)) func-name))
          (return (lsp.SignatureHelp
            :signatures [(lsp.SignatureInformation
                           :label sig-text
                           :documentation (lsp.MarkupContent
                             :kind lsp.MarkupKind.Markdown
                             :value doc-text))]))))

  ;; 2. Python builtins
  (= builtin-name (.replace func-name "-" "_"))
  (= bi (.get BUILTIN-INFO builtin-name))
  (if bi
      (do (= sig (.get bi "signature" func-name))
          (= doc-str (.get bi "doc" ""))
          (return (lsp.SignatureHelp
            :signatures [(lsp.SignatureInformation
                           :label sig
                           :documentation (ife doc-str
                                              (lsp.MarkupContent
                                                :kind lsp.MarkupKind.Markdown
                                                :value doc-str)
                                              None))]))))

  (return None)))

;; ---------------------------------------------------------------------------
;; Member completion
;; ---------------------------------------------------------------------------

;; After `recv.` or in the attribute slot of `(. recv ...)`, where recv is
;; the first parameter of the enclosing method, completion offers only the
;; enclosing class's members, as pyright and jedi do for `self.`.  Every walk
;; here runs on an explicit stack, so nesting depth costs no Python frames.

(= _FUNCTION-HEADS (, "def" "async-def"))
(= _LAMBDA-HEADS (, "lambda" "fn"))
;; Forms whose body is another scope: an assignment in it is not the method's.
(= _SCOPE-HEADS (, "def" "async-def" "lambda" "fn" "class" "defmacro"))

(def head-of [node]
  "The head symbol's text of a non-empty Paren, else None."
  (if (and (isinstance node Paren) (> (len node) 0) (isinstance node.op Symbol))
      (return node.op.value))
  (return None))

(def node-end [node]
  (return (, node.end_lineno node.end_col_offset)))

(def open-path [tree line col]
  "The forms open at the cursor, outermost first, and the leaf touching it.
   tree is the parse of the prefix with its closers right after the cursor,
   so a form is open iff it ends past the cursor.  The leaf is the innermost
   open form's last element when it ends exactly at the cursor, else None."
  (= cursor (, line col))
  (= path [])
  (= node (ife tree (sub tree -1) None))
  (while (is-not node None)
    (while (and (isinstance node (, Wrapper MetaIndicator))
                (is-not node.value None))
      (= node node.value))
    (if (and (isinstance node Expression) (> (node-end node) cursor))
        (do (.append path node)
            (= node (ife (len node) (sub node -1) None)))
        (return (, path (ife (== (node-end node) cursor) node None)))))
  (return (, path None)))

(def member-access [path leaf]
  "The receiver name and the attribute typed so far at the cursor, or None.
   Either the leaf is recv.partial with one dot, or the cursor is in the
   attribute slot of an open (. recv ...): past recv, or touching a plain
   second operand."
  (if (and (isinstance leaf Symbol) (== (.count leaf.value ".") 1))
      (do (= [recv partial] (.split leaf.value "."))
          (return (ife recv (, recv partial) None))))
  (if (or (not path) (!= (head-of (sub path -1)) "."))
      (return None))
  (= form (sub path -1))
  (if (or (not (isinstance (sub form 1) Symbol)) (in "." (. (sub form 1) value)))
      (return None))
  (= recv (. (sub form 1) value))
  (cond (and (== (len form) 2) (is leaf None))
        (return (, recv ""))
        (and (== (len form) 3) (is leaf (sub form 2))
             (isinstance leaf Symbol) (not (in "." leaf.value)))
        (return (, recv leaf.value)))
  (return None))

(def decorator-name [node]
  "A plain-symbol decorator's Python name, builtins.X read as X, or None."
  (if (not (isinstance node Symbol))
      (return None))
  (= [module _ name] (.rpartition node.name "."))
  (return (ife (== module "builtins") name node.name)))

(def decorator-names [node]
  "Names of the plain-symbol decorators in a deco form's decorator slot."
  (= decorators (ife (isinstance node Bracket) node.list [node]))
  (return [name for name in (map decorator-name decorators)
           if (is-not name None)]))

(def undecorated [form]
  "The definition a (deco ...) chain wraps, and its decorators' names."
  (= decorators [])
  (while (and (== (head-of form) "deco") (>= (len form) 3))
    (.extend decorators (decorator-names (sub form 1)))
    (= form (sub form -1)))
  (return (, form decorators)))

(def param-names [params]
  "The Python names a parameter list binds (annotations and defaults skipped)."
  (= names [])
  (for param in params.list
    (if (isinstance param (, Starred DoubleStarred Keyword))
        (= param param.value))
    (if (and (isinstance param Symbol) (not (in param.value (, "*" "/"))))
        (.append names param.name)))
  (return names))

;; Methods Python makes classmethods implicitly; __new__ is a staticmethod
;; whose first parameter is the class all the same, decorated or not.
(= _CLASS-RECEIVER-METHODS (, "__init_subclass__" "__class_getitem__" "__new__"))

(def method-name [method]
  "A def form's Python name, or None."
  (= name-node (ife (>= (len method) 2) (def-name-symbol (sub method 1)) None))
  (return (ife (is-not name-node None) name-node.name None)))

(def receiver-param [method decorators]
  "The Python name of a method's first parameter, which receives the
   instance (the class under classmethod), or None for a staticmethod
   other than __new__ or a non-name first slot."
  (if (or (and (in "staticmethod" decorators) (!= (method-name method) "__new__"))
          (< (len method) 3)
          (not (isinstance (sub method 2) Bracket)))
      (return None))
  (= params (sub method 2))
  (if (and (len params) (isinstance (sub params 0) Symbol)
           (not (in (. (sub params 0) value) (, "*" "/"))))
      (return (. (sub params 0) name)))
  (return None))

(def class-receiver-p [method decorators]
  "Whether a method's first parameter receives the class, not an instance."
  (return (or (in "classmethod" decorators)
              (in (method-name method) _CLASS-RECEIVER-METHODS))))

(def receiver-class [path recv]
  "The class recv refers to at the cursor and whether recv is the class
   itself (a classmethod's receiver), or None.  The open functions are
   walked outward: a method whose receiver is recv answers, another
   function binding recv shadows it, and a closure that does not bind it
   sees the enclosing scope's, as Python's scoping does."
  (= recv (py-name recv))
  (for i in (range (- (len path) 1) -1 -1)
    (= node (sub path i))
    (= head (head-of node))
    (cond (in head _FUNCTION-HEADS) (= params-at 2)
          (in head _LAMBDA-HEADS) (= params-at 1)
          True (continue))
    ;; Inside the parameter list (a default, say) is the enclosing scope.
    (if (or (<= (len node) (+ params-at 1))
            (not (isinstance (sub node params-at) Bracket)))
        (continue))
    (if (in head _FUNCTION-HEADS)
        (do (= j (- i 1))
            (= decorators [])
            (while (and (>= j 0) (== (head-of (sub path j)) "deco"))
              (.extend decorators (decorator-names (sub (sub path j) 1)))
              (-= j 1))
            (if (and (>= j 0) (== (head-of (sub path j)) "class")
                     (== (receiver-param node decorators) recv))
                (return (, (sub path j) (class-receiver-p node decorators))))))
    (if (in recv (param-names (sub node params-at)))
        (return None)))
  (return None))

(def find-class-at [tree cls]
  "The class form in tree starting where cls starts, or None."
  (= start (, cls.lineno cls.col_offset))
  (= stack (list tree))
  (while stack
    (= node (.pop stack))
    (if (isinstance node (, Wrapper MetaIndicator))
        (do (if (is-not node.value None)
                (.append stack node.value))
            (continue)))
    (if (or (not (isinstance node Expression))
            (< start (, node.lineno node.col_offset))
            (> start (node-end node)))
        (continue))
    (if (and (== (head-of node) "class")
             (== (, node.lineno node.col_offset) start))
        (return node))
    (.extend stack node.list))
  (return None))

(def class-parts [cls]
  "The bases bracket (or None) and the body forms of a class form."
  (if (and (> (len cls) 2) (isinstance (sub cls 2) Bracket))
      (return (, (sub cls 2) (sub cls.list [: 3 None]))))
  (return (, None (sub cls.list [: 2 None]))))

(def top-level-class [tree name]
  "The last top-level class whose Python name is name in tree, or None."
  (= found None)
  (for form in tree
    (= definition (sub (undecorated form) 0))
    (if (and (== (head-of definition) "class") (>= (len definition) 2))
        (do (= name-node (def-name-symbol (sub definition 1)))
            (if (and (is-not name-node None) (== name-node.name name))
                (= found definition)))))
  (return found))

(def with-targets [items]
  "The targets of a with form's [context as target ...] items."
  (= targets [])
  (if (isinstance items Bracket)
      (for i in (range 1 (- (len items) 1))
        (if (and (isinstance (sub items i) Symbol) (== (. (sub items i) value) "as"))
            (.append targets (sub items (+ i 1))))))
  (return targets))

(def assignment-targets [form]
  "The targets an =, augmented assignment, for or with binds, bracket and
   (, ...) tuple targets flattened."
  (= head (head-of form))
  (cond (and (== head "=") (>= (len form) 3) (isinstance (sub form 2) Annotation))
        (= targets [(sub form 1)])
        (== head "=")
        (= targets (sub form.list [: 1 -1]))
        (and (or (in head augassignop-dict) (in head (, "for" "async-for")))
             (>= (len form) 2))
        (= targets [(sub form 1)])
        (and (in head (, "with" "async-with")) (>= (len form) 2))
        (= targets (with-targets (sub form 1)))
        True
        (return []))
  (= flat [])
  (= stack (list (reversed targets)))
  (while stack
    (= target (.pop stack))
    (cond (isinstance target Bracket)
          (.extend stack (reversed target.list))
          (== (head-of target) ",")
          (.extend stack (reversed (sub target.list [: 1 None])))
          (isinstance target Starred)
          (.append stack target.value)
          True
          (.append flat target)))
  (return flat))

(def receiver-attribute [target receiver]
  "The attribute, as written, a target assigns on the receiver whose
   Python name is receiver (recv.attr or (. recv attr)), or None."
  (if (and (isinstance target Symbol) (== (.count target.value ".") 1))
      (do (= [owner attr] (.split target.value "."))
          (return (ife (and (== (py-name owner) receiver) attr) attr None))))
  (if (and (== (head-of target) ".") (== (len target) 3)
           (isinstance (sub target 1) Symbol) (== (. (sub target 1) name) receiver)
           (isinstance (sub target 2) Symbol) (not (in "." (. (sub target 2) value))))
      (return (. (sub target 2) value)))
  (return None))

(def receiver-attributes [method receiver]
  "Attribute names a method assigns through its receiver, in source order.
   Nested functions and classes are other scopes and are not walked."
  (= names [])
  (= stack (list (reversed (sub method.list [: 3 None]))))
  (while stack
    (= node (.pop stack))
    (if (isinstance node (, Wrapper MetaIndicator))
        (do (if (is-not node.value None)
                (.append stack node.value))
            (continue)))
    (if (not (isinstance node Expression))
        (continue))
    (= head (head-of node))
    (if (in head _SCOPE-HEADS)
        (continue))
    (for target in (assignment-targets node)
      (= attr (receiver-attribute target receiver))
      (if (is-not attr None)
          (.append names attr)))
    (.extend stack (reversed node.list)))
  (return names))

(def add-member [members label kind]
  "Record a member under its Python name; the first spelling seen wins."
  (.setdefault members (py-name label) (, label kind)))

(def class-members [cls tree class-receiver]
  "Python name -> (label, CompletionItemKind) of the members of cls and its
   same-buffer bases, subclass first.  Members are the class body's
   definitions plus the attributes its methods assign through their
   receiver; on the class itself (class-receiver) only class-receiver
   methods' assignments count."
  (= members {})
  (= pending [cls])
  (= visited (set))
  (while pending
    (= current (.pop pending 0))
    (if (in (id current) visited)
        (continue))
    (.add visited (id current))
    (= [bases body] (class-parts current))
    (= methods [])
    (for form in body
      (= [definition decorators] (undecorated form))
      (= head (head-of definition))
      (cond
        (and (in head (, "def" "async-def" "class")) (>= (len definition) 2)
             (is-not (def-name-symbol (sub definition 1)) None))
        (do (= name (. (def-name-symbol (sub definition 1)) value))
            (cond (== head "class")
                  (add-member members name lsp.CompletionItemKind.Class)
                  (in "property" decorators)
                  (add-member members name lsp.CompletionItemKind.Property)
                  True
                  (do (add-member members name lsp.CompletionItemKind.Method)
                      (.append methods (, definition decorators)))))

        (and (== head "type") (type-alias-p definition))
        (add-member members (. (def-name-symbol (sub definition 1)) value)
                    lsp.CompletionItemKind.Class)

        (== head "=")
        (for target in (assignment-targets definition)
          (if (and (isinstance target Symbol) (not (in "." target.value)))
              (add-member members target.value lsp.CompletionItemKind.Variable)))))
    (for [method decorators] in methods
      (= receiver (receiver-param method decorators))
      (if (or (is receiver None)
              (and class-receiver (not (class-receiver-p method decorators))))
          (continue))
      (for attr in (receiver-attributes method receiver)
        (add-member members attr lsp.CompletionItemKind.Variable)))
    (if (is-not bases None)
        (for base in bases.list
          (if (and (isinstance base Symbol) (not (in "." base.value)))
              (do (= base-class (top-level-class tree base.name))
                  (if (is-not base-class None)
                      (.append pending base-class)))))))
  (return members))

(def client-position [doc line character]
  "The 1-based line and code-point character as an LSP Position in client
   units, through the document's position codec (a test double without one
   is taken as code points)."
  (= pos (lsp.Position :line (- line 1) :character character))
  (= codec (getattr doc "position_codec" None))
  (if (is codec None)
      (return pos))
  (return (.position-to-client-units codec doc.lines pos)))

(def completion-ranges [doc line col]
  "The ranges a completion item edits at the 1-based line and code-point
   col, and the word typed so far: (insert, replace, typed).  insert covers
   the partial word before the cursor (partial-span, the word the Python
   view restores), replace that and the rest of the name run after the
   cursor; both in client units."
  (= lines (.split doc.source "\n"))
  (= text (ife (<= 1 line (len lines)) (sub lines (- line 1)) ""))
  (= [start end] (partial-span text (min col (len text))))
  (= start-pos (client-position doc line start))
  (return (, (lsp.Range :start start-pos :end (client-position doc line col))
             (lsp.Range :start start-pos :end (client-position doc line end))
             (sub text [: start col]))))

(def completion-edit [ranges new-text insert-replace]
  "The edit of a completion item putting new-text over the word at the
   cursor (ranges from completion-ranges): an InsertReplaceEdit when the
   client supports one (insert-replace), else a TextEdit over the insert
   range."
  (= [insert replace _] ranges)
  (if insert-replace
      (return (lsp.InsertReplaceEdit :new-text new-text :insert insert :replace replace)))
  (return (lsp.TextEdit :range insert :new-text new-text)))

(def hyphen-spelling [name]
  "name with each _ between two alphanumerics written -, or None when that
   spelling does not stand for name again (py-name)."
  (= spelled (re.sub "(?<=[^\\W_])_(?=[^\\W_])" "-" name))
  (return (ife (== (py-name spelled) name) spelled None)))

;; filterText decides whether the client keeps an item while the user types.
;; `-` is a completion trigger character, so the client asks again right
;; after one and filters that answer by the word typed so far, hyphen
;; included; `_` is not, so after a `_` the client filters the answer it
;; already holds.  So an item carries the spelling being typed: the hyphen
;; spelling once the typed word holds a `-` (my-|), else the Python name,
;; which also matches what a user typing `_` spells (my_|).
(def filter-text [label name typed]
  "The filterText of a completion item labelled label for Python name name,
   when typed is the word typed so far."
  (if (not-in "-" typed)
      (return name))
  (if (in "-" label)
      (return label))
  (= spelled (hyphen-spelling name))
  (return (ife (is spelled None) label spelled)))

(def insert-replace-support [ls]
  "Whether the client takes an InsertReplaceEdit in a completion item
   (textDocument.completion.completionItem.insertReplaceSupport); False
   before initialize and for a test double without capabilities."
  (try
    (= value (getattr ls "client_capabilities" None))
    (for attr in ["text_document" "completion" "completion_item" "insert_replace_support"]
      (= value (getattr value attr None)))
    (except [Exception]
      (return False)))
  (return (is value True)))

(def member-completion [doc line col :insert-replace False]
  "The member CompletionList at the 1-based line and code-point column,
   or None when the cursor is not on an attribute of a method's receiver.
   insert-replace is insert-replace-support's answer for the client."
  (= prefix (source-prefix doc.source line col))
  (= closers (open-form-closers prefix))
  (if (is closers None)
      (return None))
  (= [path leaf] (open-path (parse (+ prefix closers) :partial True) line col))
  (= access (member-access path leaf))
  (if (is access None)
      (return None))
  (= [recv partial] access)
  (= found (receiver-class path recv))
  (if (is found None)
      (return None))
  (= [cls class-receiver] found)
  ;; The whole buffer's class, when it parses, also has the members
  ;; written after the cursor.
  (= tree (parse doc.source :partial True))
  (= whole (find-class-at tree cls))
  (if (is-not whole None)
      (= cls whole))
  (= ranges (completion-ranges doc line col))
  (= typed (sub ranges 2))
  (return (lsp.CompletionList
            :is-incomplete False
            :items [(lsp.CompletionItem
                      :label label
                      :kind kind
                      :filter-text (filter-text label name typed)
                      :text-edit (completion-edit ranges label insert-replace))
                    for [name [label kind]] in (.items (class-members cls tree class-receiver))])))

;; ---------------------------------------------------------------------------
;; Completion
;; ---------------------------------------------------------------------------

(= _LPY-KEYWORDS
   ["defn" "cond" "conde" "ife" "when" "unless"
    "do" "deco" "require" "fn" "match" "case"
    "async-def" "async-for" "async-with"
    "yield-from" "except*"
    "->" "->>" "as->"
    "gensym" "pprint"])

(def local-completion [doc line col :insert-replace False]
  "lispython's own completion at the 1-based line and code-point column:
   on a method receiver's attribute only the class's members
   (member-completion), else the general list.  The answer when no Python
   backend does."
  (try
    (= members (member-completion doc line col :insert-replace insert-replace))
    (except [Exception]
      (.debug logger "member completion failed" :exc-info True)
      (= members None)))
  (if (is-not members None)
      (return members))
  (return (lsp.CompletionList :is-incomplete False :items (general-items doc))))

(def general-items [doc]
  "The completion items offered anywhere: special forms, lispython
   keywords, Python builtins, the buffer's definitions, the workspace's."
  (= items [])
  (= seen (set))

  ;; 1. Special forms
  (for name in SPECIAL-FORM-DOCS
    (if (not (in name seen))
        (do (seen.add name)
            (items.append
              (lsp.CompletionItem
                :label name
                :kind lsp.CompletionItemKind.Keyword
                :detail "special form")))))

  ;; 2. LisPython-specific keywords
  (for name in _LPY-KEYWORDS
    (if (not (in name seen))
        (do (seen.add name)
            (items.append
              (lsp.CompletionItem
                :label name
                :kind lsp.CompletionItemKind.Keyword
                :detail "keyword")))))

  ;; 3. Python builtins
  (for [name info] in (BUILTIN-INFO.items)
    (if (not (in name seen))
        (do (seen.add name)
            (= kind (ife (isinstance (getattr builtins name None) type)
                         lsp.CompletionItemKind.Class
                         lsp.CompletionItemKind.Function))
            (items.append
              (lsp.CompletionItem
                :label name
                :kind kind
                :detail (or (.get info "signature") ""))))))

  ;; 4. Symbols from current file
  (try
    (= tree (parse doc.source :partial True))
    (= defs (collect-definitions tree doc.uri))
    (for name in defs
      (if (not (in name seen))
          (do (seen.add name)
              (items.append
                (lsp.CompletionItem
                  :label name
                  :kind lsp.CompletionItemKind.Variable)))))
    (except [Exception] (pass)))

  ;; 5. Workspace symbols
  (for name in WORKSPACE-INDEX
    (if (not (in name seen))
        (do (seen.add name)
            (items.append
              (lsp.CompletionItem
                :label name
                :kind lsp.CompletionItemKind.Variable
                :detail "workspace")))))
  (return items))

;; ---------------------------------------------------------------------------
;; Completion through the Python backend
;; ---------------------------------------------------------------------------

;; The cursor views of the open documents, by version (python_view.ViewCache).
(= view-cache (ViewCache))

(def cursor-view [uri version source line col name package import-root]
  "view-at-cursor of source, through view-cache when the document has a
   version.  It runs the buffer's macros, so callers run it in a thread."
  (if (is version None)
      (return (view-at-cursor source line col :package package :name name
                              :import-root import-root)))
  (return (.view-at-cursor view-cache uri version source line col
                           :package package :name name :import-root import-root)))

(def generated-position [view]
  "view.cursor as an LSP Position over view.text, in UTF-16 units: the
   backend client negotiates no position encoding, so the backend counts
   in the protocol's default."
  (= [line col] view.cursor)
  (return (.position-to-client-units (PositionCodec) (.split view.text "\n")
                                     (lsp.Position :line (- line 1) :character col))))

(def completion-items [answer]
  "The items of a completion answer: a list, a CompletionList or None."
  (cond (is answer None)
        (return (list))
        (isinstance answer lsp.CompletionList)
        (return (list answer.items))
        True
        (return (list answer))))

(def buffer-spellings [source]
  "Python name -> the buffer's first spelling of it in source order: every
   Symbol counts, a dotted one (a.my-b) by each of its parts."
  (try
    (= tree (parse source :partial True))
    (except [Exception]
      (return {})))
  (= spellings {})
  (= stack (list (reversed tree)))
  (while stack
    (= node (.pop stack))
    (cond (isinstance node Symbol)
          (for part in (.split node.value ".")
            (if part
                (.setdefault spellings (py-name part) part)))
          (isinstance node Expression)
          (.extend stack (reversed node.list))
          (isinstance node (, Wrapper MetaIndicator))
          (if (is-not node.value None)
              (.append stack node.value))
          (isinstance node GluedHead)
          (.extend stack [node.params node.head])))
  (return spellings))

(def backend-member-items [doc line col items insert-replace]
  "The backend's attribute completion items as the buffer's: labelled by
   the buffer's own spelling of each Python name (none: the backend's
   name), with filterText and edit over the .lpy word at the cursor.  What
   is positioned in or tied to the generated code (text_edit,
   additional_text_edits such as an auto-import, insert_text, command,
   data) is dropped: it would land on lines the user never wrote."
  (= spellings (buffer-spellings doc.source))
  (= ranges (completion-ranges doc line col))
  (= typed (sub ranges 2))
  (= result [])
  (for item in items
    (= name item.label)
    (= label (.get spellings name name))
    (.append result
      (lsp.CompletionItem
        :label label
        :kind item.kind
        :detail item.detail
        :label-details item.label-details
        :documentation item.documentation
        :sort-text item.sort-text
        :tags item.tags
        :deprecated item.deprecated
        :preselect item.preselect
        :filter-text (filter-text label name typed)
        :text-edit (completion-edit ranges label insert-replace))))
  (return result))

(def with-backend-kinds [result items]
  "result's items, each whose label is one of the backend items' Python
   names taking that item's kind (a special form or keyword keeps its own):
   the backend knows that an imported defaultdict is a class."
  (= kinds {})
  (for item in items
    (if (is-not item.kind None)
        (.setdefault kinds item.label item.kind)))
  (for item in result.items
    (if (!= item.kind lsp.CompletionItemKind.Keyword)
        (do (= kind (.get kinds (py-name item.label)))
            (if (is-not kind None)
                (= item.kind kind)))))
  (return result))

(async-def backend-completion [doc line col insert-replace]
  "The completion answer with the Python backend's help, or None when it
   gives none (no backend, a buffer with no Python view, no items), and
   local-completion is the answer.  On an attribute the backend's items
   alone answer; elsewhere the local list does, with the backend's kinds."
  (= uri doc.uri)
  (try
    (= client (.client-for backends uri))
    (except [Exception]
      (.exception logger "lispython LSP: no Python backend for %s" uri)
      (return None)))
  (if (or (is client None) (not client.available))
      (return None))
  (= path (to-fs-path uri))
  (if (is path None)
      (return None))
  (= [name package import-root] (module-names path))
  (= view (await (asyncio.to-thread cursor-view uri (getattr doc "version" None)
                                    doc.source line col name package import-root)))
  (if (is view None)
      (return None))
  (= params (lsp.CompletionParams
              :text-document (lsp.TextDocumentIdentifier :uri (.backend-uri client uri))
              :position (generated-position view)))
  (= items (completion-items
             (await (.request client lsp.TEXT_DOCUMENT_COMPLETION params
                              :uri uri :text view.text))))
  (if (not items)
      (return None))
  (if view.attribute
      (return (lsp.CompletionList
                :is-incomplete False
                :items (backend-member-items doc line col items insert-replace))))
  (return (with-backend-kinds
            (local-completion doc line col :insert-replace insert-replace)
            items)))

(deco (server.feature
        lsp.TEXT_DOCUMENT_COMPLETION
        (lsp.CompletionOptions :trigger-characters ["." "-"]))
(async-def completion [ls params]
  (= doc (.get-text-document ls.workspace params.text_document.uri))
  (try
    (= [line col] (cursor-of doc params.position))
    (except [Exception]
      (.debug logger "completion position failed" :exc-info True)
      (return (lsp.CompletionList :is-incomplete False :items (general-items doc)))))
  (= insert-replace (insert-replace-support ls))
  (try
    (= result (await (backend-completion doc line col insert-replace)))
    (except [Exception]
      (.debug logger "backend completion failed" :exc-info True)
      (= result None)))
  (if (is-not result None)
      (return result))
  (return (local-completion doc line col :insert-replace insert-replace))))

(deco (server.feature lsp.TEXT_DOCUMENT_REFERENCES)
(def references [ls params]
  (= doc (.get-text-document ls.workspace params.text_document.uri))
  (try
    (= tree (parse doc.source :partial True))
    (except [Exception]
      (return None)))
  (= pos params.position)
  (= target (node-at-position tree pos.line pos.character))
  (if (or (is target None) (not (isinstance target Symbol)))
      (return None))
  (return (collect-references tree target.value doc.uri))))

(deco (server.feature lsp.WORKSPACE_SYMBOL)
(def workspace-symbol [ls params]
  (= query (.lower params.query))
  (return [symbol
           for symbols in (.values WORKSPACE-SYMBOLS)
           for symbol in symbols
           if (in query (.lower symbol.name))])))
