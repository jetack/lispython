;; The Python view of a lispython buffer: the Python the compiler makes of it,
;; with a map between generated and .lpy positions, so a Python language
;; server can answer for the buffer (design: the vault page "LSP Python
;; Delegation").  Backend-agnostic: nothing here talks to a server.
;;
;; Positions are (1-based line, code-point column) on both sides.  The
;; compiler stamps .lpy positions in code points; ast.parse gives UTF-8 byte
;; columns, converted here.  Every walk runs on an explicit stack, so nesting
;; depth costs no Python frames.

(require lispy.macros *)

(import ast)
(import builtins)
(import collections)
(import contextlib)
(import errno)
(import functools)
(import glob)
(import hashlib)
(import json)
(import logging)
(import os)
(import os.path as osp)
(import re)
(import shutil)
(import sys)
(import tempfile)
(import threading)
(import time)
(import tomllib)

(try
  (import fcntl)
  (except [ImportError]
    (= fcntl None)
    (import msvcrt)))

(from lispy.core.builtins [LAMBDA-HEADS])
(from lispy.core.compiler.expr [param-bindings])
(from lispy.core.errors [LispyCompileError compile-errors])
(from lispy.core.nodes [Annotation Bracket Expression GluedHead MetaIndicator Paren
                         Symbol Wrapper atom-text])
(from lispy.core.parser [completion-word-span parse source-offset tokenize word-parts])
(from lispy.core.macro [compile-unit])
(from lispy.core.macro-table [MacroTable])
(from lispy.core.compiler.literal [hyphen-spelling name-key python-name-p])
(from lispy.core.unparse [unparse])
(from lispy.core.importer [has-init-file package-root])
(from lispy.form-docs [BUILTIN-MACRO-NAMESPACE])
(from lispy.lsp.macro-modules [current-epoch epoch fresh-modules])

(= logger (logging.getLogger __name__))

;; ---------------------------------------------------------------------------
;; Source text helpers
;; ---------------------------------------------------------------------------

(= _CLOSERS {"(" ")" "[" "]" "{" "}"})

(def py-name [text]
  "The Python name lispython text stands for (Symbol.name, the compiler's
   mangling): the LSP compares names by it, since my-attr and my_attr are
   one Python name."
  (return (. (Symbol text) name)))

(def _spells-p [word name]
  "Whether .lpy text word spells Python name name: a name the compiler
   accepts (python-name-p) whose py-name is name, so the operator - never
   spells the name _."
  (return (and (python-name-p word) (== (py-name word) name))))

;; name-key (from compiler/literal.py) is how the LSP compares identifiers
;; (references, completion, macro heads): the compiler's own name identity,
;; so the LSP and the macro clash check agree on which spellings are one name
;; (my-x and my_x are; -> and _to_, ok? and ok_p are not).  Re-exported here
;; for the server.  hyphen-spelling (from compiler/literal.py too) is the
;; spelling completion offers for a Python name (move_to_end as
;; move-to-end), the nREPL's as well.

(def source-prefix [source line col]
  "The text of source before the 1-based line and code-point column."
  (= lines (.split source "\n"))
  (= before (sub lines [: None (- line 1)]))
  (.append before (sub (sub lines (- line 1)) [: None col]))
  (return (.join "\n" before)))

(def _pop-through [stack kind]
  "Pop stack down to and including its last entry of kind, if it has one."
  (for index in (range (- (len stack) 1) -1 -1)
    (if (== (sub (sub stack index) 0) kind)
        (do (del (sub stack [: index None]))
            (return)))))

(def open-forms [prefix :literals False]
  "The forms still open at the end of prefix, outermost first, or None
   when the lexer cannot read it or it ends inside an f/t-string, which no
   bracket can close: each a list [kind closer opening head index], kind
   \"b\" a bracket, \"f\" a field's }, \"q\" a literal's quote; opening and
   head are the (1-based line, code-point column) of a bracket's token (its
   prefix included) and of the token after it (None when there is none),
   index the opening's index in prefix, all three None for a field or
   literal.  literals: keep an open f/t-string too (open-form-closers)."
  (try
    (= tokens (list (tokenize prefix)))
    (except [Exception]
      (return None)))
  ;; A stray closer pops only a bracket; a field or literal end pops back
  ;; to its own entry, if any, so a typo never misaligns the closers or
  ;; empties the stack.
  (= stack [])
  (= open-literals 0)
  (= awaiting-head None)
  (= offset (source-offset prefix))
  (for [text tktype info _] in tokens
    (= position (, (sub info "lineno") (sub info "col_offset")))
    (if (is-not awaiting-head None)
        (do (= (sub awaiting-head 3) position)
            (= awaiting-head None)))
    (cond
      (== tktype "error")
      (return None)

      (== tktype "interpolated-start")
      (do (+= open-literals 1)
          (.append stack ["q" (.lstrip text "fFtTrR") None None None]))

      (== tktype "interpolated-end")
      (do (-= open-literals 1)
          (_pop-through stack "q"))

      (== tktype "field-start")
      (.append stack ["f" "}" None None None])

      (== tktype "field-end")
      (_pop-through stack "f")

      (or (== tktype "opening")
          (and (== tktype "bad-prefix") (in (sub text -1) "([{")))
      (do (= closer (.get _CLOSERS (sub text -1)))
          (if (is closer None)
              (return None))
          (= awaiting-head ["b" closer position None (offset (sub position 0) (sub position 1))])
          (.append stack awaiting-head))

      (and (== tktype "closing") stack (== (sub (sub stack -1) 0) "b"))
      (.pop stack)))
  (if (and open-literals (not literals))
      (return None))
  (return stack))

(def open-form-closers [prefix :literals False]
  "The closers of the forms still open at the end of prefix (open-forms),
   innermost first, or None when open-forms is.  Appended to prefix, they
   make a mid-edit buffer parse up to the cursor.  literals: close an open
   f/t-string too (its fields' }, its quote), for a reader of the forms
   inside a field; the cursor view never asks for it, its text must
   compile to the Python the buffer means."
  (= stack (open-forms prefix :literals literals))
  (if (is stack None)
      (return None))
  (return (.join "" (reversed [(sub entry 1) for entry in stack]))))

;; A suppression comment of tool (pyright, pyrefly) in a comment's text,
;; spaced as the tool takes one after its comment marker (a ; here, #
;; there): ;pyright:ignore, ;; pyrefly: ignore[codeA, code-b]; group 1 is
;; the rule list.  Each tool honours only its own marker, so the backend
;; decides which one is read (backend.suppression-tool).
(deco functools.cache
(def _suppression-pattern [tool]
  (return (re.compile (+ "(?:^|;)\\s*" (re.escape tool)
                         ":\\s*ignore(?:\\s*\\[([\\s\\w\\-,]*)\\]|\\s|$)")))))

(def suppression-comments [source tool]
  "Line (1-based) -> what a suppression comment of tool on it ignores in
   source: the frozenset of the rules ; tool: ignore[ruleA, ruleB] names,
   or None for a bare ; tool: ignore, every rule.  Comments are the
   reader's own (tokenize's comment tokens), so a ; in a string is none; a
   source the lexer cannot read keeps those before the failure."
  (= pattern (_suppression-pattern tool))
  (try
    (= tokens (tokenize source :comments True))
    (except [Exception]
      (return {})))
  (= found {})
  (for [text tktype position _] in tokens
    (if (!= tktype "comment")
        (continue))
    (= m (.search pattern text))
    (if (is m None)
        (continue))
    (= rules (.group m 1))
    (= (sub found (sub position "lineno"))
       (ife (is rules None)
            None
            (frozenset (filter None (map str.strip (.split rules ",")))))))
  (return found))

;; Every word read back from the source (the partial word at the cursor, a
;; word spelling a Python name) is the reader's (completion-word-span,
;; word-parts in core/parser.py), never a character table of its own.

(def partial-span [text col]
  "The partial word at code-point column col of line text, as view-at-cursor
   reads it: (start, end), the reader's word from after its last dot before
   col through to the next dot after col or the token's end
   (completion-word-span's replace-start..end)."
  (= [_ start end] (completion-word-span text col))
  (return (, start end)))

(def glued-base [text col]
  "The dotted name written glued to the dot before the word at code-point
   column col of line text (a.b for a.b.c|), or None when no dot is there
   or no name runs into it (x .c, (.c x), a..c)."
  (= [start replace-start _] (completion-word-span text col))
  (= base (sub text [: start (max start (- replace-start 1))]))
  (if (or (not base) (in "" (.split base ".")))
      (return None))
  (return base))

;; ---------------------------------------------------------------------------
;; Position map
;; ---------------------------------------------------------------------------

(def _contains [start end pos]
  (return (and (<= start pos) (<= pos end))))

(def _narrower-p [start end name-p best-start best-end best-name-p]
  "Whether span start..end lies inside the best span so far: it starts later,
   or starts there and ends sooner, or is the same span read as a name."
  (cond (!= start best-start)
        (return (> start best-start))
        (!= end best-end)
        (return (< end best-end)))
  (return (and name-p (not best-name-p))))

(def _shift-pos [pos line start end delta]
  "pos after the text start..end of line became delta characters longer:
   a point at or past end moves by delta, one inside clamps to the new end."
  (if (!= (sub pos 0) line)
      (return pos))
  (= col (sub pos 1))
  (cond (>= col end)
        (return (, line (+ col delta)))
        (> col start)
        (return (, line (min col (+ end delta)))))
  (return pos))

(class PositionMap []
  "Spans between the generated Python and the .lpy source.  Each entry is
   (gen-start gen-end lpy-start lpy-end name-p): a whole node, or with name-p
   just its identifier (Name, arg, keyword, alias, the attribute of an
   Attribute), whose columns correspond character for character."

  (def __init__ [self entries]
    (= self.entries entries))

  (def _innermost [self pos from-index]
    "The innermost entry whose span on side from-index (0 generated, 2
     .lpy) holds pos (end inclusive), or None; a name wins a tie."
    (= best None)
    (for entry in self.entries
      (= start (sub entry from-index))
      (= end (sub entry (+ from-index 1)))
      (if (and (_contains start end pos)
               (or (is best None)
                   (_narrower-p start end (sub entry 4)
                                (sub best from-index)
                                (sub best (+ from-index 1))
                                (sub best 4))))
          (= best entry)))
    (return best))

  (def entry-at [self line col]
    "The innermost entry whose generated span holds (line, col), or None."
    (return (._innermost self (, line col) 0)))

  (def range-spans [self start end]
    "(exact, spanning) for the generated range start..end, in one pass over
     the entries: exact, the narrowest .lpy span of the node entries (never
     a name entry) whose generated span is exactly start..end; spanning, the
     .lpy span of the innermost entry whose generated span holds the whole
     range (a name wins a tie).  Either is None when there is none."
    (= exact None)
    (= spanning None)
    (for entry in self.entries
      (= [gen-start gen-end lpy-start lpy-end name-p] entry)
      (if (or (> gen-start start) (< gen-end end))
          (continue))
      (if (and (not name-p) (== gen-start start) (== gen-end end)
               (or (is exact None)
                   (_narrower-p lpy-start lpy-end False (sub exact 0) (sub exact 1) False)))
          (= exact (, lpy-start lpy-end)))
      (if (or (is spanning None)
              (_narrower-p gen-start gen-end name-p
                           (sub spanning 0) (sub spanning 1) (sub spanning 4)))
          (= spanning entry)))
    (return (, exact (ife (is spanning None) None (, (sub spanning 2) (sub spanning 3))))))

  (def _lookup [self pos from-index to-index]
    (= best (._innermost self pos from-index))
    (if (is best None)
        (return None))
    (= target (sub best to-index))
    (if (not (sub best 4))
        (return target))
    (= offset (- (sub pos 1) (sub (sub best from-index) 1)))
    (= length (- (sub (sub best (+ to-index 1)) 1) (sub target 1)))
    (return (, (sub target 0) (+ (sub target 1) (min offset length)))))

  (def to-lpy [self line col]
    "The .lpy position of generated (line, col), or None: the innermost
     generated span holding it (end inclusive).  Inside a name the offset
     into it is kept, clamped to the .lpy spelling; elsewhere the .lpy start
     of the node."
    (return (._lookup self (, line col) 0 2)))

  (def to-generated [self line col]
    "The generated position of .lpy (line, col), or None: the innermost .lpy
     span holding it, the first in generated order among equal spans."
    (return (._lookup self (, line col) 2 0)))

  (def shift [self gen-line gen-start gen-end gen-delta
              lpy-line lpy-start lpy-end lpy-delta]
    "Follow a text edit on one generated and one .lpy line (_shift-pos)."
    (= self.entries
       [(, (_shift-pos gs gen-line gen-start gen-end gen-delta)
           (_shift-pos ge gen-line gen-start gen-end gen-delta)
           (_shift-pos ls lpy-line lpy-start lpy-end lpy-delta)
           (_shift-pos le lpy-line lpy-start lpy-end lpy-delta)
           name-p)
        for [gs ge ls le name-p] in self.entries])))

(def _lpy-span [node]
  "node's .lpy (start, end), or None for a node the compiler left
   unpositioned: lineno 0 or missing (what a macro or require synthesised)."
  (= line (getattr node "lineno" None))
  (if (not line)
      (return None))
  (= col (or (getattr node "col_offset" None) 0))
  (= end-line (or (getattr node "end_lineno" None) line))
  (= end-col (getattr node "end_col_offset" None))
  (if (is end-col None)
      (= end-col col))
  (return (, (, line col) (, end-line end-col))))

(def _in-buffer-p [lines span]
  "Whether .lpy span span lies inside the buffer text lines: a macro may give
   a node any explicit position, so the map never trusts an AST position."
  (= [[line col] [end-line end-col]] span)
  (return (and (<= 1 line end-line (len lines))
               (<= 0 col (len (sub lines (- line 1))))
               (<= 0 end-col (len (sub lines (- end-line 1)))))))

(def _lpy-name-span [lines span name]
  "The .lpy span spelling Python name name within node span span, or None.
   The spelling sits at no fixed place: a dotted symbol or (. x a) ends the
   node with it, a method call (.ff x) starts it right after the dot, a
   keyword parameter after its colon, and a macro may put anything there;
   so each place is tried and the one that spells name (_spells-p) wins.  span
   lies inside lines (_in-buffer-p)."
  (= [[line col] [end-line end-col]] span)
  (= text (sub lines (- line 1)))
  (if (and (== line end-line) (_spells-p (sub text [: col end-col]) name))
      (return (, (, line col) (, line end-col))))
  (= end-text (sub lines (- end-line 1)))
  (= start (sub (completion-word-span end-text end-col) 1))
  (if (and (< start end-col) (_spells-p (sub end-text [: start end-col]) name))
      (return (, (, end-line start) (, end-line end-col))))
  (= start (ife (and (< col (len text)) (in (sub text col) ".:")) (+ col 1) col))
  (= end (sub (completion-word-span text start) 2))
  (if (and (< start end) (_spells-p (sub text [: start end]) name))
      (return (, (, line start) (, line end))))
  (return None))

(class _GeneratedColumns []
  "Code-point columns of the generated text from ast.parse's byte offsets."
  (def __init__ [self text]
    (= self.lines (.split text "\n")))

  (def pos [self line byte-col]
    (if (> line (len self.lines))
        (return (, line byte-col)))
    (= text (sub self.lines (- line 1)))
    (if (.isascii text)
        (return (, line byte-col)))
    (return (, line (len (.decode (sub (.encode text "utf-8") [: None byte-col])
                                  "utf-8" "replace"))))))

(def _gen-span [node columns]
  (= line (getattr node "lineno" None))
  (if (not line)
      (return None))
  (return (, (.pos columns line node.col_offset)
             (.pos columns node.end_lineno node.end_col_offset))))

(def _gen-name-span [node span]
  "The generated span of node's identifier and the identifier, or None."
  (= [[line col] [end-line end-col]] span)
  (cond (isinstance node ast.Name)
        (return (, span node.id))
        (isinstance node ast.Attribute)
        (return (, (, (, end-line (- end-col (len node.attr))) (, end-line end-col))
                   node.attr))
        (and (isinstance node (, ast.arg ast.keyword)) node.arg)
        (return (, (, (, line col) (, line (+ col (len node.arg)))) node.arg))
        (isinstance node ast.alias)
        (return (, (, (, line col) (, line (+ col (len node.name)))) node.name)))
  (return None))

(def build-position-map [compiled generated source text]
  "The PositionMap from a structural walk of the compiled tree and its
   re-parse in step.  A pair whose types differ (a round trip that changed
   shape) and a list field whose lengths differ are skipped with everything
   under them, never the whole map; except a Constant the unparse spells as an
   operation (-1, 1+2j, a nan), which still maps as one node."
  (= lines (.split source "\n"))
  (= columns (_GeneratedColumns text))
  (= entries [])
  (= stack [(, compiled generated)])
  (while stack
    (= [a b] (.pop stack))
    (= leaf (and (isinstance a ast.Constant) (isinstance b (, ast.UnaryOp ast.BinOp))))
    (if (and (is-not (type a) (type b)) (not leaf))
        (continue))
    (= lpy (_lpy-span a))
    (if (and (is-not lpy None) (not (_in-buffer-p lines lpy)))
        (= lpy None))
    (= gen (ife (is lpy None) None (_gen-span b columns)))
    (if (is-not gen None)
        (do (.append entries (, (sub gen 0) (sub gen 1) (sub lpy 0) (sub lpy 1) False))
            (= named (_gen-name-span b gen))
            (if (is-not named None)
                (do (= lpy-name (_lpy-name-span lines lpy (sub named 1)))
                    (if (is-not lpy-name None)
                        (.append entries
                          (, (sub (sub named 0) 0) (sub (sub named 0) 1)
                             (sub lpy-name 0) (sub lpy-name 1) True)))))))
    (if leaf
        (continue))
    (= children [])
    (for [field va] in (ast.iter-fields a)
      (= vb (getattr b field None))
      (cond (and (isinstance va ast.AST) (isinstance vb ast.AST))
            (.append children (, va vb))
            (and (isinstance va list) (isinstance vb list) (== (len va) (len vb)))
            (for [x y] in (zip va vb)
              (if (and (isinstance x ast.AST) (isinstance y ast.AST))
                  (.append children (, x y))))))
    (.extend stack (reversed children)))
  ;; Generated order, which breaks ties between equal .lpy spans.
  (.sort entries :key (fn [e] (sub e 0)))
  (return (PositionMap entries)))

;; ---------------------------------------------------------------------------
;; Views
;; ---------------------------------------------------------------------------

(class PythonView []
  "A buffer's generated Python (text), its PositionMap (map) and tree, the
   ast.parse of text.  A view at a cursor also has cursor, the generated
   (line, col) right after the partial word typed there, partial, that word
   as typed, attribute, True when that word is an attribute name in the
   generated Python (a dot right before it: x.a, (. x a), a.b.c),
   in-import, True when the word is a name inside an import statement
   (a module, a dotted part of one, an imported name or its alias), and
   fallback, True when only the text before the cursor compiled; its tree
   is None, since its text was edited after the parse (and may not parse:
   x.).  macros maps the name (name-key) of every macro the buffer's
   compile had registered once expanded to the spelling it was registered
   under (my-mac, mod.my-mac): a name there is a lispython form at a call's
   head, which no Python backend knows, and completion offers the
   spelling's hyphen spelling (hyphen-spelling).  builtin-macros maps the name (name-key) of each of those that
   is a built-in macro (the very macro of lispy.macros, so never one a
   defmacro or another module's require registered under that name) to the
   built-in's own name."
  (def __init__ [self text position-map tree :macros {}
                 :builtin-macros {}]
    (= self._lines None)
    (= self.text text)
    (= self.map position-map)
    (= self.tree tree)
    (= self.macros macros)
    (= self.builtin-macros builtin-macros)
    (= self.cursor None)
    (= self.partial None)
    (= self.attribute False)
    (= self.in-import False)
    (= self.fallback False))

  (deco property
    (def lines [self]
      "text split into lines, once per text (view-at-cursor edits text)."
      (if (or (is self._lines None) (is-not (sub self._lines 0) self.text))
          (= self._lines (, self.text (.split self.text "\n"))))
      (return (sub self._lines 1)))))

(deco (functools.lru-cache :maxsize 8)
  (def source-lines [source]
    "source split into lines, as a tuple: one split per source however many
     ranges are mapped over it."
    (return (tuple (.split source "\n")))))

(def spelled-in [lines start end name]
  "The .lpy span of the first word between start and end in lines
   (source-lines) that spells name (_spells-p), or None: each word is a
   .-part of the leaf of a symbol token the reader reads there (word-parts:
   (- -x) spells x)."
  (for line in (range (sub start 0) (+ (sub end 0) 1))
    (if (> line (len lines))
        (break))
    (= text (sub lines (- line 1)))
    (= col (ife (== line (sub start 0)) (sub start 1) 0))
    (= stop (ife (== line (sub end 0)) (min (sub end 1) (len text)) (len text)))
    (for [part-start part-end] (word-parts text col stop)
      (if (_spells-p (sub text [: part-start part-end]) name)
          (return (, (, line part-start) (, line part-end))))))
  (return None))

(def lpy-range [view source start end]
  "The .lpy ((line col) (line col)) range in source, the text view was
   compiled from, of the generated range start..end of view.text, or None
   when it maps nowhere (code the compiler made up).  Positions are (1-based
   line, code-point column) on both sides.  An empty range at (1, 0) is the
   module itself and stays there.  Inside one name entry the range maps
   character for character, clamped to the .lpy spelling.  Otherwise a range
   that is one identifier is looked up by py-name among the words of the
   innermost entry's .lpy span: a FunctionDef or ClassDef name has no node,
   so no entry, of its own (its entry is the whole (def my-fn ...) form),
   and a name the source never spells (a defmacro's temporary def, a
   gensym) is found nowhere and dropped.  Anything else maps nowhere."
  (if (and (== start (, 1 0)) (== end (, 1 0)))
      (return (, (, 1 0) (, 1 0))))
  (= entry (.entry-at view.map (sub start 0) (sub start 1)))
  (if (is entry None)
      (return None))
  (= [gen-start gen-end lpy-start lpy-end name-p] entry)
  (if (and name-p (_contains gen-start gen-end end))
      (do (= length (- (sub lpy-end 1) (sub lpy-start 1)))
          (return (, (, (sub lpy-start 0)
                        (+ (sub lpy-start 1) (min (- (sub start 1) (sub gen-start 1)) length)))
                     (, (sub lpy-start 0)
                        (+ (sub lpy-start 1) (min (- (sub end 1) (sub gen-start 1)) length)))))))
  (= word (_generated-text view start end))
  (if (or (is word None) (not (.isidentifier word)))
      (return None))
  (return (spelled-in (source-lines source) lpy-start lpy-end word)))

(def _generated-text [view start end]
  "The text of view between generated start and end when both lie on one
   line of it, else None."
  (= gen-lines view.lines)
  (if (or (!= (sub start 0) (sub end 0)) (> (sub start 0) (len gen-lines)))
      (return None))
  (return (sub (sub gen-lines (- (sub start 0) 1)) [: (sub start 1) (sub end 1)])))

(def lpy-diagnostic-range [view source start end tagged]
  "The .lpy range in source of a backend diagnostic at the generated range
   start..end of view, or None to drop it; positions as in lpy-range.
   tagged: the diagnostic is a hint the editor greys or strikes out
   (DiagnosticTag Unnecessary or Deprecated).  In order:
   a. lpy-range (a name entry, or one identifier the innermost entry's .lpy
      span spells);
   b. a range that is not one identifier and is exactly the generated span
      of node entries (an extra call argument, an unreachable statement):
      the narrowest of their .lpy spans;
   c. untagged only, the innermost entry holding the whole range: an error
      inside a macro's output lands on the macro call, whose position its
      positionless nodes took;
   d. None, as Volar and Svelte drop what does not map.
   A hint needs a or b, since greying the whole enclosing form would mark
   code that is used; and an identifier that a misses (a gensym, a
   defmacro's temporary def) is never b's, since its node took the macro
   call's span.  lpy-range's module rule (an empty range at (1, 0)) does
   not apply: a dropped diagnostic never moves to the module's start."
  (if (and (== start (, 1 0)) (== end (, 1 0)))
      (return None))
  (= found (lpy-range view source start end))
  (if (is-not found None)
      (return found))
  (= word (_generated-text view start end))
  (= [exact spanning] (.range-spans view.map start end))
  (if (and (is-not exact None) (not (and (is-not word None) (.isidentifier word))))
      (return exact))
  (if tagged
      (return None))
  (return spanning))

;; Who holds each import root on sys.path: directory -> [users, the entry
;; _on-sys-path inserted or None], under _SYS-PATH-LOCK, since threads
;; compiling at once share one sys.path.
(= _SYS-PATH-LOCK (threading.Lock))
(= _SYS-PATH-USERS {})

(deco contextlib.contextmanager
  (def _on-sys-path [directory]
    "Keep directory on sys.path for the body (nothing for None): inserted
     first by the first user when absent, and that entry removed when the
     last user leaves, so sys.path ends as it was."
    (if (is directory None)
        (do (yield)
            (return)))
    (with [_SYS-PATH-LOCK]
      (= users (.get _SYS-PATH-USERS directory))
      (if (is users None)
          (do (= users [0 None])
              (if (not (in directory sys.path))
                  (do (.insert sys.path 0 directory)
                      (= (sub users 1) directory)))
              (= (sub _SYS-PATH-USERS directory) users)))
      (+= (sub users 0) 1))
    (try
      (yield)
      (finally
        (with [_SYS-PATH-LOCK]
          (-= (sub users 0) 1)
          (if (== (sub users 0) 0)
              (do (del (sub _SYS-PATH-USERS directory))
                  (for [i entry] in (enumerate sys.path)
                    (if (is entry (sub users 1))
                        (do (del (sub sys.path i))
                            (break)))))))))))

(deco contextlib.contextmanager
  (def _on-sys-paths [directories]
    "Keep each of directories on sys.path for the body (_on-sys-path), the
     first ending first in sys.path where none of them was there before."
    (with [(contextlib.ExitStack) as stack]
      (for directory in (reversed (list directories))
        (.enter-context stack (_on-sys-path directory)))
      (yield))))

;; id of each built-in macro -> its name: compile-buffer tells a built-in
;; macro in a buffer's macro table by identity, as the seeding and a require
;; of lispy.macros register the macro object itself, whatever the key.
(= _BUILTIN-MACRO-NAMES {(id macro) name
                         for [name macro] in (.items BUILTIN-MACRO-NAMESPACE)})

;; compile-buffer's stages: where a buffer that made no view failed.
(= PARSE-STAGE "parse")
(= COMPILE-STAGE "compile")
(= VIEW-STAGE "view")

(class CompiledBuffer []
  "What compile-buffer made of a buffer: view, its PythonView, or None; and
   when that is None, stage, where it failed, and error, the exception.
   PARSE-STAGE is the reader, COMPILE-STAGE macro expansion and the
   compiler (what diagnostics report); VIEW-STAGE is the unparse or the
   re-parse of the generated module, which no diagnostic names.  epoch is
   the macro environment it compiled under (macro_modules.epoch)."
  (def __init__ [self view :stage None :error None :epoch None]
    (= self.epoch epoch)
    (= self.view view)
    (= self.stage stage)
    (= self.error error)))

(def compile-buffer [source :package "" :name "__main__" :search-dirs (,)
                     :filename None]
  "The CompiledBuffer of source: the one compile of a buffer, whose view
   the backend gets and whose failure diagnostics report.  The parse is
   strict and runs in compile-errors for filename (the document's path), so
   a parse warning names that file.  Macros run with search-dirs
   (module-names' fourth item) on sys.path (_on-sys-paths), so a relative
   require imports its package and a script's sibling module imports, and
   under fresh-modules, so a module a require imported is
   imported anew once its file changed (macro_modules.lpy); the generated
   module is never compiled or executed.  Warnings go where the process's
   filters send them (stderr, never the LSP's stdout); a filter that makes one an error fails the stage it was
   issued in.  The filters are never swapped here: a swap is process wide,
   so it would need a lock held across the user's macros, which every other
   compile on the loop would then wait for."
  (= scope {"__builtins__" builtins
            "__name__" name
            "__package__" package
            "__macro_namespace" (MacroTable)})
  (try
    (with [(compile-errors filename source)]
      (= forms (parse source)))
    (except [Exception as e]
      ;; No macro ran, so any epoch holds it.
      (return (CompiledBuffer None :stage PARSE-STAGE :error e :epoch (current-epoch)))))
  (= macro-epoch None)
  (try
    (with [(fresh-modules) as entered (_on-sys-paths search-dirs)]
      (= macro-epoch entered)
      (= body (list (compile-unit forms scope))))
    (except [Exception as e]
      (return (CompiledBuffer None :stage COMPILE-STAGE :error e :epoch macro-epoch))))
  (try
    (= module (ast.Module :body body :type-ignores (list)))
    (= text (unparse module))
    (= tree (ast.parse text))
    (= position-map (build-position-map module tree source text))
    ;; One entry per name (MacroTable), under the spelling a defmacro or
    ;; require last registered it by.
    (= table (list (.items (.get scope "__macro_namespace" {}))))
    (= macros {(name-key key) key for [key _] in table})
    (= builtin-macros {(name-key key) (sub _BUILTIN-MACRO-NAMES (id macro))
                       for [key macro] in table
                       if (in (id macro) _BUILTIN-MACRO-NAMES)})
    (except [Exception as e]
      (return (CompiledBuffer None :stage VIEW-STAGE :error e :epoch macro-epoch))))
  (return (CompiledBuffer (PythonView text position-map tree :macros macros
                                      :builtin-macros builtin-macros)
                          :epoch macro-epoch)))

(def compile-view [source :package "" :name "__main__" :search-dirs (,)]
  "The PythonView of source (compile-buffer), or None when it does not
   become Python: a parse or compile error, a failing macro, a nesting too
   deep to unparse."
  (return (. (compile-buffer source :package package :name name :search-dirs search-dirs)
             view)))

;; Stands in for the word at the cursor: a plain name, unchanged by mangling,
;; that compiles wherever a symbol does.
(= CURSOR-SENTINEL "___lpy_cursor___")

(= _IDENTIFIER-FIELDS (frozenset ["id" "attr" "arg" "name" "asname" "module"
                                  "names" "rest" "kwd_attrs"]))

(def _identifier-count [tree word]
  "How many identifiers in tree are word: a name, attribute, parameter,
   keyword, definition, pattern capture or a component of a dotted import.
   Only the fields that hold identifiers are read (_IDENTIFIER-FIELDS),
   never a string: a constant, a type comment, or a t-string
   Interpolation's str, the field's source text, which spells the sentinel
   a second time."
  (= found 0)
  (for node in (ast.walk tree)
    (for [field value] in (ast.iter-fields node)
      (if (in field _IDENTIFIER-FIELDS)
          (for v in (ife (isinstance value list) value [value])
            (if (isinstance v str)
                (+= found (.count (.split v ".") word)))))))
  (return found))

(def _refused-open-form [compiled stack]
  "The entry of stack (open-forms) that compiled's compile error is placed
   at, at its bracket or its head, or None: no such error, or an error at
   any other form, which unwrapping the forms around the cursor never
   mends.  The innermost match wins: an inner form's bracket is the head
   of the one around it, and unwrapping the outer one first would drop it
   in the next round too ([(when x| is [x], never x)."
  (= error compiled.error)
  (if (or (!= compiled.stage COMPILE-STAGE)
          (not (isinstance error LispyCompileError))
          (is error.lineno None) (is error.offset None))
      (return None))
  (= position (, error.lineno (- error.offset 1)))
  (for entry in (reversed stack)
    (if (and (== (sub entry 0) "b")
             (in position (, (sub entry 2) (sub entry 3))))
        (return entry)))
  (return None))

(def _blank-span [text start end]
  "text with every character but a line break from index start up to end
   replaced by a space, so every position after it stays where it was."
  (= blanked (re.sub "[^\r\n]" " " (sub text [: start end])))
  (return (+ (sub text [: None start]) blanked (sub text [: end None]))))

;; The heads whose form binds parameters in its [params] bracket: these at
;; slot 2, LAMBDA-HEADS at slot 1; and the heads whose name may carry glued
;; type parameters (f[T]).  A user macro that wraps one is not seen.
(= _DEF-HEADS (, "def" "async-def" "defmacro"))
(= _TYPE-PARAMETER-HEADS (, "def" "async-def" "class" "type"))

(def _param-slot [form]
  "The slot of form, a parsed Paren, that holds the [params] bracket its
   head binds (_DEF-HEADS, LAMBDA-HEADS), or None when its head binds
   none."
  (if (== (len form) 0)
      (return None))
  (= head (atom-text (sub form 0)))
  (return (ife (in head _DEF-HEADS) 2 (ife (in head LAMBDA-HEADS) 1 None))))

(def _header-slot [form]
  "The slot of form, a parsed Paren, whose bracket is the form's own syntax,
   never an expression: a def's or lambda's params (_param-slot) or a
   class's bases; or None."
  (= slot (_param-slot form))
  (if (and (is slot None) (== (atom-text (sub form 0)) "class"))
      (return 2))
  (return slot))

(def _sentinel-child [form]
  "The direct child of form, a parsed Expression, that holds the cursor
   sentinel (_holds-sentinel), or None."
  (for child in form.list
    (if (_holds-sentinel child)
        (return child)))
  (return None))

(def _position [node]
  "The (1-based line, column) a parsed node starts at, its reader prefixes
   included."
  (= info node.position-info)
  (return (, (.get info "lineno") (.get info "col_offset"))))

(def _unwrap-start [prefix refused]
  "Where unwrapping refused, an open-forms entry of prefix, blanks up to:
   the index in prefix of the start of refused's direct child that holds
   the cursor sentinel, the prefixes and glue the reader gives it included
   (' ~@ * : f[T] grid.), so that child takes the form's place and every
   form inside it stays; or None, when the reader places no such form or
   child, or the cursor stands where a form the unwrap drops binds a name
   (_binds-sentinel-p): unwrapping would answer for the scope around it,
   where that name is no name."
  ;; Only the refused form is dropped, never the forms between it and the
  ;; cursor: blanking up to the sentinel dropped a fn, for or glued base
  ;; there, and with it the names it binds or the attribute being typed.
  (= closers (open-form-closers prefix))
  (if (is closers None)
      (return None))
  (= closed (+ prefix closers))
  (= opening (sub refused 2))
  ;; A node's bracket token, where open-forms places it, is at the node's
  ;; own position or at that of a wrapper the token includes (*( **(), so
  ;; each node is walked with its wrapper's position too.
  (= pending [(, node (_position node)) for node in (parse closed :partial True)])
  (= form None)
  (while pending
    (= [node outer] (.pop pending))
    (cond (isinstance node Expression)
          (do (= here (, outer (_position node)))
              (if (and (is form None) (in opening here))
                  (= form node))
              ;; A form counts when it is dropped, or the bracket of its
              ;; params or type parameters is (refused at its head:
              ;; (def f [:x|).
              (= parts (list here))
              (= slot (ife (isinstance node Paren) (_param-slot node) None))
              (if (and (is-not slot None) (> (len node) slot))
                  (.append parts (_position (sub node slot))))
              (if (and (>= (len node) 2) (isinstance (sub node 1) GluedHead))
                  (.append parts (_position (. (sub node 1) params))))
              (if (and (isinstance node Paren) (in opening parts)
                       (_binds-sentinel-p node))
                  (return None))
              (.extend pending ((, child (_position child)) for child in node.list)))
          (isinstance node GluedHead)
          (.extend pending ((, child (_position child))
                             for child in [node.head node.params]))
          (isinstance node (, Wrapper MetaIndicator))
          (.append pending (, node.value outer))))
  (if (is form None)
      (return None))
  (= child (_sentinel-child form))
  ;; A params or bases bracket is no expression ([a :b gr] is refused as a
  ;; list), so its child holding the cursor (a default, an annotation, a
  ;; base) takes the form's place, an annotation without its ^ (the
  ;; return annotation's mark where the form stood).
  (= slot (ife (and (isinstance form Paren) (> (len form) 0)) (_header-slot form) None))
  (if (and (is-not child None) (is-not slot None) (> (len form) slot)
           (is child (sub form slot)) (isinstance child Bracket))
      (do (= child (_sentinel-child child))
          (if (isinstance child Annotation)
              (= child child.value))))
  (if (is child None)
      (return None))
  (return ((source-offset closed) *(_position child))))

(def _binds-sentinel-p [form]
  "True when the cursor sentinel stands where form, a parsed Paren, binds a
   name: a parameter's name (param-bindings; a list it refuses counts, the
   name may be what is being typed), anywhere in glued type parameters
   (def f[T], class A[T]), or anywhere in the body of a def or lambda,
   where its parameters are names.  A default or annotation is read in the
   scope around the form, so it never counts; nor do class bases."
  (if (== (len form) 0)
      (return False))
  (if (and (in (atom-text (sub form 0)) _TYPE-PARAMETER-HEADS) (>= (len form) 2)
           (isinstance (sub form 1) GluedHead)
           (_holds-sentinel (. (sub form 1) params)))
      (return True))
  (= slot (_param-slot form))
  (if (or (is slot None) (<= (len form) slot)
          (not (isinstance (sub form slot) Bracket)))
      (return False))
  ;; Unwrapping a def or lambda the cursor is inside loses its parameters.
  (if (any ((_holds-sentinel part) for part in (sub form.list [: (+ slot 1) None])))
      (return True))
  (if (not (_holds-sentinel (sub form slot)))
      (return False))
  (try
    (return (any ((== (atom-text name) CURSOR-SENTINEL)
                  for name in (param-bindings (sub form slot)))))
    (except [LispyCompileError]
      (return True))))

(def _holds-sentinel [node]
  "True when node, a parsed node, has the cursor sentinel among its atoms."
  (= pending [node])
  (while pending
    (= node (.pop pending))
    (cond (isinstance node Expression)
          (.extend pending node.list)
          (isinstance node GluedHead)
          (.extend pending [node.head node.params])
          (isinstance node (, Wrapper MetaIndicator))
          (.append pending node.value)
          ;; The sentinel's own token may glue it to a base (grid.___).
          (and (isinstance node Symbol) (in CURSOR-SENTINEL (atom-text node)))
          (return True)))
  (return False))

(def view-at-cursor [source line col :package "" :name "__main__" :search-dirs (,)]
  "The PythonView of source at the cursor (_view-at-cursor)."
  (return (sub (_view-at-cursor source line col :package package :name name
                                :search-dirs search-dirs)
               0)))

(def _view-at-cursor [source line col :package "" :name "__main__" :search-dirs (,)]
  "(view, epoch): view-at-cursor's view and the earliest macro environment
   its compiles ran under (None when none ran).  The PythonView of source for a request at 1-based line, code-point col,
   or None.  The partial word at the cursor (partial-span: the reader's
   word of completion-word-span after its last dot, through to the next dot
   or the token's end, so my-|x and -|-x leave nothing of the token to glue
   onto it) is replaced by CURSOR-SENTINEL so a buffer mid-edit (my-x.  or
   (. obj ) ) still compiles, the rest of the word being what a completion
   there replaces; when the whole buffer does not, the text
   before the cursor with its open forms closed is compiled instead, and
   while that is refused at an open form around the cursor ((== (sub gr|
   with one operand, (when x| with no body), that one form is unwrapped:
   its text up to its child holding the cursor is blanked (_unwrap-start,
   _blank-span), so that child, and every form inside it, stands in the
   form's place, every position unmoved; never with the cursor where the
   dropped form binds a name or inside a def or lambda it drops
   (_binds-sentinel-p), and a round that blanks no open bracket gives up.
   A word glued to a base (grid.re|) gives a view only as an attribute.
   The sentinel must come out as exactly one identifier of the generated Python
   (a cursor in a string literal gives None); it is replaced by the
   partial's Python name and the map follows that edit, the generated
   partial standing for the whole .lpy word.  search-dirs is
   compile-buffer's."
  (= lines (.split source "\n"))
  (if (not (<= 1 line (len lines)))
      (return (, None None)))
  (= text (sub lines (- line 1)))
  (if (not (<= 0 col (len text)))
      (return (, None None)))
  (= [word-start start end] (completion-word-span text col))
  (= partial (sub text [: start col]))
  (= (sub lines (- line 1)) (+ (sub text [: None start]) CURSOR-SENTINEL (sub text [: end None])))
  (= marked (.join "\n" lines))
  (= sentinel-end (+ start (len CURSOR-SENTINEL)))
  (= fallback False)
  (= compiled (compile-buffer marked :package package :name name :search-dirs search-dirs))
  (= view compiled.view)
  (= macro-epoch compiled.epoch)
  (if (is view None)
      (do (= prefix (source-prefix marked line sentinel-end))
          (= sentinel-start (- (len prefix) (len CURSOR-SENTINEL)))
          (= fallback True)
          ;; Each round must blank at least one open bracket, or the loop
          ;; gives up, so the rounds (each a compile running the user's
          ;; macros) are bounded by the open forms around the cursor.
          (= open-count None)
          (while True
            (= stack (open-forms prefix))
            (if (or (is stack None)
                    (and (is-not open-count None) (>= (len stack) open-count)))
                (return (, None macro-epoch)))
            (= open-count (len stack))
            (= compiled (compile-buffer
                          (+ prefix (.join "" (reversed [(sub entry 1) for entry in stack])))
                          :package package :name name :search-dirs search-dirs))
            (if (or (is macro-epoch None)
                    (and (is-not compiled.epoch None) (< compiled.epoch macro-epoch)))
                (= macro-epoch compiled.epoch))
            (= view compiled.view)
            (if (is-not view None)
                (break))
            (= refused (_refused-open-form compiled stack))
            (if (or (is refused None)
                    (not (<= 0 (sub refused 4) (- sentinel-start 1))))
                (return (, None macro-epoch)))
            (= child-start (_unwrap-start prefix refused))
            (if (or (is child-start None)
                    (not (< (sub refused 4) child-start (+ sentinel-start 1))))
                (return (, None macro-epoch)))
            (= prefix (_blank-span prefix (sub refused 4) child-start)))))
  (if (or (is view None) (!= (.count view.text CURSOR-SENTINEL) 1)
          (!= (_identifier-count view.tree CURSOR-SENTINEL) 1))
      (return (, None macro-epoch)))
  (= in-import (any ((> (_identifier-count node CURSOR-SENTINEL) 0)
                     for node in (ast.walk view.tree)
                     if (isinstance node (, ast.Import ast.ImportFrom)))))
  (= index (.index view.text CURSOR-SENTINEL))
  (= gen-line (+ (.count view.text "\n" 0 index) 1))
  (= gen-col (- index (+ (.rfind view.text "\n" 0 index) 1)))
  ;; The sentinel compiled as an identifier, so only a Python name
  ;; (python-name-p) may take its place: any other word (a keyword such as
  ;; class, an operator or macro name such as - or ->>) gives no view, so no
  ;; backend is asked about a name the buffer does not hold (- is no _), and
  ;; cursor-word's offset back over the word stays the word's Python name.
  ;; An empty partial leaves what the user is typing (x.) unparsable, as it
  ;; is.
  (if (and partial (not (python-name-p partial)))
      (return (, None macro-epoch)))
  (= restored (py-name partial))
  (= view.text (+ (sub view.text [: None index]) restored
                  (sub view.text [: (+ index (len CURSOR-SENTINEL)) None])))
  (.shift view.map
          gen-line gen-col (+ gen-col (len CURSOR-SENTINEL))
          (- (len restored) (len CURSOR-SENTINEL))
          line start sentinel-end (- (- end start) (len CURSOR-SENTINEL)))
  (= view.tree None)
  (= view.cursor (, gen-line (+ gen-col (len restored))))
  (= view.partial partial)
  (= view.attribute (and (> index 0) (== (sub view.text (- index 1)) ".")))
  ;; A word glued to a base (grid.re|) is an attribute: a view that lost
  ;; the base would answer with the scope's names instead of its members.
  (if (and (< word-start start) (not view.attribute))
      (return (, None macro-epoch)))
  (= view.in-import in-import)
  (= view.fallback fallback)
  (return (, view macro-epoch)))

(class ViewCache []
  "The latest view of each document, by version and macro environment
   (the epoch its compile ran under: a hit needs macro_modules.epoch to be
   that one now, so the modules its requires imported are unchanged), and
   cursor for view-at-cursor: one
   entry per uri, so the cache never outgrows the open documents.  A None
   result is cached like any other.  Views are made in
   worker threads while forget runs on the LSP's loop, so a view stores
   its result only when no forget came since it began (generation, one
   counter for every uri: a close elsewhere only costs a cache miss),
   checked and stored under lock with forget, so a closed document's
   entry is never stored after it was dropped.  A caller that hands the
   view to a thread reads generation on its own thread first and passes
   it, since a forget can come before the worker starts."
  (def __init__ [self]
    (= self._views {})
    (= self._cursor-views {})
    (= self._lock (threading.Lock))
    (= self._generation 0))

  (def _store [self table uri key result generation]
    "Keep result as uri's entry in table under key, (version, epoch, ...),
     unless the document was forgotten since generation, or the entry is of
     a newer (version, epoch): a slow compile (one given up on) returning
     late must not cost the newer entry a recompile.  An entry of the same
     (version, epoch) is replaced (a fresh compile)."
    (with [self._lock]
      (= old (.get table uri))
      (if (and (== generation self._generation)
               (or (is old None) (is (sub (sub old 0) 0) None) (is (sub key 0) None)
                   (<= (, (sub (sub old 0) 0) (sub (sub old 0) 1))
                       (, (sub key 0) (sub key 1)))))
          (= (sub table uri) (, key result)))))

  (def _hit [self table uri key]
    "uri's entry in table when it is stored under key, whose second item is
     the epoch read now (None, a drop due: every entry is stale); else None."
    (if (is (sub key 1) None)
        (return None))
    (= hit (.get table uri))
    (if (and (is-not hit None) (== (sub hit 0) key))
        (return hit))
    (return None))

  (deco property
    (def generation [self]
      "The forget count a view made from now on stores under."
      (return self._generation)))

  (def compiled [self uri version source :package "" :name "__main__" :search-dirs (,)
                 :filename None :generation None :fresh False]
    "The CompiledBuffer of uri's source at version (compile-buffer), compiled
     once per version: the diagnostics of a change and every request on the
     same version share it.  fresh compiles again, replacing the entry."
    (if (is generation None)
        (= generation self._generation))
    (= hit (._hit self self._views uri (, version (epoch))))
    (if (and (not fresh) (is-not hit None))
        (return (sub hit 1)))
    (= result (compile-buffer source :package package :name name :search-dirs search-dirs
                              :filename filename))
    (if (is-not result.epoch None)
        (._store self self._views uri (, version result.epoch) result generation))
    (return result))

  (def cached-view [self uri version]
    "uri's full view at version as compiled under the macro environment of
     now (epoch), or None: none compiled yet, or it failed.  It never
     compiles, so a request on the loop may read it."
    (if (is version None)
        (return None))
    (= hit (._hit self self._views uri (, version (epoch))))
    (if (is hit None)
        (return None))
    (return (. (sub hit 1) view)))

  (def view [self uri version source :package "" :name "__main__" :search-dirs (,)
             :generation None]
    (return (. (.compiled self uri version source :package package :name name
                          :search-dirs search-dirs :generation generation)
               view)))

  (def view-at-cursor [self uri version source line col
                       :package "" :name "__main__" :search-dirs (,)
                       :generation None]
    (if (is generation None)
        (= generation self._generation))
    (= hit (._hit self self._cursor-views uri (, version (epoch) line col)))
    (if (is-not hit None)
        (return (sub hit 1)))
    (= [result macro-epoch] (_view-at-cursor source line col :package package :name name
                                             :search-dirs search-dirs))
    (if (is-not macro-epoch None)
        (._store self self._cursor-views uri (, version macro-epoch line col) result
                 generation))
    (return result))

  (def forget [self uri]
    "Drop uri's entries (its document closed)."
    (with [self._lock]
      (+= self._generation 1)
      (.pop self._views uri None)
      (.pop self._cursor-views uri None))))

;; ---------------------------------------------------------------------------
;; View root: shadows of the workspace and the backend's config
;; ---------------------------------------------------------------------------

(class ViewRoot []
  "The cache directory a Python backend analyses for one project (path,
   also its os.fspath), and python, the interpreter the backend should
   resolve imports with: this process's own.  Every server of the project
   shares it, so its writers take its lock file (_view-root-lock) and never
   act through a link out of it (_check-in-root); a view root that overlaps
   the project is refused (_refuse-overlap)."
  (def __init__ [self path project-root python]
    (= self.path path)
    (= self.project-root project-root)
    (= self.python python))

  (def __fspath__ [self]
    (return self.path))

  (def __repr__ [self]
    (return f"ViewRoot({self.path!r})")))

(def view-root-for [project-root :cache-home None]
  "The ViewRoot of project-root under $XDG_CACHE_HOME (default ~/.cache),
   keyed by a hash of the project's real path so two projects never share
   one and a symlinked checkout finds its own."
  (if (is cache-home None)
      (= cache-home (or (.get os.environ "XDG_CACHE_HOME")
                        (osp.join (osp.expanduser "~") ".cache"))))
  (= digest (sub (.hexdigest (hashlib.sha256 (.encode (osp.realpath project-root) "utf-8")))
                 [: None 16]))
  (return (ViewRoot (osp.join cache-home "lispython" "lsp-view" digest)
                    (osp.abspath project-root)
                    sys.executable)))

;; The view root's own files, beside the shadows: its lock file and every
;; backend's config file.  None is a .py, link or temporary file, so the
;; orphan sweep leaves them, and a package overlay never links over one (a
;; project inside a package may hold a file of that name).
(= _LOCK-NAME ".lock")
(= PYRIGHT-CONFIG "pyrightconfig.json")
(= PYREFLY-CONFIG "pyrefly.toml")
(= _ROOT-FILES (frozenset [_LOCK-NAME PYRIGHT-CONFIG PYREFLY-CONFIG]))

(def _lock-fd [fd]
  "Take an exclusive lock on the open file fd, waiting for it."
  (if (is-not fcntl None)
      (return (fcntl.flock fd fcntl.LOCK_EX)))
  ;; msvcrt.locking gives up after ten one-second tries (EDEADLOCK, or
  ;; EACCES); a sweep may be longer, so contention is retried, nothing else.
  (while True
    (try
      (msvcrt.locking fd msvcrt.LK_LOCK 1)
      (return)
      (except [OSError as e]
        (if (not (in e.errno (, errno.EDEADLOCK errno.EACCES)))
            (raise))))))

(def _unlock-fd [fd]
  (if (is-not fcntl None)
      (fcntl.flock fd fcntl.LOCK_UN)
      (msvcrt.locking fd msvcrt.LK_UNLCK 1)))

(deco contextlib.contextmanager
  (def _view-root-lock [root]
    "Hold root's lock file exclusively (making root first).  Servers of one
     project share its view root, and one server's link over a view
     directory would otherwise land another's writes and removals in the
     project.  The lock belongs to an open file, so each public writer takes
     it once and never inside another."
    (os.makedirs root :exist-ok True)
    (= fd (os.open (osp.join root _LOCK-NAME)
                   (| os.O_RDWR os.O_CREAT (getattr os "O_NOFOLLOW" 0))
                   0o600))
    (try
      (_lock-fd fd)
      (try
        (yield)
        (finally
          (_unlock-fd fd)))
      (finally
        (os.close fd)))))

(def _check-in-root [root directory]
  "Raise OSError unless directory is root or a path below it that reaches no
   link: an act in it could otherwise land in the project a link names."
  (= rel (osp.relpath directory root))
  (if (or (== rel os.pardir) (.startswith rel (+ os.pardir os.sep))
          (!= (osp.realpath directory)
              (osp.normpath (osp.join (osp.realpath root) rel))))
      (raise (OSError f"{directory} leaves the view root {root}"))))

(def _refuse-overlap [project-root view-root]
  "Raise ValueError when view-root is project-root or either holds the
   other: the shadow sweep deletes every .py and link under the view root.
   Paths on two drives never overlap (commonpath refuses them)."
  (= project (osp.realpath project-root))
  (= root (osp.realpath (os.fspath view-root)))
  (if (!= (osp.normcase (sub (osp.splitdrive project) 0))
          (osp.normcase (sub (osp.splitdrive root) 0)))
      (return None))
  (if (in (osp.commonpath [project root]) (, project root))
      (raise (ValueError
               f"view root {root} overlaps the project {project}: it must be a cache outside it"))))

(def _write-if-changed [root path content]
  "Write content to path, in view root root, unless it already holds it;
   True when written.  Through a temporary file of a unique name beside it
   and os.replace, so a backend reading the file never sees half of it; the
   temporary file is removed when the write fails, and the OSError
   propagates, as it does when path's directory leaves root
   (_check-in-root).  A symlink at path (a mirrored .py a shadow now
   replaces) is never read, whatever the file it names holds, and
   os.replace puts the file in its place without writing through it: the
   .py it names is left alone."
  (if (not (osp.islink path))
      (try
        (with [(open path "r" :encoding "utf-8") as f]
          (if (== (.read f) content)
              (return False)))
        (except [(, OSError ValueError)]
          (pass))))
  (= directory (osp.dirname path))
  (_check-in-root root directory)
  (os.makedirs directory :exist-ok True)
  (_check-in-root root directory)
  (= [fd tmp] (tempfile.mkstemp :dir directory :suffix _TEMP-SUFFIX))
  (try
    (with [(os.fdopen fd "w" :encoding "utf-8") as f]
      (.write f content))
    (_check-in-root root directory)
    (os.replace tmp path)
    (except [BaseException]
      (_remove-quietly tmp)
      (raise)))
  (return True))

(def _link-if-changed [root path target]
  "Make path, in view root root, a symlink to target unless it already is
   one; True when made.  Created under a unique temporary name and moved
   over path with os.replace, as _write-if-changed writes, and refused
   (OSError) when path's directory leaves root.  A view directory at path
   (one that held .lpy shadows and no longer does) is removed first; rmtree
   unlinks the links in it, never what they name."
  (if (and (osp.islink path) (== (os.readlink path) target))
      (return False))
  (= directory (osp.dirname path))
  (_check-in-root root directory)
  (if (and (osp.isdir path) (not (osp.islink path)))
      (shutil.rmtree path))
  (os.makedirs directory :exist-ok True)
  (= tmp (osp.join directory
                   f".{(osp.basename path)}.{(.hex (os.urandom 8))}{_TEMP-SUFFIX}"))
  (_check-in-root root directory)
  (os.symlink target tmp)
  (try
    (_check-in-root root directory)
    (os.replace tmp path)
    (except [BaseException]
      (_remove-quietly tmp)
      (raise)))
  (return True))

(def _remove-quietly [path]
  (try
    (os.remove path)
    (except [OSError]
      (pass))))

(def _regular-file-p [path]
  (return (and (not (osp.islink path)) (osp.isfile path))))

(def _shadow-file-p [root path]
  "Whether path is a regular file under root that no link leads to: every
   directory of it below root is real, since a link there is a project
   directory and the file in it the project's own."
  (= current root)
  (= rel (osp.relpath (osp.dirname path) root))
  (if (!= rel os.curdir)
      (for part in (.split rel os.sep)
        (= current (osp.join current part))
        (if (osp.islink current)
            (return False))))
  (return (_regular-file-p path)))

(def _real-view-dir [root directory]
  "Make directory, under root, a real directory: a symlink or file standing
   for one of its components below root (a package overlay linked a
   directory that now holds .lpy) is removed first, since a shadow written
   under it would land in the project itself.  _write-shadows calls it only
   right before writing a shadow, so a directory link stays while nothing is
   written under it; _overlay-package for the directories it overlays.
   OSError when directory leaves root (_check-in-root)."
  (= current root)
  (= rel (osp.relpath directory root))
  (if (!= rel os.curdir)
      (for part in (.split rel os.sep)
        (= parent current)
        (= current (osp.join current part))
        (if (or (osp.islink current)
                (and (osp.lexists current) (not (osp.isdir current))))
            (do (_check-in-root root parent)
                (os.remove current)))))
  (_check-in-root root directory)
  (os.makedirs directory :exist-ok True))

;; Every temporary file of the view root ends so.  The orphan sweep leaves
;; one younger than _TEMP-MAX-AGE seconds, since it may be another server's
;; write in flight; an older one was left by a write that died.
(= _TEMP-SUFFIX ".tmp")
(= _TEMP-MAX-AGE 3600)

(def view-path [project-root view-root lpy-path]
  "The shadow .py of lpy-path in view-root, mirroring its place under
   project-root, or None for a file outside the project."
  (= rel (osp.relpath (osp.abspath lpy-path) (osp.abspath project-root)))
  (if (or (== rel os.pardir) (.startswith rel (+ os.pardir os.sep)))
      (return None))
  (return (osp.join (os.fspath view-root) (+ (sub (osp.splitext rel) 0) ".py"))))

(def _view-dir [project-root view-root directory]
  "directory's counterpart in view-root, or None outside project-root."
  (= rel (osp.relpath directory project-root))
  (if (or (== rel os.pardir) (.startswith rel (+ os.pardir os.sep)))
      (return None))
  (return (osp.normpath (osp.join (os.fspath view-root) rel))))

(def project-import-roots [project-root]
  "The search roots a project's modules are imported from: the project
   root and its src directory (the src layout).  The one home of that
   list: module-names' namespace packages and resolve-module-to-file's
   absolute lookup read it."
  (return [project-root (osp.join project-root "src")]))

(def module-names [lpy-path :project-root None]
  "(__name__, __package__, import root, search dirs) of lpy-path as Python
   imports it (package-root, the rule the lpy CLI uses): the packages are
   the directories up from its own that hold __init__.py or __init__.lpy,
   and the import root is where that walk stops, so src/pkg/m.lpy is pkg.m
   from src.  Under project-root (the document's workspace folder),
   namespace packages count too, up to the nearest of project-import-roots,
   so ns/a.lpy with no ns/__init__ is ns.a from the project root.  The
   search dirs, a tuple, are the one home of the directories the module's
   compile searches (on sys.path while its macros run, compile-buffer; the
   local definition fallback), in this order, each once: the file's own
   directory, which `lpy` and the nREPL's load-file put on sys.path when
   they run the file as a script; then the script root, the root its
   regular packages give with no search roots (the l2py rule,
   package-root): scripts/ for scripts/x.lpy, tools/ for tools/mypkg/a.lpy,
   so (require mypkg.mac) resolves; then the import root.  The backend
   searches backend-search-dirs of them."
  (= directory (osp.dirname (osp.abspath lpy-path)))
  (= roots (ife (is project-root None) [] (project-import-roots project-root)))
  (= [import-root parts] (package-root directory roots))
  (= script-root (sub (package-root directory) 0))
  (= search-dirs (tuple (dict.fromkeys [directory script-root import-root])))
  (= stem (sub (osp.splitext (osp.basename lpy-path)) 0))
  (= package (.join "." parts))
  (if (== stem "__init__")
      (return (, package package import-root search-dirs)))
  (return (, (.join "." (+ parts [stem])) package import-root search-dirs)))

(def backend-search-dirs [names]
  "The search dirs of module-names' result names that the backend searches
   for the module (ShadowManifest.import-roots): the import root, and each
   other search dir that is no regular package and lies inside none below
   the import root (_in-regular-package-p)."
  ;; The backend config (extraPaths, search-path) is project-wide, while
  ;; `lpy` puts the own directory on sys.path only for the file it runs.  A
  ;; directory inside a package (src/pkg, or src/pkg/res with no __init__ of
  ;; its own) as a top-level root would shadow the stdlib and top-level
  ;; names for every file (src/pkg/json.py answering `import json`) and make
  ;; one module importable under two names (helper and pkg.helper).  A
  ;; script directory in no package is a top-level root anyway.  Derived
  ;; from names alone, so module-names stays the one home of the script
  ;; root and import root.
  (= import-root (sub names 2))
  (= kept [])
  (for directory in (sub names 3)
    (if (or (== directory import-root)
            (not (_in-regular-package-p directory import-root)))
        (.append kept directory)))
  (return (tuple kept)))

(def _in-regular-package-p [directory import-root]
  "Whether directory or a directory above it, up to but not including
   import-root, is a regular package (has-init-file, the importer's
   predicate)."
  (= current directory)
  (while (!= current import-root)
    (if (has-init-file current)
        (return True))
    (= parent (osp.dirname current))
    (if (== parent current)
        (return False))
    (= current parent))
  (return False))

;; Directory names a source sweep never enters: dependencies and caches, not
;; the project's own modules.  Dot-directories and virtualenvs (a directory
;; holding pyvenv.cfg) are skipped too (_pruned-p).
(= _PRUNED-DIRS (frozenset ["__pycache__" "node_modules" "site-packages"]))

(def _pruned-p [parent name]
  (return (or (.startswith name ".")
              (in name _PRUNED-DIRS)
              (osp.exists (osp.join parent name "pyvenv.cfg")))))

(def project-sources [project-root]
  "The .lpy files under project-root, sorted.  The walk follows no
   directory symlink (a link back up would loop) and skips _pruned-p
   directories.  Each path is its own module, so two paths to one file
   (a file symlink beside it) are both listed."
  (= found [])
  (for [dirpath dirnames filenames] in (os.walk project-root :followlinks False)
    (= kept (sorted (filter (fn [d] (not (_pruned-p dirpath d))) dirnames)))
    (.clear dirnames)
    (.extend dirnames kept)
    (for filename in filenames
      (if (.endswith filename ".lpy")
          (.append found (osp.join dirpath filename)))))
  (return (sorted found)))

(class ShadowManifest []
  "What write-shadows last saw of each source: path -> ((mtime_ns, size),
   module-names, whether its shadow is written, the macro environment it
   compiled in (macro_modules.epoch)), so a file unchanged since, under the
   same macro environment, is not compiled again; and import-roots, the
   sorted backend-search-dirs of the written shadows' sources
   (_search-paths)."
  (def __init__ [self]
    (= self.sources {})
    (= self.import-roots [])))

(def _regular-package-p [directory]
  "Whether directory is a regular package (it holds an __init__.py or
   __init__.pyi file)."
  (return (any ((osp.isfile (osp.join directory name))
                for name in (, "__init__.py" "__init__.pyi")))))

(def _mirror-py-files [project-root root directory shadows links]
  "Link the modules of directory, an import root with a shadow, into the
   view beside its shadows: each real .py and .pyi file as a file link, each
   regular package (_regular-package-p) as one directory link, so the
   backend analyses them as view modules, under the view's config, and they
   see the shadows.  Left out: a view directory this sweep needs real, one
   holding a shadow or a link of it (a package overlaid around a shadow,
   _overlay-package, which runs first; a stale view directory of a package
   that lost its last .lpy is replaced by the link), a .py that a shadow
   replaces (its .lpy wins on import), _pruned-p directories and the view
   root's own files (_ROOT-FILES).  A namespace package (no __init__) or an
   extension module is not linked, nor is a regular package holding a
   nested import root's shadow (pkg/sub/x.lpy with no pkg/sub/__init__),
   whose view directory is real but holds no __init__: the import root is
   no package, so each still resolves on the real path.  Each link made or
   kept is added to links; a failure is logged and skipped."
  (= view-dir (_view-dir project-root root directory))
  (if (is view-dir None)
      (return))
  (= reserved (frozenset [(osp.join root name) for name in _ROOT-FILES]))
  ;; The entries of view-dir that hold a shadow or link of this sweep.
  (= needed (set))
  (for kept in (+ (list shadows) (list links))
    (= rel (osp.relpath kept view-dir))
    (if (and (in os.sep rel) (not (.startswith rel (+ os.pardir os.sep))))
        (.add needed (osp.join view-dir (sub (.split rel os.sep) 0)))))
  (try
    (= entries (sorted (os.listdir directory)))
    (except [OSError]
      (return)))
  (for name in entries
    (= target (osp.join directory name))
    (= path (osp.join view-dir name))
    (if (or (in path shadows) (in path links) (in path reserved) (in path needed))
        (continue))
    (if (osp.isdir target)
        (if (or (_pruned-p directory name) (not (_regular-package-p target)))
            (continue))
        (if (not (and (.endswith name (, ".py" ".pyi")) (osp.isfile target)))
            (continue)))
    (try
      (_link-if-changed root path target)
      (.add links path)
      (except [OSError as e]
        (.warning logger "lispython view: cannot link %s: %s" path e)))))

(def _source-dirs [project-root sources]
  "Every directory below project-root on the way to one of sources."
  (= dirs (set))
  (for path in sources
    (= directory (osp.dirname path))
    (while (and (!= directory project-root) (not (in directory dirs)))
      (.add dirs directory)
      (= directory (osp.dirname directory))))
  (return dirs))

(def _top-package [project-root import-root directory]
  "The top package directory of a module in directory below import-root,
   or project-root when that package lies above the project (the project
   root is itself inside a package)."
  (= top (osp.join import-root (sub (.split (osp.relpath directory import-root) os.sep) 0)))
  (= rel (osp.relpath top project-root))
  (if (or (== rel os.pardir) (.startswith rel (+ os.pardir os.sep)))
      (return project-root))
  (return top))

(def _overlay-package [project-root root package source-dirs shadows links]
  "Mirror the package directory package into the view whole.  Its view
   directory is a regular package once its __init__.py is there, and so
   hides the real one from the backend: whatever the view lacks of it does
   not resolve.  So every directory on the way to a .lpy source
   (source-dirs) becomes a real view directory, and every other entry is
   linked: a file (.py, .pyi stub, py.typed, extension module, data) as a
   file link, a subdirectory with no .lpy at any depth as one directory
   link, never walked.  Left out: .lpy files, a .py that a shadow replaces
   (its .lpy wins on import), _pruned-p directories, and the view root's
   own files (_ROOT-FILES).  Each link made or kept is added to links; a
   failure is logged and skipped."
  (= reserved (frozenset [(osp.join root name) for name in _ROOT-FILES]))
  (= stack [package])
  (while stack
    (= directory (.pop stack))
    (= view-dir (_view-dir project-root root directory))
    (try
      (_real-view-dir root view-dir)
      (= entries (sorted (os.listdir directory)))
      (except [OSError as e]
        (.warning logger "lispython view: cannot mirror %s: %s" directory e)
        (continue)))
    (for name in entries
      (= target (osp.join directory name))
      (= path (osp.join view-dir name))
      (= dir-p (osp.isdir target))
      (cond
        (in target source-dirs)
        (.append stack target)

        (or (in path shadows) (in path links) (in path reserved)
            (ife dir-p
                 (_pruned-p directory name)
                 (or (.endswith name ".lpy") (not (osp.isfile target)))))
        (pass)

        True
        (try
          (_link-if-changed root path target)
          (.add links path)
          (except [OSError as e]
            (.warning logger "lispython view: cannot link %s: %s" path e)))))))

(def _sweep-orphans [root shadows links]
  "Remove what under root no current source accounts for: every symlink and
   .py file that is neither a shadow nor a link of this sweep, every
   temporary file older than _TEMP-MAX-AGE, then every directory left empty
   (bottom up, never root).  Other files, the view root's own files
   (_ROOT-FILES) among them, are never touched.  A directory link is unlinked, never
   followed, and nothing is removed in a directory that leaves root
   (_check-in-root): that one is logged and skipped.  Returns the links and
   .py files removed."
  (= stale-before (- (time.time) _TEMP-MAX-AGE))
  (= removed [])
  (for [dirpath dirnames filenames] in (os.walk root :topdown False :followlinks False)
    (for name in (+ dirnames filenames)
      (= path (osp.join dirpath name))
      (try
        (cond
          (or (in path shadows) (in path links))
          (pass)

          (.endswith name _TEMP-SUFFIX)
          (if (< (. (os.lstat path) st_mtime) stale-before)
              (do (_check-in-root root dirpath)
                  (os.remove path)))

          (or (osp.islink path) (and (.endswith name ".py") (osp.isfile path)))
          (do (_check-in-root root dirpath)
              (os.remove path)
              (.append removed path)))
        (except [FileNotFoundError]
          (pass))
        (except [OSError as e]
          (.warning logger "lispython view: cannot remove %s: %s" path e))))
    (if (!= dirpath root)
        (try
          (_check-in-root root dirpath)
          (os.rmdir dirpath)
          (except [OSError]
            (pass)))))
  (return removed))

(def write-shadows [project-root view-root :manifest None]
  "Write a compiled shadow .py into view-root for every .lpy under
   project-root (project-sources), mirroring the project's layout, so
   imports between .lpy modules resolve for the backend.  A shadow is
   written only when its text changed; a file that is gone or does not
   compile has none, and one that cannot be read keeps the shadow it has.
   Every package holding a shadow is overlaid whole beside the shadows
   (_overlay-package), and the other modules of every import root with a
   shadow are linked in (_mirror-py-files), so the backend analyses them
   under the view's config; only namespace packages, extension modules
   and a whole package holding a nested import root stay on the real
   paths.  One file that cannot be read or written is logged and left
   out of the manifest, so the next sweep tries it again; the rest go on.
   Then _sweep-orphans clears what no current source accounts for.  Each
   source compiles with its import root on sys.path (a relative require
   imports its package), which is left as it was.  A view root that overlaps the project is a ValueError before
   anything is touched; the whole sweep holds the view root's lock, and
   nothing is written or removed through a link out of it.  Returns its
   ShadowSweep."
  (_refuse-overlap project-root view-root)
  (if (is manifest None)
      (= manifest (ShadowManifest)))
  (= project-root (osp.abspath project-root))
  (= root (osp.abspath (os.fspath view-root)))
  (with [(_view-root-lock root)]
    (return (_write-shadows project-root root manifest))))

(class ShadowSweep []
  "What one write-shadows sweep did: shadows, the sorted shadow paths;
   written, the sorted shadows whose text it wrote; removed, the sorted
   links and .py files it removed (_sweep-orphans), so a backend can be
   told of every file that changed."
  (def __init__ [self shadows written removed]
    (= self.shadows shadows)
    (= self.written written)
    (= self.removed removed)))

(def _write-shadows [project-root root manifest]
  "write-shadows' sweep, under the view root's lock."
  (= sources (project-sources project-root))
  (= current (set sources))
  ;; None: a drop is due, so every entry is stale.
  (= macro-epoch (epoch))
  (for path in (list manifest.sources)
    (if (not (in path current))
        (del (sub manifest.sources path))))
  (= names-of {})
  (= shadows {})
  (= written [])
  (for lpy-path in sources
    (= shadow (view-path project-root root lpy-path))
    (= names (module-names lpy-path :project-root project-root))
    (= (sub names-of lpy-path) names)
    (try
      (= st (os.stat lpy-path))
      (= stamp (, st.st_mtime_ns st.st_size))
      (= known (.get manifest.sources lpy-path))
      (if (and (is-not known None) (== (sub known 0) stamp) (== (sub known 1) names)
               (is-not macro-epoch None) (== (sub known 3) macro-epoch)
               (or (not (sub known 2)) (_shadow-file-p root shadow)))
          (do (if (sub known 2)
                  (= (sub shadows shadow) lpy-path))
              (continue)))
      (.pop manifest.sources lpy-path None)
      (with [(open lpy-path "r" :encoding "utf-8") as f]
        (= source (.read f)))
      ;; A source gone since the walk loses its shadow; one that cannot be
      ;; read now (permissions, a busy network mount) keeps the one it has,
      ;; which was its text when it last could be.
      (except [OSError as e]
        (.warning logger "lispython view: cannot read %s: %s" lpy-path e)
        (if (and (not (isinstance e FileNotFoundError)) (_shadow-file-p root shadow))
            (= (sub shadows shadow) lpy-path))
        (continue))
      (except [ValueError as e]
        (.warning logger "lispython view: no shadow for %s: %s" lpy-path e)
        (continue)))
    (try
      (= compiled (compile-buffer source :name (sub names 0) :package (sub names 1)
                                  :search-dirs (sub names 3)))
      (= view compiled.view)
      (if (is-not view None)
          (do (_real-view-dir root (osp.dirname shadow))
              (if (_write-if-changed root shadow view.text)
                  (.append written shadow))
              (= (sub shadows shadow) lpy-path)))
      (= (sub manifest.sources lpy-path) (, stamp names (is-not view None) compiled.epoch))
      (except [OSError as e]
        (.warning logger "lispython view: no shadow for %s: %s" lpy-path e))))
  (= import-roots (set))
  (= packages (set))
  (= module-dirs (set))
  (for lpy-path in (.values shadows)
    (= import-root (sub (sub names-of lpy-path) 2))
    (.update import-roots (backend-search-dirs (sub names-of lpy-path)))
    ;; module-dirs: every import root with a shadow, whose other modules
    ;; are linked in (_mirror-py-files).
    (.add module-dirs import-root)
    (= directory (osp.dirname (osp.abspath lpy-path)))
    (if (!= directory import-root)
        (.add packages (_top-package project-root import-root directory))))
  (= manifest.import-roots (sorted import-roots))
  (= source-dirs (_source-dirs project-root sources))
  (= links (set))
  (for package in (sorted packages)
    (_overlay-package project-root root package source-dirs shadows links))
  (for directory in (sorted module-dirs)
    (_mirror-py-files project-root root directory shadows links))
  (= removed (_sweep-orphans root shadows links))
  (return (ShadowSweep (sorted shadows) (sorted written) (sorted removed))))

;; The project's rule settings the view root's config takes over: these,
;; typeCheckingMode and every report* rule.  Never a path setting (include,
;; exclude, extraPaths, venv, stubPath, executionEnvironments, ...): the
;; view root owns every path, and the project's would name directories the
;; backend reads instead of the shadows.
(= _RULE-KEYS (frozenset ["typeCheckingMode" "strictListInference" "strictDictionaryInference"
                          "strictSetInference" "strictParameterNoneValue"
                          "analyzeUnannotatedFunctions" "deprecateTypingAliases"
                          "enableTypeIgnoreComments" "enableExperimentalFeatures"
                          "enableReachabilityAnalysis" "disableBytesTypePromotions"
                          "pythonVersion" "pythonPlatform"]))

;; basedpyright's own default, "recommended", reports every missing
;; annotation, which most lispython code has none of; "off" leaves hints only.
(= DEFAULT-TYPE-CHECKING-MODE "standard")

(def _jsonc-to-json [text]
  "JSONC text (pyright's config format: // and /* */ comments, trailing
   commas) as JSON: comments outside strings become a space, and a comma
   followed by nothing but whitespace and comments before a } or ] goes.
   A string's escapes are skipped, so a quote or // inside one is text."
  (= out [])
  (= n (len text))
  (= i 0)
  ;; index in out of a comma that may turn out to trail
  (= comma None)
  (while (< i n)
    (= ch (sub text i))
    (cond
      (== ch "\"")
      (do (= j (+ i 1))
          (while (and (< j n) (!= (sub text j) "\""))
            (+= j (ife (== (sub text j) "\\") 2 1)))
          (.append out (sub text [: i (+ j 1)]))
          (= comma None)
          (= i (+ j 1)))

      (.startswith text "//" i)
      (do (= j (.find text "\n" i))
          (= i (ife (== j -1) n j)))

      (.startswith text "/*" i)
      (do (= j (.find text "*/" (+ i 2)))
          (.append out " ")
          (= i (ife (== j -1) n (+ j 2))))

      True
      (do (cond (== ch ",")
                (= comma (len out))
                (and (in ch "}]") (is-not comma None))
                (do (= (sub out comma) "")
                    (= comma None))
                (not (.isspace ch))
                (= comma None))
          (.append out ch)
          (+= i 1))))
  (return (.join "" out)))

(def _project-type-config [project-root]
  "The project's own basedpyright/pyright settings, as a dict: its
   pyrightconfig.json, else [tool.basedpyright], else [tool.pyright] of its
   pyproject.toml; {} when it has none or the file that holds them is
   malformed."
  (= path (osp.join project-root PYRIGHT-CONFIG))
  (try
    (if (osp.isfile path)
        (with [(open path "r" :encoding "utf-8") as f]
          (= config (json.loads (_jsonc-to-json (.read f))))
          (return (ife (isinstance config dict) config {}))))
    (= path (osp.join project-root "pyproject.toml"))
    (if (not (osp.isfile path))
        (return {}))
    (with [(open path "rb") as f]
      (= tool (.get (tomllib.load f) "tool" {})))
    (for key in ["basedpyright" "pyright"]
      (= config (.get tool key))
      (if (isinstance config dict)
          (return config)))
    (return {})
    (except [(, OSError ValueError)]
      (.debug logger "lispython view: no type checking settings read from %s" path
              :exc-info True)
      (return {}))))

(def _rule-settings [project-root check-types]
  "The rule settings of the view root's config: the project's rule keys
   (_RULE-KEYS, report*), typeCheckingMode DEFAULT-TYPE-CHECKING-MODE when
   it sets none, and the rules lispython forces.  Without check-types (no
   diagnostic is forwarded) checking is off and the project's report*
   rules are left out, since the backend would check for nobody; its other
   settings (pythonVersion, pythonPlatform, ...) stay, since hover and
   completion follow them."
  (= rules {"typeCheckingMode" DEFAULT-TYPE-CHECKING-MODE})
  (for [key value] in (.items (_project-type-config project-root))
    (if (and (isinstance key str)
             (or (in key _RULE-KEYS) (and check-types (.startswith key "report"))))
        (= (sub rules key) value)))
  (if (not check-types)
      (= (sub rules "typeCheckingMode") "off"))
  ;; lispython's reader owns string escapes: a generated string literal is
  ;; a repr, so an escape the backend flags there is not one the user wrote.
  (= (sub rules "reportInvalidStringEscapeSequence") "none")
  (return rules))

(def _search-paths [project-root root import-roots]
  "The backend's search paths for the view root root of project-root (both
   absolute), in order: the view-root counterpart of every import root
   strictly inside the project (ShadowManifest.import-roots; <view>/src in
   a src layout; one above the project, which lies inside a package, is
   left out), so import pkg finds the shadows before any real directory of
   uncompiled .lpy; then those import roots themselves, so what the view
   lacks of one still resolves: its namespace packages, its extension
   modules and, whole, a package of it that holds a nested import root
   (_mirror-py-files links every other module of it into the view);
   then the project and its .venv site-packages.  The one list of every
   backend's config.  The paths are project-wide, so a module of one
   import root (a script directory's sibling) is visible from every file
   of the project, not only from the modules that search it."
  (= roots [])
  (for import-root in (or import-roots [])
    (= import-root (osp.abspath import-root))
    (if (and (!= import-root project-root) (not (in import-root roots))
             (is-not (_view-dir project-root root import-root) None))
        (.append roots import-root)))
  (= paths (+ [(_view-dir project-root root import-root) for import-root in roots]
              roots
              [project-root]))
  (.extend paths (sorted (glob.glob (osp.join project-root ".venv" "lib" "python*"
                                              "site-packages"))))
  (return paths))

(def write-pyright-config [project-root view-root :import-roots None :check-types True]
  "Write view-root's pyrightconfig.json when it changed: the project's
   rule settings (_rule-settings; check-types false, as when no diagnostic
   is forwarded, turns checking off), the search paths (_search-paths, as
   extraPaths), and the environment of this process's interpreter.  pyright's config has no interpreter path; it takes a
   virtualenv as venvPath (its parent) and venv (its name), so a base
   interpreter is left to the backend's own discovery and to
   ViewRoot.python, sent as python.pythonPath.  A view root that overlaps
   the project is a ValueError; the write holds the view root's lock.
   Returns the path."
  (_refuse-overlap project-root view-root)
  (= project-root (osp.abspath project-root))
  (= root (osp.abspath (os.fspath view-root)))
  ;; Every server of the project shares the view root: two run with
  ;; different pythonDiagnostics, the last to write decides its checking.
  (= config (_rule-settings project-root check-types))
  (= (sub config "extraPaths") (_search-paths project-root root import-roots))
  (if (!= sys.prefix sys.base-prefix)
      (do (= (sub config "venvPath") (osp.dirname sys.prefix))
          (= (sub config "venv") (osp.basename sys.prefix))))
  (= path (osp.join root PYRIGHT-CONFIG))
  (with [(_view-root-lock root)]
    (_write-if-changed root path (+ (json.dumps config :indent 2 :sort-keys True) "\n")))
  (return path))

;; The project's pyrefly settings the view root's pyrefly.toml takes over:
;; these, and errors (its per-code severities) while checking.  Never a path
;; or tooling setting (project-includes/-excludes, search-path,
;; site-packages-path, python-interpreter-path and the other interpreter
;; keys, typeshed-path, baseline*, extends, sub-config, whose matches are
;; path globs, build-system, output-format, min-severity,
;; ignore-errors-in-generated-code, ...): the view root owns every path, the
;; project's would name directories pyrefly reads instead of the shadows,
;; and the LSP owns what is reported.  infer-param-types-from-docstring is
;; documented, but pyrefly 1.4.1 rejects it as an unknown key.
(= _PYREFLY-RULE-KEYS (frozenset ["preset" "python-version" "python-platform"
                                  "replace-imports-with-any" "ignore-missing-imports"
                                  "replace-untyped-imports-with-any" "infer-with-first-use"
                                  "check-unannotated-defs" "infer-return-types"
                                  "strict-callable-subtyping" "treat-all-caps-as-final"
                                  "untyped-def-behavior" "permissive-ignores"
                                  "enabled-ignores" "type-ignore-unknown-tag-behavior"
                                  "spec-compliant-overloads" "legacy-overload-expansion"]))

;; The preset of a project whose pyrefly settings the view cannot use: it
;; has none, they cannot be read, or the installed pyrefly refuses them.
;; pyrefly's own preset for a project with no config hides nearly every type
;; error; default reports about what basedpyright's standard mode does.
;; pyrefly would migrate the project's pyright or mypy config there; that
;; migration is not mirrored.  The LSP tells the user once per project that
;; this preset is in effect, and why (server.lpy, notify-preset-fallback).
(= DEFAULT-PYREFLY-PRESET "default")

;; Why a view runs DEFAULT-PYREFLY-PRESET: reason is "missing" (no pyrefly
;; config), "malformed" (source cannot be read as one) or "refused" (the
;; installed pyrefly refuses source's settings); source is the project file
;; that holds them (pyproject.toml when there is none).
(= PyreflyFallback (collections.namedtuple "PyreflyFallback" ["reason" "source"]))

(def _project-pyrefly-config [project-root]
  "The project's own pyrefly settings, as (path of the file that holds
   them, dict, fallback reason, problem): its pyrefly.toml, else
   [tool.pyrefly] of its pyproject.toml, as pyrefly finds them.  The dict is
   None and the reason \"missing\" when it has none, \"malformed\" when that
   file cannot be read or its table is no table, problem then saying why
   (the caller warns, naming the file: the user's to fix); the reason and
   problem are None with a dict.  Logs nothing, since it runs on every
   backend start and every save."
  (= path (osp.join project-root PYREFLY-CONFIG))
  (try
    (if (osp.isfile path)
        (with [(open path "rb") as f]
          (return (, path (tomllib.load f) None None))))
    (= path (osp.join project-root "pyproject.toml"))
    (if (not (osp.isfile path))
        (return (, path None "missing" None)))
    (with [(open path "rb") as f]
      (= config (.get (.get (tomllib.load f) "tool" {}) "pyrefly")))
    (cond (is config None)
          (return (, path None "missing" None))
          (isinstance config dict)
          (return (, path config None None)))
    (= problem "[tool.pyrefly] is not a table")
    (except [(, OSError ValueError AttributeError) as e]
      (= problem e)))
  (return (, path None "malformed" problem)))

;; View root -> its PyreflyFallback, or None when its pyrefly.toml holds the
;; project's settings or checks nothing: decided by write-pyrefly-config,
;; under the view root's lock, and only there.
(= _PYREFLY-FALLBACKS {})

(def pyrefly-fallback [view-root]
  "Why view-root's last written pyrefly.toml runs DEFAULT-PYREFLY-PRESET
   (a PyreflyFallback), or None: the project's settings are in it, its
   checking is off, or none was written by this process.  A dict read,
   never a file read or a pyrefly run, so the event loop may call it."
  (return (.get _PYREFLY-FALLBACKS (osp.abspath (os.fspath view-root)))))

(def _pyrefly-rule-settings [project check-types]
  "The rule settings of the view root's pyrefly.toml: the project's rule
   keys (_PYREFLY-RULE-KEYS) and, with check-types, its errors table; preset
   DEFAULT-PYREFLY-PRESET when the project has no pyrefly config, none
   (pyrefly's own default preset) when it has one that sets none.  Without
   check-types (no diagnostic is forwarded) the preset is off and the
   project's errors are left out, since they would turn codes back on for
   nobody; its other settings (python-version, ...) stay, since hover and
   completion follow them.  pyrefly flags no invalid string escape, so
   nothing is forced here as the pyright config forces one.  project is
   the project's settings dict, or None."
  (= rules (ife (is project None) {"preset" DEFAULT-PYREFLY-PRESET} {}))
  (for [key value] in (.items (or project {}))
    (if (or (in key _PYREFLY-RULE-KEYS) (and check-types (== key "errors")))
        (= (sub rules key) value)))
  (if (not check-types)
      (= (sub rules "preset") "off"))
  (return rules))

(def _toml-string [value]
  "value as a TOML basic string, or None when TOML cannot hold it (a lone
   surrogate).  json.dumps' escapes are TOML's, except that it leaves DEL,
   which TOML must escape; ensure_ascii is off because it escapes a
   character above U+FFFF as a surrogate pair, which TOML refuses."
  (try
    (.encode value "utf-8")
    (except [UnicodeEncodeError]
      (return None)))
  (return (.replace (json.dumps value :ensure-ascii False) "\x7f" "\\u007f")))

(def _toml-value [value]
  "value as TOML when it is a str, bool, int or list of str TOML can hold,
   else None: a value of any other shape is dropped, never written as
   something it is not."
  (cond (isinstance value bool)
        (return (ife value "true" "false"))
        (isinstance value int)
        (return (str value))
        (isinstance value str)
        (return (_toml-string value))
        (isinstance value list)
        (do (= items [(ife (isinstance item str) (_toml-string item) None)
                      for item in value])
            (if (in None items)
                (return None))
            (return (+ "[" (.join ", " items) "]"))))
  (return None))

(def _pyrefly-toml [config]
  "config as TOML text, keys sorted: every value _toml-value can write, and
   the errors table (code -> severity str or bool) last, as its own table;
   an entry of any other shape is left out."
  (= lines [])
  (for key in (sorted config)
    (= text (ife (== key "errors") None (_toml-value (sub config key))))
    (if (is-not text None)
        (.append lines f"{key} = {text}")))
  (= errors (.get config "errors"))
  (if (isinstance errors dict)
      (do (.append lines "[errors]")
          (for code in (sorted (code for code in errors if (isinstance code str)))
            (= severity (sub errors code))
            (= key (_toml-string code))
            (= text (ife (isinstance severity (, str bool)) (_toml-value severity) None))
            (if (and (is-not key None) (is-not text None))
                (.append lines f"{key} = {text}")))))
  (return (+ (.join "\n" lines) "\n")))

(def read-quietly [path]
  "The text of the regular file path, or None (absent, a link, unreadable)."
  (if (osp.islink path)
      (return None))
  (try
    (with [(open path "r" :encoding "utf-8") as f]
      (return (.read f)))
    (except [(, OSError ValueError)]
      (return None))))

;; View root -> the last pyrefly.toml text its check refused (one per root),
;; read and written under the view root's lock; dropped once the project has
;; no usable pyrefly config or a text is accepted.
(= _REFUSED-PYREFLY {})

;; View root -> the (source, problem) of the malformed project pyrefly config
;; last warned about (one per root), read and written under the view root's
;; lock; dropped once the project's config is not malformed, so a config
;; fixed and broken again is told again.
(= _MALFORMED-PYREFLY {})

(def write-pyrefly-config [project-root view-root :import-roots None :check-types True
                          :python None :check None]
  "Write view-root's pyrefly.toml when it changed: the project's rule
   settings (_pyrefly-rule-settings; check-types false turns checking off),
   the search paths, and python as python-interpreter-path (default
   view-root's ViewRoot.python, else this process's interpreter), since
   pyrefly otherwise queries the python3 on PATH for its site-packages.  A
   pyrefly.toml wins over a pyrightconfig.json in the same directory.
   check, when given, is called with new TOML text and answers why pyrefly
   refuses it, or None: a value the installed pyrefly rejects (an error
   code or variant of another release) makes it drop the whole file and fall
   back to auto configuration, losing the search paths, the interpreter and
   preset off with it, so a refused text is replaced by one without any of
   the project's settings, with a warning naming the project's config.  A
   project config that cannot be read is warned about once per view root
   until its problem changes (_MALFORMED-PYREFLY).  Why the written file
   runs DEFAULT-PYREFLY-PRESET, if it does, is recorded for
   pyrefly-fallback.  A view root that overlaps the project is a
   ValueError; the write holds the view root's lock.  Returns the path."
  (_refuse-overlap project-root view-root)
  (= project-root (osp.abspath project-root))
  (= root (osp.abspath (os.fspath view-root)))
  (= [source project reason unreadable] (_project-pyrefly-config project-root))
  (= paths {;; pyrefly looks in search-path before the directory of its
            ;; config (the view root), where pyright looks in its execution
            ;; root first: the root leads, so a module the view links (most
            ;; modules of an import root with a shadow, _mirror-py-files)
            ;; resolves to the link and is analysed under this config, never
            ;; as the real file under the project's own.
            "search-path" (+ [root] (_search-paths project-root root import-roots))
            "python-interpreter-path"
            (ife (is python None) (getattr view-root "python" sys.executable) python)})
  (= path (osp.join root PYREFLY-CONFIG))
  ;; Every server of the project shares the view root: two run with
  ;; different pythonDiagnostics, the last to write decides its checking.
  (with [(_view-root-lock root)]
    (= text (_pyrefly-toml (| (_pyrefly-rule-settings project check-types) paths)))
    ;; No usable project config: a refusal remembered from before no longer
    ;; holds, so the same config restored later is checked and told again.
    (if (is project None)
        (.pop _REFUSED-PYREFLY root None))
    ;; A malformed config is told once until its problem changes, whatever
    ;; check-types is: the view still drops its python-version and the rest.
    (if (== reason "malformed")
        (do (= told (, source (str unreadable)))
            (if (!= told (.get _MALFORMED-PYREFLY root))
                (do (.warning logger "lispython LSP: cannot read the pyrefly settings of %s, so the view uses none of them: %s"
                              source unreadable)
                    (= (sub _MALFORMED-PYREFLY root) told))))
        (.pop _MALFORMED-PYREFLY root None))
    (cond
      (or (is check None) (is project None) (== text (read-quietly path)))
      (pass)

      ;; Refused before: the file holds the fallback, so the text differs
      ;; from it on every save; checked and warned about once.
      (== text (.get _REFUSED-PYREFLY root))
      (do (= reason "refused")
          (= text (_pyrefly-toml (| (_pyrefly-rule-settings None check-types) paths))))

      True
      (do (= problem (check text))
          (if (is None problem)
              (.pop _REFUSED-PYREFLY root None)
              (do (.warning logger "lispython LSP: pyrefly refuses the settings of %s, so the view uses none of them: %s"
                            source problem)
                  (= (sub _REFUSED-PYREFLY root) text)
                  (= reason "refused")
                  (= text (_pyrefly-toml (| (_pyrefly-rule-settings None check-types)
                                            paths)))))))
    (_write-if-changed root path text)
    (= (sub _PYREFLY-FALLBACKS root)
       (ife (and check-types (is-not reason None)) (PyreflyFallback reason source) None)))
  (return path))
