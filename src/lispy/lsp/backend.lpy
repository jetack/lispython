;; The Python backend client: one Python language server (pyrefly, or
;; basedpyright) per project, run as a subprocess LSP over the project's
;; view root (python_view.lpy), so lispython's LSP can ask it about the compiled
;; buffer (design: the vault page "LSP Python Delegation").
;;
;; Nothing here may raise into a feature handler: a backend that is off,
;; failed to start, died or timed out answers None, and the caller keeps its
;; own answer.  A plain install (neither backend) resolves to "off" and
;; never spawns anything.

(require lispy.macros *)

(import asyncio)
(import attrs)
(import functools)
(import importlib.util)
(import logging)
(import os)
(import os.path as osp)
(import pathlib)
(import re)
(import shutil)
(import subprocess)
(import sysconfig)
(import tempfile)
(import uuid)

(from lsprotocol [types as lsp])
(from pygls.lsp.client [LanguageClient])
(from pygls.protocol [default-converter])
(from pygls.uris [to-fs-path])

(from lispy.lsp.python-view [PYREFLY-CONFIG PYRIGHT-CONFIG ShadowManifest read-quietly
                             view-path view-root-for write-pyrefly-config
                             write-pyright-config write-shadows])

(= logger (logging.getLogger __name__))

;; Seconds.  A request waits REQUEST-TIMEOUT in all, for the backend's start
;; and its answer (a first basedpyright completion takes about 0.9 s); the
;; start's initialize handshake gives up after START-TIMEOUT.  Shutdown gives
;; a backend SHUTDOWN-TIMEOUT to answer shutdown and exit, then kills it and
;; reaps it: _reap waits up to KILL-TIMEOUT each for the process, its stderr
;; drain and pygls' client tasks, so about 3.5 s at worst.  A start that
;; shutdown cancels reaps its own client instead (no protocol wait, about
;; 1.5 s).
(= REQUEST-TIMEOUT 10)
(= START-TIMEOUT 30)
(= SHUTDOWN-TIMEOUT 2)
(= KILL-TIMEOUT 0.5)

;; A backend process is started at most this often per BackendClient: the
;; first spawn and one restart after a crash.  A backend that dies twice is
;; broken for this project (a bad install, a view it cannot take), and
;; respawning it on every request would cost a process start per keystroke.
(= MAX-SPAWNS 2)

;; ---------------------------------------------------------------------------
;; Backends and the setting
;; ---------------------------------------------------------------------------

(def _scripts-binary [name]
  "name's executable in this interpreter's scripts directory, else on PATH,
   or None."
  (= exe (or (sysconfig.get-config-var "EXE") ""))
  (= scripts (sysconfig.get-path "scripts"))
  (if scripts
      (do (= candidate (osp.join scripts (+ name exe)))
          (if (osp.isfile candidate)
              (return candidate))))
  (return (shutil.which name)))

(def _package-dir [name]
  "The directory of installed package name, or None; the package is not
   imported."
  (try
    (= spec (importlib.util.find-spec name))
    (except [(, ImportError ValueError)]
      (return None)))
  (if (or (is spec None) (not spec.submodule-search-locations))
      (return None))
  (return (sub (list spec.submodule-search-locations) 0)))

(def _basedpyright-argv []
  "node running basedpyright's langserver.index.js over stdio, or None.
   node is nodejs_wheel's own binary, found as nodejs_wheel/executable.py's
   _program finds it.  The basedpyright-langserver wrapper is never run: it
   starts node with subprocess.run, so killing the wrapper orphans the node
   server, which then outlives the LSP."
  (= package (_package-dir "basedpyright"))
  (= node-root (_package-dir "nodejs_wheel"))
  (if (or (is package None) (is node-root None))
      (return None))
  (= node (ife (== os.name "nt")
               (osp.join node-root "node.exe")
               (osp.join node-root "bin" "node")))
  (= script (osp.join package "langserver.index.js"))
  (if (not (and (osp.isfile node) (osp.isfile script)))
      (return None))
  (return [node script "--stdio"]))

(def _pyrefly-argv []
  "The pyrefly binary's language server, or None."
  (= binary (_scripts-binary "pyrefly"))
  (if (is binary None)
      (return None))
  (return [binary "lsp"]))

;; Backend name -> a function giving its argv, or None when it is not
;; installed.  "off" is the name of no backend.  A test adds a fake backend
;; here (any LSP over stdio).  With no backend setting, the first installed
;; of DEFAULT-BACKENDS runs (resolve-backend): pyrefly answers the LSP's
;; features as often as basedpyright, starts faster and takes a third of
;; its memory.
(= OFF "off")
(= DEFAULT-BACKENDS (, "pyrefly" "basedpyright"))
(= BACKENDS {"basedpyright" _basedpyright-argv
             "pyrefly" _pyrefly-argv})

;; Seconds pyrefly dump-config gets to read a candidate pyrefly.toml (it
;; takes about 0.1 s, its interpreter query included).
(= CONFIG-CHECK-TIMEOUT 20)

;; A line of the text excerpt in pyrefly's TOML parse error: an optional
;; line number, then a | gutter ("  |", "1 | key = 1", "  | ^").
(= _EXCERPT-LINE (re.compile "^\\s*\\d*\\s*\\|"))

(def pyrefly-config-problem [binary text]
  "Why the pyrefly at binary refuses pyrefly.toml text, or None when it
   reads it or cannot say (not runnable, timed out).  dump-config reads the
   text from a file of its own in a temporary directory: pyrefly reports a
   value it cannot read as a config that failed to parse, then falls back
   to auto configuration, and exits 1 whether or not it did (it also does
   when no file matches).  The answer is pyrefly's description of what it
   refused (unknown variant `x`), the list of values it expected cut off;
   never its ERROR line's position, which is in the generated text, not
   the project's file the caller names."
  (try
    (with [(tempfile.TemporaryDirectory :prefix "lispython-pyrefly-") as directory]
      (= path (osp.join directory "pyrefly.toml"))
      (with [(open path "w" :encoding "utf-8") as f]
        (.write f text))
      (= result (subprocess.run [binary "dump-config" "--color" "never" "-c" path]
                                :cwd directory :stdin subprocess.DEVNULL
                                :capture-output True :text True :errors "replace"
                                :timeout CONFIG-CHECK-TIMEOUT)))
    (except [(, OSError subprocess.SubprocessError)]
      (.debug logger "python backend: cannot check a pyrefly config" :exc-info True)
      (return None)))
  (= output (+ result.stdout result.stderr))
  (if (not (in "failed to parse" output))
      (return None))
  ;; Left out: the WARN and ERROR lines (the file and the position) and the
  ;; excerpt of the text, by its shape (_EXCERPT-LINE): the description
  ;; itself may hold a | (unknown variant `a|b`).
  (= lines [(sub (.strip line) [: None 200]) for line in (.splitlines output)
            if (and (.strip line) (not (.match _EXCERPT-LINE line))
                    (not (.startswith (.strip line) (, "WARN" "ERROR" "Fatal configuration error"))))])
  (return (or (.join " " [(sub (.split line ", expected one of" 1) 0) for line in lines])
              "pyrefly cannot read it")))

(def _write-pyrefly-config [project-root view-root **settings]
  "write-pyrefly-config, checked by the installed pyrefly
   (pyrefly-config-problem) when there is one."
  (= argv (backend-argv "pyrefly"))
  (= check (ife (is argv None) None (functools.partial pyrefly-config-problem (sub argv 0))))
  (return (write-pyrefly-config project-root view-root :check check **settings)))

;; Backend name -> the tool name its suppression comments carry, as the tool
;; honours them (; pyright: ignore, ; pyrefly: ignore); any other name (a
;; test's fake) takes pyright's.
(= SUPPRESSION-TOOLS {"basedpyright" "pyright"
                      "pyrefly" "pyrefly"})

(def suppression-tool [name]
  "The tool name of backend name's suppression comments
   (python_view.suppression-comments)."
  (return (.get SUPPRESSION-TOOLS name "pyright")))

;; Backend name -> the writer of its config file in the view root; any other
;; name (a test's fake) takes pyrightconfig.json.
(= CONFIG-WRITERS {"basedpyright" write-pyright-config
                   "pyrefly" _write-pyrefly-config})

(def config-writer [name]
  "The function writing backend name's config file into a view root."
  (return (.get CONFIG-WRITERS name write-pyright-config)))

;; Backend name -> the name of the config file its writer writes in the view
;; root; any other name (a test's fake) takes pyrightconfig.json, as in
;; CONFIG-WRITERS.
(= CONFIG-FILES {"basedpyright" PYRIGHT-CONFIG
                 "pyrefly" PYREFLY-CONFIG})

(def config-file [name]
  "The name of backend name's config file in a view root."
  (return (.get CONFIG-FILES name PYRIGHT-CONFIG)))

;; Backends whose definition answer for a name with no declarations walks up
;; the parse tree to the enclosing call or operator and answers for it
;; (basedpyright's DefinitionProviderBase.getDefinitionsForNode), so an
;; undefined name in (print nosuch) gets print's definition.  The server
;; checks such an answer (BackendClient.definition-walks-up).
(= DEFINITION-WALKS-UP (frozenset ["basedpyright"]))

(def backend-argv [name]
  "The argv that starts backend name, or None for off, an unknown name or a
   backend that is not installed."
  (= find (.get BACKENDS name))
  (if (is find None)
      (return None))
  (return (find)))

(def resolve-python-diagnostics [init-options]
  "Whether the backend's diagnostics are forwarded, from the LSP client's
   initializationOptions key \"pythonDiagnostics\": only false turns them
   off; missing or None leaves them on (they need a backend all the same)."
  (return (not (and (isinstance init-options dict)
                    (is (.get init-options "pythonDiagnostics") False)))))

(def resolve-backend [init-options]
  "The backend name from the LSP client's initializationOptions (a dict or
   None), key \"backend\".  Missing or None: the first installed of
   DEFAULT-BACKENDS, else off.  A name that is unknown or not installed:
   off, with a warning, never another backend in its place."
  (= name (ife (isinstance init-options dict) (.get init-options "backend") None))
  (if (is name None)
      (do (for default in DEFAULT-BACKENDS
            (if (is-not (backend-argv default) None)
                (return default)))
          (return OFF)))
  (if (== name OFF)
      (return OFF))
  (if (not (in name BACKENDS))
      (do (.warning logger "lispython LSP: unknown Python backend %r; backend off" name)
          (return OFF)))
  (if (is (backend-argv name) None)
      (do (.warning logger "lispython LSP: Python backend %r is not installed; backend off"
                    name)
          (return OFF)))
  (return name))

;; ---------------------------------------------------------------------------
;; One backend process
;; ---------------------------------------------------------------------------

(def _converter []
  "pygls' converter, able to read a notebook filter with no notebook.
   lsprotocol (2025.0.0) hooks the notebook union of
   NotebookCellTextDocumentFilter and NotebookDocumentFilterWithNotebook,
   but not the Optional one of NotebookDocumentFilterWithCells.notebook, so
   the initialize result of a backend whose notebookDocumentSync selects
   cells alone (pyrefly) fails to structure and the backend never starts."
  (= converter (default-converter))
  (= notebook (. (attrs.fields lsp.NotebookCellTextDocumentFilter) notebook type))
  (.register-structure-hook converter
    (. (attrs.fields lsp.NotebookDocumentFilterWithCells) notebook type)
    (fn [value _] (ife (is value None) None (.structure converter value notebook))))
  (return converter))

(class _Client [LanguageClient]
  "pygls' LanguageClient for one backend process, reporting the process's
   exit to its BackendClient."
  (def __init__ [self owner]
    (.__init__ (super) "lpy-lsp-backend" "v0.1.0" :converter-factory _converter)
    (= self.owner owner))

  (async-def server-exit [self server]
    (._backend-exited self.owner self server)))

;; Settings a backend takes from its client, not from the view root's
;; config file, as one nested object (the didChangeConfiguration shape); a
;; workspace/configuration section is a dotted path into it, and a server
;; ignores the keys that are not its own.  Auto-import completions are off:
;; their edits land on generated lines, and a symbol the buffer never
;; imports would give a buffer name its kind.  pyright's settings default
;; wins over pyrightconfig.json there, so the config file cannot turn them
;; off.  pyrefly reads python.analysis for that; basedpyright reads it
;; only when basedpyright.analysis is absent, and takes the whole analysis
;; object from the one it picks, so its own section stays, with
;; autoSearchPaths kept at its default (true) explicitly.
(def backend-settings [view-root]
  (return {"python" {"pythonPath" view-root.python
                     "analysis" {"autoImportCompletions" False}}
           "basedpyright" {"analysis" {"autoImportCompletions" False
                                       "autoSearchPaths" True
                                       ;; The view root holds a shadow of every
                                       ;; .lpy of the project: only the open
                                       ;; buffers are analysed, never them all.
                                       "diagnosticMode" "openFilesOnly"}}}))

(def settings-section [settings section]
  "The value at dotted section of settings, {} when there is none."
  (= node settings)
  (for key in (.split (or section "") ".")
    (= node (ife (isinstance node dict) (.get node key) None))
    (if (is node None)
        (return {})))
  (return node))

(def _register-handlers [client view-root]
  "The backend's requests and notifications to the client."
  (deco (client.feature lsp.WORKSPACE_CONFIGURATION)
    (def configuration [params]
      ;; pyright asks python, python.analysis, basedpyright and
      ;; basedpyright.analysis; the rest is the view root's config file's.
      (= settings (backend-settings view-root))
      (return [(settings-section settings item.section) for item in params.items])))
  (deco (client.feature lsp.TEXT_DOCUMENT_PUBLISH_DIAGNOSTICS)
    (def publish-diagnostics [params]
      (._diagnostics-published client.owner client params)))
  (for method in [lsp.CLIENT_REGISTER_CAPABILITY
                  lsp.CLIENT_UNREGISTER_CAPABILITY
                  lsp.WINDOW_WORK_DONE_PROGRESS_CREATE
                  lsp.PROGRESS]
    ((.feature client method) (fn [params] None)))
  (for method in [lsp.WINDOW_LOG_MESSAGE lsp.WINDOW_SHOW_MESSAGE]
    ((.feature client method)
     (fn [params] (.debug logger "python backend: %s" params.message)))))

(async-def _drain-stderr [stream]
  "Read the backend's stderr to its end into the debug log.  pygls' start_io
   opens it as a pipe and never reads it, so a backend that writes 64 KB to
   it would block on the full pipe."
  (try
    (while True
      (= chunk (await (.read stream 65536)))
      (if (not chunk)
          (break))
      (.debug logger "python backend stderr: %s"
              (.rstrip (.decode chunk "utf-8" "replace"))))
    (except [Exception]
      (pass))))

(def _client-capabilities []
  "What lispython's LSP asks a backend for: completion, hover, signature
   help, definition and references over full-text sync, its configuration,
   and file changes notified by the client (dynamic registration), so the
   backend does not watch the view root itself."
  (return
    (lsp.ClientCapabilities
      :text-document (lsp.TextDocumentClientCapabilities
                       :synchronization (lsp.TextDocumentSyncClientCapabilities)
                       :completion (lsp.CompletionClientCapabilities)
                       :hover (lsp.HoverClientCapabilities
                                :content-format [lsp.MarkupKind.Markdown
                                                 lsp.MarkupKind.PlainText])
                       ;; Parameters as offsets into the label: the server
                       ;; maps them through its relabel (python-to-buffer),
                       ;; where a parameter's own text could match twice.
                       :signature-help (lsp.SignatureHelpClientCapabilities
                                         :signature-information
                                         (lsp.ClientSignatureInformationOptions
                                           :documentation-format [lsp.MarkupKind.Markdown
                                                                  lsp.MarkupKind.PlainText]
                                           :parameter-information
                                           (lsp.ClientSignatureParameterInformationOptions
                                             :label-offset-support True)))
                       :definition (lsp.DefinitionClientCapabilities)
                       :references (lsp.ReferenceClientCapabilities)
                       ;; The version tells a full view's diagnostics from a
                       ;; request's cursor view's (_diagnostics-published);
                       ;; pyright reports unused and unreachable code only to
                       ;; a client that takes the Unnecessary tag.
                       :publish-diagnostics (lsp.PublishDiagnosticsClientCapabilities
                                              :version-support True
                                              :related-information True
                                              :code-description-support True
                                              :tag-support
                                              (lsp.ClientDiagnosticsTagOptions
                                                :value-set [lsp.DiagnosticTag.Unnecessary
                                                            lsp.DiagnosticTag.Deprecated])))
      :workspace (lsp.WorkspaceClientCapabilities
                   :configuration True
                   :did-change-watched-files (lsp.DidChangeWatchedFilesClientCapabilities
                                               :dynamic-registration True)))))

(def _kill [process]
  (if (and (is-not process None) (is process.returncode None))
      (try
        (.kill process)
        (except [ProcessLookupError]
          (pass)))))

(class BackendClient []
  "The Python backend of one project, over its ViewRoot view-root.  argv
   starts it; None is the off backend, which never spawns.  name is the
   backend argv runs (a BACKENDS key), None for an unnamed one (a test's
   fake), which takes pyright's config file and suppression comments.  The
   process starts on the first request (request), after the view root's
   shadows and name's config file (config-writer) are written; a process that exits without shutdown is
   restarted by the next request, once (MAX-SPAWNS), and a second death
   leaves the backend off.  state is idle (not started), running, dead
   (waiting for its restart), off or closed (after shutdown); process is
   the running process.  Documents are synced by full text, keyed by their
   .lpy uri, as the view-path shadow's uri: a buffer's full view
   (push-buffer), or a request's cursor view, after whose answer the full
   view is synced back.  Its diagnostics are kept only for a full view's
   text (_diagnostics-published, diagnostics-for).  A save while a start
   is in progress is recorded and replayed once it runs (_replay-saves),
   since the start's sweep may have read the disk before the save.
   definition-walks-up is True for a backend in DEFINITION-WALKS-UP."
  (def __init__ [self view-root argv :name None :manifest None
                 :check-types True :definition-walks-up False]
    (= self.view-root view-root)
    (= self.name name)
    (= self.project-root (osp.realpath view-root.project-root))
    (= self.argv argv)
    ;; The config writer's: False when no diagnostic is forwarded.
    (= self.check-types check-types)
    (= self.definition-walks-up definition-walks-up)
    (= self.manifest (ife (is manifest None) (ShadowManifest) manifest))
    (= self.state (ife (is argv None) OFF "idle"))
    (= self.spawns 0)
    (= self.process None)
    (= self._client None)
    (= self._stderr-task None)
    ;; The one start in progress (_start), shared by every request that
    ;; waits for it.
    (= self._starting None)
    ;; _discard's cleanups still running (_reap).
    (= self._cleanups (set))
    ;; lpy uris saved while a start was in progress (file-saved), which its
    ;; sweep may have missed: replayed once it runs; the next start clears
    ;; them before its own sweep (_start).
    (= self._saved-while-starting (set))
    ;; The replays of those saves still running (_replay-saves); kept here
    ;; because the loop holds tasks only weakly.
    (= self._replays (set))
    ;; lpy uri -> [backend uri, version, text last sent, origin], for this
    ;; spawn: origin is (source, view), the .lpy source and the PythonView
    ;; whose text was sent, or None when the sender did not say (locate).
    (= self._docs {})
    ;; lpy uri -> (text, origin) of the buffer's latest full view
    ;; (push-buffer), kept across spawns: a start opens each in the new
    ;; process, and a request that synced a cursor view puts it back.
    (= self._full {})
    ;; lpy uri -> (text, diagnostics) the backend last published for a
    ;; full view's text (_diagnostics-published).
    (= self._diagnostics {})
    ;; Called with an lpy uri on the loop when its diagnostics arrive; set by
    ;; Backends.
    (= self.on-diagnostics None)
    ;; Called with this client on the loop once a start succeeded, so the
    ;; process runs over the view root that start wrote (_prepare-view-root),
    ;; or a save changed its config file (saved); set by Backends.  Never
    ;; raises (_tell-view-prepared catches).
    (= self.on-view-prepared None)
    ;; Called on the loop once the backend's input changed: with an lpy uri
    ;; once a text of that buffer was sent to it (_sync: a full view's or a
    ;; cursor view's), with None once a start succeeded (_start: the new
    ;; process reads the disk anew) or it was told files on disk changed
    ;; (file-saved, saved); set by Backends.  Never raises
    ;; (_tell-input-changed catches).
    (= self.on-input-changed None)
    ;; The view root's config file text the running process last read: at
    ;; its start (_spawn) or when told it changed (saved).
    (= self._config-text None)
    ;; lpy uri -> its requests in flight (request), which a full view's
    ;; sync waits for.
    (= self._in-flight {}))

  (deco property
    (def running [self]
      (return (and (== self.state "running") (is-not self.process None)
                   (is self.process.returncode None)))))

  (deco property
    (def starting [self]
      "True while a start is in progress (_start-task's task)."
      (return (and (is-not self._starting None) (not (.done self._starting))))))

  (deco property
    (def available [self]
      "False when the backend is off or shut down: a request answers None
       without trying, so a caller need not prepare one."
      (return (not-in self.state (, OFF "closed")))))

  (def backend-uri [self lpy-uri]
    "The backend's uri for document lpy-uri (its shadow's), or None for a
     document outside the project."
    (= path (to-fs-path lpy-uri))
    (if (is path None)
        (return None))
    (= shadow (view-path self.project-root self.view-root (osp.realpath path)))
    (if (is shadow None)
        (return None))
    (return (.as-uri (pathlib.Path shadow))))

  (def _prepare-view-root [self]
    "Write the view root's shadows and the backend's config file, and return
     the shadows' ShadowSweep.  They compile every .lpy of the project (its
     macros run), so callers run this in a thread, off the event loop."
    (= root (os.fspath self.view-root))
    (os.makedirs root :exist-ok True)
    (= sweep (write-shadows self.project-root root :manifest self.manifest))
    ((config-writer self.name) self.project-root self.view-root
                               :import-roots self.manifest.import-roots
                               :check-types self.check-types)
    (return sweep))

  (def _start-task [self]
    "The task starting the backend: the one in progress, else a new one when
     none runs and a start is left (MAX-SPAWNS), else None.  Synchronous, so
     two requests on the loop never start two processes."
    (if self.starting
        (return self._starting))
    (if (and (== self.state "running") (not self.running))
        ;; exited, and server_exit has not reported it yet
        (= self.state "dead"))
    (cond (in self.state (, OFF "closed"))
          (return None)
          (>= self.spawns MAX-SPAWNS)
          (do (.warning logger "lispython LSP: Python backend for %s failed twice; backend off"
                        self.project-root)
              (= self.state OFF)
              (return None)))
    (+= self.spawns 1)
    (= self._starting (asyncio.create-task (._start self)))
    (return self._starting))

  (async-def _ensure-started [self deadline]
    "True once a backend process runs, waiting for its start until deadline
     (the loop's clock).  The start is a task of its own, awaited without
     cancelling it (`_await-until`): a request that is cancelled (the
     editor's $/cancelRequest) or runs out of time stops waiting, never the
     start, which a later request finds done.  Only a start that fails or a
     process that exits uses up a spawn."
    (if self.running
        (return True))
    (= task (._start-task self))
    (if (is task None)
        (return False))
    (try
      (return (await (_await-until task deadline)))
      (except [TimeoutError]
        (return False))
      (except [asyncio.CancelledError]
        ;; shutdown cancelled the start: no backend, not a cancelled request
        (if (.cancelled task)
            (return False))
        (raise))))

  (async-def _start [self]
    "Start a backend process; True when it runs.  Cancelled only by
     shutdown."
    ;; Before the first await: this start's own sweep covers every save
    ;; recorded so far, a failed start's included.
    (.clear self._saved-while-starting)
    (try
      (if (is-not self._client None)
          ;; the dead process's client: its tasks end, its pipes close
          (await (._discard self)))
      (await (._spawn self))
      (except [Exception as e]
        (.warning logger "lispython LSP: Python backend for %s failed to start: %s"
                  self.project-root e)
        (await (._discard self))
        (if (!= self.state "closed")
            (= self.state (ife (>= self.spawns MAX-SPAWNS) OFF "dead")))
        (return False))
      (except [asyncio.CancelledError]
        (await (._discard self))
        (raise)))
    (if (== self.state "closed")
        ;; shutdown came during the spawn
        (do (await (._discard self))
            (return False)))
    (= self.state "running")
    ;; The buffers pushed while it started: their diagnostics need their
    ;; text in the backend, which no request may ever send.
    (for lpy-uri in (list self._full)
      (._sync-full self lpy-uri))
    ;; The new process holds none of the old one's state, so no answer kept
    ;; from before this start may serve it: drop every entry.
    (._tell-input-changed self None)
    ;; Only now: a start that failed or was shut down tells nobody of the
    ;; view it wrote, since no backend ever used it.
    (._tell-view-prepared self)
    (._replay-saves self)
    (return True))

  (def _replay-saves [self]
    "Replay the saves recorded while the start that just succeeded was in
     progress, all at once (saved: one sweep), as a task of its own: a
     request awaits the start, and the sweep compiles the project."
    (if (not self._saved-while-starting)
        (return))
    (= lpy-uris (sorted self._saved-while-starting))
    (.clear self._saved-while-starting)
    (= replay (asyncio.create-task (.saved self *lpy-uris)))
    (.add self._replays replay)
    (.add-done-callback replay _task-done)
    (.add-done-callback replay self._replays.discard))

  (def _tell-view-prepared [self]
    "Call on-view-prepared with this client, if set.  Never raises."
    (if (is-not self.on-view-prepared None)
        (try
          (self.on-view-prepared self)
          (except [Exception]
            (.exception logger "lispython LSP: reacting to the view of %s failed"
                        self.project-root)))))

  (def _config-path [self]
    "The backend's config file in the view root."
    (return (osp.join (os.fspath self.view-root) (config-file self.name))))

  (async-def _spawn [self]
    (await (asyncio.to-thread self._prepare-view-root))
    (= self._config-text (await (asyncio.to-thread read-quietly (._config-path self))))
    (= self._docs {})
    (= root (os.fspath self.view-root))
    (= root-uri (.as-uri (pathlib.Path root)))
    (= client (_Client self))
    (_register-handlers client self.view-root)
    (= self._client client)
    (await (.start-io client *self.argv :cwd root))
    ;; pygls keeps the process in a private field and has no accessor.
    (= self.process client._server)
    (if (== self.state "closed")
        (raise (RuntimeError "shut down while starting")))
    (= self._stderr-task (asyncio.create-task (_drain-stderr self.process.stderr)))
    (await (asyncio.wait-for
             (.initialize-async client
               (lsp.InitializeParams
                 ;; basedpyright exits when this process does, even killed,
                 ;; by watching this pid.  pyrefly ignores it and exits when
                 ;; its stdin reaches EOF, which a killed process's pipe
                 ;; gives as long as nothing else holds the pipe's write end.
                 :process-id (os.getpid)
                 :root-uri root-uri
                 :workspace-folders [(lsp.WorkspaceFolder :uri root-uri :name "lispython-view")]
                 :capabilities (_client-capabilities)))
             START-TIMEOUT))
    (.initialized client (lsp.InitializedParams))
    (.workspace-did-change-configuration client
      (lsp.DidChangeConfigurationParams
        :settings (backend-settings self.view-root))))

  (def _backend-exited [self client process]
    "A backend process exited: unless shutdown stopped it, its backend is
     dead until the next request restarts it."
    (if (and (is client self._client) (== self.state "running"))
        (do (.warning logger "lispython LSP: Python backend for %s exited (%s)"
                      self.project-root process.returncode)
            (= self.state "dead"))))

  (async-def _discard [self]
    "Kill the current process if it still runs and drop its client."
    (= client self._client)
    (= process self.process)
    (= drain self._stderr-task)
    (= self._client None)
    (= self.process None)
    (= self._stderr-task None)
    (= self._docs {})
    (_kill process)
    ;; A task of its own, awaited shielded: shutdown may cancel a _start
    ;; that is discarding, and the client this call took off self would then
    ;; keep its pygls tasks with nobody left to stop them.  shutdown waits
    ;; for every one left (_cleanups, which also keeps them referenced: the
    ;; loop holds tasks only weakly).  The shield is safe from 3.14+'s
    ;; "exception in shielded future" ERROR log only because _reap never
    ;; raises (it catches every Exception): keep it so.
    (= cleanup (asyncio.create-task (_reap client process drain)))
    (.add self._cleanups cleanup)
    (.add-done-callback cleanup self._cleanups.discard)
    (await (asyncio.shield cleanup)))

  (def _sync [self lpy-uri text :origin None]
    "Make the backend's copy of document lpy-uri text: didOpen when it is
     not open in this process, didChange with the whole text when it
     changed, nothing otherwise; origin (see _docs) is kept with it either
     way, since one text can come from sources that place it differently.
     on-input-changed hears of each text sent, never of an unchanged one,
     whoever syncs it (a full view or a request's cursor view).  False when
     the document has no backend uri, else True, sent or not."
    (= client self._client)
    (= doc (.get self._docs lpy-uri))
    (if (is doc None)
        (do (= uri (.backend-uri self lpy-uri))
            (if (is uri None)
                (return False))
            (.text-document-did-open client
              (lsp.DidOpenTextDocumentParams
                :text-document (lsp.TextDocumentItem :uri uri :language-id "python"
                                                     :version 1 :text text)))
            (= (sub self._docs lpy-uri) [uri 1 text origin])
            (._tell-input-changed self lpy-uri)
            (return True)))
    (= (sub doc 3) origin)
    (if (!= (sub doc 2) text)
        (do (+= (sub doc 1) 1)
            (= (sub doc 2) text)
            (.text-document-did-change client
              (lsp.DidChangeTextDocumentParams
                :text-document (lsp.VersionedTextDocumentIdentifier :uri (sub doc 0)
                                                                    :version (sub doc 1))
                :content-changes [(lsp.TextDocumentContentChangeWholeDocument :text text)]))
            (._tell-input-changed self lpy-uri)))
    (return True))

  (async-def request [self method params :uri None :text None :timeout None
                      :origin None :failed None]
    "Send request method with params (its lsprotocol params type) to the
     backend and return its result, or failed (default None, which is also
     a null result): the backend is off, failed to start, died, or took
     REQUEST-TIMEOUT.  The first request spawns the
     backend.  With uri (the .lpy document's) and text, the backend's copy
     of that document is made text first: any text, a cursor view's as
     well as the buffer's; origin is where that text comes from (_docs),
     for locate.  timeout (default REQUEST-TIMEOUT) bounds the whole call,
     the backend's start included; a start that takes longer goes on, for the
     next request.  Never raises but for cancellation."
    (= deadline (+ (.time (asyncio.get-running-loop))
                   (ife (is timeout None) REQUEST-TIMEOUT timeout)))
    (try
      (if (not (await (._ensure-started self deadline)))
          (return failed))
      (= client self._client)
      (if (is-not uri None)
          (= (sub self._in-flight uri) (+ (.get self._in-flight uri 0) 1)))
      (try
        (if (and (is-not uri None) (is-not text None))
            (._sync self uri text :origin origin))
        (= msg-id (str (uuid.uuid4)))
        (= answer (.send-request-async client.protocol method params :msg-id msg-id))
        ;; a timeout only stops waiting (`_await-until`): the late answer
        ;; resolves a future nobody awaits, which `_retrieve` marks read.
        (.add-done-callback answer _retrieve)
        (try
          (return (await (_await-until answer deadline)))
          (except [TimeoutError]
            (.debug logger "python backend: %s timed out" method)
            (.notify client.protocol lsp.CANCEL_REQUEST (lsp.CancelParams :id msg-id))
            (return failed)))
        (finally
          (if (is-not uri None)
              (._request-done self uri))))
      (except [Exception as e]
        (.debug logger "python backend: %s failed: %s" method e)
        (return failed))))

  (def _request-done [self lpy-uri]
    "A request on document lpy-uri ended.  Once none is left in flight, the
     backend analyses the buffer's full view again (a cursor view's
     diagnostics are never forwarded); never while another still waits for
     its answer over the text it synced."
    (= left (- (.get self._in-flight lpy-uri 1) 1))
    (if (> left 0)
        (do (= (sub self._in-flight lpy-uri) left)
            (return)))
    (.pop self._in-flight lpy-uri None)
    (._sync-full self lpy-uri))

  (def push-buffer [self lpy-uri source view]
    "Make view, the full PythonView of buffer source (the one compile of
     the change, never a second), the buffer's text in the backend: sent at
     once to a running one, else at its start; while requests on the
     document are in flight, when the last ends (_request-done), never
     under a request still waiting for its answer over the text it synced.
     True when the running backend has it or will.  The caller pushes only
     a view that compiled, so the backend keeps the last good text.  Call
     on the loop."
    (= (sub self._full lpy-uri) (, view.text (, source view)))
    (if (not self.running)
        (return False))
    (if (> (.get self._in-flight lpy-uri 0) 0)
        (return True))
    (return (._sync-full self lpy-uri)))

  (def _sync-full [self lpy-uri]
    "Sync lpy-uri's latest full view (_full) to a running backend; True when
     the backend has it.  Never raises."
    (= full (.get self._full lpy-uri))
    (if (or (is full None) (not self.running))
        (return False))
    (try
      (= synced (._sync self lpy-uri (sub full 0) :origin (sub full 1)))
      (except [Exception]
        (.debug logger "python backend: cannot sync %s" lpy-uri :exc-info True)
        (return False)))
    (return synced))

  (def _tell-input-changed [self lpy-uri]
    "Call on-input-changed with lpy-uri, if set.  Never raises."
    (if (is-not self.on-input-changed None)
        (try
          (self.on-input-changed lpy-uri)
          (except [Exception]
            (.exception logger "lispython LSP: reacting to a backend input change failed")))))

  (def _diagnostics-published [self client params]
    "The backend published diagnostics (publishDiagnostics params) from
     client's process.  Kept only for the text of a buffer's full view: the
     document must be one this process has open, at the version published,
     and its text then the buffer's latest full view (_full), never a
     request's cursor view, whose text the user does not see.  on-diagnostics
     then hears of it.  Call on the loop.  Never raises."
    (try
      (if (is-not client self._client)
          (return))
      (= path (to-fs-path params.uri))
      (= path (ife (is path None) None (osp.normpath path)))
      (for [lpy-uri doc] in (list (.items self._docs))
        (= synced (to-fs-path (sub doc 0)))
        (if (not (or (== (sub doc 0) params.uri)
                     (and path synced (== (osp.normpath synced) path))))
            (continue))
        (= full (.get self._full lpy-uri))
        (if (or (is params.version None) (!= params.version (sub doc 1))
                (is full None) (!= (sub full 0) (sub doc 2)))
            (return))
        ;; Related locations are placed now, as locate requires, through
        ;; the origin of the text the backend analysed.
        (= origins {lpy-uri (sub full 1)})
        (= (sub self._diagnostics lpy-uri)
           (, (sub doc 2)
              [(, diagnostic [(.locate self info.location.uri :origins origins)
                              for info in (or diagnostic.related-information [])])
               for diagnostic in params.diagnostics]))
        (if (is-not self.on-diagnostics None)
            (self.on-diagnostics lpy-uri))
        (return))
      (except [Exception]
        (.exception logger "lispython LSP: backend diagnostics failed for %s" params.uri))))

  (def diagnostics-for [self lpy-uri text]
    "The backend's diagnostics for document lpy-uri when they were published
     for text, the text of its full view, else None: a list of (diagnostic,
     places), an lsprotocol Diagnostic over text in UTF-16 units and the
     locate answer for each of its related locations."
    (= known (.get self._diagnostics lpy-uri))
    (if (or (is known None) (!= (sub known 0) text))
        (return None))
    (return (sub known 1)))

  (def locate [self uri :origins None]
    "Where a location the backend answered with, at uri, lives for the
     editor, or None when it lives nowhere the editor has (drop it):
     (lpy, lpy-uri, origin) for a compiled view of a .lpy, to be mapped
     through origin ((source, view), _docs) or, when origin is None, through
     the shadow on disk of lpy-uri's file; (file, uri) for a real file,
     whose range stands as it is.  A document this process synced is its
     own .lpy uri, as the editor gave it, and is dropped when the text sent
     has no origin, since its disk shadow is not what the backend read; any
     other .py file under the view
     root is a shadow when its .lpy is in the project (view-path's
     inverse); a path that leaves the view root through a link (a mirrored
     .py or .pyi, a linked directory) is the real file it reaches; anything
     else under the view root (a temporary file, a shadow whose .lpy is
     gone) is dropped; a path outside it is a real file.  origins (lpy uri
     -> origin) names the origin of a document the caller knows better than
     _docs: the requesting document's, the text its answer was computed
     over, which a sync since the request may have replaced in _docs.
     Call on the loop (it reads _docs), right after the answer arrives, so
     no later sync moves another document's origin.  Never raises."
    (try
      (= path (to-fs-path uri))
      (if (is path None)
          (return None))
      (= path (osp.normpath path))
      (for [lpy-uri origin] in (.items (or origins {}))
        (= own (.backend-uri self lpy-uri))
        (if (and own (== (osp.normpath (to-fs-path own)) path))
            (return (, "lpy" lpy-uri origin))))
      (for [lpy-uri doc] in (.items self._docs)
        (= synced (to-fs-path (sub doc 0)))
        (if (or (== (sub doc 0) uri) (and synced (== (osp.normpath synced) path)))
            (return (ife (is (sub doc 3) None) None (, "lpy" lpy-uri (sub doc 3))))))
      (= root (osp.abspath (os.fspath self.view-root)))
      (= real-root (osp.realpath root))
      (= rel None)
      (for base in (, root real-root)
        (= candidate (osp.relpath path base))
        (if (not (or (== candidate os.pardir) (.startswith candidate (+ os.pardir os.sep))))
            (do (= rel candidate)
                (break))))
      (if (is rel None)
          (return (, "file" uri)))
      (= real (osp.realpath path))
      (if (!= real (osp.normpath (osp.join real-root rel)))
          (return (, "file" (.as-uri (pathlib.Path real)))))
      (if (and (.endswith path ".py") (osp.isfile path))
          (do (= lpy-path (osp.join self.project-root (+ (sub (osp.splitext rel) 0) ".lpy")))
              (if (osp.isfile lpy-path)
                  (return (, "lpy" (.as-uri (pathlib.Path lpy-path)) None)))))
      (return None)
      (except [Exception]
        (.debug logger "python backend: cannot locate %s" uri :exc-info True)
        (return None))))

  (def close-document [self lpy-uri]
    "didClose for document lpy-uri if this backend process has it open."
    (.pop self._full lpy-uri None)
    (.pop self._diagnostics lpy-uri None)
    (= doc (.pop self._docs lpy-uri None))
    (if (and (is-not doc None) self.running)
        (.text-document-did-close self._client
          (lsp.DidCloseTextDocumentParams
            :text-document (lsp.TextDocumentIdentifier :uri (sub doc 0))))))

  (async-def file-saved [self *lpy-uris]
    "Rewrite a running backend's shadows and config, then tell it every file
     the sweep changed: each saved file's shadow and each shadow the sweep
     wrote (a macro module's dependents recompile with it) as Changed, each
     file it removed as Deleted.  While a start is in progress the saves
     are recorded instead and replayed once it runs (_replay-saves),
     because its sweep may have read the disk before them; with neither, a
     no-op, since the next start sweeps."
    (if (not self.running)
        (do (if self.starting
                (.update self._saved-while-starting lpy-uris))
            (return)))
    (= sweep (await (asyncio.to-thread self._prepare-view-root)))
    (= changed [(.as-uri (pathlib.Path path)) for path in sweep.written])
    (for lpy-uri in lpy-uris
      (= uri (.backend-uri self lpy-uri))
      (if (and (is-not uri None) (not-in uri changed))
          (.append changed uri)))
    (= changes (+ [(lsp.FileEvent :uri uri :type lsp.FileChangeType.Changed)
                   for uri in changed]
                  [(lsp.FileEvent :uri (.as-uri (pathlib.Path path))
                                  :type lsp.FileChangeType.Deleted)
                   for path in sweep.removed]))
    (if (and changes self.running)
        (do (.workspace-did-change-watched-files self._client
              (lsp.DidChangeWatchedFilesParams :changes changes))
            ;; On the loop: the thread's work ended at the await above.
            (._tell-input-changed self None))))

  (async-def saved [self *lpy-uris]
    "Documents lpy-uris were saved: file-saved, then, when that changed the
     view root's config file, tell the running backend the file changed and
     call on-view-prepared.  A running backend reads its config at start
     and when told the file changed, then republishes its open documents;
     it never re-reads it on its own.  A save during a start is replayed
     through here once it runs (_replay-saves)."
    (await (.file-saved self *lpy-uris))
    (if (not self.running)
        (return))
    (= path (._config-path self))
    (= text (await (asyncio.to-thread read-quietly path)))
    (if (or (not self.running) (== text self._config-text))
        (return))
    (= self._config-text text)
    (.workspace-did-change-watched-files self._client
      (lsp.DidChangeWatchedFilesParams
        :changes [(lsp.FileEvent :uri (.as-uri (pathlib.Path path))
                                 :type lsp.FileChangeType.Changed)]))
    (._tell-input-changed self None)
    (._tell-view-prepared self))

  (async-def shutdown [self]
    "Stop the backend for good: cancel a start or save replay in progress,
     send shutdown and exit and wait for the process to end, all within
     SHUTDOWN-TIMEOUT, then kill and reap it (_reap: up to three
     KILL-TIMEOUT waits), about 3.5 s at worst; a start it cancels reaps
     its own client instead.  A replay cancelled inside its to_thread sweep
     stops waiting for it, as a start does; the thread finishes that write
     under the view root's lock.  No request spawns one afterwards."
    (= self.state "closed")
    (= deadline (+ (.time (asyncio.get-running-loop)) SHUTDOWN-TIMEOUT))
    (= starting self._starting)
    (if (and (is-not starting None) (not (.done starting)))
        ;; A start inside its to_thread view-root write stops waiting for
        ;; it; the thread itself finishes that write (under the view root's
        ;; lock) after shutdown, which only touches the cache directory.
        (do (.cancel starting)
            (await (asyncio.gather starting :return-exceptions True))))
    (= replays (list self._replays))
    (for replay in replays
      (.cancel replay))
    (await (asyncio.gather *replays :return-exceptions True))
    (= client self._client)
    (= process self.process)
    (if (and (is-not client None) (is-not process None) (is process.returncode None))
        (try
          (await (asyncio.wait-for (.shutdown-async client None) (_remaining deadline)))
          (.exit client None)
          (await (asyncio.wait-for (.wait process) (_remaining deadline)))
          (except [Exception as e]
            (.debug logger "python backend: no clean exit: %s" e))))
    (await (._discard self))
    ;; a cleanup a cancelled start left running (each bounded by _reap)
    (await (asyncio.gather *self._cleanups :return-exceptions True)))

  (def start-soon [self]
    "Begin starting the backend without waiting for it, so a later request
     finds it running: the one start task every request shares
     (_start-task), so never a second process, and none when it runs, is
     off or closed, or has no start left.  Call on the loop.  Never
     raises."
    (if self.running
        (return))
    (try
      (._start-task self)
      (except [Exception]
        (.exception logger "lispython LSP: cannot start the Python backend for %s"
                    self.project-root))))

  (def kill [self]
    "Kill the process now, without the protocol (the LSP is exiting)."
    (= self.state "closed")
    (if (is-not self._starting None)
        (.cancel self._starting))
    (for replay in (list self._replays)
      (.cancel replay))
    (_kill self.process)))

(async-def _reap [client process drain]
  "Wait (bounded) for a killed process to end, for its stderr drain and for
   its client's tasks."
  (if (is-not process None)
      (try
        (await (asyncio.wait-for (.wait process) KILL-TIMEOUT))
        (except [Exception]
          (pass))))
  (if (is-not drain None)
      (try
        (await (asyncio.wait-for drain KILL-TIMEOUT))
        (except [Exception]
          (pass))))
  (if (is-not client None)
      (try
        (await (asyncio.wait-for (.stop client) KILL-TIMEOUT))
        (except [Exception]
          (pass)))))

(def _remaining [deadline]
  "Seconds left until deadline on the running loop's clock, never below 0."
  (return (max 0 (- deadline (.time (asyncio.get-running-loop))))))

(async-def _await-until [future deadline]
  "The result of future, waiting until deadline (the loop's clock) and
   raising TimeoutError after it.  Never cancels the future and never uses
   asyncio.shield, whose 3.14+ exception logging fires when a future we
   stopped waiting on later fails."
  (await (asyncio.wait [future] :timeout (_remaining deadline)))
  (if (not (.done future))
      (raise (TimeoutError)))
  (return (.result future)))

(def _retrieve [future]
  "Mark a request future's exception retrieved: one whose wait timed out is
   failed later by the process exit, with nobody left to read it."
  (if (not (.cancelled future))
      (.exception future)))

;; ---------------------------------------------------------------------------
;; The LSP's backends
;; ---------------------------------------------------------------------------

(def project-root-of [path folders]
  "The real path of the innermost of folders (workspace folders, objects
   with .uri) holding path, or None: path's project, the one home of that
   rule (a document's backend, the module names its compiles take).  The
   file's directory is resolved, never the file: a file link
   proj/ns/a.lpy -> /elsewhere/a.lpy is in proj, as write-shadows' walk
   and package-root see it."
  (= real (pathlib.Path (osp.realpath (osp.dirname (osp.abspath path)))))
  (= best None)
  (for folder in folders
    (= folder-path (to-fs-path folder.uri))
    (if (is folder-path None)
        (continue))
    (= root (osp.realpath folder-path))
    (if (and (.is-relative-to real root)
             (or (is best None) (> (len root) (len best))))
        (= best root)))
  (return best))

(class Backends []
  "The BackendClient of each workspace project, for lispython's LSP.
   folders gives the client's workspace folders (objects with .uri); a
   document's project is the innermost one holding it, and a document
   outside every folder or outside its project's view never reaches a
   backend.  The backend comes from the initializationOptions given to
   configure (resolve-backend), and so does python-diagnostics
   (resolve-python-diagnostics), whether the backend's diagnostics are
   forwarded.  The document-* hooks run on the LSP's loop and never raise:
   document-opened starts the backend when its diagnostics are forwarded;
   the others never start one, and send to one only when it already runs
   (a start sends the pushed buffers itself).  on-diagnostics, set by the
   server, is called with an lpy uri when the backend published that
   buffer's diagnostics; on-view-prepared with a BackendClient once its
   start succeeded, over the view root's shadows and config file it wrote,
   or a save changed its config file; on-input-changed with an lpy uri once
   a text of that buffer (a full or cursor view's) was sent to a backend,
   or None once a backend started or was told files on disk changed."
  (def __init__ [self folders :cache-home None]
    (= self.folders folders)
    (= self.cache-home cache-home)
    (= self.name None)
    (= self.python-diagnostics True)
    (= self.on-diagnostics None)
    (= self.on-view-prepared None)
    (= self.on-input-changed None)
    (= self.clients {})
    (= self._tasks (set))
    (= self._closed False))

  (def configure [self init-options]
    (try
      (= self.name (resolve-backend init-options))
      (= self.python-diagnostics (resolve-python-diagnostics init-options))
      (except [Exception]
        (.exception logger "lispython LSP: cannot resolve the Python backend")
        (= self.name OFF))))

  (deco property
    (def forwards-diagnostics [self]
      "Whether a backend's diagnostics reach the editor: a backend is on and
       pythonDiagnostics is not false."
      (if (is self.name None)
          (.configure self None))
      (return (and self.python-diagnostics (!= self.name OFF)))))

  (def _diagnostics-arrived [self lpy-uri]
    (if (and self.forwards-diagnostics (is-not self.on-diagnostics None))
        (try
          (self.on-diagnostics lpy-uri)
          (except [Exception]
            (.exception logger "lispython LSP: publishing diagnostics failed for %s"
                        lpy-uri)))))

  (def _input-changed [self lpy-uri]
    ;; BackendClient._tell-input-changed catches what this raises.
    (if (is-not self.on-input-changed None)
        (self.on-input-changed lpy-uri)))

  (def _view-prepared [self client]
    ;; BackendClient._tell-view-prepared catches what this raises.
    (if (is-not self.on-view-prepared None)
        (self.on-view-prepared client)))

  (def _project-root [self path]
    (return (project-root-of path (self.folders))))

  (def _existing [self lpy-uri]
    "The BackendClient already made for document lpy-uri's project, or None."
    (if (not self.clients)
        (return None))
    (= path (to-fs-path lpy-uri))
    (if (is path None)
        (return None))
    (return (.get self.clients (self._project-root path))))

  (def client-for [self lpy-uri]
    "Document lpy-uri's BackendClient, made on demand, or None when the
     document has no backend."
    (if self._closed
        (return None))
    (= path (to-fs-path lpy-uri))
    (if (is path None)
        (return None))
    (= root (self._project-root path))
    (if (is root None)
        (return None))
    (= client (.get self.clients root))
    (if (is client None)
        (do (if (is self.name None)
                (.configure self None))
            (= client (BackendClient (view-root-for root :cache-home self.cache-home)
                                     (backend-argv self.name)
                                     :name self.name
                                     :check-types self.forwards-diagnostics
                                     :definition-walks-up
                                     (in self.name DEFINITION-WALKS-UP)))
            (= client.on-diagnostics self._diagnostics-arrived)
            (= client.on-view-prepared self._view-prepared)
            (= client.on-input-changed self._input-changed)
            (= (sub self.clients root) client)))
    (if (is (.backend-uri client lpy-uri) None)
        (return None))
    (return client))

  (def available-client [self lpy-uri]
    "Document lpy-uri's BackendClient when a request to it can be answered
     (BackendClient.available), else None: the one lookup every feature
     makes, so a caller prepares nothing for a document with no backend.
     Never raises."
    (try
      (= client (.client-for self lpy-uri))
      (except [Exception]
        (.exception logger "lispython LSP: no Python backend for %s" lpy-uri)
        (return None)))
    (if (or (is client None) (not client.available))
        (return None))
    (return client))

  (async-def request [self lpy-uri method params :text None]
    "BackendClient.request for document lpy-uri's backend, or None when it
     has none."
    (= client (.available-client self lpy-uri))
    (if (is client None)
        (return None))
    (return (await (.request client method params :uri lpy-uri :text text))))

  (def _schedule [self coroutine]
    "Run coroutine as a task of the running loop, its failure logged."
    (= task (asyncio.ensure-future coroutine))
    (.add self._tasks task)
    (.add-done-callback task _task-done)
    (.add-done-callback task self._tasks.discard))

  (def document-opened [self lpy-uri]
    "A buffer opened: start its backend without waiting for it
     (BackendClient.start-soon) when its diagnostics are forwarded, since
     they come only from a running one.  Call on the loop."
    (try
      (if self.forwards-diagnostics
          (do (= client (.available-client self lpy-uri))
              (if (is-not client None)
                  (.start-soon client))))
      (except [Exception]
        (.exception logger "lispython LSP: backend start failed for %s" lpy-uri))))

  (def document-changed [self lpy-uri source view]
    "A buffer opened or changed and view, the PythonView of its source,
     compiled: push it to the buffer's backend (BackendClient.push-buffer),
     sent now to a running one, else when one starts.  True when the
     backend has it and its diagnostics are forwarded, so they will come.
     Call on the loop."
    (try
      (= client (._existing self lpy-uri))
      (if (or (is client None) (not client.available))
          (return False))
      (return (and (.push-buffer client lpy-uri source view) self.forwards-diagnostics))
      (except [Exception]
        (.exception logger "lispython LSP: backend sync failed for %s" lpy-uri)
        (return False))))

  (def backend-diagnostics [self lpy-uri text]
    "The backend's diagnostics published for text, the full view of buffer
     lpy-uri (BackendClient.diagnostics-for: (diagnostic, places) pairs);
     None when they are not forwarded or not known for text."
    (if (not self.forwards-diagnostics)
        (return None))
    (= client (._existing self lpy-uri))
    (if (is client None)
        (return None))
    (return (.diagnostics-for client lpy-uri text)))

  (def document-closed [self lpy-uri]
    (try
      (= client (._existing self lpy-uri))
      (if (is-not client None)
          (.close-document client lpy-uri))
      (except [Exception]
        (.exception logger "lispython LSP: backend close failed for %s" lpy-uri))))

  (def document-saved [self lpy-uri]
    "A buffer was saved: BackendClient.saved for a running backend or one
     starting, which replays it once it runs (its sweep may predate the
     save).  Call on the loop."
    (try
      (= client (._existing self lpy-uri))
      (if (and (is-not client None) (or client.running client.starting))
          (._schedule self (.saved client lpy-uri)))
      (except [Exception]
        (.exception logger "lispython LSP: backend save failed for %s" lpy-uri))))

  (async-def shutdown-all [self]
    "Shut every backend down (the LSP's shutdown); none starts afterwards."
    (= self._closed True)
    (= clients (list (.values self.clients)))
    (try
      (await (asyncio.gather *[(.shutdown client) for client in clients]
                             :return-exceptions True))
      (except [Exception]
        (.exception logger "lispython LSP: backend shutdown failed"))))

  (def kill-all [self]
    "Kill every backend process now (the LSP's exit, a safety net for a
     client that exits without shutdown)."
    (= self._closed True)
    (for client in (list (.values self.clients))
      (try
        (.kill client)
        (except [Exception]
          (pass))))))

(def _task-done [task]
  (if (and (not (.cancelled task)) (is-not (.exception task) None))
      (.error logger "lispython LSP: backend task failed" :exc-info (.exception task))))
