(import unittest)
(from lispy.core.parser [parse])
(from lispy.core.nodes [Symbol Paren])

(class TestParser [unittest.TestCase]
  (def test-arrow-macro-definition [self]
    (= rst (parse "(defmacro -> [x *fs] x)"))
    (= p (rst.pop))
    (self.assertIsInstance p Paren)
    (self.assertEqual (str (p.list.__getitem__ 1)) "->")
    (self.assertIsInstance (p.list.__getitem__ 1) Symbol))

  (def test-arrow-macro-call [self]
    (= rst (parse "(-> 1 (+ 2))"))
    (= p (rst.pop))
    (self.assertIsInstance p Paren)
    (self.assertEqual (str (p.list.__getitem__ 0)) "->")
    (self.assertIsInstance (p.list.__getitem__ 0) Symbol)))